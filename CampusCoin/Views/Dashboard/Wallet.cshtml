@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Digital Wallet — CampusCoin</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50:  '#f6effc',
                            100: '#ede4f6',
                            400: '#a486e0',
                            500: '#8b58b8',
                            600: '#6b3a92',
                        }
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', '-apple-system', 'BlinkMacSystemFont', 'Inter', 'sans-serif']
                    }
                }
            }
        };
    </script>

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

    <style>
        * {
            transition:
                background-color 0.4s ease,
                border-color 0.4s ease,
                box-shadow 0.4s ease,
                color 0.3s ease;
        }

        html { scroll-behavior: smooth; }

        body {
            min-height: 100vh;
            font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
            background-color: #fbf6f0;
            background-image:
                radial-gradient(at 0% 0%,   rgba(237, 228, 246, 0.9) 0px, transparent 50%),
                radial-gradient(at 100% 0%, rgba(196, 174, 224, 0.85) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(255, 225, 230, 0.85) 0px, transparent 50%),
                radial-gradient(at 0% 100%, rgba(246, 239, 252, 0.9) 0px, transparent 50%),
                radial-gradient(at 50% 50%, rgba(212, 243, 228, 0.4) 0px, transparent 50%);
            background-attachment: fixed;
        }

        body.dark-mesh {
            background-color: #100a1a;
            background-image:
                radial-gradient(at 10% 10%, rgba(139, 111, 240, 0.28) 0px, transparent 50%),
                radial-gradient(at 90% 10%, rgba(155, 111, 216, 0.22) 0px, transparent 50%),
                radial-gradient(at 90% 90%, rgba(109, 74, 255, 0.28) 0px, transparent 50%),
                radial-gradient(at 10% 90%, rgba(212, 121, 159, 0.22) 0px, transparent 50%);
            background-attachment: fixed;
        }

        .orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(80px);
            z-index: -1;
            pointer-events: none;
            animation: floatOrb 18s infinite alternate ease-in-out;
        }

        .orb-1 { width: 450px; height: 450px; background: rgba(155, 111, 216, 0.5); top: -100px; left: -100px; }
        .orb-2 { width: 480px; height: 480px; background: rgba(139, 111, 240, 0.45); top: 30%; right: -120px; animation-delay: -5s; }
        .orb-3 { width: 400px; height: 400px; background: rgba(212, 121, 159, 0.4); bottom: -100px; left: 20%; animation-delay: -10s; }

        @@keyframes floatOrb {
            0%   { transform: translate(0px, 0px) scale(1); }
            50%  { transform: translate(40px, 60px) scale(1.08); }
            100% { transform: translate(-30px, 30px) scale(0.95); }
        }

        .ios-glass {
            backdrop-filter: blur(32px) saturate(240%);
            -webkit-backdrop-filter: blur(32px) saturate(240%);
            position: relative;
            overflow: hidden;
        }

        .light .ios-glass {
            background: rgba(255, 255, 255, 0.72);
            border: 1.5px solid rgba(255, 255, 255, 0.95);
            box-shadow:
                0 20px 40px -12px rgba(109, 74, 255, 0.12),
                0 4px 16px -2px rgba(0, 0, 0, 0.04),
                inset 0 1.5px 2px 0 rgba(255, 255, 255, 1),
                inset 0 -1.5px 2px 0 rgba(0, 0, 0, 0.03);
            color: #1a0b2e;
        }

        .dark .ios-glass {
            background: rgba(28, 18, 42, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow:
                0 25px 50px -12px rgba(0, 0, 0, 0.45),
                inset 0 1px 0 0 rgba(255, 255, 255, 0.18);
            color: #f8fafc;
        }

        .ios-glass-interactive {
            transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease, background 0.35s ease;
        }

        .ios-glass-interactive::before {
            content: '';
            position: absolute;
            top: 0; left: -150%;
            width: 100%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.65), transparent);
            transform: skewX(-25deg);
            transition: left 0.75s ease;
            pointer-events: none;
        }

        .dark .ios-glass-interactive::before {
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.15), transparent);
        }

        .ios-glass-interactive:hover::before { left: 150%; }
        .ios-glass-interactive:hover { transform: translateY(-4px); }

        .sidebar {
            position: fixed;
            top: 20px; left: 20px; bottom: 20px;
            width: 260px; z-index: 100; border-radius: 30px; padding: 18px;
            display: flex; flex-direction: column; transform: translateX(0);
            transition: transform .35s ease;
        }

        .brand { display: flex; align-items: center; gap: 12px; padding: 4px 6px 22px; }
        .brand-logo {
            width: 46px; height: 46px; border-radius: 16px;
            display: flex; align-items: center; justify-content: center;
            color: white; font-size: 20px;
            background: linear-gradient(135deg, #8b58b8, #6b3a92, #241232);
            box-shadow: 0 12px 25px rgba(109, 74, 255, 0.32);
        }
        .brand-name { font-size: 18px; font-weight: 800; letter-spacing: -0.5px; }
        .brand-sub { font-size: 9px; font-weight: 800; letter-spacing: .16em; opacity: .45; margin-top: 3px; }

        .nav-section { font-size: 9px; text-transform: uppercase; letter-spacing: .15em; font-weight: 800; opacity: .4; padding: 14px 10px 7px; }
        .nav { flex: 1; overflow-y: auto; }
        .nav-link {
            display: flex; align-items: center; gap: 12px;
            padding: 11px 12px; margin: 4px 0; border-radius: 15px;
            text-decoration: none; color: inherit; font-size: 12px; font-weight: 650;
            transition: all .25s ease;
        }
        .nav-link i { width: 20px; text-align: center; opacity: .55; }
        .nav-link:hover { background: rgba(255,255,255,.30); transform: translateX(3px); }
        .dark .nav-link:hover { background: rgba(255,255,255,.06); }
        .nav-link.active {
            color: #6b3a92;
            background: linear-gradient(135deg, rgba(139,111,240,.18), rgba(109,74,255,.14));
            box-shadow: inset 0 0 0 1px rgba(139,111,240,.15), 0 10px 25px rgba(109,74,255,.08);
        }
        .dark .nav-link.active { color: #c4aee0; background: rgba(139,111,240,.1); }

        .student-mini {
            display: flex; align-items: center; gap: 9px; padding: 11px;
            border-radius: 18px; background: rgba(255,255,255,.30); border: 1px solid rgba(255,255,255,.35);
        }
        .dark .student-mini { background: rgba(255,255,255,.04); border-color: rgba(255,255,255,.08); }
        .student-avatar {
            width: 36px; height: 36px; border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            color: white; font-size: 11px; font-weight: 800;
            background: linear-gradient(135deg, #8b58b8, #6b3a92);
        }

        .main { margin-left: 300px; padding: 20px 25px 40px 0; min-height: 100vh; }
        .topbar {
            height: 70px; border-radius: 25px; padding: 10px 13px;
            display: flex; align-items: center; gap: 12px; position: sticky; top: 20px; z-index: 80;
        }

        .search { flex: 1; max-width: 500px; position: relative; }
        .search i { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); opacity: .4; font-size: 12px; }
        .search input {
            width: 100%; border: none; outline: none; padding: 11px 15px 11px 42px;
            border-radius: 16px; background: rgba(255,255,255,.38); color: inherit;
            font-size: 12px; border: 1px solid rgba(255,255,255,.50);
        }
        .dark .search input { background: rgba(255,255,255,.05); border-color: rgba(255,255,255,.08); }

        .top-actions { display: flex; align-items: center; gap: 7px; margin-left: auto; }
        .action-btn {
            width: 42px; height: 42px; border-radius: 14px;
            border: 1px solid rgba(255,255,255,.55); background: rgba(255,255,255,.36);
            color: inherit; cursor: pointer; position: relative;
        }
        .dark .action-btn { background: rgba(255,255,255,.05); border-color: rgba(255,255,255,.08); }

        .notification-dot {
            width: 8px; height: 8px; border-radius: 50%; background: #f43f5e;
            position: absolute; top: 8px; right: 8px;
        }

        .profile { display: flex; align-items: center; gap: 9px; padding: 4px 9px 4px 4px; border-radius: 15px; cursor: pointer; }
        .profile-avatar {
            width: 36px; height: 36px; border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            color: white; font-size: 11px; font-weight: 800;
            background: linear-gradient(135deg, #a486e0, #6b3a92);
        }

        .dropdown-wrap { position: relative; }
        .dropdown {
            position: absolute; right: 0; top: calc(100% + 10px);
            width: 250px; padding: 9px; border-radius: 20px;
            opacity: 0; pointer-events: none; transform: translateY(-8px) scale(.98);
            transition: .2s ease; z-index: 200;
        }
        .dropdown.show { opacity: 1; pointer-events: auto; transform: translateY(0) scale(1); }
        .dropdown-item {
            width: 100%; display: flex; align-items: center; gap: 10px;
            border: 0; background: transparent; color: inherit;
            padding: 11px; border-radius: 13px; cursor: pointer; text-align: left; font-size: 11px;
        }

        .page-header { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin: 28px 3px 20px; }
        .eyebrow { color: #6b3a92; font-size: 9px; font-weight: 850; text-transform: uppercase; letter-spacing: .18em; margin-bottom: 8px; }
        .page-title { font-size: clamp(28px, 3vw, 40px); font-weight: 900; letter-spacing: -1.8px; line-height: 1; }

        /* HERO BALANCE CARD STYLING */
        .hero-wallet-card {
            background: linear-gradient(135deg, #8b58b8, #6b3a92, #241232);
            border-radius: 28px;
            padding: 28px;
            color: white;
            position: relative;
            overflow: hidden;
            box-shadow: 0 20px 45px rgba(109, 74, 255, 0.35);
        }
        .hero-wallet-card::before {
            content: '';
            position: absolute;
            width: 250px; height: 250px;
            background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, transparent 70%);
            top: -50px; right: -50px;
            pointer-events: none;
        }

        .hero-action-btn {
            background: rgba(255, 255, 255, 0.18);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 16px;
            padding: 12px 18px;
            font-size: 12px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: white;
            cursor: pointer;
            transition: all 0.25s ease;
        }
        .hero-action-btn:hover {
            background: rgba(255, 255, 255, 0.35);
            transform: translateY(-2px);
        }

        /* MODAL STYLES */
        .modal-overlay {
            position: fixed; inset: 0; background: rgba(15,23,42,.45);
            backdrop-filter: blur(10px); display: none; align-items: center; justify-content: center; z-index: 300;
        }
        .modal-overlay.show { display: flex; }
        .modal-card { width: 100%; max-width: 480px; padding: 26px; border-radius: 28px; }

        .glass-input {
            width: 100%;
            padding: 12px 16px;
            border-radius: 14px;
            background: rgba(255,255,255,.35);
            border: 1px solid rgba(255,255,255,.5);
            font-size: 12px;
            outline: none;
            color: inherit;
        }
        .dark .glass-input { background: rgba(255,255,255,.05); border-color: rgba(255,255,255,.1); }

        .method-chip {
            padding: 10px;
            border-radius: 14px;
            border: 1px solid rgba(255,255,255,.4);
            background: rgba(255,255,255,.2);
            cursor: pointer;
            text-align: center;
            font-size: 11px;
            font-weight: 700;
            transition: all 0.2s ease;
        }
        .method-chip.active {
            background: #6b3a92;
            color: white;
            border-color: transparent;
            box-shadow: 0 8px 20px rgba(109,74,255,.3);
        }

        .filter-btn {
            padding: 8px 16px; border-radius: 14px; font-size: 11px; font-weight: 700;
            border: 1px solid rgba(255,255,255,.4); background: rgba(255,255,255,.2); cursor: pointer;
        }
        .filter-btn.active {
            background: linear-gradient(135deg, #8b58b8, #6b3a92); color: white; border-color: transparent;
        }

        .mobile-btn { display: none; }
        .mobile-overlay { display: none; position: fixed; inset: 0; background: rgba(15,23,42,.25); backdrop-filter: blur(5px); z-index: 90; }
        .mobile-overlay.show { display: block; }

        @@media(max-width:950px) {
            .sidebar { transform: translateX(-120%); }
            .sidebar.open { transform: translateX(0); }
            .main { margin-left: 0; padding: 15px; }
            .mobile-btn { display: flex; }
        }

        #toastContainer { position: fixed; right: 20px; bottom: 20px; z-index: 999; display: flex; flex-direction: column; gap: 9px; }
        .toast { min-width: 270px; padding: 13px; border-radius: 17px; display: flex; align-items: center; gap: 10px; animation: toastIn .3s ease; }
        @@keyframes toastIn { from { opacity: 0; transform: translateY(15px) scale(.96); } to { opacity: 1; transform: translateY(0) scale(1); } }
    </style>
</head>

<body class="light min-h-screen text-slate-900 dark:text-slate-100 font-sans">

    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>

    <div id="mobileOverlay" class="mobile-overlay" onclick="closeSidebar()"></div>

    <!-- SIDEBAR -->
    <aside id="sidebar" class="sidebar ios-glass">
        <div class="brand">
            <div class="brand-logo"><i class="fa-solid fa-coins"></i></div>
            <div>
                <div class="brand-name">CampusCoin</div>
                <div class="brand-sub">STUDENT PORTAL</div>
            </div>
        </div>

        <nav class="nav">
        
            <div class="nav-section">Main Menu</div>
            <a href="/Dashboard/Index" class="nav-link"><i class="fa-solid fa-chart-line"></i><span>Dashboard</span></a>
            <a href="/Dashboard/Transactions" class="nav-link"><i class="fa-solid fa-arrow-right-arrow-left"></i><span>My Transactions</span></a>
            <a href="/FeeVouchers" class="nav-link"><i class="fa-solid fa-receipt"></i><span>Fee Vouchers</span></a>
            <a href="/Dashboard/Budgets" class="nav-link"><i class="fa-solid fa-wallet"></i><span>My Budgets</span></a>
            <a href="/Dashboard/Categories" class="nav-link"><i class="fa-solid fa-tags"></i><span>My Categories</span></a>
            <a href="/Dashboard/SavingGoals" class="nav-link"><i class="fa-solid fa-bullseye"></i><span>Saving Goals</span></a>
            <a href="/FeeVouchers" class="nav-link"><i class="fa-solid fa-bullseye"></i><span>Fee Voucher</span></a>
            <a href="/Dashboard/Wallet" class="nav-link active"><i class="fa-solid fa-bullseye"></i><span>Wallet</span></a>
            <a href="/Events" class="nav-link"><i class="fa-solid fa-bullseye"></i><span>Events</span></a>
            <a href="/Dashboard/BillSplit" class="nav-link"><i class="fa-solid fa-bullseye"></i><span>Share Expenses</span></a>
            
            <div class="nav-section">Personal</div>
            <a href="/Dashboard/FinancialHealth" class="nav-link"><i class="fa-solid fa-heart-pulse"></i><span>Financial Score</span></a>
            <a href="/Dashboard/Notifications" class="nav-link"><i class="fa-solid fa-bell"></i><span>Inbox & Chats</span></a>
            <a href="/Dashboard/Notifications" class="nav-link"><i class="fa-solid fa-bullhorn"></i><span>Announcement</span></a>
            <a href="/Dashboard/Profile" class="nav-link"><i class="fa-solid fa-sliders"></i><span>Profile</span></a>
            <a href="/AiCoach" class="nav-link"><i class="fa-solid fa-bullseye"></i><span>AiCoach & Support</span></a>
            <a href="/Dashboard/SavingGoals" class="nav-link"><i class="fa-solid fa-bullseye"></i><span>Wishlist</span></a>
        </nav>

        <div class="student-mini">
            <div class="student-avatar" id="sidebarAvatar">AR</div>
            <div class="flex-1 min-w-0">
                <div class="text-[11px] font-bold truncate" id="sidebarStudentName">Alex Rivera</div>
                <div class="text-[9px] opacity-45 truncate" id="sidebarStudentRole">BS Computer Science</div>
            </div>
            <i class="fa-solid fa-graduation-cap text-xs opacity-35"></i>
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="main">

        <!-- TOP BAR -->
        <header class="topbar ios-glass">
            <button class="action-btn mobile-btn" onclick="toggleSidebar()">
                <i class="fa-solid fa-bars"></i>
            </button>

            <div class="search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input id="globalSearch" type="text" placeholder="Search transactions, receipts, payments..." autocomplete="off">
            </div>

            <div class="top-actions">
                <button class="action-btn" onclick="toggleTheme()">
                    <i id="themeIcon" class="fa-solid fa-moon"></i>
                </button>

                <div class="dropdown-wrap">
                    <button class="action-btn" onclick="toggleDropdown('notificationDropdown')">
                        <i class="fa-regular fa-bell"></i>
                        <span id="notificationDot" class="notification-dot"></span>
                    </button>

                    <div id="notificationDropdown" class="dropdown ios-glass">
                        <div class="px-3 py-2">
                            <div class="font-bold text-xs">Notifications</div>
                            <div id="notificationCount" class="text-[9px] opacity-45 mt-1">0 unread</div>
                        </div>
                        <div id="notificationList"></div>
                    </div>
                </div>

                <div class="dropdown-wrap">
                    <div class="profile" onclick="toggleDropdown('profileDropdown')">
                        <div class="profile-avatar" id="topAvatar">AR</div>
                        <div class="profile-name-wrap">
                            <div class="text-[10px] font-bold" id="topStudentName">Alex Rivera</div>
                            <div class="text-[8px] opacity-45">Student</div>
                        </div>
                        <i class="fa-solid fa-chevron-down text-[8px] opacity-40"></i>
                    </div>

                    <div id="profileDropdown" class="dropdown ios-glass">
                        <a href="/Dashboard/Profile" class="dropdown-item">
                            <i class="fa-regular fa-user text-purple-500"></i> Profile
                        </a>
                        <button class="dropdown-item text-rose-500" onclick="logoutStudent()">
                            <i class="fa-solid fa-right-from-bracket"></i> Logout
                        </button>
                    </div>
                </div>
            </div>
        </header>

        <!-- PAGE HEADER -->
        <section class="page-header">
            <div>
                <div class="eyebrow">CampusCoin / Financial Management</div>
                <h1 class="page-title">Digital Wallet 💳</h1>
                <p class="page-description">Manage your account balance, instant fee checkouts, top-ups, and peer transfers.</p>
            </div>
            <div class="px-4 py-2 rounded-2xl ios-glass text-[11px] font-bold flex items-center gap-2">
                <i class="fa-solid fa-shield-halved text-emerald-500"></i>
                <span>2FA / PIN Verification Active</span>
            </div>
        </section>

        <!-- RECEIVE QR CARD (dynamic) -->
        <section class="ios-glass rounded-3xl p-5 mb-6">
            <div class="flex flex-wrap items-center gap-6">
                <div id="walletQrInline" class="flex-shrink-0 rounded-2xl bg-white p-3 shadow-sm" style="width:148px;height:148px;"></div>
                <div class="flex-1 min-w-[200px]">
                    <div class="text-[9px] font-extrabold uppercase tracking-widest text-purple-600 mb-1">Receive Money</div>
                    <h2 class="text-base font-black mb-1">Your Wallet QR</h2>
                    <p class="text-[11px] opacity-50 mb-3">Friends can scan this code or use your Account ID to send you CampusCoin balance.</p>
                    <div class="font-mono text-sm font-bold mb-1" id="inlineQrAccount">—</div>
                    <div class="text-[11px] opacity-50 mb-3" id="inlineQrName">—</div>
                    <div class="flex flex-wrap gap-2">
                        <button type="button" onclick="copyAccountId()" class="px-4 py-2 rounded-xl text-[11px] font-bold text-white bg-gradient-to-r from-purple-600 to-purple-700 shadow-md">
                            <i class="fa-regular fa-copy mr-1"></i> Copy ID
                        </button>
                        <button type="button" onclick="openModal('qrModal')" class="px-4 py-2 rounded-xl text-[11px] font-bold border border-purple-500/30 bg-purple-500/10 text-purple-700 dark:text-purple-300">
                            <i class="fa-solid fa-expand mr-1"></i> Enlarge QR
                        </button>
                    </div>
                </div>
                <div class="flex flex-col gap-2 text-[10px] opacity-60 min-w-[160px]">
                    <div class="flex items-center gap-2"><i class="fa-solid fa-shield-halved text-purple-500"></i> Secure peer transfer</div>
                    <div class="flex items-center gap-2"><i class="fa-solid fa-bolt text-purple-500"></i> Instant balance update</div>
                    <div class="flex items-center gap-2"><i class="fa-solid fa-database text-purple-500"></i> Saved in WalletLedgers</div>
                </div>
            </div>
        </section>


        <!-- LOW BALANCE WARNING BANNER -->
        <div id="lowBalanceWarning" class="hidden mb-6 p-4 rounded-2xl bg-amber-500/15 border border-amber-500/30 text-amber-600 dark:text-amber-400 text-xs font-bold flex items-center justify-between">
            <div class="flex items-center gap-3">
                <i class="fa-solid fa-triangle-exclamation text-base"></i>
                <span>Low Balance Warning: Your wallet balance is below Rs. 2,000. Please top up to avoid fee auto-pay failures.</span>
            </div>
            <button onclick="openModal('topUpModal')" class="underline hover:opacity-80">Top Up Now</button>
        </div>

        <!-- HERO BALANCE CARD -->
        <section class="hero-wallet-card mb-8">
            <div class="flex flex-wrap items-center justify-between gap-6 relative z-10">
                <div>
                    <div class="text-xs uppercase tracking-widest font-extrabold opacity-75 mb-1">Live Campus Balance</div>
                    <div class="text-4xl sm:text-5xl font-black tracking-tight mb-2">
                        Rs. <span id="walletBalance">12,500</span>
                    </div>
                    <div class="flex items-center gap-3 text-xs opacity-85">
                        <span>Account ID: <strong id="accountId" class="font-mono bg-white/20 px-2 py-0.5 rounded-lg">CC-8942-PK</strong></span>
                        <button type="button" onclick="openModal('qrModal')" class="ml-2 underline text-[11px] font-bold opacity-90 hover:opacity-100">

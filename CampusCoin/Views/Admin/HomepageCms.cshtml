.dark .cms-tab{background:rgba(255,255,255,.06);color:#e2e8f0;}
.cms-tab.active{background:linear-gradient(135deg,#a486e0,#6366f1);color:#fff;box-shadow:0 10px 22px rgba(107,58,146,.25);}
.cms-primary-btn{padding:10px 14px;border-radius:999px;font-size:12px;font-weight:700;border:0;cursor:pointer;background:linear-gradient(135deg,#8b6ff0,#6d4aff);color:#fff;display:inline-flex;align-items:center;gap:6px;box-shadow:0 10px 20px rgba(109,74,255,.25);}
.cms-ghost-btn{padding:10px 14px;border-radius:999px;font-size:12px;font-weight:700;border:1px solid rgba(148,163,184,.35);background:rgba(255,255,255,.4);color:inherit;text-decoration:none;display:inline-flex;align-items:center;gap:6px;}
.dark .cms-ghost-btn{background:rgba(255,255,255,.06);}
.cms-panel{padding:20px;border-radius:24px;margin-bottom:20px;}
.cms-panel.hidden{display:none!important;}
.cms-panel-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap;margin-bottom:16px;}
.cms-panel-head h3{font-size:16px;font-weight:800;margin:0 0 4px;}
.cms-panel-head p{font-size:12px;opacity:.65;margin:0;max-width:520px;line-height:1.45;}
.cms-list{display:flex;flex-direction:column;gap:12px;}
.cms-card{border-radius:18px;padding:16px;background:rgba(255,255,255,.55);border:1px solid rgba(255,255,255,.7);}
.dark .cms-card{background:rgba(15,23,42,.55);border-color:rgba(255,255,255,.08);}
.cms-card h4{font-size:13px;font-weight:800;margin:0 0 6px;display:flex;align-items:center;gap:8px;}
.cms-hint{font-size:11px;opacity:.6;margin:0 0 12px;}
.cms-card label{display:block;font-size:11px;font-weight:700;opacity:.65;margin-bottom:4px;}
.cms-card input,.cms-card textarea,.cms-card select{width:100%;border-radius:12px;border:1px solid rgba(148,163,184,.35);padding:9px 11px;font-size:13px;background:rgba(255,255,255,.9);}
.dark .cms-card input,.dark .cms-card textarea,.dark .cms-card select{background:rgba(15,23,42,.9);color:#e2e8f0;border-color:rgba(255,255,255,.12);}
.cms-actions{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap;}
.cms-btn{padding:8px 12px;border-radius:12px;font-size:12px;font-weight:700;border:0;cursor:pointer;}
.cms-btn-primary{background:linear-gradient(135deg,#a486e0,#6366f1);color:#fff;}
.cms-btn-danger{background:#fee2e2;color:#b91c1c;}
.cms-key{font-size:10px;opacity:.45;font-family:ui-monospace,monospace;margin-bottom:6px;}
.cms-title{font-size:12px;font-weight:800;margin-bottom:2px;}
.cms-design-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px;}
.cms-switch-list{display:flex;flex-direction:column;gap:10px;}
.cms-switch{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 12px;border-radius:14px;background:rgba(255,255,255,.35);font-size:12px;font-weight:700;}
.dark .cms-switch{background:rgba(255,255,255,.05);}
.cms-switch input{width:18px;height:18px;}
.cms-fields{display:flex;flex-direction:column;gap:10px;}
.cms-help{font-size:12px;line-height:1.7;padding-left:18px;margin:0;opacity:.85;}
#cmsToast{position:fixed;right:18px;bottom:18px;z-index:99;background:#0f172a;color:#fff;padding:12px 16px;border-radius:14px;font-size:13px;font-weight:700;opacity:0;transform:translateY(12px);transition:.25s;}
#cmsToast.show{opacity:1;transform:none;}

.cms-loading{display:flex;align-items:center;gap:10px;padding:28px 12px;font-size:13px;font-weight:600;opacity:.75;}
.cms-switch-label{display:flex;align-items:center;gap:10px;padding:8px 0;font-size:13px;font-weight:600;cursor:pointer;}
.cms-switch-label input{width:18px;height:18px;}
.cms-field{margin-bottom:10px;}
.cms-field label{display:block;font-size:12px;font-weight:700;margin-bottom:4px;opacity:.8;}
.cms-btn i{margin-right:4px;}
.cms-ghost-btn{display:inline-flex;align-items:center;gap:8px;padding:10px 16px;border-radius:12px;font-size:13px;font-weight:700;border:1px solid rgba(15,23,42,.12);background:rgba(255,255,255,.55);backdrop-filter:blur(8px);cursor:pointer;color:inherit;text-decoration:none;}
.dark .cms-ghost-btn{border-color:rgba(255,255,255,.12);background:rgba(255,255,255,.06);}
.cms-ghost-btn:hover{transform:translateY(-1px);box-shadow:0 8px 20px rgba(15,23,42,.08);}
</style>

<script>

let _contentCache = null;

function showToast(m){ toast(m); }
const toast = (m) => {
  const el = document.getElementById('cmsToast');
  if (!el) return;
  el.textContent = m;
  el.classList.add('show');
  el.style.opacity = '1';
  el.style.transform = 'none';
  setTimeout(() => {
    el.classList.remove('show');
    el.style.opacity = '0';
    el.style.transform = 'translateY(12px)';
  }, 2200);
};
const esc = s => (s ?? '').toString().replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');

async function j(u, o = {}) {
  const r = await fetch(u, {
    headers: { 'Content-Type': 'application/json', ...(o.headers || {}) },
    credentials: 'same-origin',
    ...o
  });
  const ct = r.headers.get('content-type') || '';
  let data = {};
  try {
    data = ct.includes('json') ? await r.json() : {};
  } catch (_) {}
  if (!r.ok) throw new Error(data.message || ('HTTP ' + r.status));
  return data;
}

function setLoading(elId, on) {
  const el = document.getElementById(elId);
  if (!el) return;
  if (on) {
    el.innerHTML = '<div class="cms-loading"><i class="fa-solid fa-spinner fa-spin"></i> Loading…</div>';
  }
}

document.querySelectorAll('.cms-tab[data-tab]').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.cms-tab[data-tab]').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('.cms-panel').forEach(p => p.classList.add('hidden'));
    const panel = document.getElementById('panel-' + btn.dataset.tab);
    if (panel) panel.classList.remove('hidden');
  });
});

const btnEnsure = document.getElementById('btnEnsure');
if (btnEnsure) {
  btnEnsure.addEventListener('click', async () => {
    try {
      btnEnsure.disabled = true;
      await j('/api/admin/cms/ensure', { method: 'POST', body: '{}' });
      toast('CMS tables ready');
      await loadAll();
    } catch (e) {
      toast(e.message);
      const cl = document.getElementById('contentList');
      if (cl) cl.innerHTML = '<p style="color:#e11d48;font-size:13px;">' + esc(e.message) + '</p>';
    } finally {
      btnEnsure.disabled = false;
    }
  });
}

async function loadContent() {
  const el = document.getElementById('contentList');
  if (!el) return;
  try {
    setLoading('contentList', true);
    const rows = await j('/api/admin/cms/content');
    _contentCache = rows;
    if (!Array.isArray(rows) || !rows.length) {
      el.innerHTML = '<p style="font-size:13px;opacity:.7;">No rows yet. Click <b>Init / Repair CMS</b>.</p>';
      return;
    }
    el.innerHTML = rows.map(r => `<div class="cms-card" data-id="${r.id}">
      <div class="cms-title">${esc(r.label || r.key)}</div>
      <div class="cms-key">${esc(r.key)}</div>
      <textarea rows="2" data-field="value">${esc(r.value)}</textarea>
      <div class="cms-actions">
        <button type="button" class="cms-btn cms-btn-primary" onclick="saveContent(${r.id},this)">
          <i class="fa-solid fa-floppy-disk"></i> Save
        </button>
      </div>
    </div>`).join('');
  } catch (e) {
    el.innerHTML = `<p style="color:#e11d48;font-size:13px;">${esc(e.message)} — click <b>Init / Repair CMS</b>.</p>`;
  }
}

async function saveContent(id, btn) {
  try {
    const value = btn.closest('[data-id]').querySelector('[data-field=value]').value;
    btn.disabled = true;
    await j('/api/admin/cms/content/' + id, { method: 'PUT', body: JSON.stringify({ value }) });
    toast('Saved');
  } catch (e) {
    toast(e.message || 'Save failed');
  } finally {
    if (btn) btn.disabled = false;
  }
}

function grid(fields) {
  const html = Array.isArray(fields) ? fields.join('') : (fields || '');
  return `<div class="cms-field-grid">${html}</div>`;
}
function field(label, html) {
  return `<div class="cms-field"><label>${label || ''}</label>${html}</div>`;
}
function toneSelect(val) {
  const opts = ['violet', 'mint', 'coral', 'rose', 'amber', 'yellow', 'plum'];
  const v = (val || 'violet').toLowerCase();
  return `<select data-f="tone">${opts.map(o =>
    `<option value="${o}" ${o === v || (o === 'amber' && v === 'yellow') ? 'selected' : ''}>${o}</option>`
  ).join('')}</select>`;
}

function featureCard(r = {}) {
  return `<div class="cms-card" data-id="${r.id || ''}">
  <div class="cms-card-badge">Feature card</div>
  ${grid([
    field('Title', `<input data-f="title" placeholder="e.g. Friendly AI insights" value="${esc(r.title)}"/>`),
    field('Status label', `<input data-f="status" placeholder="Live / Online / On track" value="${esc(r.status || 'Live')}"/>`),
    field('Description', `<textarea rows="2" data-f="description" placeholder="Short description">${esc(r.description)}</textarea>`),
    field('Icon class', `<input data-f="icon" placeholder="ri-sparkling-2-line" value="${esc(r.icon || 'ri-sparkling-2-line')}"/>`),
    field('Tone color', toneSelect(r.tone)),
    field('Sort order', `<input type="number" data-f="sortOrder" value="${r.sortOrder ?? 0}"/>`),
    field('Show on site', `<select data-f="isActive"><option value="true" ${r.isActive !== false ? 'selected' : ''}>Yes</option><option value="false" ${r.isActive === false ? 'selected' : ''}>No</option></select>`)
  ])}
  <div class="cms-actions">
    <button type="button" class="cms-btn cms-btn-primary" onclick="saveFeature(this)"><i class="fa-solid fa-floppy-disk"></i> Save</button>
    ${r.id ? `<button type="button" class="cms-btn cms-btn-danger" onclick="delFeature(${r.id})"><i class="fa-solid fa-trash"></i> Delete</button>` : ''}
  </div>
</div>`;
}

async function loadFeatures() {
  const el = document.getElementById('featuresList');
  if (!el) return;
  try {
    setLoading('featuresList', true);
    const rows = await j('/api/admin/cms/features');
    el.innerHTML = (rows || []).map(featureCard).join('') ||
      '<p style="font-size:13px;opacity:.7;">No feature cards yet. Click <b>Add card</b>.</p>';
  } catch (e) {
    el.innerHTML = '<p style="color:#e11d48;font-size:13px;">' + esc(e.message) + '</p>';
  }
}
function addFeature() {
  document.getElementById('featuresList').insertAdjacentHTML('afterbegin',
    featureCard({ isActive: true, sortOrder: 0, status: 'Live', tone: 'violet', icon: 'ri-sparkling-2-line' }));
}
async function saveFeature(btn) {
  try {
    const box = btn.closest('[data-id]');
    const body = Object.fromEntries([...box.querySelectorAll('[data-f]')].map(i =>
      [i.dataset.f, i.type === 'number' ? +i.value : i.value]));
    body.isActive = body.isActive === 'true';
    body.sortOrder = +body.sortOrder || 0;
    btn.disabled = true;
    const id = box.dataset.id;
    if (id) await j('/api/admin/cms/features/' + id, { method: 'PUT', body: JSON.stringify(body) });
    else await j('/api/admin/cms/features', { method: 'POST', body: JSON.stringify(body) });
    toast('Feature saved');
    await loadFeatures();
  } catch (e) {
    toast(e.message || 'Save failed');
  } finally {
    if (btn) btn.disabled = false;
  }
}
async function delFeature(id) {
  if (!confirm('Delete this feature card?')) return;
  try {
    await j('/api/admin/cms/features/' + id, { method: 'DELETE' });
    toast('Deleted');
    await loadFeatures();
  } catch (e) {
    toast(e.message || 'Delete failed');
  }
}

function catCard(r = {}) {
  return `<div class="cms-card" data-id="${r.id || ''}">
  <div class="cms-card-badge">${esc(r.group || 'Expense')} row</div>
  ${grid([
    field('Group', `<select data-f="group"><option value="Income" ${r.group === 'Income' ? 'selected' : ''}>Income</option><option value="Expense" ${r.group !== 'Income' ? 'selected' : ''}>Expense</option></select>`),
    field('Name', `<input data-f="name" placeholder="e.g. Food" value="${esc(r.name)}"/>`),
    field('Icon class', `<input data-f="icon" placeholder="ri-restaurant-line" value="${esc(r.icon || 'ri-price-tag-3-line')}"/>`),
    field('Amount (Rs.)', `<input type="number" data-f="amount" value="${r.amount ?? 0}"/>`),
    field('Bar percent (0-100)', `<input type="number" data-f="percent" min="0" max="100" value="${r.percent ?? 0}"/>`),
    field('Sort order', `<input type="number" data-f="sortOrder" value="${r.sortOrder ?? 0}"/>`),
    field('Show on site', `<select data-f="isActive"><option value="true" ${r.isActive !== false ? 'selected' : ''}>Yes</option><option value="false" ${r.isActive === false ? 'selected' : ''}>No</option></select>`)
  ])}
  <div class="cms-actions">
    <button type="button" class="cms-btn cms-btn-primary" onclick="saveCategory(this)"><i class="fa-solid fa-floppy-disk"></i> Save</button>
    ${r.id ? `<button type="button" class="cms-btn cms-btn-danger" onclick="delCategory(${r.id})"><i class="fa-solid fa-trash"></i> Delete</button>` : ''}
  </div>
</div>`;
}

async function loadCategories() {
  const el = document.getElementById('categoriesList');
  if (!el) return;
  try {
    setLoading('categoriesList', true);
    const rows = await j('/api/admin/cms/categories');
    el.innerHTML = (rows || []).map(catCard).join('') ||
      '<p style="font-size:13px;opacity:.7;">No category rows yet. Click <b>Add row</b>.</p>';
  } catch (e) {
    el.innerHTML = '<p style="color:#e11d48;font-size:13px;">' + esc(e.message) + '</p>';
  }
}
function addCategory() {
  document.getElementById('categoriesList').insertAdjacentHTML('afterbegin',
    catCard({ group: 'Expense', isActive: true, sortOrder: 0 }));
}
async function saveCategory(btn) {
  try {
    const box = btn.closest('[data-id]');
    const body = Object.fromEntries([...box.querySelectorAll('[data-f]')].map(i =>
      [i.dataset.f, i.type === 'number' ? +i.value : i.value]));
    body.isActive = body.isActive === 'true';
    body.sortOrder = +body.sortOrder || 0;
    body.amount = +body.amount || 0;
    body.percent = Math.min(100, Math.max(0, +body.percent || 0));
    btn.disabled = true;
    const id = box.dataset.id;
    if (id) await j('/api/admin/cms/categories/' + id, { method: 'PUT', body: JSON.stringify(body) });
    else await j('/api/admin/cms/categories', { method: 'POST', body: JSON.stringify(body) });
    toast('Category saved');
    await loadCategories();
  } catch (e) {
    toast(e.message || 'Save failed');
  } finally {
    if (btn) btn.disabled = false;
  }
}
async function delCategory(id) {
  if (!confirm('Delete this category row?')) return;
  try {
    await j('/api/admin/cms/categories/' + id, { method: 'DELETE' });
    toast('Deleted');
    await loadCategories();
  } catch (e) {
    toast(e.message || 'Delete failed');
  }
}

function testimonialCard(r = {}) {
  return `<div class="cms-card" data-id="${r.id || ''}">
  <div class="cms-card-badge">Testimonial</div>
  ${grid([
    field('Quote', `<textarea rows="3" data-f="quote">${esc(r.quote)}</textarea>`),
    field('Author name', `<input data-f="authorName" value="${esc(r.authorName)}"/>`),
    field('Author meta', `<input data-f="authorMeta" value="${esc(r.authorMeta)}"/>`),
    field('Avatar initials', `<input data-f="avatarInitials" maxlength="4" value="${esc(r.avatarInitials || 'ST')}"/>`),
    field('Metric label', `<input data-f="metricLabel" value="${esc(r.metricLabel)}"/>`),
    field('Metric value', `<input data-f="metricValue" value="${esc(r.metricValue)}"/>`),
    field('Metric badge', `<input data-f="metricBadge" value="${esc(r.metricBadge)}"/>`),
    field('Tags', `<input data-f="tags" value="${esc(r.tags)}"/>`),
    field('Tone', toneSelect(r.tone || 'mint')),
    field('Sort order', `<input type="number" data-f="sortOrder" value="${r.sortOrder ?? 0}"/>`),
    field('Featured', `<select data-f="isFeatured"><option value="false" ${!r.isFeatured ? 'selected' : ''}>No</option><option value="true" ${r.isFeatured ? 'selected' : ''}>Yes</option></select>`),
    field('Show on site', `<select data-f="isActive"><option value="true" ${r.isActive !== false ? 'selected' : ''}>Yes</option><option value="false" ${r.isActive === false ? 'selected' : ''}>No</option></select>`)
  ])}
  <div class="cms-actions">
    <button type="button" class="cms-btn cms-btn-primary" onclick="saveTestimonial(this)"><i class="fa-solid fa-floppy-disk"></i> Save</button>
    ${r.id ? `<button type="button" class="cms-btn cms-btn-danger" onclick="delTestimonial(${r.id})"><i class="fa-solid fa-trash"></i> Delete</button>` : ''}
  </div>
</div>`;
}

async function loadTestimonials() {
  const el = document.getElementById('testimonialsList');
  if (!el) return;
  try {
    setLoading('testimonialsList', true);
    const rows = await j('/api/admin/cms/testimonials');
    el.innerHTML = (rows || []).map(testimonialCard).join('') ||
      '<p style="font-size:13px;opacity:.7;">No testimonials yet. Click <b>Add testimonial</b>.</p>';
  } catch (e) {
    el.innerHTML = '<p style="color:#e11d48;font-size:13px;">' + esc(e.message) + '</p>';
  }
}
function addTestimonial() {
  document.getElementById('testimonialsList').insertAdjacentHTML('afterbegin',
    testimonialCard({ isActive: true, tone: 'mint', avatarInitials: 'ST' }));
}
async function saveTestimonial(btn) {
  try {
    const box = btn.closest('[data-id]');
    const body = Object.fromEntries([...box.querySelectorAll('[data-f]')].map(i =>
      [i.dataset.f, i.type === 'number' ? +i.value : i.value]));
    body.isActive = body.isActive === 'true';
    body.isFeatured = body.isFeatured === 'true';
    body.sortOrder = +body.sortOrder || 0;
    btn.disabled = true;
    const id = box.dataset.id;
    if (id) await j('/api/admin/cms/testimonials/' + id, { method: 'PUT', body: JSON.stringify(body) });
    else await j('/api/admin/cms/testimonials', { method: 'POST', body: JSON.stringify(body) });
    toast('Saved');
    await loadTestimonials();
  } catch (e) {
    toast(e.message || 'Save failed');
  } finally {
    if (btn) btn.disabled = false;
  }
}
async function delTestimonial(id) {
  if (!confirm('Delete this testimonial?')) return;
  try {
    await j('/api/admin/cms/testimonials/' + id, { method: 'DELETE' });
    toast('Deleted');
    await loadTestimonials();
  } catch (e) {
    toast(e.message || 'Delete failed');
  }
}

function proofCard(r = {}) {
  return `<div class="cms-card" data-id="${r.id || ''}">
  <div class="cms-card-badge">Proof chip</div>
  ${grid([
    field('Label', `<input data-f="label" value="${esc(r.label)}"/>`),
    field('Value', `<input data-f="value" value="${esc(r.value)}"/>`),
    field('Badge', `<input data-f="badge" value="${esc(r.badge || 'Verified')}"/>`),
    field('Tone', toneSelect(r.tone || 'mint')),
    field('Sort order', `<input type="number" data-f="sortOrder" value="${r.sortOrder ?? 0}"/>`),
    field('Show on site', `<select data-f="isActive"><option value="true" ${r.isActive !== false ? 'selected' : ''}>Yes</option><option value="false" ${r.isActive === false ? 'selected' : ''}>No</option></select>`)
  ])}
  <div class="cms-actions">
    <button type="button" class="cms-btn cms-btn-primary" onclick="saveProof(this)"><i class="fa-solid fa-floppy-disk"></i> Save</button>
    ${r.id ? `<button type="button" class="cms-btn cms-btn-danger" onclick="delProof(${r.id})"><i class="fa-solid fa-trash"></i> Delete</button>` : ''}
  </div>
</div>`;
}

async function loadProofs() {
  const el = document.getElementById('proofsList');
  if (!el) return;
  try {
    setLoading('proofsList', true);
    const rows = await j('/api/admin/cms/proofs');

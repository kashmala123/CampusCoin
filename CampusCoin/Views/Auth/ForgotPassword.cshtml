@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CampusCoin - Password Recovery</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <link rel="apple-touch-icon" href="/favicon.svg?v=4" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: { 50:'#f6effc', 100:'#ede4f6', 400: '#a486e0', 500: '#8b58b8', 600: '#6b3a92' }
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body.light-mesh { background-color: #fbf6f0; background-image: radial-gradient(at 0% 0%, rgba(186, 230, 253, 0.85) 0px, transparent 50%), radial-gradient(at 100% 100%, rgba(165, 243, 252, 0.8) 0px, transparent 50%); background-attachment: fixed; }
        body.dark-mesh { background-color: #100a1a; background-image: radial-gradient(at 10% 10%, rgba(99, 102, 241, 0.28) 0px, transparent 50%), radial-gradient(at 90% 90%, rgba(14, 165, 233, 0.28) 0px, transparent 50%); background-attachment: fixed; }
        .ios-glass { backdrop-filter: blur(32px) saturate(240%); background: rgba(255, 255, 255, 0.75); border: 1.5px solid rgba(255, 255, 255, 0.95); box-shadow: 0 20px 40px -12px rgba(14, 165, 233, 0.15); }
        .dark .ios-glass { background: rgba(18, 24, 38, 0.65); border: 1px solid rgba(255, 255, 255, 0.15); box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); }
        .field-error {
            display: none;
            margin-top: 6px;
            padding: 8px 12px;
            border-radius: 10px;
            background: rgba(239, 68, 68, 0.08);
            border: 1px solid rgba(239, 68, 68, 0.22);
            color: #b91c1c;
            font-size: 12.5px;
            font-weight: 600;
            line-height: 1.35;
            animation: errIn .22s ease;
        }
        .field-error.show { display: block; }
        input.invalid {
            border-color: rgba(239, 68, 68, 0.55) !important;
            box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.12) !important;
        }
        @@keyframes errIn {
            from { opacity: 0; transform: translateY(-4px); }
            to   { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body class="light-mesh min-h-screen text-slate-900 dark:text-slate-100 flex items-center justify-center p-4">
    <div class="max-w-md w-full ios-glass rounded-3xl p-8 shadow-2xl relative">
        <div class="flex items-center gap-3 mb-6">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-sky-400 to-indigo-500 flex items-center justify-center text-white text-2xl font-black shadow-lg">
                <i class="fa-solid fa-key"></i>
            </div>
            <div>
                <h1 class="text-xl font-bold tracking-tight">Recover Password</h1>
                <p class="text-xs text-slate-500 dark:text-slate-400">We'll email you a secure reset link</p>
            </div>
        </div>

        <div id="resultBox" class="hidden mb-4 p-3.5 rounded-2xl text-xs font-semibold"></div>

        <form id="forgotForm" onsubmit="return handleForgot(event)" class="space-y-4" novalidate>
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-1">Your Registered Email</label>
                <input type="email" id="forgotEmail" placeholder="name@@campus.edu" autocomplete="email"
                       class="w-full px-4 py-2.5 rounded-2xl ios-glass border border-slate-300 text-sm font-semibold text-slate-800 dark:text-white">
                <div class="field-error" id="forgotEmailError"></div>
            </div>
            <button type="submit" id="btnSend" class="w-full py-3 rounded-2xl bg-gradient-to-r from-sky-400 via-blue-500 to-indigo-500 text-white font-bold text-xs uppercase tracking-wider shadow-lg active:scale-95 transition-all">
                Send Recovery Link
            </button>
        </form>

        <div class="mt-6 text-center text-xs font-semibold">
            <a href="/Account/Login" class="text-sky-600 dark:text-sky-400 hover:underline"><i class="fa-solid fa-arrow-left me-1"></i> Back to Login</a>
        </div>
    </div>

    <script>
        const AT = String.fromCharCode(64);
                    const emailRe = new RegExp('^[^\\s' + AT + ']+' + AT + '[^\\s' + AT + ']+\\.[^\\s' + AT + ']+$');

        function showErr(id, msg) {
            const input = document.getElementById(id);
            if (input) input.classList.add('invalid');
            const err = document.getElementById(id + 'Error');
            if (err) { err.textContent = msg; err.classList.add('show'); }
        }
        function clearErr(id) {
            const input = document.getElementById(id);
            if (input) input.classList.remove('invalid');
            const err = document.getElementById(id + 'Error');
            if (err) { err.textContent = ''; err.classList.remove('show'); }
        }

        document.getElementById('forgotEmail').addEventListener('input', () => clearErr('forgotEmail'));

        async function handleForgot(e) {
            e.preventDefault();
            clearErr('forgotEmail');
            const email = document.getElementById('forgotEmail').value.trim();
            const btn = document.getElementById('btnSend');
            const box = document.getElementById('resultBox');

            if (!email) { showErr('forgotEmail', 'Please enter your email address.'); return false; }
            if (!emailRe.test(email)) { showErr('forgotEmail', 'Please enter a valid email address.'); return false; }

            btn.innerText = 'Sending…';
            btn.disabled = true;
            box.classList.add('hidden');

            try {
                const res = await fetch('/Auth/ForgotPassword', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ email })
                });
                const data = await res.json();
                box.classList.remove('hidden');
                if (res.ok && data.success) {
                    box.className = 'mb-4 p-3.5 rounded-2xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-800 text-xs font-semibold';
                    box.textContent = data.message || 'If an account exists, a reset link has been sent to your email.';
                    document.getElementById('forgotForm').reset();
                } else {
                    box.className = 'mb-4 p-3.5 rounded-2xl bg-rose-500/15 border border-rose-500/30 text-rose-800 text-xs font-semibold';
                    box.textContent = data.message || 'Could not send reset link.';
                }
            } catch (err) {
                box.classList.remove('hidden');
                box.className = 'mb-4 p-3.5 rounded-2xl bg-rose-500/15 border border-rose-500/30 text-rose-800 text-xs font-semibold';
                box.textContent = 'Network error. Please try again.';
            } finally {
                btn.innerText = 'Send Recovery Link';
                btn.disabled = false;
            }
            return false;
        }
    </script>
</body>
</html>

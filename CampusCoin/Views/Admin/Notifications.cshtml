@{
    Layout = null;
    ViewData["Title"] = "Notifications - CashCampus Admin";
}
<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <link rel="stylesheet" href="/css/cc-header-widgets.css" />

    <link rel="stylesheet" href="/css/admin-theme.css" />
    <link rel="stylesheet" href="/css/cc-animations.css" />

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <link rel="apple-touch-icon" href="/favicon.svg?v=4" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = { darkMode: 'class', theme: { extend: {
            colors: { brand: { 50:'#f6effc', 100:'#ede4f6', 400:'#a486e0', 500:'#8b58b8', 600:'#6b3a92' } },
            fontFamily: { sans: ['Plus Jakarta Sans','-apple-system','BlinkMacSystemFont','Inter','Segoe UI','Roboto','sans-serif'] }
        }}}
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        * {
            transition: background-color 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease, color 0.3s ease;
        }

        body.light-mesh {
            background-color: #fbf6f0;
            background-image: radial-gradient(at 0% 0%, rgba(237, 228, 246, 0.9) 0px, transparent 50%), radial-gradient(at 100% 0%, rgba(196, 174, 224, 0.85) 0px, transparent 50%), radial-gradient(at 100% 100%, rgba(255, 225, 230, 0.85) 0px, transparent 50%), radial-gradient(at 0% 100%, rgba(246, 239, 252, 0.9) 0px, transparent 50%), radial-gradient(at 50% 50%, rgba(212, 243, 228, 0.4) 0px, transparent 50%);
            background-attachment: fixed;
        }

        body.dark-mesh {
            background-color: #100a1a;
            background-image: radial-gradient(at 10% 10%, rgba(99, 102, 241, 0.28) 0px, transparent 50%), radial-gradient(at 90% 10%, rgba(168, 85, 247, 0.22) 0px, transparent 50%), radial-gradient(at 90% 90%, rgba(107, 58, 146, 0.28) 0px, transparent 50%), radial-gradient(at 10% 90%, rgba(236, 72, 153, 0.2) 0px, transparent 50%);
            background-attachment: fixed;
        }

        .orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(80px);
            z-index: -1;
            pointer-events: none;
            animation: floatOrb 18s infinite alternate ease-in-out;
        }

        .orb-1 {
            width: 450px;
            height: 450px;
            background: rgba(192, 132, 252, 0.4);
            top: -100px;
            left: -100px;
        }

        .orb-2 {
            width: 480px;
            height: 480px;
            background: rgba(139, 88, 184, 0.45);
            top: 30%;
            right: -120px;
            animation-delay: -5s;
        }

        .orb-3 {
            width: 400px;
            height: 400px;
            background: rgba(251, 113, 133, 0.35);
            bottom: -100px;
            left: 20%;
            animation-delay: -10s;
        }

        @@keyframes floatOrb {
            0% {
                transform: translate(0px, 0px) scale(1);
            }

            50% {
                transform: translate(40px, 60px) scale(1.08);
            }

            100% {
                transform: translate(-30px, 30px) scale(0.95);
            }
        }

        .ios-glass {
            backdrop-filter: blur(32px) saturate(240%);
            -webkit-backdrop-filter: blur(32px) saturate(240%);
            position: relative;
            overflow: hidden;
        }

        .light .ios-glass {
            background: rgba(255,255,255,.72);
            border: 1.5px solid rgba(255,255,255,.95);
            box-shadow: 0 20px 40px -12px rgba(107,58,146,.12), 0 4px 16px -2px rgba(0,0,0,.04);
            color: #0f172a;
        }

        .dark .ios-glass {
            background: rgba(18,24,38,.58);
            border: 1px solid rgba(255,255,255,.15);
            box-shadow: 0 25px 50px -12px rgba(0,0,0,.45);
            color: #f8fafc;
        }

        .ios-glass-interactive:hover {
            transform: translateY(-4px);
        }

        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(150,150,150,.3);
            border-radius: 999px;
        }

        #sidebar {
            transition: transform .35s cubic-bezier(.16,1,.3,1);
        }

        .sidebar-link {
            transition: all .2s ease-in-out;
        }

            .sidebar-link.active {
                background: linear-gradient(135deg, rgba(139,88,184,.22), rgba(99,102,241,.18));
                color: #6b3a92;
                box-shadow: inset 0 1px 0 rgba(255,255,255,.6), 0 10px 20px -5px rgba(2,132,199,.15);
            }

        .dark .sidebar-link.active {
            color: #c4aee0;
            background: linear-gradient(135deg, rgba(139,88,184,.16), rgba(99,102,241,.16));
        }

        .glass-btn {
            border: 1px solid rgba(255,255,255,.55);
            background: rgba(255,255,255,.38);
            color: inherit;
            border-radius: 13px;
            padding: 9px 12px;
            font-size: 10px;
            font-weight: 750;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .dark .glass-btn {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .glass-btn:hover {
            transform: translateY(-2px);
            background: rgba(255,255,255,.65);
        }

        .primary-btn {
            color: white;
            border: none;
            background: linear-gradient(135deg, #a486e0, #8b58b8, #6366f1);
            box-shadow: 0 10px 22px rgba(107,58,146,.25);
        }

        .modal-overlay {
            position: fixed;
            inset: 0;
            z-index: 300;
            background: rgba(15,23,42,.35);
            backdrop-filter: blur(8px);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transition: all .3s ease;
        }

            .modal-overlay.show {
                opacity: 1;
                pointer-events: auto;
            }

        .modal-card {
            width: 100%;
            max-width: 540px;
            border-radius: 28px;
            padding: 25px;
            transform: scale(.95) translateY(10px);
            transition: all .3s ease;
        }

        .modal-overlay.show .modal-card {
            transform: scale(1) translateY(0);
        }

        #toast {
            transform: translateY(120px);
            opacity: 0;
            pointer-events: none;
            transition: all .3s ease;
        }

            #toast.show {
                transform: translateY(0);
                opacity: 1;
            }

        @@media(max-width:1200px) {
            .kpi-grid {
                grid-template-columns: repeat(2,1fr);
            }
        }

        @@media(max-width:950px) {
            #sidebar {
                transform: translateX(-110%);
            }

                #sidebar.open {
                    transform: translateX(0);
                }

            .main {
                margin-left: 0 !important;
                padding: 15px !important;
            }
        }

        @@media(max-width:700px) {
            .kpi-grid {
                grid-template-columns: 1fr;
            }
        }

        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
        }

        .kpi {
            min-height: 140px;
            padding: 19px;
            border-radius: 25px;
            position: relative;
            overflow: hidden;
        }
    
/* Unified admin chrome */
.sidebar {
  position: fixed !important;
  top: 20px !important; left: 20px !important; bottom: 20px !important;
  width: 260px !important;
  z-index: 100 !important;
  border-radius: 30px !important;
  padding: 18px !important;
  display: flex !important;
  flex-direction: column !important;
}
.sidebar .nav { flex: 1; overflow-y: auto; padding: 4px 0; }
.sidebar .nav-section {
  font-size: 10px; font-weight: 800; letter-spacing: 0.08em;
  text-transform: uppercase; opacity: 0.45; padding: 14px 12px 6px;
}
.sidebar .nav-link {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 12px; border-radius: 14px;
  font-size: 13px; font-weight: 600; color: inherit;
  text-decoration: none; margin-bottom: 2px;
}
.sidebar .nav-link i { width: 18px; text-align: center; opacity: 0.7; }
.sidebar .nav-link:hover { background: rgba(139,88,184,0.08); }
.sidebar .nav-link.active {
  color: #6b3a92 !important;
  background: linear-gradient(135deg, rgba(237,228,246,0.95), rgba(196,174,224,0.35)) !important;
}
.brand { display: flex; align-items: center; gap: 12px; padding: 4px 6px 18px; }
.brand-name { font-size: 15px; font-weight: 800; }
.brand-sub { font-size: 10px; font-weight: 700; letter-spacing: 0.06em; opacity: 0.5; text-transform: uppercase; }
.admin-mini {
  display: flex; align-items: center; gap: 10px;
  padding: 10px; border-radius: 16px;
  background: rgba(139,88,184,0.08); margin-top: 8px;
}
.admin-avatar {
  width: 36px; height: 36px; border-radius: 12px;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 11px; font-weight: 800;
  background: linear-gradient(135deg, #8b58b8, #6b3a92);
}
.main, .main-content, #mainContent {
  margin-left: 300px !important;
}
/* Dropdowns above everything */
.dropdown, .cc-shared-dd, .cc-notif-popover, .notifications-popover, #profileDropdown {
  z-index: 10080 !important;
}
.topbar, header.topbar, .top-actions { overflow: visible !important; z-index: 90; position: relative; }

        </style>
</head>

<body class="light-mesh min-h-screen text-slate-900 dark:text-slate-100 font-sans antialiased transition-colors duration-500">


    <script>
        // ================= STATE =================
        let charts = {};
        let recentTransactions = [];
        let adminData = {
            totalStudents: 0,
            totalTransactions: 0,
            totalIncome: 0,
            totalExpenses: 0,
            systemBalance: 0,
            activeBudgets: 0,
            savingGoals: 0,
            avgHealth: 78
        };

        // ================= INIT =================
        document.addEventListener("DOMContentLoaded", async function () {
            initializeTheme();
            setDate();
            initializeCharts();

            await Promise.all([
                loadAdminSummary(),
                loadRecentTransactions(),
                loadNotifications(),
                loadInsights(),
                loadChartData()
            ]);

            initializeSearch();
            setTimeout(updateHealth, 400);
        });

        function setDate() {
            const el = document.getElementById("currentDate");
            if (el) {
                el.textContent = new Date().toLocaleDateString("en-US", {
                    weekday: "short", month: "long", day: "numeric", year: "numeric"
                });
            }
        }

        // ================= SUMMARY =================
        async function loadAdminSummary() {
            try {
                const res = await fetch('/api/admin/dashboard-summary', { credentials: 'same-origin' });
                if (!res.ok) throw new Error('Failed');
                adminData = await res.json();

                const counters = document.querySelectorAll('[data-counter]');
                const values = [
                    adminData.totalStudents,
                    adminData.totalTransactions,
                    adminData.totalIncome,
                    adminData.totalExpenses,
                    adminData.systemBalance,
                    adminData.activeBudgets,
                    adminData.savingGoals,
                    adminData.avgHealth
                ];

                counters.forEach((el, idx) => {
                    if (values[idx] !== undefined) el.dataset.counter = values[idx];
                });

                animateCounters();
            } catch (err) {
                console.error('Error:', err);
                animateCounters();
            }
        }

        // ================= RECENT TXNS =================
        async function loadRecentTransactions() {
            try {
                const res = await fetch('/api/admin/recent-transactions', { credentials: 'same-origin' });
                if (!res.ok) throw new Error('Failed');
                recentTransactions = await res.json();
                renderTransactions();
            } catch (err) { console.error(err); }
        }

        // ================= CHARTS DATA =================
        async function loadChartData() {
            try {
                const res = await fetch('/api/admin/charts', { credentials: 'same-origin' });
                if (!res.ok) throw new Error('Failed');
                const data = await res.json();

                if (charts.incomeExpense) {
                    charts.incomeExpense.data.labels = data.cashflow.labels;
                    charts.incomeExpense.data.datasets[0].data = data.cashflow.incomeData;
                    charts.incomeExpense.data.datasets[1].data = data.cashflow.expenseData;
                    charts.incomeExpense.update();
                }

                if (charts.expense) {
                    charts.expense.data.labels = data.expenseCategories.labels;
                    charts.expense.data.datasets[0].data = data.expenseCategories.values;
                    charts.expense.data.datasets[0].backgroundColor = data.expenseCategories.colors;
                    charts.expense.update();
                }

                if (charts.transactions && data.weeklyActivity) {
                    charts.transactions.data.labels = data.weeklyActivity.labels;
                    charts.transactions.data.datasets[0].data = data.weeklyActivity.data;
                    charts.transactions.update();
                }

                if (charts.budget && data.budgetUsage) {
                    charts.budget.data.datasets[0].data = [
                        data.budgetUsage.used,
                        data.budgetUsage.remaining
                    ];
                    charts.budget.update();

                    const sub = document.getElementById('budgetUsageSubtitle');
                    if (sub) {
                        sub.textContent =
                            `Rs. ${Math.round(data.budgetUsage.totalSpent).toLocaleString()} of Rs. ${Math.round(data.budgetUsage.totalLimit).toLocaleString()} used`;
                    }
                }

                if (charts.savingGoals && data.savingGoals) {
                    charts.savingGoals.data.labels = data.savingGoals.labels;
                    charts.savingGoals.data.datasets[0].data = data.savingGoals.data;
                    charts.savingGoals.data.datasets[0].backgroundColor = data.savingGoals.colors;
                    charts.savingGoals.update();
                }

            } catch (err) {
                console.error('Error loading charts:', err);
            }
        }

        // ================= NOTIFICATIONS =================
        async function loadNotifications() {
            try {
                // Admin uses announcements API (Student /api/notifications is role-blocked)
                const res = await fetch('/api/admin/announcements', { credentials: 'same-origin' });
                if (!res.ok) return;
                const data = await res.json();
                const notifs = Array.isArray(data) ? data : (data.notifications || data.items || []);

                const list = document.getElementById('notificationList');
                const count = document.getElementById('notificationCount');
                const dot = document.getElementById('notificationDot');
                if (!list || !count || !dot) return;

                count.textContent = `${notifs.length} announcement${notifs.length === 1 ? '' : 's'}`;
                dot.style.display = notifs.length ? 'block' : 'none';

                list.innerHTML = '';
                if (!notifs.length) {
                    list.innerHTML = '<div class="text-center py-3 text-xs opacity-40">No announcements yet</div>';
                    return;
                }
                notifs.slice(0, 4).forEach(n => {
                    const item = document.createElement('div');
                    item.className = 'p-2.5 rounded-xl bg-purple-600/10 border border-purple-500/15 flex items-start gap-2';
                    const msg = n.message || n.Message || n.title || n.Title || 'Announcement';
                    const title = n.title || n.Title || '';
                    const when = n.createdAt || n.CreatedAt || '';
                    item.innerHTML = `
                        <i class="fa-solid fa-bullhorn text-purple-600 text-xs mt-0.5"></i>
                        <div class="flex-1">
                            <p class="text-[10px] font-semibold">${title ? title + ' — ' : ''}${msg}</p>
                            <span class="text-[8px] opacity-40">${when ? new Date(when).toLocaleString() : ''}</span>
                        </div>
                    `;
                    list.appendChild(item);
                });
            } catch (err) { console.error(err); }
        }

        // ================= INSIGHTS =================
        async function loadInsights() {
            try {
                const container = document.getElementById('insightsContainer');
                if (!container) return;
                // Platform insights from admin summary (not student /api/tips)
                const res = await fetch('/api/admin/dashboard-summary', { credentials: 'same-origin' });
                if (!res.ok) {
                    container.innerHTML = '<div class="text-center py-4 text-xs opacity-40">Insights unavailable</div>';
                    return;
                }
                const d = await res.json();
                const items = [];
                const students = d.totalStudents ?? d.students ?? d.summary?.totalStudents;
                const tx = d.totalTransactions ?? d.transactions ?? 0;
                const expense = d.totalExpenses ?? d.totalExpense ?? d.summary?.totalExpense;
                const goals = d.savingGoals ?? d.activeGoals;
                if (students != null) items.push({ title: 'Active students', text: `${students} registered on the platform`, icon: 'fa-user-graduate', color: 'emerald' });
                if (tx != null) items.push({ title: 'Transactions', text: `${tx} recorded across campus`, icon: 'fa-arrow-right-arrow-left', color: 'sky' });
                if (expense != null) items.push({ title: 'Campus spending', text: `Rs. ${Number(expense).toLocaleString()} total expenses tracked`, icon: 'fa-chart-pie', color: 'amber' });
                if (goals != null) items.push({ title: 'Saving goals', text: `${goals} goals in progress`, icon: 'fa-bullseye', color: 'emerald' });
                if (!items.length) {
                    items.push({ title: 'Platform healthy', text: 'Monitor students, budgets and announcements from this console.', icon: 'fa-heart-pulse', color: 'emerald' });
                }
                const colorMap = {
                    'emerald': { bg: 'rgba(16,185,129,.10)', text: 'text-emerald-500' },
                    'amber': { bg: 'rgba(245,158,11,.10)', text: 'text-amber-500' },
                    'sky': { bg: 'rgba(139,88,184,.10)', text: 'text-purple-600' },
                    'rose': { bg: 'rgba(244,63,94,.10)', text: 'text-rose-500' }
                };
                container.innerHTML = items.map(tip => {
                    const colors = colorMap[tip.color] || colorMap.sky;
                    return `<div class="insight">
                        <div class="insight-icon ${colors.text}" style="background:${colors.bg}"><i class="fa-solid ${tip.icon}"></i></div>
                        <div><div class="insight-title">${tip.title}</div><div class="insight-text">${tip.text}</div></div>
                    </div>`;
                }).join('');
            } catch (err) {
                console.error(err);
                const container = document.getElementById('insightsContainer');
                if (container) container.innerHTML = '<div class="text-center py-4 text-xs opacity-40">Unable to load insights</div>';
            }
        }

        
        function renderTransactions(searchTerm = "") {
            const tbody = document.getElementById("transactionTableBody");
            if (!tbody) return;

            const term = searchTerm.toLowerCase().trim();
            const filtered = term
                ? recentTransactions.filter(t =>
                    t.student.toLowerCase().includes(term) ||
                    t.category.toLowerCase().includes(term))
                : recentTransactions;

            tbody.innerHTML = '';

            if (!filtered.length) {
                tbody.innerHTML = '<tr><td colspan="5"><div class="text-center py-8 opacity-40">No transactions found</div></td></tr>';
                return;
            }

            filtered.slice(0, 8).forEach(tx => {
                const isIncome = tx.type === "Income";
                const amountColor = isIncome ? "text-emerald-500" : "text-rose-500";
                const amount = isIncome
                    ? `+Rs. ${Number(tx.amount).toFixed(2)}`
                    : `-Rs. ${Number(tx.amount).toFixed(2)}`;

                const row = document.createElement("tr");
                row.innerHTML = `
                    <td>
                        <div class="student">
                            <div class="student-avatar">${tx.initials}</div>
                            <div>
                                <div class="font-bold">${tx.student}</div>
                                <div class="text-[8px] opacity-35">Student</div>
                            </div>
                        </div>
                    </td>
                    <td>${tx.category}</td>
                    <td class="${amountColor} font-bold">${amount}</td>
                    <td>${tx.type}</td>
                    <td><span class="status completed">${tx.status}</span></td>
                `;
                tbody.appendChild(row);
            });
        }

        // ================= COUNTERS =================
        function animateCounters() {
            document.querySelectorAll("[data-counter]").forEach(element => {
                const target = Number(element.dataset.counter);
                const format = element.dataset.format;
                const start = performance.now();
                const duration = 1200;

                function update(time) {
                    const progress = Math.min((time - start) / duration, 1);
                    const eased = 1 - Math.pow(1 - progress, 3);
                    const value = target * eased;

                    if (format === "currency") {
                        element.textContent = "$" + Math.round(value).toLocaleString();
                    } else if (format === "score") {
                        element.textContent = Math.round(value) + "/100";
                    } else {
                        element.textContent = Math.round(value).toLocaleString();
                    }

                    if (progress < 1) requestAnimationFrame(update);
                }
                requestAnimationFrame(update);
            });
        }

        // ================= CHART SETUP =================
        function getChartColors() {
            const dark = document.documentElement.classList.contains("dark");
            return {
                text: dark ? "rgba(226,232,240,.65)" : "rgba(15,23,42,.55)",
                grid: dark ? "rgba(255,255,255,.06)" : "rgba(15,23,42,.07)"
            };
        }

        function baseChartOptions() {
            const colors = getChartColors();
            return {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { intersect: false, mode: "index" },
                plugins: {
                    legend: { labels: { color: colors.text, usePointStyle: true, boxWidth: 8, font: { size: 10 } } }
                },
                scales: {
                    x: { grid: { display: false }, ticks: { color: colors.text, font: { size: 9 } } },
                    y: { grid: { color: colors.grid }, ticks: { color: colors.text, font: { size: 9 } } }
                }
            };
        }

        function initializeCharts() {
            const colors = getChartColors();

            const ctx1 = document.getElementById("incomeExpenseChart");
            if (ctx1) {
                const c1 = ctx1.getContext("2d");
                const incGrad = c1.createLinearGradient(0, 0, 0, 260);
                incGrad.addColorStop(0, "rgba(139,88,184,.30)");
                incGrad.addColorStop(1, "rgba(139,88,184,0)");
                const expGrad = c1.createLinearGradient(0, 0, 0, 260);
                expGrad.addColorStop(0, "rgba(99,102,241,.22)");
                expGrad.addColorStop(1, "rgba(99,102,241,0)");

                charts.incomeExpense = new Chart(c1, {
                    type: "line",
                    data: {
                        labels: [],
                        datasets: [
                            { label: "Income", data: [], borderColor: "#6b3a92", backgroundColor: incGrad, fill: true, tension: 0.42, borderWidth: 3 },
                            { label: "Expenses", data: [], borderColor: "#6366f1", backgroundColor: expGrad, fill: true, tension: 0.42, borderWidth: 3 }
                        ]
                    },
                    options: baseChartOptions()
                });
            }

            const ctx2 = document.getElementById("expenseChart");
            if (ctx2) {
                charts.expense = new Chart(ctx2.getContext("2d"), {
                    type: "doughnut",
                    data: { labels: [], datasets: [{ data: [], backgroundColor: [], borderWidth: 0 }] },
                    options: {
                        responsive: true, maintainAspectRatio: false, cutout: "68%",
                        plugins: { legend: { position: "bottom", labels: { color: colors.text, font: { size: 9 } } } }
                    }
                });
            }

            const ctx3 = document.getElementById("transactionChart");
            if (ctx3) {
                charts.transactions = new Chart(ctx3.getContext("2d"), {
                    type: "bar",
                    data: {
                        labels: [],
                        datasets: [{
                            label: "Transactions",
                            data: [],
                            backgroundColor: "rgba(139,88,184,.65)",
                            borderColor: "#8b58b8",
                            borderWidth: 1,
                            borderRadius: 8
                        }]
                    },
                    options: baseChartOptions()
                });
            }

            const ctx4 = document.getElementById("budgetChart");
            if (ctx4) {
                charts.budget = new Chart(ctx4.getContext("2d"), {
                    type: "doughnut",
                    data: {
                        labels: ["Used", "Remaining"],
                        datasets: [{
                            data: [0, 100],
                            backgroundColor: ["#8b58b8", "rgba(148,163,184,.14)"],
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false, cutout: "72%",
                        plugins: { legend: { position: "bottom", labels: { color: colors.text, font: { size: 9 } } } }
                    }
                });
            }

            const ctx5 = document.getElementById("savingGoalChart");
            if (ctx5) {
                charts.savingGoals = new Chart(ctx5.getContext("2d"), {
                    type: "bar",
                    data: {
                        labels: [],
                        datasets: [{
                            label: "Progress %",
                            data: [],
                            backgroundColor: [],
                            borderRadius: 8
                        }]
                    },
                    options: {
                        indexAxis: "y", responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { max: 100, grid: { color: colors.grid }, ticks: { color: colors.text, font: { size: 9 } } },
                            y: { grid: { display: false }, ticks: { color: colors.text, font: { size: 9 } } }
                        }
                    }
                });
            }
        }

        function changePeriod(period) {
            showToast(period === "6" ? "Showing last 6 months" : period === "12" ? "Showing last 12 months" : "Showing this year");
        }

        // ================= HEALTH =================
        function updateHealth() {
            const health = adminData.avgHealth || 78;
            const progress = document.getElementById("healthProgress");
            const score = document.querySelector(".health-score");
            const ring = document.querySelector(".health-ring");

            if (progress) progress.style.width = health + "%";
            if (score) score.textContent = health;
            if (ring) {
                const deg = (health / 100) * 360;
                ring.style.background = `conic-gradient(#a486e0 0deg, #6366f1 ${deg}deg, rgba(148,163,184,.13) ${deg}deg)`;
            }
        }

        // ================= SEARCH =================
        function initializeSearch() {
            const s = document.getElementById("globalSearch");
            if (s) s.addEventListener("input", function () { renderTransactions(this.value); });
        }

        // ================= THEME =================
        function initializeTheme() {
            if (localStorage.getItem("campuscoin-admin-theme") === "dark") {
                document.documentElement.classList.remove("light");
                document.documentElement.classList.add("dark");
                document.body.classList.remove("light-mesh");
                document.body.classList.add("dark-mesh");
            }
            updateThemeIcon();
        }

        function toggleTheme() {
            const html = document.documentElement;
            const dark = html.classList.contains("dark");
            if (dark) {
                html.classList.remove("dark"); html.classList.add("light");
                document.body.classList.remove("dark-mesh"); document.body.classList.add("light-mesh");
                localStorage.setItem("campuscoin-admin-theme", "light");
            } else {
                html.classList.remove("light"); html.classList.add("dark");
                document.body.classList.remove("light-mesh"); document.body.classList.add("dark-mesh");
                localStorage.setItem("campuscoin-admin-theme", "dark");
            }
            updateThemeIcon();
            updateChartsTheme();
        }

        function updateThemeIcon() {
            const icon = document.getElementById("themeIcon");
            if (!icon) return;
            icon.className = document.documentElement.classList.contains("dark")
                ? "fa-solid fa-sun text-amber-300"
                : "fa-solid fa-moon";
        }

        function updateChartsTheme() {
            const colors = getChartColors();
            Object.values(charts).forEach(chart => {
                if (!chart) return;
                if (chart.options.scales) {
                    Object.values(chart.options.scales).forEach(scale => {
                        if (scale.ticks) scale.ticks.color = colors.text;
                        if (scale.grid) scale.grid.color = colors.grid;
                    });
                }
                if (chart.options.plugins?.legend?.labels) chart.options.plugins.legend.labels.color = colors.text;
                chart.update();
            });
        }

        // ================= DROPDOWN =================
        function toggleDropdown(id) {
            const t = document.getElementById(id);
            if (!t) return;
            document.querySelectorAll(".dropdown").forEach(d => {
                if (d.id !== id) d.classList.remove("show");
            });
            t.classList.toggle("show");
        }

        document.addEventListener("click", function (e) {
            if (!e.target.closest(".dropdown-wrap")) {
                document.querySelectorAll(".dropdown").forEach(d => d.classList.remove("show"));
            }
        });

        function quickAction(action) {
            document.querySelectorAll(".dropdown").forEach(d => d.classList.remove("show"));
            const routes = {
                'Add Student': '/Admin/Students',
                'View Transactions': '/Admin/Transactions',
                'Send Notification': '/Admin/Notifications',
                'Generate Report': '/Admin/Reports'
            };
            if (routes[action]) { window.location.href = routes[action]; return; }
            showToast(action + ' — opening…');
        }

        function viewAllTransactions() { window.location.href = "/Admin/Transactions"; }
        function logoutAdmin() { window.location.href = "/Auth/Logout"; }

        function toggleSidebar() {
            const sb = document.getElementById("sidebar");
            const ov = document.getElementById("mobileOverlay");
            if (sb) sb.classList.toggle("open");
            if (ov) ov.classList.toggle("show");
        }
        function closeSidebar() {
            const sb = document.getElementById("sidebar");
            const ov = document.getElementById("mobileOverlay");
            if (sb) sb.classList.remove("open");
            if (ov) ov.classList.remove("show");
        }

        // ================= TOAST =================
        function showToast(message) {
            const container = document.getElementById("toastContainer");
            if (!container) return;
            const toast = document.createElement("div");
            toast.className = "toast ios-glass";
            toast.innerHTML = `
                <div class="w-9 h-9 rounded-xl bg-purple-600/10 text-purple-600 flex items-center justify-center">
                    <i class="fa-solid fa-check"></i>
                </div>
                <div>
                    <div class="text-[10px] font-bold">CampusCoin Admin</div>
                    <div class="text-[9px] opacity-50">${message}</div>
                </div>
            `;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = "0";
                toast.style.transform = "translateY(10px)";
                setTimeout(() => toast.remove(), 300);
            }, 2400);
        }
    </script>

<script>
(function(){
  window.toggleDropdown = function(id){
    document.querySelectorAll('.dropdown').forEach(function(d){
      if(d.id !== id){ d.classList.remove('show'); d.style.setProperty('display','none','important'); }
    });
    var t = document.getElementById(id);
    if(!t) return;
    var open = !(t.classList.contains('show'));
    if(open){ t.classList.add('show'); t.style.setProperty('display','block','important'); }
    else { t.classList.remove('show'); t.style.setProperty('display','none','important'); }
  };
  document.addEventListener('click', function(e){
    if(!e.target.closest('.dropdown-wrap')){
      document.querySelectorAll('.dropdown').forEach(function(d){
        d.classList.remove('show'); d.style.setProperty('display','none','important');
      });
    }
  });
})();
</script>

</body>
</html>
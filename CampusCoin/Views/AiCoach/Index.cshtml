    <script>
        document.addEventListener("DOMContentLoaded", function () {
            initializeTheme();
            initializeAdviceChart();
            loadAiCoachUser();
        });

        async function loadAiCoachUser() {
            try {
                var res = await fetch('/api/auth/me');
                if (!res.ok) res = await fetch('/api/dashboard/summary');
                if (!res.ok) return;
                var data = await res.json();
                var name = data.fullName || data.userName || data.FullName || 'Student';
                var year = data.academicYear || data.userAcademicYear || 'Student';
                var initials = name.split(' ').map(function (n) { return n[0]; }).join('').toUpperCase().slice(0, 2) || 'ST';
                function setTxt(id, val) { var el = document.getElementById(id); if (el) el.textContent = val; }
                setTxt('sidebarAvatar', initials);
                setTxt('sidebarStudentName', name);
                setTxt('sidebarStudentRole', year);
                setTxt('topAvatar', initials);
                setTxt('topStudentName', name);
                setTxt('topStudentRole', year);
            } catch (e) { console.error(e); }
        }

        window.aiState = {
            lastGoalItem: "",
            lastAmount: 0,
            awaitingDuration: false
        };

        function handleChatSubmit(e) {
            e.preventDefault();
            const input = document.getElementById("chatInput");
            const text = input.value.trim();
            if (!text) return;
            addChatMessage(text, 'user');
            input.value = "";
            askAiCoach(text);
        }

        function sendQuickPrompt(promptText) {
            addChatMessage(promptText, 'user');
            askAiCoach(promptText);
        }

        async function askAiCoach(message) {
            const chatBox = document.getElementById("chatBox");
            const loading = document.createElement("div");
            loading.className = "chat-msg msg-ai";
            loading.id = "aiLoadingMsg";
            loading.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Thinking…';
            chatBox.appendChild(loading);
            chatBox.scrollTop = chatBox.scrollHeight;

            try {
                const csrfToken = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_csrf));
                const res = await fetch('/api/aicoach/ask', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        'RequestVerificationToken': csrfToken
                    },
                    credentials: 'same-origin',
                    body: JSON.stringify({ message: message })
                });
                const data = await res.json().catch(() => ({}));
                loading.remove();
                if (res.ok && data.success && data.reply) {
                    const safe = String(data.reply)
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        .replace(/\*\*([^*]+)\*\*/g, '<b>Rs. 1</b>')
                        .replace(/\*([^*]+)\*/g, '<i>Rs. 1</i>')
                        .replace(/\n/g, '<br>');
                    addChatMessage(safe, 'ai');
                } else {
                    addChatMessage((data.message || 'Sorry, AI Coach is unavailable right now. Please try again.') , 'ai');
                }
            } catch (err) {
                loading.remove();
                addChatMessage('Network error talking to AI Coach. Please try again.', 'ai');
                console.error(err);
            }
        }

        function addChatMessage(msg, sender) {
            const chatBox = document.getElementById("chatBox");
            const msgDiv = document.createElement("div");
            msgDiv.className = `chat-msg ${sender === 'user' ? 'msg-user' : 'msg-ai'}`;
            msgDiv.innerHTML = msg;
            chatBox.appendChild(msgDiv);
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        function generateDynamicAIReply(userText) {
            const text = userText.toLowerCase();
            let reply = "";

            let extractedAmount = extractAmount(text);
            let extractedMonths = extractMonths(text) || 6;

            if (window.aiState.awaitingDuration && (text.includes("haan") || text.includes("yes") || text.includes("ok") || extractedMonths > 0)) {
                let goal = window.aiState.lastGoalItem || "Custom Goal";
                let amount = window.aiState.lastAmount || 50000;
                let monthly = Math.round(amount / extractedMonths);

                reply = `🎯 <b>Personalized AI Savings Plan Generated!</b><br>
                • <b>Target Goal:</b> ${goal}<br>
                • <b>Total Amount:</b> Rs. ${amount.toLocaleString()}<br>
                • <b>Timeframe:</b> ${extractedMonths} Months<br>
                • <b>Monthly Required Saving:</b> <b>Rs. ${monthly.toLocaleString()}/month</b><br><br>
                💡 <i>Tip: Aap apne daily canteen &amp; food expense me 15% cut karke yeh target asani se meet kar sakte hain.</i><br><br>
                <button onclick="syncGoalToWishlist('${goal}', ${amount})" class="mt-2 text-[10px] font-bold text-white bg-violet-600 px-3 py-1.5 rounded-xl hover:bg-violet-700 shadow-md">
                    <i class="fa-solid fa-plus-circle"></i> Sync '${goal}' to Wishlist.html
                </button>`;

                window.aiState.awaitingDuration = false;
            }
            else if (text.includes("buy") || text.includes("kharid") || text.includes("save") || text.includes("saving") || text.includes("chahiye") || text.includes("plan") || text.includes("iphone") || text.includes("phone") || text.includes("laptop") || text.includes("bike") || text.includes("fee")) {

                let itemName = detectItemName(userText);
                let targetAmount = extractedAmount > 0 ? extractedAmount : (itemName.toLowerCase().includes("iphone") ? 180000 : 50000);

                window.aiState.lastGoalItem = itemName;
                window.aiState.lastAmount = targetAmount;
                window.aiState.awaitingDuration = true;

                let monthlySaving = Math.round(targetAmount / extractedMonths);

                reply = `📱 <b>AI Goal Detected:</b> <b>${itemName}</b> (Est. Rs. ${targetAmount.toLocaleString()})<br><br>
                Agar aap <b>${extractedMonths} months</b> ka plan banayein, toh aapko monthly <b>Rs. ${monthlySaving.toLocaleString()}</b> save karna hoga.<br><br>
                Kya aap is plan ko confirm karke apni Wishlist me add karna chahte hain? (Answer 'Haan' ya timeline change karein).`;
            }
            else if (text.includes("invest") || text.includes("mutual fund") || text.includes("profit") || text.includes("grow") || text.includes("stock") || text.includes("paisa lagana")) {
                reply = `📈 <b>AI Micro-Investment Guidance for Students:</b><br>
                1. <b>Money Market Funds:</b> Low risk &amp; daily profit allocation (Approx 15-20% annual yield).<br>
                2. <b>Starting Amount:</b> Student account se Rs. 1,000 se bhi start kar sakte hain.<br>
                3. <b>Recommendation:</b> App balance ka 10% auto-invest setting par lagayein.<br><br>
                <button onclick="syncGoalToWishlist('Low Risk Mutual Fund', 10000)" class="text-[10px] font-bold text-emerald-600 bg-emerald-500/10 px-3 py-1.5 rounded-xl border border-emerald-500/20 hover:bg-emerald-500/20">
                    <i class="fa-solid fa-seedling"></i> Start Rs. 10,000 Investment Goal
                </button>`;
            }
            else if (text.includes("analyze") || text.includes("budget") || text.includes("expense") || text.includes("kharcha") || text.includes("paisa bachayein")) {
                reply = `📊 <b>AI Smart Budget Breakdown:</b><br>
                • <b>Food &amp; Outing:</b> Your highest expense (40% of allowance).<br>
                • <b>University Dues:</b> 35% fixed.<br>
                • <b>Savings Potential:</b> Agar aap weekly Rs. 500 transport/canteen se save karein, toh monthly <b>Rs. 2,000 extra</b> bachenge!`;
            }
            else {
                reply = `🤖 <b>CampusCoin AI Assistant:</b><br>
                Aapne poocha: <i>"${userText}"</i><br><br>
                Main aapke budget ko analyze karke yeh suggest kar raha hun:<br>
                1. Aap kisi bhi purchase (Mobile, Laptop, Fees) ka <b>Saving Goal</b> set kar sakte hain.<br>
                2. Daily <b>Micro-Savings</b> se mahine ke Rs. 3,000-5,000 save kar sakte hain.<br><br>
                👉 <i>Aap mujhe bataayein: Aapko kitni savings ya kis item ke liye planning karni hai?</i>`;
            }

            addChatMessage(reply, 'ai');
        }

        function extractAmount(text) {
            if (text.includes("50k") || text.includes("50 k")) return 50000;
            if (text.includes("100k") || text.includes("1 lac") || text.includes("1lakh")) return 100000;
            if (text.includes("200k") || text.includes("2 lac") || text.includes("2lakh")) return 200000;

            let numMatch = text.match(/\d+/g);
            if (numMatch) {
                let val = parseInt(numMatch.join(''));
                return val < 100 ? val * 1000 : val;
            }
            return 0;
        }

        function extractMonths(text) {
            if (text.includes("1 month") || text.includes("ek mahina")) return 1;
            if (text.includes("3 month") || text.includes("3 mahine")) return 3;
            if (text.includes("6 month") || text.includes("6 mahine")) return 6;
            if (text.includes("1 year") || text.includes("saal") || text.includes("12 month")) return 12;
            return 0;
        }

        function detectItemName(text) {
            if (text.toLowerCase().includes("iphone")) return "iPhone Savings";
            if (text.toLowerCase().includes("laptop")) return "Laptop Savings";
            if (text.toLowerCase().includes("bike")) return "Bike Fund";
            if (text.toLowerCase().includes("fee") || text.toLowerCase().includes("semester")) return "Semester Fee Goal";
            if (text.toLowerCase().includes("trip")) return "Northern Trip Fund";

            return "Custom Student Goal";
        }

        function syncGoalToWishlist(goalName, amount) {
            showToast(`"${goalName}" (Rs. ${amount.toLocaleString()}) successfully synced to Wishlist.html!`);
        }

        async function clearChat() {
            try { await fetch('/api/aicoach/chat', { method: 'DELETE' }); } catch (_) {}
            document.getElementById("chatBox").innerHTML = `
                <div class="chat-msg msg-ai">
                    👋 Chat cleared. Ask anything about budgets, fees, or savings!
                </div>
            `;
            window.aiState = { lastGoalItem: "", lastAmount: 0, awaitingDuration: false };
        }

        async function loadChatHistory() {
            try {
                const res = await fetch('/api/aicoach/chat');
                if (!res.ok) return;
                const msgs = await res.json();
                if (!Array.isArray(msgs) || !msgs.length) return;
                const chatBox = document.getElementById("chatBox");
                chatBox.innerHTML = '';
                msgs.forEach(function (m) {
                    const safe = String(m.message || '')
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        .replace(/\n/g, '<br>');
                    addChatMessage(safe, m.sender === 'user' ? 'user' : 'ai');
                });
            } catch (e) { console.error(e); }
        }

        function handleTicketSubmit(e) {
            e.preventDefault();
            const subject = document.getElementById("ticketSubject").value;
            const category = document.getElementById("ticketCategory").value;

            const ticketId = Math.floor(1000 + Math.random() * 9000);
            const container = document.getElementById("ticketContainer");

            const ticketHtml = `
                <div class="p-3.5 rounded-2xl bg-slate-500/10 flex justify-between items-center text-xs">
                    <div>
                        <div class="font-bold">#TCK-${ticketId}: ${subject}</div>
                        <div class="text-[9px] opacity-50">Submitted Just Now • Category: ${category}</div>
                    </div>
                    <span class="px-2.5 py-1 rounded-xl text-[9px] font-extrabold bg-emerald-500/10 text-emerald-500">Submitted</span>
                </div>
            `;

            container.innerHTML = ticketHtml + container.innerHTML;
            document.getElementById("ticketCount").textContent = `${container.children.length} Active Tickets`;

            closeModal("ticketModal");
            showToast(`Support Ticket #TCK-${ticketId} successfully submitted!`);
        }

        function initializeAdviceChart() {
            const ctx = document.getElementById("aiAdviceChart").getContext("2d");
            new Chart(ctx, {
                type: "doughnut",
                data: {
                    labels: ["Needs & Academics (50%)", "Wants & Outing (30%)", "Savings & Goals (20%)"],
                    datasets: [{
                        data: [12500, 7500, 5000],
                        backgroundColor: [
                            "rgba(109, 74, 255, 0.8)",
                            "rgba(244, 63, 94, 0.8)",
                            "rgba(16, 185, 129, 0.8)"
                        ],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: "bottom", labels: { boxWidth: 10, font: { size: 9 } } } }
                }
            });
        }

        function openModal(id) { document.getElementById(id).classList.add("show"); }
        function closeModal(id) { document.getElementById(id).classList.remove("show"); }

        function toggleDropdown(id, evt) {
            if (evt) { evt.preventDefault(); evt.stopPropagation(); }

            const dropdown = document.getElementById(id);
            const isShown = dropdown.classList.contains("show");
            document.querySelectorAll(".dropdown").forEach(d => d.classList.remove("show"));
            if (!isShown) dropdown.classList.add("show");
        }

        document.addEventListener("click", function (e) {
            if (!e.target.closest(".dropdown-wrap")) {
                document.querySelectorAll(".dropdown").forEach(d => d.classList.remove("show"));
            }
        });

        function toggleSidebar() {
            document.getElementById("sidebar").classList.toggle("open");
            document.getElementById("mobileOverlay").classList.toggle("show");
        }
        function closeSidebar() {
            document.getElementById("sidebar").classList.remove("open");
            document.getElementById("mobileOverlay").classList.remove("show");
        }

        function initializeTheme() {
            const saved = localStorage.getItem("campuscoin-theme");
            if (saved === "dark") {
                document.documentElement.classList.remove("light");
                document.documentElement.classList.add("dark");
                document.body.classList.add("dark-mesh");
            }
            updateThemeIcon();
        }

        function toggleTheme() {
            const isDark = document.documentElement.classList.contains("dark");
            if (isDark) {
                document.documentElement.classList.remove("dark");
                document.documentElement.classList.add("light");
                document.body.classList.remove("dark-mesh");
                localStorage.setItem("campuscoin-theme", "light");
            } else {
                document.documentElement.classList.remove("light");
                document.documentElement.classList.add("dark");
                document.body.classList.add("dark-mesh");
                localStorage.setItem("campuscoin-theme", "dark");
            }
            updateThemeIcon();
        }

        function updateThemeIcon() {
            const icon = document.getElementById("themeIcon");
            const isDark = document.documentElement.classList.contains("dark");
            icon.className = isDark ? "fa-solid fa-sun text-amber-300" : "fa-solid fa-moon";
        }

        function logoutStudent() { window.location.href = "/Auth/Logout"; }

        function showToast(msg) {
            const container = document.getElementById("toastContainer");
            const toast = document.createElement("div");
            toast.className = "toast ios-glass font-bold text-xs";
            toast.innerHTML = `<i class="fa-solid fa-circle-info text-violet-500"></i> ${msg}`;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 300);
            }, 2500);
        }
    </script>
<script src="/js/cc-header-widgets.js" asp-append-version="true"></script>
</body>
</html>
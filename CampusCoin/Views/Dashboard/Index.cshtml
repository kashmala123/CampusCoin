@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <link rel="stylesheet" href="/css/student-theme.css" />
    <link rel="stylesheet" href="/css/cc-animations.css" />

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CampusCoin — Student Portal</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <link rel="apple-touch-icon" href="/favicon.svg?v=4" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50:'#f6effc', 100:'#ede4f6', 400:'#a486e0',
                            500:'#8b58b8', 600:'#6b3a92',
                        }
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans','-apple-system', 'BlinkMacSystemFont', 'Inter', 'Segoe UI', 'Roboto', 'sans-serif'],
                    }
                }
            }
        };
    </script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <style>
        * {
            transition: background-color 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease, color 0.3s ease;
        }

        html {
            scroll-behavior: smooth;
        }

        body.light-mesh {
            background-color: #fbf6f0;
            background-image: radial-gradient(at 0% 0%, rgba(237, 228, 246, 0.9) 0px, transparent 50%), radial-gradient(at 100% 0%, rgba(196, 174, 224, 0.85) 0px, transparent 50%), radial-gradient(at 100% 100%, rgba(255, 225, 230, 0.85) 0px, transparent 50%), radial-gradient(at 0% 100%, rgba(246, 239, 252, 0.9) 0px, transparent 50%), radial-gradient(at 50% 50%, rgba(212, 243, 228, 0.4) 0px, transparent 50%);
            background-attachment: fixed;
        }

        body.dark-mesh {
            background-color: #100a1a;
            background-image: radial-gradient(at 10% 10%, rgba(99, 102, 241, 0.28) 0px, transparent 50%), radial-gradient(at 90% 10%, rgba(168, 85, 247, 0.22) 0px, transparent 50%), radial-gradient(at 90% 90%, rgba(107, 58, 146, 0.28) 0px, transparent 50%), radial-gradient(at 10% 90%, rgba(236, 72, 153, 0.2) 0px, transparent 50%);
            background-attachment: fixed;
        }

        .orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(80px);
            z-index: -1;
            pointer-events: none;
            animation: floatOrb 18s infinite alternate ease-in-out;
        }

        .orb-1 {
            width: 450px;
            height: 450px;
            background: rgba(192, 132, 252, 0.4);
            top: -100px;
            left: -100px;
        }

        .orb-2 {
            width: 480px;
            height: 480px;
            background: rgba(139, 88, 184, 0.45);
            top: 30%;
            right: -120px;
            animation-delay: -5s;
        }

        .orb-3 {
            width: 400px;
            height: 400px;
            background: rgba(251, 113, 133, 0.35);
            bottom: -100px;
            left: 20%;
            animation-delay: -10s;
        }

        @@keyframes floatOrb {
            0% {
                transform: translate(0px, 0px) scale(1);
            }

            50% {
                transform: translate(40px, 60px) scale(1.08);
            }

            100% {
                transform: translate(-30px, 30px) scale(0.95);
            }
        }

        .ios-glass {
            backdrop-filter: blur(32px) saturate(240%);
            -webkit-backdrop-filter: blur(32px) saturate(240%);
            position: relative;
            overflow: hidden;
        }

        .light .ios-glass {
            background: rgba(255, 255, 255, 0.72);
            border: 1.5px solid rgba(255, 255, 255, 0.95);
            box-shadow: 0 20px 40px -12px rgba(107, 58, 146, 0.12), 0 4px 16px -2px rgba(0, 0, 0, 0.04), inset 0 1.5px 2px 0 rgba(255, 255, 255, 1);
            color: #0f172a;
        }

        .dark .ios-glass {
            background: rgba(18, 24, 38, 0.58);
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.45), inset 0 1px 0 0 rgba(255, 255, 255, 0.18);
            color: #f8fafc;
        }

        .ios-glass-interactive {
            transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease, background 0.35s ease;
        }

            .ios-glass-interactive::before {
                content: '';
                position: absolute;
                top: 0;
                left: -150%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.65), transparent);
                transform: skewX(-25deg);
                transition: left 0.75s ease;
                pointer-events: none;
            }

        .dark .ios-glass-interactive::before {
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.18), transparent);
        }

        .ios-glass-interactive:hover::before {
            left: 150%;
        }

        .ios-glass-interactive:hover {
            transform: translateY(-4px);
        }

        .light .ios-glass-interactive:hover {
            background: rgba(255, 255, 255, 0.88);
            box-shadow: 0 25px 50px -10px rgba(139, 88, 184, 0.22), inset 0 1.5px 3px 0 rgba(255, 255, 255, 1);
        }

        .dark .ios-glass-interactive:hover {
            background: rgba(255, 255, 255, 0.1);
            box-shadow: 0 30px 60px -12px rgba(0, 0, 0, 0.6), inset 0 1px 1px 0 rgba(255, 255, 255, 0.3);
        }

        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(150, 150, 150, 0.3);
            border-radius: 999px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: rgba(150, 150, 150, 0.5);
            }

        .sidebar {
            position: fixed;
            top: 20px;
            left: 20px;
            bottom: 20px;
            width: 260px;
            z-index: 100;
            border-radius: 30px;
            padding: 18px;
            display: flex;
            flex-direction: column;
            transform: translateX(0);
            transition: transform .35s ease;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 4px 6px 22px;
        }

        .brand-logo {
            width: 46px;
            height: 46px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
            background: linear-gradient(135deg, #a486e0, #8b58b8, #6366f1);
            box-shadow: 0 12px 25px rgba(107, 58, 146, .28);
        }

        .brand-name {
            font-size: 18px;
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        .brand-sub {
            font-size: 9px;
            font-weight: 800;
            letter-spacing: .16em;
            opacity: .45;
            margin-top: 3px;
        }

        .nav-section {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: .15em;
            font-weight: 800;
            opacity: .4;
            padding: 14px 10px 7px;
        }

        .nav {
            flex: 1;
            overflow-y: auto;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 12px;
            margin: 4px 0;
            border-radius: 15px;
            text-decoration: none;
            color: inherit;
            font-size: 12px;
            font-weight: 650;
            transition: all .25s ease;
        }

            .nav-link i {
                width: 20px;
                text-align: center;
                opacity: .55;
            }

            .nav-link:hover {
                background: rgba(255,255,255,.30);
                transform: translateX(3px);
            }

        .dark .nav-link:hover {
            background: rgba(255,255,255,.06);
        }

        .nav-link.active {
            color: #6b3a92;
            background: linear-gradient(135deg, rgba(139,88,184,.18), rgba(99,102,241,.14));
            box-shadow: inset 0 0 0 1px rgba(139,88,184,.15), 0 10px 25px rgba(107,58,146,.08);
        }

        .dark .nav-link.active {
            color: #c4aee0;
            background: rgba(139,88,184,.10);
        }

        .student-mini {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 11px;
            border-radius: 18px;
            background: rgba(255,255,255,.30);
            border: 1px solid rgba(255,255,255,.35);
        }

        .dark .student-mini {
            background: rgba(255,255,255,.04);
            border-color: rgba(255,255,255,.08);
        }

        .student-avatar {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 11px;
            font-weight: 800;
            background: linear-gradient(135deg, #8b58b8, #6366f1);
        }

        .main {
            margin-left: 300px;
            padding: 20px 25px 40px 0;
            min-height: 100vh;
        }

        .topbar {
            height: 70px;
            border-radius: 25px;
            padding: 10px 13px;
            display: flex;
            align-items: center;
            gap: 12px;
            position: sticky;
            top: 20px;
            z-index: 10000;
            overflow: visible !important;
        }
        .top-actions {
            position: relative;
            z-index: 10001;
            overflow: visible !important;
        }

        .search {
            flex: 1;
            max-width: 500px;
            position: relative;
        }

            .search i {
                position: absolute;
                left: 16px;
                top: 50%;
                transform: translateY(-50%);
                opacity: .4;
                font-size: 12px;
            }

            .search input {
                width: 100%;
                border: none;
                outline: none;
                padding: 11px 15px 11px 42px;
                border-radius: 16px;
                background: rgba(255,255,255,.38);
                color: inherit;
                font-size: 12px;
                border: 1px solid rgba(255,255,255,.50);
            }

        .dark .search input {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .search input:focus {
            background: rgba(255,255,255,.65);
            box-shadow: 0 0 0 4px rgba(139,88,184,.10);
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-left: auto;
        }

        .action-btn {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            border: 1px solid rgba(255,255,255,.55);
            background: rgba(255,255,255,.36);
            color: inherit;
            cursor: pointer;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .dark .action-btn {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .action-btn:hover {
            transform: translateY(-2px);
            background: rgba(255,255,255,.65);
        }

        .notification-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #f43f5e;
            position: absolute;
            top: 8px;
            right: 8px;
            box-shadow: 0 0 0 3px rgba(244,63,94,.10);
        }

        .profile {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 4px 9px 4px 4px;
            border-radius: 15px;
            cursor: pointer;
        }

            .profile:hover {
                background: rgba(255,255,255,.30);
            }

        .profile-avatar {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 11px;
            font-weight: 800;
            background: linear-gradient(135deg, #a486e0, #6366f1);
        }

        .dropdown-wrap {
            position: relative;
        }

        .dropdown {
            position: absolute;
            right: 0;
            top: calc(100% + 10px);
            width: 250px;
            padding: 9px;
            border-radius: 20px;
            opacity: 0;
            pointer-events: none;
            transform: translateY(-8px) scale(.98);
            transition: .2s ease;
            z-index: 10050;
        }

            .dropdown.show {
                opacity: 1 !important;
                pointer-events: auto !important;
                transform: translateY(0) scale(1);
                visibility: visible !important;
                z-index: 10050 !important;
                display: flex !important;
                flex-direction: column !important;
            }
            .dropdown {
                display: flex;
                flex-direction: column;
            }
            .dropdown-wrap {
                position: relative;
                z-index: 10002;
                overflow: visible !important;
            }
            .profile { cursor: pointer; user-select: none; }
            /* Keep notification + profile menus above page cards */
            #profileDropdown, #notificationsPopover, #quickDropdown, #notifDropdown {
                z-index: 10050 !important;
            }

        .dropdown-item {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 10px;
            border: 0;
            background: transparent;
            color: inherit;
            padding: 11px;
            border-radius: 13px;
            cursor: pointer;
            text-align: left;
            font-size: 11px;
        }

            .dropdown-item:hover {
                background: rgba(139,88,184,.10);
            }

        .page-header {
            display: flex;
            align-items: end;
            justify-content: space-between;
            gap: 20px;
            margin: 28px 3px 24px;
        }

        .eyebrow {
            color: #6b3a92;
            font-size: 9px;
            font-weight: 850;
            text-transform: uppercase;
            letter-spacing: .18em;
            margin-bottom: 8px;
        }

        .page-title {
            font-size: clamp(28px, 3vw, 40px);
            font-weight: 900;
            letter-spacing: -1.8px;
            line-height: 1;
        }

        .page-description {
            font-size: 12px;
            opacity: .48;
            margin-top: 8px;
        }

        .date-pill {
            padding: 10px 14px;
            border-radius: 15px;
            font-size: 10px;
            font-weight: 700;
            white-space: nowrap;
        }

        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 22px;
        }

        .kpi {
            min-height: 155px;
            padding: 19px;
            border-radius: 25px;
            position: relative;
            overflow: hidden;
        }

            .kpi::after {
                content: '';
                position: absolute;
                width: 110px;
                height: 110px;
                border-radius: 50%;
                right: -45px;
                top: -45px;
                background: rgba(139,88,184,.08);
                pointer-events: none;
            }

        .kpi-icon {
            width: 40px;
            height: 40px;
            border-radius: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(139,88,184,.13);
            color: #6b3a92;
            margin-bottom: 13px;
        }

        .kpi-label {
            font-size: 10px;
            font-weight: 700;
            opacity: .48;
        }

        .kpi-value {
            font-size: 25px;
            font-weight: 900;
            letter-spacing: -1px;
            margin-top: 3px;
        }

        .kpi-change {
            font-size: 9px;
            font-weight: 750;
            margin-top: 5px;
        }

        .positive {
            color: #059669;
        }

        .negative {
            color: #e11d48;
        }

        .chart-grid {
            display: grid;
            grid-template-columns: 1.7fr 1fr;
            gap: 22px;
            margin-top: 15px;
        }

        .chart-card {
            border-radius: 27px;
            padding: 20px;
            min-height: 350px;
        }

        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            margin-bottom: 17px;
        }

        .chart-title {
            font-size: 14px;
            font-weight: 850;
        }

        .chart-sub {
            font-size: 9px;
            opacity: .45;
            margin-top: 3px;
        }

        .select {
            border: 1px solid rgba(255,255,255,.55);
            background: rgba(255,255,255,.38);
            color: inherit;
            border-radius: 12px;
            padding: 8px 10px;
            outline: none;
            font-size: 10px;
        }

        .dark .select {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .chart-container {
            height: 260px;
            position: relative;
        }

        .two-grid {
            display: grid;
            grid-template-columns: repeat(2,1fr);
            gap: 22px;
            margin-top: 15px;
        }

        .small-chart {
            min-height: 330px;
        }

        .health-card {
            margin-top: 15px;
            border-radius: 27px;
            padding: 21px;
            display: grid;
            grid-template-columns: 145px 1fr;
            gap: 25px;
            align-items: center;
        }

        .health-ring {
            width: 125px;
            height: 125px;
            border-radius: 50%;
            background: conic-gradient(#a486e0 0deg, #6366f1 302deg, rgba(148,163,184,.13) 302deg);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            margin: auto;
        }

            .health-ring::after {
                content: '';
                position: absolute;
                width: 91px;
                height: 91px;
                border-radius: 50%;
                background: rgba(255,255,255,.82);
            }

        .dark .health-ring::after {
            background: #121826;
        }

        .health-score {
            position: relative;
            z-index: 2;
            font-size: 27px;
            font-weight: 900;
        }

        .progress {
            height: 8px;
            background: rgba(148,163,184,.13);
            border-radius: 50px;
            overflow: hidden;
            margin-top: 15px;
        }

        .progress-bar {
            height: 100%;
            width: 0;
            border-radius: inherit;
            background: linear-gradient(90deg, #a486e0, #8b58b8, #6366f1);
            transition: width 1.2s ease;
        }

        .bottom-grid {
            display: grid;
            grid-template-columns: 1.6fr 1fr;
            gap: 22px;
            margin-top: 15px;
        }

        .panel {
            padding: 20px;
            border-radius: 27px;
        }

        .panel-title {
            font-size: 14px;
            font-weight: 850;
        }

        .panel-sub {
            font-size: 9px;
            opacity: .45;
            margin-top: 3px;
        }

        .table-wrap {
            overflow-x: auto;
            margin-top: 17px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            padding: 8px;
            text-align: left;
            font-size: 8px;
            text-transform: uppercase;
            letter-spacing: .08em;
            opacity: .4;
            white-space: nowrap;
        }

        td {
            padding: 12px 8px;
            border-top: 1px solid rgba(148,163,184,.12);
            font-size: 10px;
            white-space: nowrap;
        }

        .status {
            padding: 5px 8px;
            border-radius: 8px;
            font-size: 8px;
            font-weight: 800;
        }

            .status.completed {
                background: rgba(139,92,246,.10);
                color: #7c3aed;
            }

            .status.pending {
                background: rgba(245,158,11,.10);
                color: #d97706;
            }

        .insight {
            display: flex;
            gap: 10px;
            padding: 11px;
            margin-top: 9px;
            border-radius: 15px;
            background: rgba(255,255,255,.25);
            border: 1px solid rgba(255,255,255,.30);
            align-items: center;
        }

        .dark .insight {
            background: rgba(255,255,255,.035);
            border-color: rgba(255,255,255,.06);
        }

        .insight-icon {
            width: 33px;
            height: 33px;
            border-radius: 10px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .insight-title {
            font-size: 10px;
            font-weight: 850;
        }

        .insight-text {
            font-size: 9px;
            opacity: .52;
            line-height: 1.45;
            margin-top: 3px;
        }

        .glass-btn {
            border: 1px solid rgba(255,255,255,.55);
            background: rgba(255,255,255,.38);
            color: inherit;
            border-radius: 13px;
            padding: 9px 12px;
            font-size: 10px;
            font-weight: 750;
            cursor: pointer;
        }

        .dark .glass-btn {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .glass-btn:hover {
            transform: translateY(-2px);
            background: rgba(255,255,255,.65);
        }

        .primary-btn {
            color: white;
            border: none;
            background: linear-gradient(135deg, #a486e0, #8b58b8, #6366f1);
            box-shadow: 0 10px 22px rgba(107,58,146,.20);
        }

        .mobile-btn {
            display: none;
        }

        .mobile-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15,23,42,.25);
            backdrop-filter: blur(5px);
            z-index: 90;
        }

            .mobile-overlay.show {
                display: block;
            }

        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15,23,42,.4);
            backdrop-filter: blur(8px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 300;
        }

            .modal-overlay.show {
                display: flex;
            }

        .modal-card {
            width: 100%;
            max-width: 440px;
            padding: 24px;
            border-radius: 28px;
        }

        #toastContainer {
            position: fixed;
            right: 20px;
            bottom: 20px;
            z-index: 999;
            display: flex;
            flex-direction: column;
            gap: 9px;
        }

        .toast {
            min-width: 270px;
            padding: 13px;
            border-radius: 17px;
            display: flex;
            align-items: center;
            gap: 10px;
            animation: toastIn .3s ease;
        }

        @@keyframes toastIn {
            from {
                opacity: 0;
                transform: translateY(15px) scale(.96);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .notifications-popover {
            position: absolute;
            right: 0;
            top: calc(100% + 12px);
            width: 320px;
            max-height: 400px;
            overflow-y: auto;
            border-radius: 20px;
            padding: 14px;
            z-index: 10050 !important;
            opacity: 0;
            pointer-events: none;
            transform: translateY(-10px);
            transition: all 0.25s ease;
        }

            .notifications-popover.show {
                opacity: 1 !important;
                pointer-events: auto !important;
                transform: translateY(0);
                visibility: visible !important;
                z-index: 10060 !important;
                display: block !important;
            }

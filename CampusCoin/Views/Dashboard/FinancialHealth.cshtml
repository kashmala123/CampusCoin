    <main class="main">
        <header class="topbar ios-glass">
            <button class="action-btn mobile-btn" onclick="toggleSidebar()"><i class="fa-solid fa-bars"></i></button>
            <div class="search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" placeholder="Search financial health factors..." id="searchInput" oninput="handleSearch(this.value)">
            </div>

            <div class="top-actions">
                <button class="glass-btn primary-btn" onclick="refreshHealth()"><i class="fa-solid fa-rotate mr-1"></i> Refresh</button>
                <button class="action-btn" onclick="toggleTheme()"><i id="themeIcon" class="fa-solid fa-moon"></i></button>

                <div class="dropdown-wrap cc-notif-wrap" style="position:relative;z-index:10002;overflow:visible;">
                    <button type="button" class="action-btn cc-notif-btn" title="Notifications" aria-label="Notifications">
                        <i class="fa-regular fa-bell"></i>
                        <span class="cc-notif-dot hidden"></span>
                    </button>
                    <div class="cc-notif-popover" role="menu">
                        <div class="cc-notif-head">
                            <div class="cc-notif-title"><i class="fa-solid fa-bell"></i> Notifications</div>
                            <button type="button" class="cc-notif-markall">Mark all read</button>
                        </div>
                        <div class="cc-notif-list">
                            <div class="cc-notif-empty">Loading…</div>
                        </div>
                        <a href="/Dashboard/Notifications" class="cc-notif-footer">View all notifications →</a>
                    </div>
                </div>
                <div class="dropdown-wrap" style="position:relative;z-index:10002;overflow:visible;">
                    <div class="profile" data-cc-profile-btn style="cursor:pointer;display:flex;align-items:center;gap:8px;">
                        <div class="profile-avatar" id="topAvatar" style="width:34px;height:34px;border-radius:11px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:11px;font-weight:800;background:linear-gradient(135deg,#a486e0,#6366f1);">ST</div>
                        <div class="text-[10px] font-bold" id="topStudentName">Student</div>
                        <i class="fa-solid fa-chevron-down text-[8px] opacity-40"></i>
                    </div>
                    <div data-cc-profile-dd class="cc-shared-dd">
                        <a href="/Dashboard/Profile" class="cc-shared-dd-item"><i class="fa-regular fa-user"></i> Profile</a>
                        <a href="/Dashboard/Index" class="cc-shared-dd-item"><i class="fa-solid fa-chart-line"></i> Dashboard</a>
                        <a href="/Auth/Logout" class="cc-shared-dd-item" style="color:#e11d48;"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
                    </div>
                </div>

            </div>
        </header>

        <section class="page-header">
            <div>
                <div class="eyebrow">CampusCoin / Student Portal</div>
                <h1 class="page-title">Financial Health Score</h1>
                <p class="page-description">Analyze your financial standing and monitor real-time improvements based on your spending patterns.</p>
            </div>
            <div class="date-pill ios-glass">
                <i class="fa-regular fa-calendar mr-1"></i>
                <span id="currentDate">Loading...</span>
            </div>
        </section>

        <!-- SCORE HERO -->
        <section class="score-hero">
            <div class="score-card ios-glass ios-glass-interactive">
                <div>
                    <div class="text-[11px] font-bold uppercase tracking-wider text-purple-600">Overall Rating</div>
                    <div class="text-[16px] font-extrabold mt-1" id="overallStatus">Calculating...</div>
                </div>
                <div class="score-display">
                    <div class="score-circle" id="scoreCircleElement">
                        <div class="score-number" id="mainScoreVal">--</div>
                    </div>
                    <div>
                        <div class="text-[12px] font-bold">Scale: 0 - 100</div>
                        <div class="text-[10px] opacity-50 mt-1">Calculated from budget control, saving rate, goal progress, and expense stability.</div>
                        <div class="mt-3 inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-emerald-500/10 text-emerald-500 text-[10px] font-bold" id="scoreBadge">
                            <i class="fa-solid fa-arrow-trend-up"></i> Live Score
                        </div>
                    </div>
                </div>
                <div class="text-[10px] opacity-45">Last updated just now.</div>
            </div>

            <!-- RADAR -->
            <div class="chart-card ios-glass ios-glass-interactive" style="min-height: auto;">
                <div class="chart-header">
                    <div>
                        <div class="chart-title">Score Breakdown Radar</div>
                        <div class="chart-sub">4 sub-scores overview</div>
                    </div>
                </div>
                <div class="chart-container" style="height: 165px;">
                    <canvas id="healthRadarChart"></canvas>
                </div>
            </div>
        </section>

        <!-- FACTORS SECTION -->
        <section class="factors-section ios-glass">
            <div class="section-header">
                <div>
                    <div class="text-[14px] font-extrabold">Evaluation Metrics & Factors</div>
                    <div class="text-[10px] opacity-45">Your score is calculated from these live financial metrics</div>
                </div>
                <span class="glass-btn text-[10px]">
                    <i class="fa-solid fa-circle-info mr-1"></i> Auto-Calculated
                </span>
            </div>

            <div id="factorsListContainer">
                <div class="text-center py-6 text-[11px] opacity-45">Loading evaluation metrics...</div>
            </div>
        </section>
    </main>

    <div id="toastContainer"></div>

    <script>
        let radarChart = null;
        let breakdownData = null;

        document.addEventListener("DOMContentLoaded", async function () {
            initializeTheme();
            setDate();
            await Promise.all([loadUserInfo(), loadHealthData()]);
        });

        function setDate() {
            document.getElementById("currentDate").textContent = new Date().toLocaleDateString("en-US", {
                weekday: "short", month: "long", day: "numeric", year: "numeric"
            });
        }

        // ================= USER INFO =================
        async function loadUserInfo() {
            try {
                const res = await fetch('/api/dashboard/summary');
                if (!res.ok) return;
                const data = await res.json();

                if (data.userName) {
                    const initials = data.userName.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);
                    document.getElementById('sidebarAvatar').textContent = initials;
                    document.getElementById('sidebarStudentName').textContent = data.userName;
                    var topName = document.getElementById('topStudentName');
                    if (topName) topName.textContent = data.userName;
                    var topAv = document.getElementById('topAvatar');
                    if (topAv) topAv.textContent = data.userName.split(' ').map(function(n){return n[0];}).join('').toUpperCase().slice(0,2);
                }
                if (data.userAcademicYear) {
                    document.getElementById('sidebarStudentRole').textContent = data.userAcademicYear;
                }
            } catch (err) { console.error(err); }
        }

        // ================= LOAD HEALTH DATA =================
        async function loadHealthData() {
            try {
                const [summaryRes, chartsRes] = await Promise.all([
                    fetch('/api/dashboard/summary'),
                    fetch('/api/dashboard/charts')
                ]);

                if (!summaryRes.ok) throw new Error('Failed to load summary');
                const summary = await summaryRes.json();

                const charts = chartsRes.ok ? await chartsRes.json() : null;

                // Update main score
                const score = summary.healthScore || 0;
                document.getElementById('mainScoreVal').textContent = score;
                document.getElementById('overallStatus').textContent = summary.healthScoreStatus || '--';

                // Update score circle conic gradient
                const circle = document.getElementById('scoreCircleElement');
                const degrees = (score / 100) * 360;

                let color1, color2;
                if (score >= 75) { color1 = '#a486e0'; color2 = '#10b981'; }
                else if (score >= 50) { color1 = '#a486e0'; color2 = '#6366f1'; }
                else { color1 = '#f59e0b'; color2 = '#f43f5e'; }

                circle.style.background = `conic-gradient(${color1} 0deg, ${color2} ${degrees}deg, rgba(148,163,184,0.15) ${degrees}deg)`;

                // Update badge color
                const badge = document.getElementById('scoreBadge');
                if (score >= 75) {
                    badge.className = 'mt-3 inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-emerald-500/10 text-emerald-500 text-[10px] font-bold';
                    badge.innerHTML = '<i class="fa-solid fa-arrow-trend-up"></i> Excellent Standing';
                } else if (score >= 50) {
                    badge.className = 'mt-3 inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-purple-600/10 text-purple-600 text-[10px] font-bold';
                    badge.innerHTML = '<i class="fa-solid fa-circle-check"></i> Stable Standing';
                } else {
                    badge.className = 'mt-3 inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-rose-500/10 text-rose-500 text-[10px] font-bold';
                    badge.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> Needs Improvement';
                }

                // Breakdown
                breakdownData = summary.healthBreakdown;

                // Radar scores from charts endpoint (or from breakdown)
                let scores = [0, 0, 0, 0];
                if (charts && charts.healthRadar && charts.healthRadar.scores) {
                    scores = charts.healthRadar.scores;
                } else if (breakdownData) {
                    scores = [
                        breakdownData.budgetControlScore || 0,
                        breakdownData.savingRateScore || 0,
                        breakdownData.goalProgressScore || 0,
                        breakdownData.expenseStabilityScore || 0
                    ];
                }

                renderRadar(scores);
                renderFactors(breakdownData, scores);

            } catch (err) {
                console.error('Error loading health data:', err);
                document.getElementById('factorsListContainer').innerHTML =
                    '<div class="text-center py-6 text-[11px] text-rose-500">Failed to load health data</div>';
            }
        }

        // ================= RENDER RADAR =================
        function renderRadar(scores) {
            const colors = getChartColors();
            const ctx = document.getElementById('healthRadarChart').getContext('2d');

            if (radarChart) radarChart.destroy();

            radarChart = new Chart(ctx, {
                type: 'radar',
                data: {
                    labels: ['Budget Control', 'Saving Rate', 'Goal Progress', 'Stability'],
                    datasets: [{
                        label: 'Score',
                        data: scores,
                        borderColor: '#8b58b8',
                        backgroundColor: 'rgba(107,58,146,0.25)',
                        pointBackgroundColor: '#8b58b8',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        r: {
                            angleLines: { color: colors.grid },
                            grid: { color: colors.grid },
                            pointLabels: { color: colors.text, font: { weight: 'bold', size: 9 } },
                            ticks: { display: false, max: 25, min: 0 }
                        }
                    }
                }
            });
        }

        // ================= RENDER FACTORS =================
        function renderFactors(breakdown, scores) {
            const container = document.getElementById('factorsListContainer');

            // Build factors from breakdown
            const factors = [
                {
                    title: 'Budget Control',
                    category: 'Budgeting',
                    desc: 'How well you stay within your monthly category limits',
                    score: scores[0] || 0,
                    maxScore: 25,
                    icon: 'fa-wallet'
                },
                {
                    title: 'Saving Rate',
                    category: 'Savings',
                    desc: 'Percentage of income successfully saved this month',
                    score: scores[1] || 0,
                    maxScore: 25,
                    icon: 'fa-piggy-bank'
                },
                {
                    title: 'Goal Progress',
                    category: 'Goals',
                    desc: 'Progress towards your active savings goals',
                    score: scores[2] || 0,
                    maxScore: 25,
                    icon: 'fa-bullseye'
                },
                {
                    title: 'Expense Stability',
                    category: 'Reliability',
                    desc: 'Consistency and predictability of your spending',
                    score: scores[3] || 0,
                    maxScore: 25,
                    icon: 'fa-chart-line'
                }
            ];

            window._factorsData = factors;
            renderFactorsList(factors);
        }

        function renderFactorsList(list) {
            const container = document.getElementById('factorsListContainer');

            if (!list.length) {
                container.innerHTML = '<div class="text-center py-6 text-[11px] opacity-45">No metrics found.</div>';
                return;
            }

            container.innerHTML = list.map(f => {
                const pct = Math.round((f.score / f.maxScore) * 100);

                let color, bgColor, badgeColor, badgeIcon;
                if (pct >= 80) {
                    color = '#10b981';
                    badgeColor = 'bg-emerald-500/10 text-emerald-500';
                    badgeIcon = 'fa-circle-check';
                } else if (pct >= 50) {
                    color = '#8b58b8';
                    badgeColor = 'bg-purple-600/10 text-purple-600';
                    badgeIcon = 'fa-circle-info';
                } else {
                    color = '#f59e0b';
                    badgeColor = 'bg-amber-500/10 text-amber-500';
                    badgeIcon = 'fa-triangle-exclamation';
                }

                return `
                    <div class="factor-item">
                        <div class="flex items-center gap-3 flex-1">
                            <div class="w-10 h-10 rounded-xl bg-purple-600/10 text-purple-600 flex items-center justify-center font-bold text-sm">
                                <i class="fa-solid ${f.icon}"></i>
                            </div>
                            <div class="flex-1">
                                <div class="text-[12px] font-bold">${f.title}</div>
                                <div class="text-[9px] opacity-45">${f.desc}</div>
                                <div class="mt-2 w-full max-w-xs">
                                    <div class="w-full h-1.5 bg-slate-300/30 dark:bg-slate-700/40 rounded-full overflow-hidden">
                                        <div style="width: ${pct}%; background: ${color};" class="h-full rounded-full transition-all duration-700"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <div class="text-right">
                                <div class="text-[13px] font-extrabold">${f.score}<span class="text-[10px] opacity-40">/${f.maxScore}</span></div>
                                <div class="text-[9px] opacity-40">${pct}%</div>
                            </div>
                            <span class="text-[10px] font-extrabold px-2.5 py-1 rounded-lg ${badgeColor}">
                                <i class="fa-solid ${badgeIcon}"></i>
                            </span>
                        </div>
                    </div>
                `;
            }).join('');
        }

        // ================= REFRESH =================
        async function refreshHealth() {
            showToast('Refreshing score...', 'info');
            await loadHealthData();
            showToast('Score updated!', 'success');
        }

        // ================= SEARCH =================
        function handleSearch(val) {
            if (!window._factorsData) return;
            const term = val.toLowerCase().trim();
            const filtered = term
                ? window._factorsData.filter(f =>
                    f.title.toLowerCase().includes(term) ||
                    f.category.toLowerCase().includes(term))
                : window._factorsData;
            renderFactorsList(filtered);
        }

        // ================= CHART COLORS =================
        function getChartColors() {
            const dark = document.documentElement.classList.contains("dark");
            return {
                text: dark ? "rgba(226,232,240,.65)" : "rgba(15,23,42,.55)",
                grid: dark ? "rgba(255,255,255,.06)" : "rgba(15,23,42,.07)"
            };
        }

        // ================= THEME =================
        function initializeTheme() {
            if (localStorage.getItem("campuscoin-theme") === "dark") {
                document.documentElement.classList.replace("light", "dark");
                document.body.classList.replace("light-mesh", "dark-mesh");
            }
            updateThemeIcon();
        }

        function toggleTheme() {
            const isDark = document.documentElement.classList.contains("dark");
            if (isDark) {
                document.documentElement.classList.replace("dark", "light");
                document.body.classList.replace("dark-mesh", "light-mesh");
                localStorage.setItem("campuscoin-theme", "light");
            } else {
                document.documentElement.classList.replace("light", "dark");
                document.body.classList.replace("light-mesh", "dark-mesh");
                localStorage.setItem("campuscoin-theme", "dark");
            }
            updateThemeIcon();

            if (radarChart) {
                const colors = getChartColors();
                radarChart.options.scales.r.angleLines.color = colors.grid;
                radarChart.options.scales.r.grid.color = colors.grid;
                radarChart.options.scales.r.pointLabels.color = colors.text;
                radarChart.update();
            }
        }

        function updateThemeIcon() {
            const isDark = document.documentElement.classList.contains("dark");
            document.getElementById("themeIcon").className = isDark ? "fa-solid fa-sun text-amber-300" : "fa-solid fa-moon";
        }

        function toggleSidebar() {
            document.getElementById("sidebar").classList.toggle("open");
            document.getElementById("mobileOverlay").classList.toggle("show");
        }

        function closeSidebar() {
            document.getElementById("sidebar").classList.remove("open");
            document.getElementById("mobileOverlay").classList.remove("show");
        }

        // ================= TOAST =================
        function showToast(message, type = 'info') {
            const container = document.getElementById("toastContainer");
            const toast = document.createElement("div");
            toast.className = "toast ios-glass";

            const iconMap = {
                success: '<i class="fa-solid fa-circle-check text-emerald-500"></i>',
                error: '<i class="fa-solid fa-circle-exclamation text-rose-500"></i>',
                info: '<i class="fa-solid fa-circle-info text-purple-600"></i>'
            };

            toast.innerHTML = `
                <div class="w-9 h-9 rounded-xl bg-purple-600/10 flex items-center justify-center">
                    ${iconMap[type] || iconMap.info}
                </div>
                <div>
                    <div class="text-[10px] font-bold">CampusCoin</div>
                    <div class="text-[9px] opacity-50">${message}</div>
                </div>`;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = "0";
                setTimeout(() => toast.remove(), 300);
            }, 2500);
        }
    </script>

<script src="/js/cc-header-widgets.js" asp-append-version="true"></script>
</body>
</html>
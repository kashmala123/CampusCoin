                <div class="kpi-sub">Income − Expense</div>
            </div>
            <div class="kpi ios-glass ios-glass-interactive">
                <div class="kpi-icon"><i class="fa-solid fa-percent"></i></div>
                <div class="kpi-label">Savings Rate</div>
                <div class="kpi-value text-indigo-500" id="kpiRate">0%</div>
                <div class="kpi-sub">Of total income</div>
            </div>
        </section>

        <!-- WEEKLY SUMMARY (SRS) -->
        <section class="ios-glass" style="border-radius:25px;padding:18px 20px;margin-bottom:15px;">
            <div class="flex items-center justify-between mb-3">
                <div>
                    <div class="text-[11px] font-extrabold opacity-50 uppercase tracking-wider">Weekly spending</div>
                    <div class="text-sm font-bold">Current range · expense by week</div>
                </div>
                <i class="fa-solid fa-calendar-week text-purple-600 opacity-70"></i>
            </div>
            <div id="weeklySummary" class="flex flex-wrap gap-2 text-[11px] opacity-70">Loading weekly summary…</div>
        </section>

        <!-- FILTERS -->
        <section class="filter-panel ios-glass">
            <div class="flex items-center gap-2 mb-4">
                <i class="fa-solid fa-filter text-purple-600"></i>
                <span class="text-[13px] font-extrabold">Filter Reports</span>
            </div>

            <div class="filter-grid">
                <div>
                    <label class="block text-[10px] opacity-60 mb-1.5 font-bold">Start Date</label>
                    <input type="date" id="startDate" class="input-field">
                </div>
                <div>
                    <label class="block text-[10px] opacity-60 mb-1.5 font-bold">End Date</label>
                    <input type="date" id="endDate" class="input-field">
                </div>
                <div>
                    <label class="block text-[10px] opacity-60 mb-1.5 font-bold">Category</label>
                    <select id="categoryFilter" class="input-field">
                        <option value="all">All Categories</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[10px] opacity-60 mb-1.5 font-bold">Type</label>
                    <select id="typeFilter" class="input-field">
                        <option value="all">All Types</option>
                        <option value="Income">Income</option>
                        <option value="Expense">Expense</option>
                    </select>
                </div>
            </div>

            <div class="flex justify-end gap-2 mt-4">
                <button class="glass-btn" onclick="resetFilters()">
                    <i class="fa-solid fa-rotate-left"></i> Reset
                </button>
                <button class="glass-btn primary-btn" onclick="applyFilters()">
                    <i class="fa-solid fa-magnifying-glass"></i> Apply Filters
                </button>
            </div>
        </section>

        <!-- CHARTS -->
        <section class="chart-grid">
            <div class="chart-card ios-glass ios-glass-interactive">
                <div>
                    <div class="chart-title">6-Month Income vs Expense Trend</div>
                    <div class="chart-sub">Last six months comparison</div>
                </div>
                <div class="chart-container">
                    <canvas id="incomeVsExpenseChart"></canvas>
                </div>
            </div>

            <div class="chart-card ios-glass ios-glass-interactive">
                <div>
                    <div class="chart-title">Category-Wise Breakdown</div>
                    <div class="chart-sub">Expense distribution</div>
                </div>
                <div class="chart-container">
                    <canvas id="categoryPieChart"></canvas>
                </div>
            </div>
        </section>

        <!-- TRANSACTIONS TABLE -->
        <section class="panel ios-glass ios-glass-interactive">
            <div class="flex justify-between items-center flex-wrap gap-3">
                <div>
                    <div class="chart-title">Detailed Transactions Report</div>
                    <div class="chart-sub" id="tableSubtitle">All transactions in selected range</div>
                </div>
                <span class="badge bg-purple-600/15 text-purple-600" id="tableBadge">0 records</span>
            </div>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Category</th>
                            <th>Description</th>
                            <th>Type</th>
                            <th class="text-right">Amount</th>
                        </tr>
                    </thead>
                    <tbody id="reportTableBody">
                        <tr><td colspan="5" class="text-center py-8 opacity-40">Loading transactions...</td></tr>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <div id="toastContainer"></div>

    <script>
        let allTransactions = [];
        let filteredTransactions = [];
        let allCategories = [];
        let incomeChart = null;
        let pieChart = null;

        document.addEventListener("DOMContentLoaded", async function () {
            initializeTheme();
            setDate();
            setDefaultDateRange();
            await Promise.all([loadUserInfo(), loadCategories(), loadTransactions()]);
        });

        function setDate() {
            document.getElementById("currentDate").textContent = new Date().toLocaleDateString("en-US", {
                weekday: "short", month: "long", day: "numeric", year: "numeric"
            });
        }

        function setDefaultDateRange() {
            const now = new Date();
            const firstDay = new Date(now.getFullYear(), now.getMonth() - 5, 1);
            const lastDay = new Date(now.getFullYear(), now.getMonth() + 1, 0);

            document.getElementById('startDate').value = firstDay.toISOString().split('T')[0];
            document.getElementById('endDate').value = lastDay.toISOString().split('T')[0];
        }

        // ================= USER INFO =================
        async function loadUserInfo() {
            try {
                const res = await fetch('/api/dashboard/summary');
                if (!res.ok) return;
                const data = await res.json();
                if (data.userName) {
                    const initials = data.userName.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);
                    document.getElementById('sidebarAvatar').textContent = initials;
                    document.getElementById('sidebarStudentName').textContent = data.userName;
                    var topName = document.getElementById('topStudentName');
                    if (topName) topName.textContent = data.userName;
                    var topAv = document.getElementById('topAvatar');
                    if (topAv) topAv.textContent = data.userName.split(' ').map(function(n){return n[0];}).join('').toUpperCase().slice(0,2);
                }
                if (data.userAcademicYear) document.getElementById('sidebarStudentRole').textContent = data.userAcademicYear;
            } catch (err) { console.error(err); }
        }

        // ================= LOAD CATEGORIES =================
        async function loadCategories() {
            try {
                const res = await fetch('/api/categories');
                if (!res.ok) return;
                allCategories = await res.json();

                const sel = document.getElementById('categoryFilter');
                sel.innerHTML = '<option value="all">All Categories</option>' +
                    allCategories.map(c => `<option value="${c.name}">${c.name}</option>`).join('');
            } catch (err) { console.error(err); }
        }

        // ================= LOAD TRANSACTIONS =================
        async function loadTransactions() {
            try {
                const res = await fetch('/api/transactions');
                if (!res.ok) throw new Error('Failed to load transactions');
                allTransactions = await res.json();
                filteredTransactions = [...allTransactions];

                renderTable();
                updateKPIs();
                renderCharts();
                loadWeeklySummary();
            } catch (err) {
                console.error('Error loading transactions:', err);
                document.getElementById('reportTableBody').innerHTML =
                    '<tr><td colspan="5" class="text-center py-8 text-rose-500">Failed to load transactions</td></tr>';
            }
        }

        // ================= APPLY FILTERS =================
        function applyFilters() {
            try { loadWeeklySummary(); } catch(_){}
            // original continues
            _applyFiltersInner(); 
        }
        function _applyFiltersInner() {
            const start = document.getElementById('startDate').value;
            const end = document.getElementById('endDate').value;
            const category = document.getElementById('categoryFilter').value;
            const type = document.getElementById('typeFilter').value;

            filteredTransactions = allTransactions.filter(t => {
                const txDate = new Date(t.date);
                const startDate = start ? new Date(start) : null;
                const endDate = end ? new Date(end) : null;

                const matchStart = !startDate || txDate >= startDate;
                const matchEnd = !endDate || txDate <= endDate;
                const matchCategory = category === 'all' || t.category === category;
                const matchType = type === 'all' || t.type === type;

                return matchStart && matchEnd && matchCategory && matchType;
            });

            renderTable();
            updateKPIs();
            renderCharts();
            showToast(`Filtered ${filteredTransactions.length} transactions`, 'success');
        }

        function resetFilters() {
            setDefaultDateRange();
            document.getElementById('categoryFilter').value = 'all';
            document.getElementById('typeFilter').value = 'all';
            applyFilters();
        }

        // ================= RENDER TABLE =================
        function renderTable() {
            const tbody = document.getElementById('reportTableBody');
            const list = filteredTransactions.slice(0, 50);

            document.getElementById('tableBadge').textContent = `${filteredTransactions.length} records`;

            if (!list.length) {
                tbody.innerHTML = '<tr><td colspan="5" class="text-center py-8 opacity-40">No transactions found</td></tr>';
                return;
            }

            tbody.innerHTML = list.map(t => {
                const isIncome = t.type === 'Income';
                const amountClass = isIncome ? 'text-emerald-500' : 'text-rose-500';
                const amountSign = isIncome ? '+' : '-';

                return `
                    <tr class="hover:bg-slate-500/5 transition-colors">
                        <td class="opacity-70">${t.date}</td>
                        <td>
                            <span class="badge bg-purple-600/10 text-purple-700 dark:text-purple-400">${t.category}</span>
                        </td>
                        <td class="font-semibold">${t.title}</td>
                        <td>
                            <span class="badge ${isIncome ? 'bg-emerald-500/10 text-emerald-500' : 'bg-rose-500/10 text-rose-500'}">
                                ${t.type}
                            </span>
                        </td>
                        <td class="text-right font-bold ${amountClass}">${amountSign} Rs. ${t.amount.toFixed(2)}</td>
                    </tr>
                `;
            }).join('');
        }

        // ================= UPDATE KPIs =================
        function updateKPIs() {
            const income = filteredTransactions.filter(t => t.type === 'Income').reduce((s, t) => s + t.amount, 0);
            const expense = filteredTransactions.filter(t => t.type === 'Expense').reduce((s, t) => s + t.amount, 0);
            const savings = income - expense;
            const rate = income > 0 ? (savings / income) * 100 : 0;

            document.getElementById('kpiIncome').textContent = `Rs. ${income.toLocaleString('en-PK', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}`;
            document.getElementById('kpiExpense').textContent = `Rs. ${expense.toLocaleString('en-PK', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}`;
            document.getElementById('kpiSavings').textContent = `Rs. ${savings.toLocaleString('en-PK', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}`;
            document.getElementById('kpiRate').textContent = `${rate.toFixed(1)}%`;
        }

        // ================= CHARTS =================
        async function renderCharts() {
            const colors = getChartColors();

            // 6-month chart
            try {
                const res = await fetch('/api/dashboard/charts');
                if (res.ok) {
                    const data = await res.json();

                    const ctx1 = document.getElementById('incomeVsExpenseChart').getContext('2d');
                    if (incomeChart) incomeChart.destroy();

                    incomeChart = new Chart(ctx1, {
                        type: 'bar',
                        data: {
                            labels: data.sixMonthComparison?.labels || [],
                            datasets: [
                                {
                                    label: 'Income (Rs.)',
                                    data: data.sixMonthComparison?.incomeData || [],
                                    backgroundColor: 'rgba(16,185,129,0.75)',
                                    borderRadius: 8
                                },
                                {
                                    label: 'Expense (Rs.)',
                                    data: data.sixMonthComparison?.expenseData || [],
                                    backgroundColor: 'rgba(244,63,94,0.75)',
                                    borderRadius: 8
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { labels: { color: colors.text, font: { size: 10 } } }
                            },
                            scales: {
                                x: { grid: { display: false }, ticks: { color: colors.text, font: { size: 9 } } },
                                y: { grid: { color: colors.grid }, ticks: { color: colors.text, font: { size: 9 } } }
                            }
                        }
                    });

                    // Category pie
                    const ctx2 = document.getElementById('categoryPieChart').getContext('2d');
                    if (pieChart) pieChart.destroy();

                    pieChart = new Chart(ctx2, {
                        type: 'doughnut',
                        data: {
                            labels: data.spendingDonut?.labels || [],
                            datasets: [{
                                data: data.spendingDonut?.data || [],
                                backgroundColor: data.spendingDonut?.colors || ['#a486e0', '#8b58b8', '#6366f1', '#818cf8', '#a78bfa', '#f472b6'],
                                borderWidth: 0
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            cutout: '68%',
                            plugins: {
                                legend: {
                                    position: 'bottom',
                                    labels: { color: colors.text, font: { size: 9 }, boxWidth: 10 }
                                }
                            }
                        }
                    });
                }
            } catch (err) { console.error(err); }
        }

        function getChartColors() {
            const dark = document.documentElement.classList.contains("dark");
            return {
                text: dark ? "rgba(226,232,240,.65)" : "rgba(15,23,42,.55)",
                grid: dark ? "rgba(255,255,255,.06)" : "rgba(15,23,42,.07)"
            };
        }

        // ================= EXPORT =================
        function openPrintableReport() {
            const start = document.getElementById('startDate')?.value || '';
            const end = document.getElementById('endDate')?.value || '';
            let url = '/api/reports/printable?';
            if (start && end) url += `startDate=${encodeURIComponent(start)}&endDate=${encodeURIComponent(end)}`;
            else {
                const month = document.getElementById('monthSelect')?.value;
                if (month) url += `month=${encodeURIComponent(month)}`;
            }
            window.open(url, '_blank');
            showToast('Printable report opened — use Print → Save as PDF', 'success');
        }

        
        async function loadWeeklySummary() {
            const box = document.getElementById('weeklySummary');
            if (!box) return;
            try {
                const start = document.getElementById('startDate')?.value;
                const end = document.getElementById('endDate')?.value;
                let url = '/api/reports/monthly?';
                if (start && end) url += `startDate=${encodeURIComponent(start)}&endDate=${encodeURIComponent(end)}`;
                const res = await fetch(url, { credentials: 'same-origin' });
                if (!res.ok) { box.textContent = 'Weekly data unavailable'; return; }
                const data = await res.json();
                const weeks = data.weeklyBreakdown || [];
                if (!weeks.length) { box.textContent = 'No expense data for weekly breakdown yet.'; return; }
                box.innerHTML = weeks.map(w =>
                    `<span class="px-3 py-1.5 rounded-xl bg-purple-600/10 border border-purple-500/20 font-semibold">
                        Week of ${w.weekStarting || w.WeekStarting}: <b>Rs. ${Number(w.total || w.Total || 0).toLocaleString()}</b>
                        <span class="opacity-50">(${w.count || w.Count || 0} txns)</span>
                    </span>`
                ).join('');
            } catch (e) {
                console.warn(e);
                box.textContent = 'Could not load weekly summary';
            }
        }

        async function exportReport(format) {
            try {
                showToast(`Preparing ${format} export...`, 'info');
                await fetch('/api/reports/export', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        format: format,
                        rangeStart: document.getElementById('startDate')?.value,
                        rangeEnd: document.getElementById('endDate')?.value
                    })
                }).catch(() => {});

                const area = document.getElementById('reportContent') || document.querySelector('main') || document.body;
                if (format === 'PDF') {
                    if (window.html2canvas && window.jspdf) {
                        const canvas = await html2canvas(area, { scale: 2, useCORS: true, backgroundColor: document.documentElement.classList.contains('dark') ? '#0f172a' : '#ffffff' });
                        const img = canvas.toDataURL('image/png');
                        const { jsPDF } = window.jspdf;
                        const pdf = new jsPDF({ orientation: 'portrait', unit: 'pt', format: 'a4' });
                        const pageW = pdf.internal.pageSize.getWidth();
                        const pageH = pdf.internal.pageSize.getHeight();
                        const margin = 20;
                        const usableW = pageW - margin * 2;
                        const usableH = pageH - margin * 2;
                        const ratio = usableW / canvas.width;
                        const imgH = canvas.height * ratio;
                        let heightLeft = imgH;
                        let position = margin;
                        pdf.addImage(img, 'PNG', margin, position, usableW, imgH);
                        heightLeft -= usableH;
                        while (heightLeft > 0) {
                            position = margin - (imgH - heightLeft);
                            pdf.addPage();
                            pdf.addImage(img, 'PNG', margin, position, usableW, imgH);
                            heightLeft -= usableH;
                        }
                        pdf.save(`campuscoin-report-${new Date().toISOString().slice(0,10)}.pdf`);
                        showToast('PDF downloaded!', 'success');
                    } else {
                        openPrintableReport();
                    }
                } else if (format === 'Image' || format === 'PNG') {
                    if (window.html2canvas) {
                        const canvas = await html2canvas(area, { scale: 2, useCORS: true, backgroundColor: null });
                        const link = document.createElement('a');
                        link.download = `campuscoin-report-${new Date().toISOString().slice(0,10)}.png`;
                        link.href = canvas.toDataURL('image/png');
                        link.click();
                        showToast('Image downloaded!', 'success');
                    } else {
                        const chart = document.getElementById('incomeVsExpenseChart');
                        if (chart) {
                            const link = document.createElement('a');
                            link.download = `campuscoin-report-${new Date().toISOString().slice(0,10)}.png`;
                            link.href = chart.toDataURL('image/png');
                            link.click();
                            showToast('Chart image downloaded!', 'success');
                        }
                    }
                }
            } catch (err) {
                console.error(err);
                showToast('Error exporting report', 'error');
            }
        }

        // ================= THEME =================
        function initializeTheme() {
            if (localStorage.getItem("campuscoin-theme") === "dark") {
                document.documentElement.classList.replace("light", "dark");
                document.body.classList.replace("light-mesh", "dark-mesh");
            }
            updateThemeIcon();
        }

        function toggleTheme() {
            const isDark = document.documentElement.classList.contains("dark");
            if (isDark) {
                document.documentElement.classList.replace("dark", "light");
                document.body.classList.replace("dark-mesh", "light-mesh");
                localStorage.setItem("campuscoin-theme", "light");
            } else {
                document.documentElement.classList.replace("light", "dark");
                document.body.classList.replace("light-mesh", "dark-mesh");
                localStorage.setItem("campuscoin-theme", "dark");
            }
            updateThemeIcon();

            [incomeChart, pieChart].forEach(c => {
                if (c) {
                    const colors = getChartColors();
                    if (c.options.plugins.legend.labels) c.options.plugins.legend.labels.color = colors.text;
                    if (c.options.scales?.x) c.options.scales.x.ticks.color = colors.text;
                    if (c.options.scales?.y) {
                        c.options.scales.y.ticks.color = colors.text;
                        c.options.scales.y.grid.color = colors.grid;
                    }
                    c.update();
                }
            });
        }

        function updateThemeIcon() {
            const isDark = document.documentElement.classList.contains("dark");
            document.getElementById("themeIcon").className = isDark ? "fa-solid fa-sun text-amber-300" : "fa-solid fa-moon";
        }

        function toggleSidebar() {
            document.getElementById("sidebar").classList.toggle("open");
            document.getElementById("mobileOverlay").classList.toggle("show");
        }

        function closeSidebar() {
            document.getElementById("sidebar").classList.remove("open");
            document.getElementById("mobileOverlay").classList.remove("show");
        }

        // ================= TOAST =================
        function showToast(message, type = 'info') {
            const container = document.getElementById("toastContainer");
            const toast = document.createElement("div");
            toast.className = "toast ios-glass";

            const iconMap = {
                success: '<i class="fa-solid fa-circle-check text-emerald-500"></i>',
                error: '<i class="fa-solid fa-circle-exclamation text-rose-500"></i>',
                info: '<i class="fa-solid fa-circle-info text-purple-600"></i>'
            };

            toast.innerHTML = `
                <div class="w-9 h-9 rounded-xl bg-purple-600/10 flex items-center justify-center">
                    ${iconMap[type] || iconMap.info}
                </div>
                <div>
                    <div class="text-[10px] font-bold">CampusCoin</div>
                    <div class="text-[9px] opacity-50">${message}</div>
                </div>`;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = "0";
                setTimeout(() => toast.remove(), 300);
            }, 2500);
        }
    </script>

<script src="/js/cc-header-widgets.js" asp-append-version="true"></script>
</body>
</html>
                                <i class="ri-mail-line"></i>
                                <input type="text" inputmode="email" id="nl-email" name="email" placeholder="you@@university.edu" aria-label="Email" autocomplete="email" spellcheck="false">
                                <button type="submit" id="nl-submit">Subscribe <i class="ri-arrow-right-line"></i></button>
                            </div>

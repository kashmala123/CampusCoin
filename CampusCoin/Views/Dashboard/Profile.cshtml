@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="light">

<head>
    <link rel="stylesheet" href="/css/student-theme.css" />
    <link rel="stylesheet" href="/css/cc-animations.css" />

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CampusCoin — Settings & Profile</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <link rel="apple-touch-icon" href="/favicon.svg?v=4" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50:'#f6effc', 100:'#ede4f6', 400:'#a486e0',
                            500:'#8b58b8', 600:'#6b3a92',
                        }
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans','-apple-system', 'BlinkMacSystemFont', 'Inter', 'Segoe UI', 'Roboto', 'sans-serif']
                    }
                }
            }
        };
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        * {
            transition: background-color 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease, color 0.3s ease;
        }

        html {
            scroll-behavior: smooth;
        }

        body.light-mesh {
            background-color: #fbf6f0;
            background-image: radial-gradient(at 0% 0%, rgba(237, 228, 246, 0.9) 0px, transparent 50%), radial-gradient(at 100% 0%, rgba(196, 174, 224, 0.85) 0px, transparent 50%), radial-gradient(at 100% 100%, rgba(255, 225, 230, 0.85) 0px, transparent 50%), radial-gradient(at 0% 100%, rgba(246, 239, 252, 0.9) 0px, transparent 50%), radial-gradient(at 50% 50%, rgba(212, 243, 228, 0.4) 0px, transparent 50%);
            background-attachment: fixed;
        }

        body.dark-mesh {
            background-color: #100a1a;
            background-image: radial-gradient(at 10% 10%, rgba(99, 102, 241, 0.28) 0px, transparent 50%), radial-gradient(at 90% 10%, rgba(168, 85, 247, 0.22) 0px, transparent 50%), radial-gradient(at 90% 90%, rgba(107, 58, 146, 0.28) 0px, transparent 50%), radial-gradient(at 10% 90%, rgba(236, 72, 153, 0.2) 0px, transparent 50%);
            background-attachment: fixed;
        }

        .orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(80px);
            z-index: -1;
            pointer-events: none;
            animation: floatOrb 18s infinite alternate ease-in-out;
        }

        .orb-1 {
            width: 450px;
            height: 450px;
            background: rgba(192, 132, 252, 0.4);
            top: -100px;
            left: -100px;
        }

        .orb-2 {
            width: 480px;
            height: 480px;
            background: rgba(139, 88, 184, 0.45);
            top: 30%;
            right: -120px;
            animation-delay: -5s;
        }

        .orb-3 {
            width: 400px;
            height: 400px;
            background: rgba(251, 113, 133, 0.35);
            bottom: -100px;
            left: 20%;
            animation-delay: -10s;
        }

        @@keyframes floatOrb {
            0% {
                transform: translate(0px, 0px) scale(1);
            }

            50% {
                transform: translate(40px, 60px) scale(1.08);
            }

            100% {
                transform: translate(-30px, 30px) scale(0.95);
            }
        }

        .ios-glass {
            backdrop-filter: blur(32px) saturate(240%);
            -webkit-backdrop-filter: blur(32px) saturate(240%);
            position: relative;
            overflow: hidden;
        }

        .light .ios-glass {
            background: rgba(255, 255, 255, 0.72);
            border: 1.5px solid rgba(255, 255, 255, 0.95);
            box-shadow: 0 20px 40px -12px rgba(107, 58, 146, 0.12), 0 4px 16px -2px rgba(0, 0, 0, 0.04), inset 0 1.5px 2px 0 rgba(255, 255, 255, 1);
            color: #0f172a;
        }

        .dark .ios-glass {
            background: rgba(18, 24, 38, 0.58);
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.45), inset 0 1px 0 0 rgba(255, 255, 255, 0.18);
            color: #f8fafc;
        }

        .sidebar {
            position: fixed;
            top: 20px;
            left: 20px;
            bottom: 20px;
            width: 260px;
            z-index: 100;
            border-radius: 30px;
            padding: 18px;
            display: flex;
            flex-direction: column;
            transition: transform .35s ease;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 4px 6px 22px;
        }

        .brand-logo {
            width: 46px;
            height: 46px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
            background: linear-gradient(135deg, #a486e0, #8b58b8, #6366f1);
            box-shadow: 0 12px 25px rgba(107, 58, 146, .28);
        }

        .brand-name {
            font-size: 18px;
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        .brand-sub {
            font-size: 9px;
            font-weight: 800;
            letter-spacing: .16em;
            opacity: .45;
            margin-top: 3px;
        }

        .nav-section {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: .15em;
            font-weight: 800;
            opacity: .4;
            padding: 14px 10px 7px;
        }

        .nav {
            flex: 1;
            overflow-y: auto;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 12px;
            margin: 4px 0;
            border-radius: 15px;
            text-decoration: none;
            color: inherit;
            font-size: 12px;
            font-weight: 650;
            transition: all .25s ease;
        }

            .nav-link i {
                width: 20px;
                text-align: center;
                opacity: .55;
            }

            .nav-link:hover {
                background: rgba(255,255,255,.30);
                transform: translateX(3px);
            }

        .dark .nav-link:hover {
            background: rgba(255,255,255,.06);
        }

        .nav-link.active {
            color: #6b3a92;
            background: linear-gradient(135deg, rgba(139,88,184,.18), rgba(99,102,241,.14));
            box-shadow: inset 0 0 0 1px rgba(139,88,184,.15), 0 10px 25px rgba(107,58,146,.08);
        }

        .dark .nav-link.active {
            color: #c4aee0;
            background: rgba(139,88,184,.10);
        }

        .student-mini {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 11px;
            border-radius: 18px;
            background: rgba(255,255,255,.30);
            border: 1px solid rgba(255,255,255,.35);
        }

        .dark .student-mini {
            background: rgba(255,255,255,.04);
            border-color: rgba(255,255,255,.08);
        }

        .student-avatar {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 11px;
            font-weight: 800;
            background: linear-gradient(135deg, #8b58b8, #6366f1);
        }

        .main {
            margin-left: 300px;
            padding: 20px 25px 40px 0;
            min-height: 100vh;
        }

        .topbar {
            overflow: visible !important;
            height: 70px;
            border-radius: 25px;
            padding: 10px 13px;
            display: flex;
            align-items: center;
            gap: 12px;
            position: sticky;
            top: 20px;
            z-index: 10000;
        }

        .search {
            flex: 1;
            max-width: 500px;
            position: relative;
        }

            .search i {
                position: absolute;
                left: 16px;
                top: 50%;
                transform: translateY(-50%);
                opacity: .4;
                font-size: 12px;
            }

            .search input {
                width: 100%;
                border: none;
                outline: none;
                padding: 11px 15px 11px 42px;
                border-radius: 16px;
                background: rgba(255,255,255,.38);
                color: inherit;
                font-size: 12px;
                border: 1px solid rgba(255,255,255,.50);
            }

        .dark .search input {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-left: auto;
        }

        .action-btn {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            border: 1px solid rgba(255,255,255,.55);
            background: rgba(255,255,255,.36);
            color: inherit;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .dark .action-btn {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .page-header {
            display: flex;
            align-items: end;
            justify-content: space-between;
            gap: 20px;
            margin: 28px 3px 20px;
        }

        .eyebrow {
            color: #6b3a92;
            font-size: 9px;
            font-weight: 850;
            text-transform: uppercase;
            letter-spacing: .18em;
            margin-bottom: 8px;
        }

        .page-title {
            font-size: clamp(28px, 3vw, 40px);
            font-weight: 900;
            letter-spacing: -1.8px;
            line-height: 1;
        }

        .page-description {
            font-size: 12px;
            opacity: .48;
            margin-top: 8px;
        }

        .date-pill {
            padding: 10px 14px;
            border-radius: 15px;
            font-size: 10px;
            font-weight: 700;
            white-space: nowrap;
        }

        .settings-grid {
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: 20px;
        }

        .settings-nav-card {
            border-radius: 25px;
            padding: 18px;
            height: fit-content;
        }

        .settings-content-card {
            border-radius: 28px;
            padding: 30px;
        }

        .settings-tab {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 15px;
            border-radius: 14px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            margin-bottom: 6px;
            color: inherit;
            border: 1px solid transparent;
        }

            .settings-tab:hover {
                background: rgba(255,255,255,0.3);
            }

        .dark .settings-tab:hover {
            background: rgba(255,255,255,0.05);
        }

        .settings-tab.active {
            background: linear-gradient(135deg, rgba(139,88,184,0.2), rgba(99,102,241,0.15));
            border-color: rgba(139,88,184,0.3);
            color: #6b3a92;
        }

        .dark .settings-tab.active {
            color: #c4aee0;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            font-size: 11px;
            font-weight: 750;
            opacity: 0.7;
            margin-bottom: 6px;
        }

        .form-input {
            width: 100%;
            padding: 12px 16px;
            border-radius: 14px;
            border: 1px solid rgba(255,255,255,0.6);
            background: rgba(255,255,255,0.4);
            outline: none;
            color: inherit;
            font-size: 12px;
        }

        .dark .form-input {
            background: rgba(255,255,255,0.05);
            border-color: rgba(255,255,255,0.08);
        }

        .form-input:focus {
            border-color: #a486e0;
            box-shadow: 0 0 0 3px rgba(139,88,184,0.15);
        }

        .glass-btn {
            border: 1px solid rgba(255,255,255,.55);
            background: rgba(255,255,255,.38);
            color: inherit;
            border-radius: 13px;
            padding: 10px 18px;
            font-size: 11px;
            font-weight: 750;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .dark .glass-btn {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .glass-btn:hover {
            transform: translateY(-2px);
            background: rgba(255,255,255,.65);
        }

        .primary-btn {
            color: white;
            border: none;
            background: linear-gradient(135deg, #a486e0, #8b58b8, #6366f1);
            box-shadow: 0 10px 22px rgba(107,58,146,.20);
        }

            .primary-btn:hover {
                opacity: 0.95;
            }

        .panel-section {
            display: none;
        }

            .panel-section.active {
                display: block;
                animation: fadeIn .3s ease;
            }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(6px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .toggle-switch {
            position: relative;
            display: inline-block;
            width: 44px;
            height: 24px;
        }

            .toggle-switch input {
                opacity: 0;
                width: 0;
                height: 0;
            }

        .slider {
            position: absolute;
            cursor: pointer;
            inset: 0;
            background-color: rgba(0,0,0,0.15);
            transition: .3s;
            border-radius: 24px;
        }

        .dark .slider {
            background-color: rgba(255,255,255,0.15);
        }

        .slider:before {
            position: absolute;
            content: "";
            height: 18px;
            width: 18px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: .3s;
            border-radius: 50%;
        }

        input:checked + .slider {
            background-color: #8b58b8;
        }

            input:checked + .slider:before {
                transform: translateX(20px);
            }

        .mobile-btn {
            display: none;
        }

        .mobile-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15,23,42,.25);
            backdrop-filter: blur(5px);
            z-index: 90;
        }

            .mobile-overlay.show {
                display: block;
            }

        @@media(max-width:950px) {
            .sidebar {
                transform: translateX(-120%);
            }

                .sidebar.open {
                    transform: translateX(0);
                }

            .main {
                margin-left: 0;
                padding: 15px;
            }

            .mobile-btn {
                display: flex;
            }

            .settings-grid {
                grid-template-columns: 1fr;
            }
        }

        #toastContainer {
            position: fixed;
            right: 20px;
            bottom: 20px;
            z-index: 999;
            display: flex;
            flex-direction: column;
            gap: 9px;
        }

        .toast {
            min-width: 270px;
            padding: 13px;
            border-radius: 17px;
            display: flex;
            align-items: center;
            gap: 10px;
            animation: toastIn .3s ease;
        }

        @@keyframes toastIn {
            from {
                opacity: 0;
                transform: translateY(15px) scale(.96);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .toast.hide {
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        /* ================= FONT SIZE ================= */
        html.font-small body {
            zoom: 0.85;
        }

        html.font-medium body {
            zoom: 1;
        }

        html.font-large body {
            zoom: 1.15;
        }
    </style>
    <link rel="stylesheet" href="/css/cc-header-widgets.css" asp-append-version="true" />
</head>

<body class="light-mesh min-h-screen text-slate-900 dark:text-slate-100 font-sans">

<style id="cc-breadcrumb-style">
.cc-breadcrumb{display:flex;flex-wrap:wrap;align-items:center;gap:6px;font-size:11px;font-weight:700;opacity:.7;margin-bottom:8px;}
.cc-breadcrumb a{color:inherit;text-decoration:none;opacity:.85;}
.cc-breadcrumb a:hover{opacity:1;text-decoration:underline;}
.cc-breadcrumb .sep{opacity:.4;}
.cc-loading-overlay{position:fixed;inset:0;background:rgba(15,23,42,.35);backdrop-filter:blur(4px);z-index:99998;display:none;align-items:center;justify-content:center;}
.cc-loading-overlay.show{display:flex;}
.cc-loading-box{padding:18px 22px;border-radius:16px;background:rgba(15,23,42,.92);color:#e2e8f0;font-size:13px;font-weight:700;display:flex;align-items:center;gap:10px;box-shadow:0 12px 40px rgba(0,0,0,.3);}
</style>
<div id="ccLoadingOverlay" class="cc-loading-overlay"><div class="cc-loading-box"><i class="fa-solid fa-spinner fa-spin"></i> Loading…</div></div>
<script>
window.ccShowLoading=function(on){var el=document.getElementById('ccLoadingOverlay');if(el)el.classList.toggle('show',!!on);};
</script>


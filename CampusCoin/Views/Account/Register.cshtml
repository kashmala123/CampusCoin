</div>

@section Scripts {
    <style>
        .lg-field-error {
            display: none;
            margin-top: 6px;
            padding: 8px 12px;
            border-radius: 10px;
            background: rgba(239, 68, 68, 0.08);
            border: 1px solid rgba(239, 68, 68, 0.22);
            color: #b91c1c;
            font-size: 12.5px;
            font-weight: 600;
            line-height: 1.35;
            animation: lgErrIn .22s ease;
        }
        .lg-field-error.show { display: block; }
        .lg-input.invalid,
        .lg-select.invalid .lg-select-btn {
            border-color: rgba(239, 68, 68, 0.55) !important;
            box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.12) !important;
        }
        .lg-input.invalid i.ico,
        .lg-select.invalid .lg-select-btn i.ico { color: #ef4444 !important; }
        @@keyframes lgErrIn {
            from { opacity: 0; transform: translateY(-4px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        #errorAlert {
            display: none;
            margin-bottom: 16px;
            padding: 12px 16px;
            border-radius: 12px;
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.28);
            color: #b91c1c;
            font-size: 13px;
            font-weight: 600;
        }
        #errorAlert.show { display: block; }
    </style>
    <script>
        function showFieldError(targetId, message) {
            var el = document.getElementById(targetId);
            var field = null;
            if (el) {
                var wrap = el.closest('.lg-input');
                if (wrap) wrap.classList.add('invalid');
                field = el.closest('.lg-field');
            }
            // for select use data-select container
            if (targetId === 'year') {
                var sel = document.querySelector('[data-select]');
                if (sel) {
                    sel.classList.add('invalid');
                    field = sel.closest('.lg-field');
                }
            }
            if (!field) return;
            var err = document.getElementById(targetId + 'Error');
            if (!err) {
                err = document.createElement('div');
                err.id = targetId + 'Error';
                err.className = 'lg-field-error';
                field.appendChild(err);
            }
            err.textContent = message;
            err.classList.add('show');
        }

        function clearFieldError(targetId) {
            var el = document.getElementById(targetId);
            if (el) {
                var wrap = el.closest('.lg-input');
                if (wrap) wrap.classList.remove('invalid');
            }
            if (targetId === 'year') {
                var sel = document.querySelector('[data-select]');
                if (sel) sel.classList.remove('invalid');
            }
            var err = document.getElementById(targetId + 'Error');
            if (err) { err.classList.remove('show'); err.textContent = ''; }
        }

        function clearAllRegisterErrors() {
            ['name', 'email', 'password', 'year', 'allowance'].forEach(clearFieldError);
            var box = document.getElementById('errorAlert');
            if (box) { box.classList.remove('show'); box.style.display = 'none'; }
        }

        function isValidName(name) {
            // letters and spaces only (unicode letters allowed)
            return /^[\p{L}\s]+$/u.test(name) && name.trim().length >= 2;
        }

        function validateRegister() {
            clearAllRegisterErrors();
            var ok = true;
            var fullName = (document.getElementById('name')?.value || '').trim();
            var email = (document.getElementById('email')?.value || '').trim();
            var password = document.getElementById('password')?.value || '';
            var yearInput = document.querySelector('input[name="year"]');
            var year = yearInput ? (yearInput.value || '').trim() : '';
            var allowanceEl = document.getElementById('allowance');
            var allowance = allowanceEl ? allowanceEl.value : '';

            if (!fullName) {
                showFieldError('name', 'Full name is required.');
                ok = false;
            } else if (!isValidName(fullName)) {
                showFieldError('name', 'Name can only contain letters and spaces (no numbers or symbols).');
                ok = false;
            }

            if (!email) {
                showFieldError('email', 'Email is required.');
                ok = false;
            } else if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email)) {
                showFieldError('email', 'Please enter a valid email address.');
                ok = false;
            }

            if (!year) {
                showFieldError('year', 'Please select your academic year.');
                ok = false;
            }

            if (allowance !== '' && (isNaN(Number(allowance)) || Number(allowance) < 0)) {
                showFieldError('allowance', 'Allowance must be a valid positive number.');
                ok = false;
            }

            if (!password) {
                showFieldError('password', 'Password is required.');
                ok = false;
            } else if (password.length < 6) {
                showFieldError('password', 'Password must be at least 6 characters.');
                ok = false;
            }

            return ok;
        }

        async function handleRegister(e) {
            e.preventDefault();
            if (!validateRegister()) return false;

            var fullName = document.getElementById('name').value.trim();
            var email = document.getElementById('email').value.trim();
            var yearInput = document.querySelector('input[name="year"]');
            var academicYear = yearInput ? (yearInput.value || '1st Year') : '1st Year';
            var allowance = parseFloat(document.getElementById('allowance')?.value) || 1000;
            var password = document.getElementById('password').value;
            var btn = document.querySelector('.lg-cta') || document.querySelector('button[type="submit"]');
            var alertBox = document.getElementById('errorAlert');
            if (!alertBox) {
                alertBox = document.createElement('div');
                alertBox.id = 'errorAlert';
                var form = document.getElementById('registerForm');
                if (form) form.parentNode.insertBefore(alertBox, form);
            }

            var originalHtml = btn ? btn.innerHTML : '';
            if (btn) { btn.innerHTML = '<span>Creating Account...</span>'; btn.disabled = true; }
            alertBox.classList.remove('show');
            alertBox.style.display = 'none';

            try {
                var res = await fetch('/Auth/Register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        fullName: fullName,
                        email: email,
                        password: password,
                        academicYear: academicYear,
                        monthlyAllowanceBaseline: allowance,
                        monthlySavingsGoal: 200
                    })
                });
                var raw = await res.text();
                var data = {};
                try { data = JSON.parse(raw); } catch (_) {}

                if (res.ok && data.success) {
                    // Always send new users to login (do not auto-enter dashboard)
                    var target = data.redirectUrl || '/Account/Login';
                    if (data.message) {
                        try { sessionStorage.setItem('cc_flash', data.message); } catch (_) {}
                    }
                    window.location.href = target.indexOf('Login') >= 0 ? target : '/Account/Login';
                    return false;
                } else {
                    alertBox.textContent = data.message || ('Registration failed (HTTP ' + res.status + ')');
                    alertBox.classList.add('show');
                    alertBox.style.display = 'block';
                    if (btn) { btn.innerHTML = originalHtml; btn.disabled = false; }
                }
            } catch (err) {
                alertBox.textContent = 'Network or server error during registration.';
                alertBox.classList.add('show');
                alertBox.style.display = 'block';
                if (btn) { btn.innerHTML = originalHtml; btn.disabled = false; }
            }
            return false;
        }

        // Custom dropdown
        function initSelects() {
            document.querySelectorAll('[data-select]').forEach(function (root) {
                var btn = root.querySelector('.lg-select-btn');
                var menu = root.querySelector('.lg-select-menu');
                var valueEl = root.querySelector('.lg-select-value');
                var hidden = root.querySelector('input[type="hidden"]');
                if (!btn || !menu) return;

                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    // close others
                    document.querySelectorAll('[data-select].open').forEach(function (other) {
                        if (other !== root) other.classList.remove('open');
                    });
                    root.classList.toggle('open');
                });

                btn.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        btn.click();
                    }
                });

                menu.querySelectorAll('li[data-value]').forEach(function (li) {
                    li.addEventListener('click', function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        var val = li.getAttribute('data-value') || '';
                        if (hidden) hidden.value = val;
                        if (valueEl) {
                            valueEl.textContent = li.textContent.trim();
                            valueEl.classList.remove('placeholder');
                        }
                        menu.querySelectorAll('li').forEach(function (x) { x.classList.remove('selected'); });
                        li.classList.add('selected');
                        root.classList.remove('open');
                        clearFieldError('year');
                    });
                });
            });

            document.addEventListener('click', function () {
                document.querySelectorAll('[data-select].open').forEach(function (s) {
                    s.classList.remove('open');
                });
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            initSelects();

            // live clear errors
            ['name', 'email', 'password', 'allowance'].forEach(function (id) {
                var el = document.getElementById(id);
                if (el) el.addEventListener('input', function () { clearFieldError(id); });
            });

            // block numbers/special chars while typing in name
            var nameEl = document.getElementById('name');
            if (nameEl) {
                nameEl.addEventListener('keypress', function (e) {
                    var ch = e.key;
                    if (ch.length === 1 && !/[\p{L}\s]/u.test(ch)) {
                        e.preventDefault();
                    }
                });
                nameEl.addEventListener('paste', function (e) {
                    e.preventDefault();
                    var text = (e.clipboardData || window.clipboardData).getData('text') || '';
                    text = text.replace(/[^\p{L}\s]/gu, '').replace(/\s+/g, ' ');
                    var start = nameEl.selectionStart;
                    var end = nameEl.selectionEnd;
                    var val = nameEl.value;
                    nameEl.value = val.slice(0, start) + text + val.slice(end);
                    clearFieldError('name');
                });
            }

            var toggle = document.getElementById('pwToggle');
            var input = document.getElementById('password');
            if (toggle && input) {
                toggle.addEventListener('click', function () {
                    var isPw = input.type === 'password';
                    input.type = isPw ? 'text' : 'password';
                    var icon = toggle.querySelector('i');
                    if (icon) icon.className = isPw ? 'ri-eye-off-line' : 'ri-eye-line';
                });
            }
        });
    </script>
}

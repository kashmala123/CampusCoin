    <div id="createGoalModal" class="modal-overlay">
        <div class="modal-card ios-glass" style="max-width:420px;width:92%;padding:22px;border-radius:20px;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
                <div style="font-weight:800;font-size:15px;display:flex;align-items:center;gap:8px;">
                    <i class="fa-solid fa-bullseye" style="color:#a486e0;"></i> New Savings Goal
                </div>
                <button type="button" onclick="closeCreateGoalModal()" style="border:0;background:transparent;cursor:pointer;opacity:.6;font-size:16px;color:inherit;"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <label style="display:block;font-size:11px;font-weight:700;opacity:.7;margin-bottom:6px;">Goal name</label>
            <input id="cgName" type="text" value="New Savings Goal" class="w-full px-3 py-2.5 rounded-xl outline-none" style="width:100%;padding:12px 14px;border-radius:12px;border:1px solid rgba(148,163,184,.25);background:rgba(15,23,42,.45);color:inherit;margin-bottom:12px;box-sizing:border-box;" />
            <label style="display:block;font-size:11px;font-weight:700;opacity:.7;margin-bottom:6px;">Target amount (Rs.)</label>
            <input id="cgTarget" type="number" min="1" step="1" value="1000" style="width:100%;padding:12px 14px;border-radius:12px;border:1px solid rgba(148,163,184,.25);background:rgba(15,23,42,.45);color:inherit;margin-bottom:16px;box-sizing:border-box;" />
            <div style="display:flex;gap:10px;justify-content:flex-end;">
                <button type="button" onclick="closeCreateGoalModal()" style="padding:10px 16px;border-radius:12px;border:1px solid rgba(148,163,184,.25);background:transparent;color:inherit;font-weight:700;cursor:pointer;">Cancel</button>
                <button type="button" onclick="submitCreateGoal()" style="padding:10px 16px;border-radius:12px;border:0;background:linear-gradient(135deg,#a486e0,#6366f1);color:#fff;font-weight:700;cursor:pointer;">Create goal</button>
            </div>
        </div>
    </div>

<script>
        let charts = {};
        let allCategories = [];
        let currentPeriod = '6';
        let dashboardData = null;
        let activeGoalId = null;

        const autoCatRules = {
            'Food': ['kfc', 'mcdonalds', 'burger', 'pizza', 'cafe', 'coffee', 'starbucks', 'subway', 'dine', 'food', 'snack', 'cafeteria', 'shawarma', 'biryani'],
            'Transport': ['careem', 'uber', 'bus', 'fuel', 'petrol', 'metro', 'taxi', 'ride', 'indrive', 'fare'],
            'Books': ['book', 'pdf', 'tuition', 'lab', 'stationery', 'course', 'udemy', 'coursera', 'exam', 'textbook'],
            'Entertainment': ['cinema', 'netflix', 'spotify', 'game', 'movie', 'concert', 'steam', 'bowling', 'outing'],
            'Subscriptions': ['apple', 'google storage', 'youtube', 'gym', 'patreon', 'discord'],
            'Allowance': ['allowance', 'pocket money', 'monthly stipend'],
            'Freelance': ['tutoring', 'freelance', 'salary', 'paycheck', 'teaching assistant', 'ta']
        };

        document.addEventListener("DOMContentLoaded", async function() {
            initializeTheme();
            setDate();
            setTodayDate();
            await loadCategories();
            await refreshAllData();
            await initializeCharts();
            initializeSearch();
        });

        function setDate() {
            const now = new Date();
            document.getElementById("currentDate").textContent = now.toLocaleDateString("en-US", {
                weekday: "short", month: "long", day: "numeric", year: "numeric"
            });
        }

        function setTodayDate() {
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('txDate').value = today;
        }

        
        // ===== Smart Spending Alerts =====
        async function loadSpendingAlerts() {
            const box = document.getElementById('spendingAlertsList');
            if (!box) return;
            try {
                const res = await fetch('/api/dashboard/spending-alerts', { credentials: 'same-origin' });
                const data = await res.json();
                const alerts = data.alerts || [];
                if (!alerts.length) {
                    box.innerHTML = '<div style="opacity:.45;font-size:12px;padding:6px 0;">All good — no categories at 80%+ of budget.</div>';
                    return;
                }
                box.innerHTML = alerts.map(a => {
                    const bg = a.severity === 'over' ? 'rgba(225,29,72,.1)' : 'rgba(245,158,11,.12)';
                    const border = a.severity === 'over' ? '1px solid rgba(225,29,72,.25)' : '1px solid rgba(245,158,11,.25)';
                    const color = a.severity === 'over' ? '#e11d48' : '#d97706';
                    return `<div style="padding:12px 14px;border-radius:14px;margin-bottom:8px;background:${bg};border:${border};">
                        <div style="font-weight:800;color:${color};font-size:13px;">${a.category} · ${a.percent}%</div>
                        <div style="font-size:12px;margin-top:4px;opacity:.85;">${a.message}</div>
                    </div>`;
                }).join('');
            } catch (e) {
                box.innerHTML = '<div style="opacity:.45;font-size:12px;">Could not load alerts.</div>';
            }
        }

        // ===== What-If Calculator =====
        function calcWhatIf() {
            const amount = parseFloat(document.getElementById('wiAmount')?.value) || 0;
            const freq = document.getElementById('wiFreq')?.value || 'day';
            let monthly = 0;
            if (freq === 'day') monthly = amount * 30;
            else if (freq === 'week') monthly = amount * (52 / 12);
            else monthly = amount;
            const fmt = n => '$' + (Math.round(n * 100) / 100).toFixed(2);
            const el1 = document.getElementById('wi1m');
            const el6 = document.getElementById('wi6m');
            const elY = document.getElementById('wi1y');
            if (el1) el1.textContent = fmt(monthly);
            if (el6) el6.textContent = fmt(monthly * 6);
            if (elY) elY.textContent = fmt(monthly * 12);
        }
        document.getElementById('wiAmount')?.addEventListener('input', calcWhatIf);
        document.getElementById('wiFreq')?.addEventListener('change', calcWhatIf);
        document.querySelectorAll('#whatIfQuick button').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('wiLabel').value = btn.dataset.label || '';
                document.getElementById('wiAmount').value = btn.dataset.amount || '0';
                document.getElementById('wiFreq').value = btn.dataset.freq || 'day';
                calcWhatIf();
            });
        });
        calcWhatIf();
        loadSpendingAlerts();

        async function refreshAllData() {
            await Promise.all([fetchSummary(), fetchTransactions(), fetchNotifications(), fetchInsights(), fetchSavingsGoals()]);
        }

        async function fetchSummary() {
            try {
                const res = await fetch('/api/dashboard/summary');
                if (!res.ok) throw new Error('Failed to fetch summary');
                const data = await res.json();
                dashboardData = data;

                document.getElementById('kpiBalance').textContent = `Rs. ${data.totalBalance.toFixed(2)}`;
                document.getElementById('kpiIncome').textContent = `Rs. ${data.monthlyIncome.toFixed(2)}`;
                document.getElementById('kpiExpenses').textContent = `Rs. ${data.monthlyExpenses.toFixed(2)}`;

                const balChange = document.getElementById('kpiBalanceChange');
                if (data.balanceChangePercent >= 0) {
                    balChange.className = 'kpi-change positive';
                    balChange.innerHTML = `<i class="fa-solid fa-arrow-trend-up"></i> ${data.balanceChangePercent}% vs last month`;
                } else {
                    balChange.className = 'kpi-change negative';
                    balChange.innerHTML = `<i class="fa-solid fa-arrow-trend-down"></i> ${Math.abs(data.balanceChangePercent)}% less spent`;
                }

                document.getElementById('kpiExpenseNote').innerHTML = `<i class="fa-solid fa-chart-pie"></i> ${data.budgetUsagePercentage}% of budget used`;

                document.getElementById('healthScore').textContent = data.healthScore;
                document.getElementById('healthStatus').textContent = data.healthScoreStatus;
                document.getElementById('healthDescription').textContent = `Your financial health is ${data.healthScoreStatus.toLowerCase()} based on spending patterns.`;

                const healthRing = document.getElementById('healthRing');
                const degrees = (data.healthScore / 100) * 360;
                healthRing.style.background = `conic-gradient(#a486e0 0deg, #6366f1 ${degrees}deg, rgba(148,163,184,.13) ${degrees}deg)`;

                document.getElementById('healthProgress').style.width = `${data.healthScore}%`;

                if (data.userName) {
                    document.getElementById('welcomeName').textContent = data.userName.split(' ')[0];
                    document.getElementById('topStudentName').textContent = data.userName;
                    document.getElementById('sidebarStudentName').textContent = data.userName;
                    const initials = data.userName.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);
                    document.getElementById('topAvatar').textContent = initials;
                    document.getElementById('sidebarAvatar').textContent = initials;
                }
                if (data.userAcademicYear) {
                    document.getElementById('sidebarStudentRole').textContent = data.userAcademicYear;
                }

                const badge = document.getElementById('notificationDot');
                if (data.unreadNotificationsCount > 0) badge.classList.remove('hidden');
                else badge.classList.add('hidden');
            } catch (err) { console.error('Error fetching summary:', err); }
        }

        async function fetchTransactions() {
            try {
                const res = await fetch('/api/transactions');
                if (!res.ok) throw new Error('Failed to fetch transactions');
                const transactions = await res.json();
                renderTransactions(transactions);
            } catch (err) {
                console.error('Error fetching transactions:', err);
                document.getElementById('transactionTableBody').innerHTML = '<tr><td colspan="5" class="text-center py-6 opacity-40">Error loading transactions</td></tr>';
            }
        }

        function renderTransactions(transactions, searchTerm = '') {
            const tbody = document.getElementById('transactionTableBody');
            const term = searchTerm.toLowerCase().trim();
            const filtered = term
                ? transactions.filter(t => t.title.toLowerCase().includes(term) || t.category.toLowerCase().includes(term) || t.type.toLowerCase().includes(term))
                : transactions.slice(0, 10);

            if (!filtered.length) {
                tbody.innerHTML = `<tr><td colspan="5" class="text-center py-6 opacity-40">No transactions found</td></tr>`;
                return;
            }

            tbody.innerHTML = filtered.map(tx => {
                const isIncome = tx.type === 'Income';
                const amountClass = isIncome ? 'text-emerald-500' : 'text-rose-500';
                const amount = isIncome ? `+Rs. ${tx.amount.toFixed(2)}` : `-Rs. ${tx.amount.toFixed(2)}`;
                return `
                    <tr class="hover:bg-slate-500/5 transition-colors">
                        <td class="font-bold">${tx.title}</td>
                        <td><span class="px-2 py-0.5 rounded-full text-[8px] font-bold bg-purple-600/10 text-purple-700 dark:text-purple-400">${tx.category}</span></td>
                        <td class="${amountClass} font-bold">${amount}</td>
                        <td>${tx.type}</td>
                        <td class="text-slate-500">${tx.date}</td>
                    </tr>
                `;
            }).join('');
        }

        async function fetchNotifications() {
            try {
                const res = await fetch('/api/notifications');
                if (!res.ok) return;
                const data = await res.json();
                const list = document.getElementById('notificationsList');

                const badge = document.getElementById('notificationDot');
                if (badge) {
                    if ((data.unreadCount || 0) > 0) badge.classList.remove('hidden');
                    else badge.classList.add('hidden');
                }
                if (!data.notifications || data.notifications.length === 0) {
                    list.innerHTML = '<div class="text-center py-4 text-xs text-slate-400">No notifications</div>';
                    return;
                }

                list.innerHTML = data.notifications.slice(0, 5).map(n => `
                    <div class="p-2.5 rounded-xl ${n.isRead ? 'bg-slate-500/5' : 'bg-purple-600/10 border border-sky-500/20'} flex items-start gap-2">
                        <i class="fa-solid ${n.type === 'Alert' ? 'fa-triangle-exclamation text-rose-500' : 'fa-circle-info text-purple-600'} text-xs mt-0.5"></i>
                        <div class="flex-1">
                            <p class="text-[10px] font-semibold text-slate-800 dark:text-slate-200">${n.message}</p>
                            <span class="text-[8px] text-slate-400">${n.createdAt || 'Just now'}</span>
                        </div>
                    </div>
                `).join('');
            } catch (err) { console.error('Error fetching notifications:', err); }
        }

        // ================= INSIGHTS WITH BOOKMARK BUTTON =================
        async function fetchInsights() {
            try {
                const res = await fetch('/api/tips');
                if (!res.ok) return;
                const tips = await res.json();
                const container = document.getElementById('insightsContainer');

                if (!tips || tips.length === 0) {
                    container.innerHTML = '<div class="text-center py-4 text-xs opacity-40">Keep logging transactions to unlock insights!</div>';
                    return;
                }

                const colorMap = {
                    'emerald': { bg: 'rgba(16,185,129,.10)', text: 'text-emerald-500' },
                    'amber': { bg: 'rgba(245,158,11,.10)', text: 'text-amber-500' },
                    'sky': { bg: 'rgba(139,88,184,.10)', text: 'text-purple-600' },
                    'rose': { bg: 'rgba(244,63,94,.10)', text: 'text-rose-500' },
                    'purple': { bg: 'rgba(168,85,247,.10)', text: 'text-purple-500' }
                };

                // Check if tip is already bookmarked
                let existingBookmarks = [];
                try {
                    const bmRes = await fetch('/api/bookmarks', { credentials: 'same-origin' });
                    if (bmRes.ok) existingBookmarks = await bmRes.json();
                } catch (e) { }

                container.innerHTML = tips.slice(0, 4).map(tip => {
                    const colors = colorMap[tip.color] || colorMap['sky'];
                    const tipId = tip.tipId || tip.tipID || tip.TipId || 0;
                    const isSaved = existingBookmarks.some(b => b.refType === 'Tip' && b.refId === tipId);
                    const btnClass = isSaved
                        ? 'bg-amber-500/20 text-amber-500'
                        : 'bg-purple-600/10 text-purple-600 hover:bg-amber-500/20 hover:text-amber-500';
                    const iconClass = isSaved ? 'fa-solid fa-bookmark' : 'fa-regular fa-bookmark';

                    return `
                        <div class="insight relative" data-tip-id="${tipId}">
                            <div class="insight-icon ${colors.text}" style="background:${colors.bg}">
                                <i class="fa-solid ${tip.icon}"></i>
                            </div>
                            <div class="flex-1 pr-14">
                                <div class="insight-title">${tip.title}</div>
                                <div class="insight-text">${tip.text}</div>
                            </div>
                            <div class="absolute top-2 right-2 flex gap-1">
                                <button onclick='saveBookmark(${tipId}, this, ${JSON.stringify(tip.title || "")}, ${JSON.stringify(tip.text || "")}, ${JSON.stringify(tip.category || "Saving Tip")})'
                                        class="w-7 h-7 rounded-lg ${btnClass} flex items-center justify-center transition-all"
                                        title="Pin / save tip">
                                    <i class="${iconClass} text-[10px]"></i>
                                </button>
                                <button onclick="dismissTip(${tipId}, this)"
                                        class="w-7 h-7 rounded-lg bg-slate-500/10 text-slate-500 hover:bg-rose-500/15 hover:text-rose-500 flex items-center justify-center transition-all"
                                        title="Dismiss tip">
                                    <i class="fa-solid fa-xmark text-[10px]"></i>
                                </button>
                            </div>
                        </div>
                    `;
                }).join('');
            } catch (err) {
                console.error('Error fetching insights:', err);
                document.getElementById('insightsContainer').innerHTML = '<div class="text-center py-4 text-xs opacity-40">Unable to load insights</div>';
            }
        }

        // ================= SAVE BOOKMARK =================
        async function saveBookmark(tipId, btnElement, title, content, category) {
            if (!tipId || tipId === 0) {
                showToast('Cannot save this tip');
                return;
            }

            try {
                const res = await fetch('/api/bookmarks', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({
                        refType: 'Tip',
                        refId: tipId,
                        title: title || 'Saved tip',
                        content: content || '',
                        category: category || 'Saving Tip'
                    })
                });

                const data = await res.json().catch(() => ({}));

                if (!res.ok) {
                    showToast(data.detail || data.message || 'Failed to save');
                    return;
                }

                if (btnElement) {
                    btnElement.innerHTML = '<i class="fa-solid fa-bookmark text-[10px]"></i>';
                    btnElement.classList.remove('bg-purple-600/10', 'text-purple-600');
                    btnElement.classList.add('bg-amber-500/20', 'text-amber-500');
                }

                if (data.alreadyExists) {
                    showToast('Already bookmarked!');
                } else {
                    showToast('Saved to Bookmarks!');
                    try { if (typeof confetti === 'function') confetti({ particleCount: 40, spread: 40, origin: { y: 0.7 } }); } catch (_) {}
                }
            } catch (err) {
                console.error(err);
                showToast('Error saving bookmark');
            }
        }

        async function fetchSavingsGoals() {
            try {
                const res = await fetch('/api/savings-goals');
                if (!res.ok) return;
                const goals = await res.json();
                if (goals.length > 0) {
                    const goal = goals[0];
                    activeGoalId = goal.goalId;
                    document.getElementById('kpiSavingsTarget').textContent = `${goal.progressPercentage}%`;
                    document.getElementById('kpiSavingsNote').innerHTML = `<i class="fa-solid fa-shield-halved"></i> Rs. ${goal.currentAmount.toFixed(0)} / Rs. ${goal.targetAmount.toFixed(0)} saved`;
                }
            } catch (err) { console.error('Error fetching savings goals:', err); }
        }

        async function loadCategories() {
            try {
                const res = await fetch('/api/categories');
                if (!res.ok) return;
                allCategories = await res.json();
                const txCategory = document.getElementById('txCategory');
                const editCategory = document.getElementById('editCategory');
                const options = allCategories.map(c => `<option value="${c.name}">${c.name} (${c.type})</option>`).join('');
                if (txCategory) txCategory.innerHTML = options;
                if (editCategory) editCategory.innerHTML = options;
            } catch (err) { console.error('Error loading categories:', err); }
        }

        async function initializeCharts() {
            try {
                const res = await fetch('/api/dashboard/charts');
                if (!res.ok) throw new Error('Failed to fetch chart data');
                const data = await res.json();
                const colors = getChartColors();

                const ctx1 = document.getElementById('incomeExpenseChart').getContext('2d');
                const incGrad = ctx1.createLinearGradient(0, 0, 0, 260);
                incGrad.addColorStop(0, 'rgba(139,88,184,.30)');
                incGrad.addColorStop(1, 'rgba(139,88,184,0)');
                const expGrad = ctx1.createLinearGradient(0, 0, 0, 260);
                expGrad.addColorStop(0, 'rgba(99,102,241,.22)');
                expGrad.addColorStop(1, 'rgba(99,102,241,0)');

                charts.incomeExpense = new Chart(ctx1, {
                    type: 'line',
                    data: {
                        labels: data.cashflow?.labels || [],
                        datasets: [
                            { label: 'Income', data: data.cashflow?.incomeData || [], borderColor: '#6b3a92', backgroundColor: incGrad, fill: true, tension: 0.42, borderWidth: 3 },
                            { label: 'Expenses', data: data.cashflow?.expenseData || [], borderColor: '#6366f1', backgroundColor: expGrad, fill: true, tension: 0.42, borderWidth: 3 }
                        ]
                    },
                    options: baseChartOptions()
                });

                const ctx2 = document.getElementById('expenseChart').getContext('2d');
                charts.expense = new Chart(ctx2, {
                    type: 'doughnut',
                    data: {
                        labels: data.spendingDonut?.labels || [],
                        datasets: [{ data: data.spendingDonut?.data || [], backgroundColor: data.spendingDonut?.colors || ['#a486e0', '#8b58b8', '#6366f1', '#818cf8', '#a78bfa'], borderWidth: 0 }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, cutout: '68%', plugins: { legend: { position: 'bottom', labels: { color: colors.text, font: { size: 9 } } } } }
                });

                const ctx3 = document.getElementById('weeklyChart').getContext('2d');
                charts.weekly = new Chart(ctx3, {
                    type: 'bar',
                    data: {
                        labels: data.weeklyTrend?.labels || ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                        datasets: [{ label: 'Spending (Rs.)', data: data.weeklyTrend?.data || [], backgroundColor: 'rgba(139,88,184,.65)', borderColor: '#8b58b8', borderWidth: 1, borderRadius: 8 }]
                    },
                    options: baseChartOptions()
                });

                const ctx4 = document.getElementById('savingGoalChart').getContext('2d');
                charts.goals = new Chart(ctx4, {
                    type: 'bar',
                    data: {
                        labels: data.savingsRadial?.labels || ['Goal 1', 'Goal 2', 'Goal 3'],
                        datasets: [{ data: data.savingsRadial?.data || [0, 0, 0], backgroundColor: ['#a486e0', '#8b58b8', '#6366f1'], borderRadius: 8 }]
                    },
                    options: {
                        indexAxis: 'y', responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { max: 100, grid: { color: colors.grid }, ticks: { color: colors.text, font: { size: 9 } } },
                            y: { grid: { display: false }, ticks: { color: colors.text, font: { size: 9 } } }
                        }
                    }
                });
            } catch (err) { console.error('Error initializing charts:', err); }
        }

        function getChartColors() {
            const dark = document.documentElement.classList.contains('dark');
            return { text: dark ? 'rgba(226,232,240,.65)' : 'rgba(15,23,42,.55)', grid: dark ? 'rgba(255,255,255,.06)' : 'rgba(15,23,42,.07)' };
        }

        function baseChartOptions() {
            const colors = getChartColors();
            return {
                responsive: true, maintainAspectRatio: false,
                interaction: { intersect: false, mode: 'index' },
                plugins: { legend: { labels: { color: colors.text, usePointStyle: true, boxWidth: 8, font: { size: 10 } } } },
                scales: {
                    x: { grid: { display: false }, ticks: { color: colors.text, font: { size: 9 } } },
                    y: { grid: { color: colors.grid }, ticks: { color: colors.text, font: { size: 9 } } }
                }
            };
        }

        function changePeriod(period) {
            currentPeriod = period;
            if (charts.incomeExpense) {
                fetch('/api/dashboard/charts?months=' + period)
                    .then(r => r.json())
                    .then(data => {
                        if (data.cashflow) {
                            charts.incomeExpense.data.labels = data.cashflow.labels;
                            charts.incomeExpense.data.datasets[0].data = data.cashflow.incomeData;
                            charts.incomeExpense.data.datasets[1].data = data.cashflow.expenseData;
                            charts.incomeExpense.update();
                        }
                    })
                    .catch(err => console.error(err));
            }
            showToast(period === '6' ? 'Showing last 6 months' : 'Showing last 12 months');
        }

        async function handleAddExpense(e) {
            e.preventDefault();
            const title = document.getElementById('txTitle').value;
            const amount = parseFloat(document.getElementById('txAmount').value);
            const type = document.getElementById('txType').value;
            const category = document.getElementById('txCategory').value;
            const date = document.getElementById('txDate').value;

            try {
                const res = await fetch('/api/transactions', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title, amount, type, category, date, isRecurring: false })
                });

                if (!res.ok) { const err = await res.json(); alert(err.message || 'Error saving transaction'); return; }
                const data = await res.json();

                closeModal();
                document.getElementById('transactionForm').reset();
                setTodayDate();
                await refreshAllData();
                await initializeCharts();
                if (type === 'Income') confetti({ particleCount: 80, spread: 60, origin: { y: 0.7 } });
                showToast('Transaction saved successfully!');
                if (data && data.budgetAlertMessage) {
                    showToast(data.budgetAlertMessage);
                }
                if (typeof loadSpendingAlerts === 'function') loadSpendingAlerts();
            } catch (err) { console.error('Error adding transaction:', err); showToast('Error saving transaction'); }
        }

        async function openEditModal(id) {
            try {
                const res = await fetch(`/api/transactions/${id}`);
                if (!res.ok) return;
                const tx = await res.json();
                document.getElementById('editId').value = tx.id;
                document.getElementById('editTitle').value = tx.title;
                document.getElementById('editAmount').value = tx.amount;
                document.getElementById('editType').value = tx.type;
                document.getElementById('editCategory').value = tx.category;
                document.getElementById('editDate').value = tx.date;
                document.getElementById('editModal').classList.add('show');
            } catch (err) { console.error('Error fetching transaction:', err); }
        }

        function closeEditModal() { document.getElementById('editModal').classList.remove('show'); }

        async function handleEditExpense(e) {
            e.preventDefault();
            const id = document.getElementById('editId').value;
            const title = document.getElementById('editTitle').value;
            const amount = parseFloat(document.getElementById('editAmount').value);
            const type = document.getElementById('editType').value;
            const category = document.getElementById('editCategory').value;
            const date = document.getElementById('editDate').value;

            try {
                const res = await fetch(`/api/transactions/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: parseInt(id), title, amount, type, category, date })
                });

                if (!res.ok) { alert('Error updating transaction'); return; }
                closeEditModal();
                await refreshAllData();
                await initializeCharts();
                showToast('Transaction updated!');
            } catch (err) { console.error('Error updating transaction:', err); }
        }

        function openAddModal(type) {
            document.getElementById('txType').value = type;
            document.getElementById('modalTitle').textContent = `Add New ${type}`;
            document.getElementById('addModal').classList.add('show');
        }

        function closeModal() { document.getElementById('addModal').classList.remove('show'); }

        async function openProfileModal() {
            try {
                const res = await fetch('/api/auth/me');
                if (!res.ok) return;
                const user = await res.json();
                document.getElementById('profFullName').value = user.fullName || '';
                document.getElementById('profAcademicYear').value = user.academicYear || '';
                document.getElementById('profAllowance').value = user.monthlyAllowanceBaseline || 0;
                document.getElementById('profSavingsGoal').value = user.monthlySavingsGoal || 0;
                renderCustomCategories();
                document.getElementById('profileModal').classList.add('show');
            } catch (err) { console.error('Error loading profile:', err); }
        }

        function closeProfileModal() { document.getElementById('profileModal').classList.remove('show'); }

        async function handleProfileUpdate(e) {
            e.preventDefault();
            const fullName = document.getElementById('profFullName').value;
            const academicYear = document.getElementById('profAcademicYear').value;
            const monthlyAllowanceBaseline = parseFloat(document.getElementById('profAllowance').value) || 0;
            const monthlySavingsGoal = parseFloat(document.getElementById('profSavingsGoal').value) || 0;

            try {
                const res = await fetch('/api/auth/profile', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ fullName, academicYear, monthlyAllowanceBaseline, monthlySavingsGoal })
                });
                if (res.ok) { showToast('Profile updated!'); await refreshAllData(); }
            } catch (err) { console.error('Error updating profile:', err); }
        }

        function renderCustomCategories() {
            const container = document.getElementById('customCategoriesList');
            const custom = allCategories.filter(c => c.isUserCustom);
            if (!custom.length) { container.innerHTML = '<div class="text-[10px] opacity-40">No custom categories yet</div>'; return; }
            container.innerHTML = custom.map(c => `
                <div class="flex justify-between items-center p-2 rounded-xl bg-slate-500/10 text-xs">
                    <span>${c.name} (${c.type})</span>
                    <button onclick="deleteCustomCategory(${c.categoryId})" class="text-rose-500 hover:opacity-75">
                        <i class="fa-regular fa-trash-can"></i>
                    </button>
                </div>
            `).join('');
        }

        async function addCustomCategory() {
            const name = document.getElementById('customCatName').value.trim();
            const type = document.getElementById('customCatType').value;
            if (!name) return;
            try {
                const res = await fetch('/api/categories', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, type })
                });
                if (res.ok) {
                    document.getElementById('customCatName').value = '';
                    await loadCategories();
                    renderCustomCategories();
                    showToast('Category added!');
                } else { const err = await res.json(); alert(err.message || 'Error adding category'); }
            } catch (err) { console.error(err); }
        }

        async function deleteCustomCategory(id) {
            if (!confirm('Delete this category?')) return;
            try {
                const res = await fetch(`/api/categories/${id}`, { method: 'DELETE' });
                if (res.ok) { await loadCategories(); renderCustomCategories(); showToast('Category deleted'); }
            } catch (err) { console.error(err); }
        }

        function openCreateGoalModal() {
            const m = document.getElementById('createGoalModal');
            if (!m) return;
            document.getElementById('cgName').value = 'New Savings Goal';
            document.getElementById('cgTarget').value = '1000';
            m.classList.add('show');
        }
        function closeCreateGoalModal() {
            const m = document.getElementById('createGoalModal');
            if (m) m.classList.remove('show');
        }
        async function submitCreateGoal() {
            const name = (document.getElementById('cgName').value || '').trim();
            const target = parseFloat(document.getElementById('cgTarget').value);
            if (!name) { showToast('Enter a goal name'); return; }
            if (!target || target <= 0) { showToast('Enter a valid target amount'); return; }
            try {
                const res = await fetch('/api/savings-goals', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ goalName: name, targetAmount: target, currentAmount: 0 })
                });
                if (res.ok) {
                    closeCreateGoalModal();
                    refreshAllData();
                    if (typeof initializeCharts === 'function') initializeCharts();
                    showToast('Savings goal created!');
                } else {
                    const err = await res.json().catch(() => ({}));
                    showToast(err.message || 'Could not create goal');
                }
            } catch (e) { showToast('Network error'); }
        }

        function toggleNotifications(evt) {
            if (evt) { evt.preventDefault(); evt.stopPropagation(); }
            const popover = document.getElementById('notificationsPopover');
            if (!popover) return;
            const willOpen = !popover.classList.contains('show');
            document.querySelectorAll('.dropdown, .notifications-popover, .cc-notif-popover').forEach(d => d.classList.remove('show'));
            if (willOpen) {
                popover.classList.add('show');
                fetchNotifications();
            }
        }

        async function markAllNotificationsRead() {
            try {
                await fetch('/api/notifications/read-all', { method: 'PUT' });
                document.getElementById('notificationDot').classList.add('hidden');
                await fetchNotifications();
            } catch (err) { console.error(err); }
        }

        function toggleDropdown(id, evt) {
            if (evt) { evt.preventDefault(); evt.stopPropagation(); }
            const dropdown = document.getElementById(id);
            if (!dropdown) return;
            const isShown = dropdown.classList.contains('show');
            document.querySelectorAll('.dropdown').forEach(d => d.classList.remove('show'));
            if (!isShown) dropdown.classList.add('show');
        }

        document.addEventListener('click', function(e) {
            if (!e.target.closest('.dropdown-wrap') && !e.target.closest('.cc-notif-wrap')) {
                document.querySelectorAll('.dropdown, .notifications-popover, .cc-notif-popover').forEach(d => d.classList.remove('show'));
            }
        });

        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
            document.getElementById('mobileOverlay').classList.toggle('show');
        }

        function closeSidebar() {
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('mobileOverlay').classList.remove('show');
        }

        function initializeSearch() {
            const searchInput = document.getElementById('globalSearch');
            let debounceTimer;
            searchInput.addEventListener('input', function() {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(async () => {
                    const term = this.value.trim();
                    if (term) {
                        try {
                            const res = await fetch(`/api/transactions?search=${encodeURIComponent(term)}`);
                            if (res.ok) { const transactions = await res.json(); renderTransactions(transactions); }
                        } catch (err) { console.error(err); }
                    } else { await fetchTransactions(); }
                }, 300);
            });
        }

        function initializeTheme() {
            const saved = localStorage.getItem('campuscoin-theme');
            if (saved === 'dark') {
                document.documentElement.classList.replace('light', 'dark');
                document.body.classList.replace('light-mesh', 'dark-mesh');
            }
            updateThemeIcon();
        }

        function toggleTheme() {
            const isDark = document.documentElement.classList.contains('dark');
            if (isDark) {
                document.documentElement.classList.replace('dark', 'light');
                document.body.classList.replace('dark-mesh', 'light-mesh');
                localStorage.setItem('campuscoin-theme', 'light');
            } else {
                document.documentElement.classList.replace('light', 'dark');
                document.body.classList.replace('light-mesh', 'dark-mesh');
                localStorage.setItem('campuscoin-theme', 'dark');
            }
            updateThemeIcon();
            const colors = getChartColors();
            Object.values(charts).forEach(chart => {
                if (chart && chart.options) {
                    if (chart.options.plugins?.legend?.labels) chart.options.plugins.legend.labels.color = colors.text;
                    if (chart.options.scales?.x?.ticks) chart.options.scales.x.ticks.color = colors.text;
                    if (chart.options.scales?.y?.ticks) {
                        chart.options.scales.y.ticks.color = colors.text;
                        if (chart.options.scales.y.grid) chart.options.scales.y.grid.color = colors.grid;
                    }
                    chart.update();
                }
            });
        }

        function updateThemeIcon() {
            const icon = document.getElementById('themeIcon');
            const isDark = document.documentElement.classList.contains('dark');
            icon.className = isDark ? 'fa-solid fa-sun text-amber-300' : 'fa-solid fa-moon';
        }

        function showToast(msg) {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = 'toast ios-glass font-bold text-xs';
            toast.innerHTML = `<i class="fa-solid fa-circle-info text-purple-600"></i> ${msg}`;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 300);
            }, 2500);
        }

        document.getElementById('txTitle')?.addEventListener('input', function() {
            const lower = this.value.toLowerCase();
            for (const [cat, keywords] of Object.entries(autoCatRules)) {
                if (keywords.some(kw => lower.includes(kw))) {
                    const select = document.getElementById('txCategory');
                    for (let i = 0; i < select.options.length; i++) {
                        if (select.options[i].value.toLowerCase() === cat.toLowerCase()) {
                            select.selectedIndex = i;
                            break;
                        }
                    }
                    if (['allowance', 'freelance', 'scholarship'].includes(cat.toLowerCase())) {
                        document.getElementById('txType').value = 'Income';
                    } else {
                        document.getElementById('txType').value = 'Expense';
                    }
                    break;
                }
            }
        });
    </script>
<script src="/js/cc-header-widgets.js" asp-append-version="true"></script>
<script>
        async function dismissTip(tipId, btn) {
            if (!tipId) return;
            try {
                const res = await fetch('/api/tips/' + tipId + '/dismiss', { method: 'POST', credentials: 'same-origin' });
                if (res.ok) {
                    const card = btn.closest('.insight-card, .insight, .ios-glass, [class*="insight"]');
                    if (card) card.style.display = 'none';
                    if (typeof showToast === 'function') showToast('Tip dismissed');
                }
            } catch (e) { console.warn(e); }
        }


        async function loadForecastAndFlags() {
            const box = document.getElementById('ccForecastBox');
            const flag = document.getElementById('ccAnomalyBox');
            try {
                const [fRes, aRes] = await Promise.all([
                    fetch('/api/transactions/forecast', { credentials: 'same-origin' }),
                    fetch('/api/transactions/anomalies', { credentials: 'same-origin' })
                ]);
                if (box) {
                    if (fRes.ok) {
                        const f = await fRes.json();
                        const inc = Number(f.predictedIncome || 0);
                        const exp = Number(f.predictedExpense || 0);
                        const net = Number(f.predictedNet != null ? f.predictedNet : (inc - exp));
                        box.innerHTML = `
                            <div class="text-sm font-bold opacity-70 mb-1"><i class="fa-solid fa-chart-line text-purple-600"></i> Next-month forecast</div>
                            <div class="text-base font-black tracking-tight">Income ~ Rs. ${inc.toLocaleString(undefined,{maximumFractionDigits:0})} · Expense ~ Rs. ${exp.toLocaleString(undefined,{maximumFractionDigits:0})}</div>
                            <div class="text-xs opacity-55 mt-1">Net ~ Rs. ${net.toLocaleString(undefined,{maximumFractionDigits:0})} · based on last 3 months${f.nextMonth ? ' → ' + f.nextMonth : ''}</div>`;
                    } else {
                        box.innerHTML = `<div class="text-sm font-bold opacity-70">Next-month forecast</div><div class="text-xs opacity-50 mt-1">Unavailable right now</div>`;
                    }
                }
                if (flag) {
                    if (aRes.ok) {
                        const a = await aRes.json();
                        const list = Array.isArray(a.items) ? a.items : (Array.isArray(a) ? a : []);
                        if (!list.length) {
                            flag.innerHTML = `<div class="text-sm font-bold opacity-70">Spending flags</div><div class="text-xs opacity-50 mt-1">No unusual expenses flagged</div>`;
                        } else {
                            flag.innerHTML = `<div class="text-sm font-bold opacity-70 mb-1">Spending flags</div>` +
                                list.slice(0, 3).map(x => `<div class="text-xs opacity-70 py-0.5">${(x.message || x.title || 'Flag').toString().replace(/</g,'&lt;')}</div>`).join('');
                        }
                    } else {
                        flag.innerHTML = `<div class="text-sm font-bold opacity-70">Spending flags</div><div class="text-xs opacity-50 mt-1">Unavailable</div>`;
                    }
                }
            } catch (e) {
                console.warn('forecast/flags', e);
                if (box) box.innerHTML = `<div class="text-sm opacity-60">Forecast could not load</div>`;
                if (flag) flag.innerHTML = `<div class="text-sm opacity-60">Flags could not load</div>`;
            }
        }

        async function loadBillSplitWidget() {
            const body = document.getElementById('billSplitWidgetBody');
            if (!body) return;
            try {
                const res = await fetch('/api/shared-expenses?filter=all', { credentials: 'same-origin' });
                if (!res.ok) {
                    body.innerHTML = '<div class="text-xs opacity-40">Sign in to see splits</div>';
                    return;
                }
                const data = await res.json();
                const s = data.summary || {};
                const open = s.openSplits ?? 0;
                const owed = Number(s.totalOwedToYou || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                const items = (data.items || []).filter(i => !i.allSettled).slice(0, 3);
                let html = `<div class="grid grid-cols-2 gap-2 mb-3">
                    <div class="rounded-2xl px-3 py-2" style="background:rgba(139,88,184,.1)">
                        <div class="text-[10px] opacity-50 font-bold">Open</div>
                        <div class="text-lg font-black text-purple-600">${open}</div>
                    </div>
                    <div class="rounded-2xl px-3 py-2" style="background:rgba(244,63,94,.08)">
                        <div class="text-[10px] opacity-50 font-bold">Owed to you</div>
                        <div class="text-lg font-black text-rose-500">${owed}</div>
                    </div>
                </div>`;
                if (!items.length) {
                    html += `<div class="text-[11px] opacity-50">No open splits. <a href="/Dashboard/BillSplit" class="font-bold text-purple-600">Create one</a> when you pay for the group.</div>`;
                } else {
                    html += items.map(it => `<div class="text-[11px] flex justify-between gap-2 py-1.5 border-b border-white/20 dark:border-white/5">
                        <span class="font-bold truncate">${String(it.description || 'Split').replace(/</g,'&lt;')}</span>
                        <span class="text-rose-500 font-bold whitespace-nowrap">${Number(it.totalOwedToYou||0).toLocaleString(undefined,{minimumFractionDigits:2})}</span>
                    </div>`).join('');
                }
                body.innerHTML = html;
            } catch (e) {
                console.warn('bill split widget', e);
                body.innerHTML = '<div class="text-xs opacity-40">Could not load bill splits</div>';
            }
        }

        function bootDashboardExtras() {
            loadForecastAndFlags();
            loadBillSplitWidget();
            setTimeout(loadForecastAndFlags, 1200);
            setTimeout(loadBillSplitWidget, 1200);
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', bootDashboardExtras);
        } else {
            bootDashboardExtras();
        }
</script>

</body>
</html>

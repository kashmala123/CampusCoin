                    </div>
                </div>
                <div class="dropdown-wrap" style="position:relative;z-index:10002;overflow:visible;">
                    <div class="profile" data-cc-profile-btn style="cursor:pointer;display:flex;align-items:center;gap:8px;">
                        <div class="profile-avatar" id="topAvatar" style="width:34px;height:34px;border-radius:11px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:11px;font-weight:800;background:linear-gradient(135deg,#a486e0,#6366f1);">ST</div>
                        <div class="text-[10px] font-bold" id="topStudentName">Student</div>
                        <i class="fa-solid fa-chevron-down text-[8px] opacity-40"></i>
                    </div>
                    <div data-cc-profile-dd class="cc-shared-dd">
                        <a href="/Dashboard/Profile" class="cc-shared-dd-item"><i class="fa-regular fa-user"></i> Profile</a>
                        <a href="/Dashboard/Index" class="cc-shared-dd-item"><i class="fa-solid fa-chart-line"></i> Dashboard</a>
                        <a href="/Auth/Logout" class="cc-shared-dd-item" style="color:#e11d48;"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
                    </div>
                </div>

            </div>
        </header>

        <section class="page-header">
            <div>
                <div class="eyebrow">CampusCoin / Saved Content</div>
                <h1 class="page-title">Bookmarks</h1>
                <p class="page-description">Your saved saving tips and monthly insights — quick access anytime.</p>
            </div>
            <div class="date-pill ios-glass">
                <i class="fa-regular fa-calendar mr-1"></i>
                <span id="currentDate">Loading...</span>
            </div>
        </section>

        <!-- BOOKMARKS GRID -->
        <section class="bookmarks-grid" id="bookmarksContainer">
            <div class="text-center py-12 col-span-3 text-xs opacity-40">Loading bookmarks...</div>
        </section>
    </main>

    <!-- VIEW DETAILS MODAL -->
    <div id="viewModal" class="modal-overlay">
        <div class="modal-card ios-glass">
            <div class="flex justify-between items-center mb-4">
                <div class="font-extrabold text-sm">
                    <i class="fa-solid fa-bookmark text-amber-500 mr-1"></i> Bookmark Details
                </div>
                <button class="action-btn !w-8 !h-8" onclick="closeModal()">
                    <i class="fa-solid fa-xmark text-xs"></i>
                </button>
            </div>

            <span id="modalCategoryBadge" class="badge bg-purple-600/15 text-purple-700 mb-3 inline-block">Saving Tip</span>
            <h3 class="text-[15px] font-bold mb-2" id="modalTitle">Title</h3>
            <p class="text-[12px] leading-relaxed opacity-70 mb-4" id="modalContent">Content here...</p>

            <div class="text-[10px] opacity-40 mb-4">
                <i class="fa-regular fa-clock mr-1"></i> Saved on <span id="modalDate">--</span>
            </div>

            <div class="flex justify-end gap-2">
                <button class="glass-btn" onclick="closeModal()">Close</button>
            </div>
        </div>
    </div>

    <div id="toastContainer"></div>

    <script>
        let allBookmarks = [];
        let filteredBookmarks = [];

        document.addEventListener("DOMContentLoaded", async function () {
            initializeTheme();
            setDate();
            await Promise.all([loadUserInfo(), loadBookmarks()]);
        });

        function setDate() {
            document.getElementById("currentDate").textContent = new Date().toLocaleDateString("en-US", {
                weekday: "short", month: "long", day: "numeric", year: "numeric"
            });
        }

        async function loadUserInfo() {
            try {
                const res = await fetch('/api/dashboard/summary');
                if (!res.ok) return;
                const data = await res.json();
                if (data.userName) {
                    const initials = data.userName.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);
                    document.getElementById('sidebarAvatar').textContent = initials;
                    document.getElementById('sidebarStudentName').textContent = data.userName;
                    var topName = document.getElementById('topStudentName');
                    if (topName) topName.textContent = data.userName;
                    var topAv = document.getElementById('topAvatar');
                    if (topAv) topAv.textContent = data.userName.split(' ').map(function(n){return n[0];}).join('').toUpperCase().slice(0,2);
                }
                if (data.userAcademicYear) document.getElementById('sidebarStudentRole').textContent = data.userAcademicYear;
            } catch (err) { console.error(err); }
        }

        async function loadBookmarks() {
            try {
                const res = await fetch('/api/bookmarks', { credentials: 'same-origin' });
                if (!res.ok) {
                    const errBody = await res.json().catch(() => ({}));
                    throw new Error(errBody.detail || errBody.message || 'Failed to load bookmarks');
                }
                allBookmarks = await res.json();
                filteredBookmarks = [...allBookmarks];
                renderBookmarks();
                document.getElementById('countBadge').textContent = `${allBookmarks.length} Items`;
            } catch (err) {
                console.error(err);
                document.getElementById('bookmarksContainer').innerHTML =
                    `<div class="text-center py-12 col-span-3 text-xs text-rose-500">${err.message || 'Failed to load bookmarks'}</div>`;
            }
        }

        function renderBookmarks() {
            const container = document.getElementById('bookmarksContainer');

            if (!filteredBookmarks.length) {
                container.innerHTML = `
                    <div class="col-span-3 text-center py-12 ios-glass rounded-3xl">
                        <i class="fa-solid fa-bookmark text-4xl opacity-20 mb-3"></i>
                        <div class="text-sm font-bold opacity-60">No bookmarks yet</div>
                        <div class="text-xs opacity-40 mt-1">Save tips and insights from Dashboard to see them here</div>
                    </div>`;
                return;
            }

            container.innerHTML = filteredBookmarks.map(b => {
                const isTip = b.refType === "Tip";
                const badgeClass = isTip ? 'bg-emerald-500/15 text-emerald-600' : 'bg-purple-600/15 text-purple-700';
                const icon = isTip ? 'fa-lightbulb' : 'fa-chart-line';
                const iconColor = isTip ? 'text-emerald-500' : 'text-purple-600';
                const iconBg = isTip ? 'bg-emerald-500/10' : 'bg-purple-600/10';

                const shortContent = b.content.length > 100 ? b.content.substring(0, 100) + '...' : b.content;

                return `
                    <div class="bookmark-card ios-glass ios-glass-interactive" data-search="${b.title.toLowerCase()} ${b.content.toLowerCase()}">
                        <div class="flex justify-between items-start mb-3">
                            <span class="badge ${badgeClass}">${b.category}</span>
                            <span class="text-[9px] opacity-50">${b.createdAt}</span>
                        </div>
                        <div class="flex items-center gap-2 mb-3">
                            <div class="w-9 h-9 rounded-xl ${iconBg} ${iconColor} flex items-center justify-center">
                                <i class="fa-solid ${icon}"></i>
                            </div>
                            <h3 class="text-[12px] font-bold flex-1">${b.title}</h3>
                        </div>
                        <p class="text-[10px] opacity-60 leading-relaxed flex-1 mb-3">${shortContent}</p>
                        <div class="flex gap-2 mt-2 pt-3 border-t border-slate-300/20">
                            <button class="glass-btn flex-1 justify-center text-[10px] py-1.5"
                                    onclick="viewDetails(${b.bookmarkId})">
                                <i class="fa-solid fa-eye"></i> View
                            </button>
                            <button class="glass-btn text-rose-500 text-[10px] py-1.5 px-3"
                                    onclick="removeBookmark(${b.bookmarkId})" title="Remove">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function filterBookmarks(val) {
            const term = val.toLowerCase().trim();
            filteredBookmarks = term
                ? allBookmarks.filter(b =>
                    b.title.toLowerCase().includes(term) ||
                    b.content.toLowerCase().includes(term) ||
                    b.category.toLowerCase().includes(term))
                : [...allBookmarks];
            renderBookmarks();
        }

        function viewDetails(id) {
            const bm = allBookmarks.find(b => b.bookmarkId === id);
            if (!bm) return;

            document.getElementById('modalTitle').textContent = bm.title;
            document.getElementById('modalContent').textContent = bm.content;
            document.getElementById('modalDate').textContent = bm.createdAt;

            const badge = document.getElementById('modalCategoryBadge');
            badge.textContent = bm.category;
            badge.className = bm.refType === 'Tip'
                ? 'badge bg-emerald-500/15 text-emerald-600 mb-3 inline-block'
                : 'badge bg-purple-600/15 text-purple-700 mb-3 inline-block';

            document.getElementById('viewModal').classList.add('show');
        }

        function closeModal() {
            document.getElementById('viewModal').classList.remove('show');
        }

        async function removeBookmark(id) {
            if (!confirm('Remove this bookmark?')) return;

            try {
                const res = await fetch(`/api/bookmarks/${id}`, { method: 'DELETE', credentials: 'same-origin' });
                if (!res.ok) {
                    showToast('Failed to remove', 'error');
                    return;
                }
                showToast('Bookmark removed', 'success');
                await loadBookmarks();
            } catch (err) {
                console.error(err);
                showToast('Error removing bookmark', 'error');
            }
        }

        // ================= THEME =================
        function initializeTheme() {
            if (localStorage.getItem("campuscoin-theme") === "dark") {
                document.documentElement.classList.replace("light", "dark");
                document.body.classList.replace("light-mesh", "dark-mesh");
            }
            updateThemeIcon();
        }

        function toggleTheme() {
            const isDark = document.documentElement.classList.contains("dark");
            if (isDark) {
                document.documentElement.classList.replace("dark", "light");
                document.body.classList.replace("dark-mesh", "light-mesh");
                localStorage.setItem("campuscoin-theme", "light");
            } else {
                document.documentElement.classList.replace("light", "dark");
                document.body.classList.replace("light-mesh", "dark-mesh");
                localStorage.setItem("campuscoin-theme", "dark");
            }
            updateThemeIcon();
        }

        function updateThemeIcon() {
            const isDark = document.documentElement.classList.contains("dark");
            document.getElementById("themeIcon").className = isDark ? 'fa-solid fa-sun text-amber-300' : 'fa-solid fa-moon';
        }

        function toggleSidebar() {
            document.getElementById("sidebar").classList.toggle("open");
            document.getElementById("mobileOverlay").classList.toggle("show");
        }

        function closeSidebar() {
            document.getElementById("sidebar").classList.remove("open");
            document.getElementById("mobileOverlay").classList.remove("show");
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById("toastContainer");
            const toast = document.createElement("div");
            toast.className = "toast ios-glass";
            const iconMap = {
                success: '<i class="fa-solid fa-circle-check text-emerald-500"></i>',
                error: '<i class="fa-solid fa-circle-exclamation text-rose-500"></i>',
                info: '<i class="fa-solid fa-circle-info text-purple-600"></i>'
            };
            toast.innerHTML = `
                <div class="w-9 h-9 rounded-xl bg-purple-600/10 flex items-center justify-center">
                    ${iconMap[type] || iconMap.info}
                </div>
                <div>
                    <div class="text-[10px] font-bold">CampusCoin</div>
                    <div class="text-[9px] opacity-50">${message}</div>
                </div>`;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = "0";
                setTimeout(() => toast.remove(), 300);
            }, 2500);
        }
    </script>

<script src="/js/cc-header-widgets.js" asp-append-version="true"></script>
</body>
</html>
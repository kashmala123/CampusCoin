            .cc-landing .sitemap-col,
            .cc-landing .reveal-item.reveal-item,
            .cc-landing .reveal-item.reveal-item.reveal-hidden {
                opacity: 1 !important;
                transform: none !important;
                filter: none !important;
                transition: none !important;
                animation: none !important;
            }
            .cc-scroll-progress { display: none; }
            .cc-landing .bp-line { stroke-dashoffset: 0; }
            .cc-landing .rp-bars span { height: var(--h) !important; }
            .cc-landing .cp-bar i { width: 100% !important; }
            .cc-landing .budget-bar i { width: var(--pct) !important; }
            .cc-landing .budget-bar i::after { animation: none !important; }
            .cc-landing .cat-bar i { width: var(--pct) !important; }
        }
        /* ════════════════════════════════════════════════════════════
   CONTACT v4 — Premium: status bar, channel cards, topic chips
   ════════════════════════════════════════════════════════════ */

.cc-landing .contact-section {
    position: relative;
    padding: 120px 0 110px;
    overflow: hidden;
    background:
        radial-gradient(ellipse 55% 50% at 8% 12%, rgba(237, 228, 246, .85), transparent 65%),
        radial-gradient(ellipse 50% 50% at 95% 88%, rgba(255, 225, 230, .7), transparent 65%),
        radial-gradient(ellipse 45% 45% at 50% 50%, rgba(212, 243, 228, .45), transparent 70%),
        linear-gradient(180deg, #fbf6f0 0%, #f6eee4 100%);
    isolation: isolate;
}

.cc-landing .contact-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
}

.cc-landing .ct-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(110px);
    opacity: .55;
}

.cc-landing .ct-orb-1 {
    width: 460px; height: 460px;
    top: -12%; right: -6%;
    background: radial-gradient(circle, rgba(155, 111, 216, .55), transparent 70%);
    animation: cat-float-a 24s ease-in-out infinite;
}

.cc-landing .ct-orb-2 {
    width: 500px; height: 500px;
    bottom: -22%; left: -8%;
    background: radial-gradient(circle, rgba(212, 121, 159, .45), transparent 70%);
    animation: cat-float-b 28s ease-in-out infinite;
}

.cc-landing .ct-orb-3 {
    width: 340px; height: 340px;
    top: 45%; left: 45%;
    background: radial-gradient(circle, rgba(110, 207, 168, .35), transparent 70%);
    animation: cat-float-a 32s ease-in-out infinite reverse;
}

.cc-landing .ct-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(107, 58, 146, .06) 1px, transparent 1px);
    background-size: 28px 28px;
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, black, transparent);
            mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, black, transparent);
    pointer-events: none;
}

.cc-landing .contact-section .wrap {
    position: relative;
    z-index: 1;
}

/* ══════════ LIVE STATUS BAR ══════════ */
.cc-landing .contact-status {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 28px;
    padding: 18px 32px;
    margin: 0 auto 40px;
    max-width: 900px;
    border-radius: 22px;
    background: linear-gradient(135deg, rgba(255, 255, 255, .82) 0%, rgba(255, 255, 255, .6) 100%);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, .95);
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 1),
        inset 0 -2px 6px rgba(107, 58, 146, .05),
        0 22px 50px -28px rgba(76, 45, 120, .3);
}

.cc-landing .cs-team {
    display: flex;
    align-items: center;
    gap: 14px;
}

.cc-landing .cs-avatars {
    display: inline-flex;
    align-items: center;
}

.cc-landing .cs-av {
    width: 38px; height: 38px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: .02em;
    color: #fff;
    border: 2.5px solid #fff;
    margin-left: -10px;
    box-shadow: 0 6px 14px -6px rgba(107, 58, 146, .4);
    transition: transform .3s cubic-bezier(.34, 1.56, .64, 1);
}

.cc-landing .cs-av:first-child { margin-left: 0; }
.cc-landing .cs-av.a { background: linear-gradient(140deg, #a486e0, #7b5ce7); }
.cc-landing .cs-av.b { background: linear-gradient(140deg, #e79bb5, #d4799f); }
.cc-landing .cs-av.c { background: linear-gradient(140deg, #8fd4b8, #4ba77f); }
.cc-landing .cs-av.more {
    background: linear-gradient(140deg, #ede4f6, #d8c0f0);
    color: #4b2568;
    font-size: 12px;
}

.cc-landing .cs-avatars:hover .cs-av {
    transform: translateY(-3px) scale(1.06);
}

.cc-landing .cs-team-text b {
    display: block;
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: -.015em;
    color: #1a0b2e;
    line-height: 1.15;
}

.cc-landing .cs-team-text small {
    display: block;
    font-size: 11.5px;
    color: #7a6d7f;
    margin-top: 2px;
}

.cc-landing .cs-div {
    width: 1px;
    height: 34px;
    background: linear-gradient(180deg, transparent, rgba(107, 58, 146, .18), transparent);
}

.cc-landing .cs-metric {
    display: flex;
    align-items: center;
    gap: 12px;
}

.cc-landing .cs-metric b {
    display: block;
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: -.015em;
    color: #1a0b2e;
    line-height: 1.15;
}

.cc-landing .cs-metric small {
    display: block;
    font-size: 11.5px;
    color: #7a6d7f;
    margin-top: 2px;
}

.cc-landing .cs-pulse {
    width: 12px; height: 12px;
    border-radius: 50%;
    background: #4ba77f;
    box-shadow: 0 0 0 0 rgba(75, 167, 127, .55);
    animation: cs-pulse-ring 2.2s ease-out infinite;
    flex: none;
    position: relative;
}

.cc-landing .cs-pulse::after {
    content: "";
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background: #fff;
    opacity: .35;
}

@@keyframes cs-pulse-ring {
    0%   { box-shadow: 0 0 0 0 rgba(75, 167, 127, .55); }
    70%  { box-shadow: 0 0 0 10px rgba(75, 167, 127, 0); }
    100% { box-shadow: 0 0 0 0 rgba(75, 167, 127, 0); }
}

.cc-landing .cs-icon {
    width: 34px; height: 34px;
    border-radius: 11px;
    display: grid;
    place-items: center;
    font-size: 17px;
    background: linear-gradient(140deg, #ede4f6, #d8c0f0);
    color: #6b3a92;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .8);
    flex: none;
}

/* ══════════ SPLIT LAYOUT ══════════ */
.cc-landing .contact-split {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 32px;
    align-items: start;
    margin-top: 8px;
}

/* ══════════ LEFT · CHANNELS ══════════ */
.cc-landing .contact-methods {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.cc-landing .cm-head {
    margin-bottom: 8px;
    padding-left: 2px;
}

.cc-landing .cm-head-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 99px;
    background: rgba(155, 111, 216, .12);
    border: 1px solid rgba(155, 111, 216, .25);
    color: #6d4aff;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    margin-bottom: 12px;
}

.cc-landing .cm-head-pill i { font-size: 12px; }

.cc-landing .cm-head h3 {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -.03em;
    color: #1a0b2e;
    margin: 0;
    line-height: 1.2;
}

/* Channel cards */
.cc-landing .contact-method {
    display: grid;
    grid-template-columns: 52px 1fr auto 22px;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    border-radius: 20px;
    background: rgba(255, 255, 255, .78);
    backdrop-filter: blur(22px) saturate(180%);
    -webkit-backdrop-filter: blur(22px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, .95);
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 1),
        0 10px 26px -22px rgba(76, 45, 120, .3);
    color: inherit;
    text-decoration: none;
    transition: all .4s cubic-bezier(.22, 1, .36, 1);
    position: relative;
    overflow: hidden;
}

.cc-landing .contact-method::before {
    content: "";
    position: absolute;
    top: 0; left: 0;
    width: 3px;
    height: 100%;
    opacity: 0;
    transition: opacity .4s ease;
    border-radius: 20px 0 0 20px;
}

.cc-landing .contact-method:nth-of-type(1)::before { background: linear-gradient(180deg, #8b6ff0, #6d4aff); }
.cc-landing .contact-method:nth-of-type(2)::before { background: linear-gradient(180deg, #e79bb5, #d4799f); }
.cc-landing .contact-method:nth-of-type(3)::before { background: linear-gradient(180deg, #a486e0, #7b5ce7); }
.cc-landing .contact-method:nth-of-type(4)::before { background: linear-gradient(180deg, #6ecfa8, #4ba77f); }

.cc-landing .contact-method::after {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    background: radial-gradient(circle at 20% 0%, rgba(155, 111, 216, .1), transparent 45%);
    opacity: 0;
    transition: opacity .4s ease;
    pointer-events: none;
}

.cc-landing .contact-method:hover {
    transform: translateY(-3px) translateX(3px);
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 1),
        0 24px 50px -25px rgba(76, 45, 120, .38);
    border-color: rgba(255, 255, 255, 1);
}

.cc-landing .contact-method:hover::before { opacity: 1; }
.cc-landing .contact-method:hover::after  { opacity: 1; }

.cc-landing .contact-method:hover .cm-icon {
    transform: scale(1.08) rotate(-6deg);
}

.cc-landing .cm-icon {
    width: 52px; height: 52px;
    border-radius: 15px;
    display: grid;
    place-items: center;
    font-size: 23px;
    color: #fff;
    flex: none;
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, .35),
        0 12px 24px -10px rgba(76, 45, 120, .45);
    transition: transform .4s cubic-bezier(.34, 1.56, .64, 1);
    position: relative;
    z-index: 1;
}

.cc-landing .cm-icon.violet { background: linear-gradient(140deg, #8b6ff0, #6d4aff); }
.cc-landing .cm-icon.rose   { background: linear-gradient(140deg, #e79bb5, #d4799f); }
.cc-landing .cm-icon.plum   { background: linear-gradient(140deg, #a486e0, #7b5ce7); }
.cc-landing .cm-icon.mint   { background: linear-gradient(140deg, #6ecfa8, #4ba77f); }

.cc-landing .cm-info {
    min-width: 0;
    position: relative;
    z-index: 1;
}

.cc-landing .cm-info b {
    display: block;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -.02em;
    color: #1a0b2e;
    line-height: 1.2;
}

.cc-landing .cm-info span {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: #6d4aff;
    margin-top: 3px;
    word-break: break-word;
}

.cc-landing .cm-info small {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11.5px;
    color: #7a6d7f;
    margin-top: 6px;
    font-weight: 500;
}

.cc-landing .cm-info small i { font-size: 12px; color: #a89fb0; }

.cc-landing .cm-badge {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 99px;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: .06em;
    text-transform: uppercase;
    white-space: nowrap;
    background: rgba(139, 111, 240, .14);
    color: #5a3d7a;
    border: 1px solid rgba(139, 111, 240, .28);
    position: relative;
    z-index: 1;
}

.cc-landing .cm-badge.rose { background: rgba(212, 121, 159, .14); color: #b84468; border-color: rgba(212, 121, 159, .3); }
.cc-landing .cm-badge.plum { background: rgba(164, 134, 224, .14); color: #5a3d7a; border-color: rgba(164, 134, 224, .3); }
.cc-landing .cm-badge.mint { background: rgba(110, 207, 168, .16); color: #2f7d4e; border-color: rgba(110, 207, 168, .32); }

.cc-landing .cm-arrow {
    font-size: 18px;
    color: #a89fb0;
    transition: all .35s cubic-bezier(.22, 1, .36, 1);
    transform: translate(-2px, 2px);
    position: relative;
    z-index: 1;
}

.cc-landing .contact-method:hover .cm-arrow {
    color: #6d4aff;
    transform: translate(0, 0);
}

/* Footnote */
.cc-landing .cm-foot {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    padding: 12px 18px;
    border-radius: 99px;
    background: rgba(255, 255, 255, .55);
    border: 1px dashed rgba(155, 111, 216, .28);
    font-size: 12.5px;
    color: #5a4a6b;
    font-weight: 500;
    align-self: flex-start;
}

.cc-landing .cm-foot i {
    font-size: 14px;
    color: #6d4aff;
}

.cc-landing .cm-foot b { color: #1a0b2e; font-weight: 700; }

/* ══════════ RIGHT · GLASS FORM ══════════ */
.cc-landing .contact-form-wrap {
    position: relative;
    padding: 32px 32px 28px;
    border-radius: 28px;
    background: linear-gradient(135deg,
        rgba(255, 255, 255, .62) 0%,
        rgba(255, 255, 255, .4) 45%,
        rgba(250, 240, 255, .5) 100%);
    backdrop-filter: blur(30px) saturate(180%);
    -webkit-backdrop-filter: blur(30px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, .9);
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 1),
        inset 0 0 0 1px rgba(255, 255, 255, .25),
        inset -2px -3px 10px rgba(107, 58, 146, .07),
        0 26px 60px -18px rgba(107, 58, 146, .3),
        0 60px 100px -40px rgba(76, 45, 120, .22);
    overflow: hidden;
}

.cc-landing .contact-form-wrap::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, #8b6ff0 0%, #d4799f 50%, #6ecfa8 100%);
    border-radius: 28px 28px 0 0;
    z-index: 2;
}

.cc-landing .contact-form-wrap::after {
    content: "";
    position: absolute;
    top: 0; left: 0;
    width: 65%; height: 45%;
    background: radial-gradient(ellipse at top left,
        rgba(255, 255, 255, .75) 0%,
        rgba(255, 255, 255, .12) 40%,
        transparent 70%);
    border-radius: inherit;
    pointer-events: none;
    z-index: 0;
}

.cc-landing .contact-form-wrap > * { position: relative; z-index: 1; }

/* Head */
.cc-landing .cf-head { margin-bottom: 20px; }

.cc-landing .cf-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 99px;
    background: rgba(155, 111, 216, .14);
    border: 1px solid rgba(155, 111, 216, .3);
    color: #6d4aff;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    margin-bottom: 12px;
}

.cc-landing .cf-pill i { font-size: 12px; }

.cc-landing .cf-head h3 {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 23px;
    font-weight: 700;
    letter-spacing: -.03em;
    color: #1a0b2e;
    margin: 0 0 6px;
    line-height: 1.15;
    text-shadow: 0 1px 0 rgba(255, 255, 255, .5);
}

.cc-landing .cf-head p {
    font-size: 13.5px;
    color: #5a4a6b;
    margin: 0;
}

/* Topic chips */
.cc-landing .cf-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 22px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(107, 58, 146, .1);
}

.cc-landing .cf-topic {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 99px;
    background: rgba(255, 255, 255, .55);
    border: 1px solid rgba(255, 255, 255, .9);
    color: #5a4a6b;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: -.005em;
    cursor: pointer;
    transition: all .28s cubic-bezier(.22, 1, .36, 1);
    font-family: inherit;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .7);
}

.cc-landing .cf-topic i { font-size: 14px; color: #8b7d94; transition: color .22s ease; }

.cc-landing .cf-topic:hover {
    background: rgba(255, 255, 255, .85);
    color: #4b2568;
    transform: translateY(-1px);
    box-shadow: 0 8px 18px -8px rgba(107, 58, 146, .25);
}

.cc-landing .cf-topic:hover i { color: #6d4aff; }

.cc-landing .cf-topic.active {
    background: linear-gradient(135deg, #8b6ff0, #6d4aff);
    color: #fff;
    border-color: rgba(155, 111, 216, .55);
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, .28),
        0 10px 22px -8px rgba(109, 74, 255, .6);
}

.cc-landing .cf-topic.active i { color: #fff; }

/* Form */
.cc-landing .contact-form {
    display: grid;
    gap: 14px;
}

.cc-landing .cf-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
}

.cc-landing .cf-field {
    display: grid;
    gap: 6px;
}

.cc-landing .cf-field label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    color: #3d2f48;
    letter-spacing: .01em;
    text-shadow: 0 1px 0 rgba(255, 255, 255, .6);
}

.cc-landing .cf-count {
    font-size: 11px;
    font-weight: 500;
    color: #a89fb0;
    letter-spacing: .01em;
    text-shadow: none;
}

.cc-landing .cf-count b {
    color: #6d4aff;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
}

/* Glass inputs */
.cc-landing .cf-input {
    display: flex;
    align-items: flex-start;
    background: rgba(255, 255, 255, .6);
    border: 1.5px solid rgba(255, 255, 255, .75);
    border-radius: 14px;
    transition: all .25s ease;
    overflow: hidden;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, .95),
        inset 0 -1px 3px rgba(107, 58, 146, .05);
}

.cc-landing .cf-input:hover {
    border-color: rgba(255, 255, 255, .95);
    background: rgba(255, 255, 255, .72);
}

.cc-landing .cf-input:focus-within {
    border-color: rgba(123, 92, 231, .65);
    background: rgba(255, 255, 255, .92);
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 1),
        0 0 0 4px rgba(123, 92, 231, .15);
}

.cc-landing .cf-input i.ico {
    width: 42px;
    padding-top: 14px;
    text-align: center;
    color: #a89fb0;
    font-size: 15px;
    transition: color .2s ease;
    flex: none;
}

.cc-landing .cf-input:focus-within i.ico { color: #6d4aff; }

.cc-landing .cf-input input,
.cc-landing .cf-input textarea {
    flex: 1;
    border: 0;
    background: transparent;
    padding: 13px 14px 13px 0;
    font: inherit;
    font-size: 14px;
    color: #1a0b2e;
    outline: none;
    font-family: inherit;
    font-weight: 500;
    resize: vertical;
    min-height: 46px;
}

.cc-landing .cf-input textarea {
    min-height: 110px;
    padding-top: 13px;
    line-height: 1.55;
}

.cc-landing .cf-input input::placeholder,
.cc-landing .cf-input textarea::placeholder {
    color: #a89fb0;
    font-weight: 400;
}

/* Submit */
.cc-landing .cf-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    margin-top: 6px;
    padding: 15px;
    border-radius: 14px;
    background: linear-gradient(135deg, #8b6ff0, #6d4aff);
    border: 1px solid rgba(109, 74, 255, .9);
    color: #fff;
    font-size: 14.5px;
    font-weight: 700;
    cursor: pointer;
    transition: all .28s cubic-bezier(.22, 1, .36, 1);
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, .25),
        0 14px 32px -12px rgba(109, 74, 255, .6);
    font-family: inherit;
    letter-spacing: -.005em;
    position: relative;
    overflow: hidden;
}

.cc-landing .cf-submit::after {
    content: "";
    position: absolute;
    top: 0; left: -120%;
    width: 60%; height: 100%;
    background: linear-gradient(100deg, transparent 20%, rgba(255, 255, 255, .35) 50%, transparent 80%);
    transform: skewX(-22deg);
    transition: left .8s cubic-bezier(.22, 1, .36, 1);
    pointer-events: none;
}

.cc-landing .cf-submit:hover::after { left: 130%; }

.cc-landing .cf-submit:hover {

                    </div>
                </div>

                <!-- Main footer -->
                <div class="footer-wrap">

                    <div class="footer-top">

                        <div class="footer-brand">
                            <a class="brand" asp-controller="Home" asp-action="Index">
                                <span class="brand-mark"><svg><use href="#cc-logo" /></svg></span>
                                <span class="brand-name"><b>Cash</b><span>Campus</span></span>
                            </a>

                            <p>Smart spending, student style. A calm, no-bank-required way to track income, notice patterns, and save more — one small choice at a time.</p>

                            <div class="footer-badges">
                                <span><i class="ri-shield-check-line"></i> No bank link</span>
                                <span><i class="ri-graduation-cap-line"></i> Student-first</span>
                                <span><i class="ri-lock-line"></i> Private by default</span>
                            </div>

                            <div class="footer-trust-row" aria-label="CashCampus promises">
                                <span class="footer-trust-pill"><i class="ri-shield-check-line"></i> No bank link</span>
                                <span class="footer-trust-pill"><i class="ri-lock-line"></i> Private by default</span>
                                <span class="footer-trust-pill"><i class="ri-graduation-cap-line"></i> Student-first</span>
                            </div>
                        </div>

                        <div class="footer-cols">
                            <div class="footer-col">
                                <h5>Product</h5>
                                <ul>
                                    <li><a href="/#features">Features</a></li>
                                    <li><a href="/#ai">AI insights</a></li>
                                    <li><a href="/#categories">Categories</a></li>
                                    <li><a href="/#sitemap">Sitemap</a></li>
                                </ul>
                            </div>

                            <div class="footer-col">
                                <h5>Account</h5>
                                <ul>
                                    <li><a asp-controller="Account" asp-action="Login">Sign in</a></li>
                                    <li><a asp-controller="Account" asp-action="Register">Create account</a></li>
                                    <li><a href="/Home/Privacy">Privacy</a></li>
                                </ul>
                            </div>

                            <div class="footer-col">
                                <h5>Company</h5>
                                <ul>
                                    <li><a href="/#how">How it works</a></li>
                                    <li><a href="/#about">About us</a></li>
                                    <li><a href="/#contact">Contact</a></li>
                                    <li><a href="/#sitemap">Sitemap</a></li>
                                </ul>
                            </div>
                        </div>

                    </div>

                    <!-- Bottom bar -->
                    <div class="footer-bottom">
                        <span>© 2026 <b>CashCampus</b> · Made with intention.</span>
                        <div class="footer-legal">
                            <a href="/Home/Terms">Terms</a>
                            <span>·</span>
                            <a href="/Home/Privacy">Privacy</a>
                            <span>·</span>
                           <a href="/Home/Cookies">Cookies</a>
                        </div>
                    </div>

                </div>
            </footer>

            <!-- Back to top -->
            <button class="back-to-top" id="ccBackTop" aria-label="Back to top">
                <i class="ri-arrow-up-line"></i>
            </button>

        </div>
    }

    <div class="toast" data-toast>
        <i class="ri-check-line"></i><span>Changes saved</span>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="~/javascript/site.js" asp-append-version="true"></script>

    <!-- ═══════════════════════════════════════════════════════════
         GLOBAL THEME TOGGLE
         ═══════════════════════════════════════════════════════════ -->
    <script>
        (function () {
            var STORAGE_KEY = 'campuscoin-theme';
            var html = document.documentElement;
            var body = document.body;

            function applyTheme(theme, persist) {
                var isDark = theme === 'dark';

                html.classList.toggle('dark', isDark);
                html.classList.toggle('light', !isDark);

                body.classList.toggle('dark-mesh', isDark);
                body.classList.toggle('light-mesh', !isDark);

                if (persist) {
                    localStorage.setItem(STORAGE_KEY, theme);
                }

                /* Re-theme any Chart.js instances on the page */
                if (window.Chart && Chart.instances) {
                    var textColor = isDark ? 'rgba(226,232,240,.65)' : 'rgba(26,11,46,.55)';
                    var gridColor = isDark ? 'rgba(255,255,255,.06)' : 'rgba(26,11,46,.07)';
                    Object.values(Chart.instances).forEach(function (c) {
                        if (!c || !c.options) return;
                        if (c.options.plugins && c.options.plugins.legend && c.options.plugins.legend.labels) {
                            c.options.plugins.legend.labels.color = textColor;
                        }
                        if (c.options.scales) {
                            ['x', 'y'].forEach(function (axis) {
                                var a = c.options.scales[axis];
                                if (!a) return;
                                if (a.ticks) a.ticks.color = textColor;
                                if (a.grid)  a.grid.color  = gridColor;
                            });
                        }
                        try { c.update(); } catch (_) { /* noop */ }
                    });
                }
            }

            function syncToggleIcons() {
                document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
                    var isDark = html.classList.contains('dark');
                    btn.setAttribute('aria-pressed', isDark ? 'true' : 'false');
                });
            }

            document.addEventListener('click', function (e) {
                var btn = e.target.closest('[data-theme-toggle]');
                if (!btn) return;

                var next = html.classList.contains('dark') ? 'light' : 'dark';
                applyTheme(next, true);
                syncToggleIcons();
            });

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', syncToggleIcons);
            } else {
                syncToggleIcons();
            }

            window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
                if (localStorage.getItem(STORAGE_KEY)) return;
                applyTheme(e.matches ? 'dark' : 'light', false);
                syncToggleIcons();
            });
        })();
    </script>

    @if (!isAppShell && !isAuthPage)
    {
        <script>
            (function () {
                const nav = document.getElementById('ccNav');
                const progress = document.getElementById('ccNavProgress');
                const backTop = document.getElementById('ccBackTop');

                // ─── Nav scroll spy ───
                const sectionLinks = document.querySelectorAll('[data-nav-section]');
                const sectionIds = ['features', 'ai', 'about', 'contact'];
                const sectionEls = {};

                sectionIds.forEach(id => {
                    const el = document.getElementById(id);
                    if (el) sectionEls[id] = el;
                });

                const setActiveSection = (id) => {
                    sectionLinks.forEach(l => {
                        l.classList.toggle('active', l.dataset.navSection === id);
                    });
                };

                const updateActiveSection = () => {
                    if (window.scrollY < 220) {
                        setActiveSection('home');
                        return;
                    }

                    const y = window.scrollY + 140;
                    let current = 'home';

                    sectionIds.forEach(id => {
                        const el = sectionEls[id];
                        if (el && el.offsetTop <= y) current = id;
                    });

                    setActiveSection(current);
                };

                // ─── Unified scroll handler ───
                const onScroll = () => {
                    if (nav) nav.classList.toggle('scrolled', window.scrollY > 10);

                    if (progress) {
                        const max = document.documentElement.scrollHeight - window.innerHeight;
                        const pct = max > 0 ? (window.scrollY / max) * 100 : 0;
                        progress.style.width = pct + '%';
                    }

                    if (backTop) backTop.classList.toggle('show', window.scrollY > 600);

                    updateActiveSection();
                };
                onScroll();
                window.addEventListener('scroll', onScroll, { passive: true });
                window.addEventListener('resize', onScroll, { passive: true });

                // ─── Back to top ───
                backTop?.addEventListener('click', () =>
                    window.scrollTo({ top: 0, behavior: 'smooth' }));

                // ─── Section link click → smooth scroll + immediate active ───
                sectionLinks.forEach(link => {
                    link.addEventListener('click', (e) => {
                        const id = link.dataset.navSection;

                        if (id === 'home') {
                            if (window.location.pathname === '/' || window.location.pathname === '') {
                                e.preventDefault();
                                window.scrollTo({ top: 0, behavior: 'smooth' });
                                setActiveSection('home');
                                history.replaceState(null, '', '/');
                            }
                            return;
                        }

                        const target = sectionEls[id];
                        if (!target) return;

                        e.preventDefault();

                        const navH = nav ? nav.offsetHeight : 70;
                        const top = target.getBoundingClientRect().top + window.scrollY - navH - 12;

                        window.scrollTo({ top, behavior: 'smooth' });
                        setActiveSection(id);
                        history.replaceState(null, '', '#' + id);
                    });
                });

                // ═══════════════════════════════════════════════════════
                // MOBILE DRAWER
                // ═══════════════════════════════════════════════════════
                const drawer = document.getElementById('ccDrawer');

                const openDrawer = () => {
                    drawer?.classList.add('open');
                    document.body.style.overflow = 'hidden';
                };

                const closeDrawer = () => {
                    drawer?.classList.remove('open');
                    document.body.style.overflow = '';
                };

                document.querySelectorAll('[data-nav-open]').forEach(b =>
                    b.addEventListener('click', openDrawer));
                document.querySelectorAll('[data-nav-close]').forEach(b =>
                    b.addEventListener('click', closeDrawer));

                document.addEventListener('keydown', e => {
                    if (e.key === 'Escape') closeDrawer();
                });

                /* Auto-close the drawer when leaving mobile width */
                const DESKTOP_BP = 1025;
                let wasMobile = window.innerWidth < DESKTOP_BP;

                window.addEventListener('resize', () => {
                    const isMobile = window.innerWidth < DESKTOP_BP;
                    if (wasMobile && !isMobile) closeDrawer();
                    wasMobile = isMobile;
                }, { passive: true });

                // ─── Newsletter: JS validation + real subscribe ───
                (function () {
                    const form = document.getElementById('newsletterForm');
                    if (!form) return;
                    const emailInput = document.getElementById('nl-email');
                    const err = document.getElementById('nl-emailError');
                    const btn = document.getElementById('nl-submit');
                    const AT = String.fromCharCode(64);
                    const emailRe = new RegExp('^[^\\s' + AT + ']+' + AT + '[^\\s' + AT + ']+\\.[^\\s' + AT + ']+$');

                    function showErr(msg) {
                        if (emailInput) emailInput.classList.add('invalid');
                        form.classList.add('invalid');
                        if (err) { err.textContent = msg; err.classList.add('show'); }
                    }
                    function clearErr() {
                        if (emailInput) emailInput.classList.remove('invalid');
                        form.classList.remove('invalid');
                        if (err) { err.textContent = ''; err.classList.remove('show'); }
                    }
                    if (emailInput) emailInput.addEventListener('input', clearErr);

                    form.addEventListener('submit', async (e) => {
                        e.preventDefault();
                        clearErr();
                        let email = (emailInput && emailInput.value || '').trim();
                        // Ignore accidental whitespace / placeholder-looking empty
                        if (!email || email.toLowerCase() === 'you@university.edu') {
                            showErr('Please type your email address.');
                            if (emailInput) emailInput.focus();
                            return;
                        }
                        if (!emailRe.test(email)) {
                            showErr('Enter a valid email like name@university.edu');
                            if (emailInput) emailInput.focus();
                            return;
                        }

                        const original = btn ? btn.innerHTML : '';
                        if (btn) { btn.disabled = true; btn.innerHTML = 'Subscribing…'; }
                        try {
                            const res = await fetch('/Home/Newsletter', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                                body: JSON.stringify({ email })
                            });
                            const raw = await res.text();
                            let data = {};
                            try { data = JSON.parse(raw); } catch (_) {}
                            if (res.ok && data.success) {
                                form.reset();
                                window.dispatchEvent(new CustomEvent('cc:toast', { detail: data.message || 'Subscribed — check your inbox ✨' }));
                            } else {
                                showErr(data.message || 'Could not subscribe. Please try again.');
                            }
                        } catch (err) {
                            showErr('Network error. Please try again.');
                        } finally {
                            if (btn) { btn.disabled = false; btn.innerHTML = original; }
                        }
                    });
                })();

                // ─── Toast bridge (used by newsletter form) ───
                window.addEventListener('cc:toast', (e) => {
                    const t = document.querySelector('[data-toast]');
                    if (!t) return;
                    t.querySelector('span').textContent = e.detail || 'Changes saved';
                    t.classList.add('show');
                    clearTimeout(window.__ccToastT);
                    window.__ccToastT = setTimeout(() => t.classList.remove('show'), 2600);
                });
            })();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
    <!-- ══════════ RIGHT · Glass form ══════════ -->
    <main class="lg-form-panel">
        <div class="lg-card-wrap">

            <span class="lg-hello">
                <span class="lg-hello-dot"></span>
                Free forever · no card
            </span>

            <div class="lg-head">
                <h2>Let's get<br>you <em>started.</em></h2>
                <p>Set up your student money space in under a minute.</p>
                <span class="lg-head-accent"></span>
            </div>

            <div id="errorAlert" style="display:none; margin-bottom:16px; padding:12px 16px; border-radius:12px; background:rgba(239,68,68,0.12); border:1px solid rgba(239,68,68,0.3); color:#b91c1c; font-size:13px; font-weight:600;"></div>
            <form id="registerForm" onsubmit="return handleRegister(event);" method="post" action="#">
                

                <div class="lg-field">
                    <label for="name">Full name</label>
                    <div class="lg-input">

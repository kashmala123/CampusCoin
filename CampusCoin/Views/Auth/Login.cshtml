@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CampusCoin - Login</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <link rel="apple-touch-icon" href="/favicon.svg?v=4" />
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50:'#f6effc',
                            100:'#ede4f6',
                            400: '#a486e0',
                            500: '#8b58b8',
                            600: '#6b3a92',
                        }
                    },
                    fontFamily: {
                        sans: ['SF Pro Display', '-apple-system', 'BlinkMacSystemFont', 'Inter', 'Segoe UI', 'Roboto', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { transition: background-color 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease, color 0.3s ease; }
        body.light-mesh {
            background-color: #fbf6f0;
            background-image: 
                radial-gradient(at 0% 0%, rgba(186, 230, 253, 0.85) 0px, transparent 50%),
                radial-gradient(at 100% 0%, rgba(221, 214, 254, 0.85) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(165, 243, 252, 0.8) 0px, transparent 50%),
                radial-gradient(at 0% 100%, rgba(252, 231, 243, 0.85) 0px, transparent 50%),
                radial-gradient(at 50% 50%, rgba(254, 240, 138, 0.5) 0px, transparent 50%);
            background-attachment: fixed;
        }
        body.dark-mesh {
            background-color: #100a1a;
            background-image: 
                radial-gradient(at 10% 10%, rgba(99, 102, 241, 0.28) 0px, transparent 50%),
                radial-gradient(at 90% 10%, rgba(168, 85, 247, 0.22) 0px, transparent 50%),
                radial-gradient(at 90% 90%, rgba(14, 165, 233, 0.28) 0px, transparent 50%),
                radial-gradient(at 10% 90%, rgba(236, 72, 153, 0.2) 0px, transparent 50%);
            background-attachment: fixed;
        }
        .orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(80px);
            z-index: -1;
            pointer-events: none;
            animation: floatOrb 18s infinite alternate ease-in-out;
        }
        .orb-1 { width: 450px; height: 450px; background: rgba(192, 132, 252, 0.4); top: -100px; left: -100px; }
        .orb-2 { width: 480px; height: 480px; background: rgba(56, 189, 248, 0.45); top: 30%; right: -120px; animation-delay: -5s; }
        .orb-3 { width: 400px; height: 400px; background: rgba(251, 113, 133, 0.35); bottom: -100px; left: 20%; animation-delay: -10s; }
        @@keyframes floatOrb {
            0% { transform: translate(0px, 0px) scale(1); }
            50% { transform: translate(40px, 60px) scale(1.08); }
            100% { transform: translate(-30px, 30px) scale(0.95); }
        }
        .ios-glass {
            backdrop-filter: blur(32px) saturate(240%);
            -webkit-backdrop-filter: blur(32px) saturate(240%);
        }
        .light .ios-glass {
            background: rgba(255, 255, 255, 0.75);
            border: 1.5px solid rgba(255, 255, 255, 0.95);
            box-shadow: 0 20px 40px -12px rgba(14, 165, 233, 0.15), 0 4px 16px -2px rgba(0, 0, 0, 0.04);
            color: #0f172a;
        }
        .dark .ios-glass {
            background: rgba(18, 24, 38, 0.65);
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            color: #f8fafc;
        }
    </style>
</head>
<body class="light-mesh min-h-screen text-slate-900 dark:text-slate-100 flex items-center justify-center p-4">

    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>

    <div class="max-w-md w-full ios-glass rounded-3xl p-8 shadow-2xl relative">
        <!-- Theme Toggle Button -->
        <button onclick="toggleTheme()" class="absolute top-6 right-6 w-9 h-9 rounded-2xl ios-glass flex items-center justify-center text-slate-700 dark:text-amber-300">
            <i id="themeIcon" class="fa-solid fa-moon"></i>
        </button>

        <!-- Brand Header -->
        <div class="flex items-center gap-3 mb-6">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-sky-400 via-blue-500 to-indigo-500 flex items-center justify-center text-white text-2xl font-black shadow-lg shadow-sky-500/30">
                <i class="fa-solid fa-coins"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold tracking-tight bg-gradient-to-r from-blue-600 via-indigo-500 to-sky-400 dark:from-white dark:via-sky-200 dark:to-indigo-300 bg-clip-text text-transparent">
                    CampusCoin
                </h1>
                <p class="text-xs font-semibold text-slate-500 dark:text-slate-400">Sign in to your financial companion</p>
            </div>
        </div>

        <div id="errorAlert" class="hidden mb-4 p-3 rounded-2xl bg-rose-500/15 border border-rose-500/30 text-rose-700 dark:text-rose-300 text-xs font-bold">
        </div>

        <!-- Student login (this page) vs. separate, direct-access Admin portal -->
        <div class="flex p-1 rounded-2xl bg-slate-500/10 mb-6">
            <span class="flex-1 py-2 text-xs font-bold rounded-xl bg-white dark:bg-slate-800 shadow-sm text-sky-600 dark:text-sky-400 text-center">
                <i class="fa-solid fa-graduation-cap me-1"></i> Student
            </span>
            <a href="/Auth/AdminLogin" class="flex-1 py-2 text-xs font-bold rounded-xl text-slate-500 hover:text-slate-800 dark:hover:text-white transition-all text-center">
                <i class="fa-solid fa-shield-halved me-1"></i> Admin Portal
            </a>
        </div>

        <!-- Login Form -->
        <form id="loginForm" onsubmit="handleLogin(event)" class="space-y-4">
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-1">Email Address</label>
                <div class="relative">
                    <i class="fa-solid fa-envelope absolute left-3.5 top-3.5 text-slate-400 text-xs"></i>
                    <input type="email" id="loginEmail" value="alex@campuscoin.com" required placeholder="alex@campuscoin.com" class="w-full pl-9 pr-4 py-2.5 rounded-2xl ios-glass border border-slate-300/80 dark:border-slate-700 text-sm font-semibold text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-sky-400">
                </div>
            </div>

            <div>
                <div class="flex justify-between items-center mb-1">
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400">Password</label>
                    <a href="/Auth/ForgotPassword" class="text-[11px] font-bold text-sky-600 dark:text-sky-400 hover:underline">Forgot?</a>
                </div>
                <div class="relative">
                    <i class="fa-solid fa-lock absolute left-3.5 top-3.5 text-slate-400 text-xs"></i>
                    <input type="password" id="loginPassword" value="" required placeholder="••••••••" class="w-full pl-9 pr-4 py-2.5 rounded-2xl ios-glass border border-slate-300/80 dark:border-slate-700 text-sm font-semibold text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-sky-400">
                </div>
            </div>

            <div class="flex items-center gap-2">
                <input type="checkbox" id="rememberMe" checked class="rounded text-sky-500 focus:ring-sky-400 h-4 w-4">
                <label for="rememberMe" class="text-xs font-semibold text-slate-600 dark:text-slate-400">Stay signed in for 12 hours</label>
            </div>

            <button type="submit" id="submitBtn" class="w-full py-3 rounded-2xl bg-gradient-to-r from-sky-400 via-blue-500 to-indigo-500 text-white font-bold text-xs uppercase tracking-wider shadow-lg shadow-sky-500/30 active:scale-95 transition-all">
                Sign In
            </button>
        </form>

        <!-- Quick 1-Click Demo Login Shortcut for Testing/Grading -->
        <div class="mt-6 pt-5 border-t border-slate-300/60 dark:border-slate-700/60">
            <span class="block text-center text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-2">1-Click Demo Login</span>
            <div class="grid grid-cols-1 gap-2">
                <button type="button" onclick="setDemoCredentials('alex@campuscoin.com', '')" class="py-2 px-3 rounded-2xl ios-glass text-[11px] font-bold text-slate-700 dark:text-slate-200 hover:bg-slate-500/10">
                    <i class="fa-solid fa-user me-1 text-sky-500"></i> Student Demo
                </button>
            </div>
            <p class="text-center text-[10px] text-slate-400 mt-2">
                Administrator? <a href="/Auth/AdminLogin" class="font-bold text-indigo-500 hover:underline">Use the direct admin login &rarr;</a>
            </p>
        </div>

        <div class="mt-6 text-center text-xs text-slate-500 dark:text-slate-400 font-semibold">
            Don't have an account? 
            <a href="/Auth/Register" class="text-sky-600 dark:text-sky-400 font-bold hover:underline">Register here</a>
        </div>
    </div>

    <script>
        function toggleTheme() {
            const html = document.documentElement;
            const themeIcon = document.getElementById('themeIcon');
            const isDark = html.classList.contains('dark');
            if (isDark) {
                html.classList.remove('dark');
                html.classList.add('light');
                document.body.classList.remove('dark-mesh');
                document.body.classList.add('light-mesh');
                themeIcon.className = 'fa-solid fa-moon';
            } else {
                html.classList.remove('light');
                html.classList.add('dark');
                document.body.classList.remove('light-mesh');
                document.body.classList.add('dark-mesh');
                themeIcon.className = 'fa-solid fa-sun text-amber-300';
            }
        }

        function setDemoCredentials(email, pass) {
            document.getElementById('loginEmail').value = email;
            document.getElementById('loginPassword').value = pass;
        }

        async function handleLogin(e) {
            e.preventDefault();
            const email = document.getElementById('loginEmail').value.trim();
            const password = document.getElementById('loginPassword').value;
            const rememberMe = document.getElementById('rememberMe').checked;
            const btn = document.getElementById('submitBtn');
            const alertBox = document.getElementById('errorAlert');

            btn.innerText = 'Signing In...';
            btn.disabled = true;
            alertBox.classList.add('hidden');

            try {
                const res = await fetch('/Auth/Login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email, password, rememberMe })
                });

                // Read as text first: a server crash can return an HTML error page,
                // which would make res.json() throw and hide the real problem.
                const raw = await res.text();
                let data = {};
                try { data = JSON.parse(raw); } catch (_) { /* not JSON */ }

                if (res.ok && data.success) {
                    window.location.href = data.redirectUrl || '/';
                } else {
                    alertBox.innerText = data.message || ('Login failed (HTTP ' + res.status + '). Check the app console for the server error.');
                    alertBox.classList.remove('hidden');
                    btn.innerText = 'Sign In';
                    btn.disabled = false;
                }
            } catch (err) {
                alertBox.innerText = 'Network or server error during sign in.';
                alertBox.classList.remove('hidden');
                btn.innerText = 'Sign In';
                btn.disabled = false;
            }
        }
    </script>
</body>
</html>

           GENERIC REVEAL
           ════════════════════════════════════════════════════════════ */
        .cc-landing .reveal-item.reveal-item {
            opacity: 1;
            transform: none;
            filter: none;
            transition:
                opacity 1s cubic-bezier(.16, 1, .3, 1),
                transform 1.1s cubic-bezier(.16, 1, .3, 1),
                filter .9s cubic-bezier(.16, 1, .3, 1) !important;
            will-change: opacity, transform, filter;
        }
        .cc-landing .reveal-item.reveal-item.reveal-hidden {
            opacity: 0;
            transform: translateY(70px) scale(.9);
            filter: blur(10px);
            transition:
                opacity 1s cubic-bezier(.16, 1, .3, 1),
                transform 1.1s cubic-bezier(.16, 1, .3, 1),
                filter .9s cubic-bezier(.16, 1, .3, 1) !important;
        }
        .cc-landing .reveal-item.reveal-item.reveal-hidden.from-left  { transform: translateX(-90px); }
        .cc-landing .reveal-item.reveal-item.reveal-hidden.from-right { transform: translateX(90px); }
        .cc-landing .reveal-item.reveal-item.reveal-hidden.from-zoom  { transform: scale(.82) translateY(30px); }

        .cc-landing .section-head.reveal-group > * {
            opacity: 0;
            transform: translateY(28px);
            transition: opacity .95s cubic-bezier(.16, 1, .3, 1), transform .95s cubic-bezier(.16, 1, .3, 1);

    <script>
        let allTransactions = [];
        let filteredTransactions = [];
        let allCategories = [];
        let cashFlowChart = null;
        let expenseCatChart = null;
        let _lastSuggestion = null;
        let _suggestTimer = null;

        document.addEventListener("DOMContentLoaded", async function () {
            initializeTheme();
            setDate();
            setTodayDate();
            await Promise.all([loadUserInfo(), loadCategories(), loadTransactions()]);
        });

        function setDate() {
            document.getElementById("currentDate").textContent = new Date().toLocaleDateString("en-US", {
                weekday: "short", month: "long", day: "numeric", year: "numeric"
            });
        }

        function setTodayDate() {
            const today = new Date().toISOString().split('T')[0];
            const dt = document.getElementById('txDate');
            if (dt) dt.value = today;
        }

        // ================= USER INFO =================
        async function loadUserInfo() {
            try {
                const res = await fetch('/api/dashboard/summary');
                if (!res.ok) return;
                const data = await res.json();
                if (data.userName) {
                    const initials = data.userName.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);
                    document.getElementById('sidebarAvatar').textContent = initials;
                    document.getElementById('sidebarStudentName').textContent = data.userName;
                    var topName = document.getElementById('topStudentName');
                    if (topName) topName.textContent = data.userName;
                    var topAv = document.getElementById('topAvatar');
                    if (topAv) topAv.textContent = data.userName.split(' ').map(function(n){return n[0];}).join('').toUpperCase().slice(0,2);
                }
                if (data.userAcademicYear) document.getElementById('sidebarStudentRole').textContent = data.userAcademicYear;
            } catch (err) { console.error(err); }
        }

        // ================= CATEGORIES =================
        async function loadCategories() {
            try {
                const res = await fetch('/api/categories', { credentials: 'same-origin' });
                if (!res.ok) return;
                const data = await res.json();
                allCategories = Array.isArray(data) ? data : [];

                const filterCat = document.getElementById('filterCategory');
                if (filterCat) {
                    filterCat.innerHTML = '<option value="all">All Categories</option>' +
                        allCategories.map(c => `<option value="${c.name}">${c.name}</option>`).join('');
                }
                // Fill add/edit dropdowns for current type (default Expense)
                refreshCategoryOptions(document.getElementById('txType')?.value || 'Expense', 'txCategory');
                refreshCategoryOptions(document.getElementById('editType')?.value || 'Expense', 'editCategory');
            } catch (err) { console.error(err); }
        }

        /** Show only categories that match Income or Expense */
        function refreshCategoryOptions(type, selectId) {
            const sel = document.getElementById(selectId);
            if (!sel) return;
            const prev = sel.value;
            const want = (type || 'Expense').toLowerCase();
            let list = allCategories.filter(c => String(c.type || '').toLowerCase() === want);
            // Fallback: if no income categories seeded, still show all so user can pick
            if (!list.length) list = allCategories.slice();
            const options = list.map(c =>
                `<option value="${c.name}">${c.name}${c.type ? ' (' + c.type + ')' : ''}</option>`
            ).join('');
            sel.innerHTML = '<option value="">-- Select --</option>' + options;
            if (prev && [...sel.options].some(o => o.value === prev)) sel.value = prev;
        }

        // ================= LOAD TRANSACTIONS =================
        async function loadTransactions() {
            try {
                const res = await fetch('/api/transactions');
                if (!res.ok) throw new Error('Failed to load transactions');
                allTransactions = await res.json();
                filteredTransactions = [...allTransactions];

                renderTable(filteredTransactions);
                updateKPIs();
                renderCharts();
            } catch (err) {
                console.error('Error loading transactions:', err);
                document.getElementById('transactionTableBody').innerHTML =
                    '<tr><td colspan="7" class="text-center py-6 text-rose-500">Failed to load transactions</td></tr>';
            }
        }

        // ================= RENDER TABLE =================
        function renderTable(data) {
            const tbody = document.getElementById('transactionTableBody');

            if (!data.length) {
                tbody.innerHTML = '<tr><td colspan="7" class="text-center py-6 opacity-40">No transactions found</td></tr>';
                return;
            }

            tbody.innerHTML = data.map(t => {
                const isIncome = t.type === "Income";
                const amountClass = isIncome ? "text-emerald-500 font-bold" : "text-rose-500 font-bold";
                const amountSign = isIncome ? "+" : "-";
                const statusClass = t.isRecurring ? "recurring" : "completed";
                const statusText = t.isRecurring ? "Recurring" : "Completed";

                return `
                    <tr class="hover:bg-slate-500/5 transition-colors">
                        <td class="font-bold">${t.title}</td>
                        <td>
                            <span class="px-2 py-0.5 rounded-full text-[8px] font-bold bg-purple-600/10 text-purple-700 dark:text-purple-400">
                                ${t.category}
                            </span>
                        </td>
                        <td class="opacity-70">${t.date}</td>
                        <td>${t.type}</td>
                        <td class="${amountClass}">${amountSign}Rs. ${t.amount.toFixed(2)}</td>
                        <td><span class="status ${statusClass}">${statusText}</span></td>
                        <td class="text-right whitespace-nowrap">
                            ${!isIncome ? `<button onclick='openSplitFromTx(${JSON.stringify({ id: t.id, title: t.title, amount: t.amount })})' class="text-slate-400 hover:text-purple-600 p-1.5 transition-colors" title="Split with roommates"><i class="fa-solid fa-people-arrows"></i></button>` : ''}
                            <button onclick="openEditModal(${t.id})" class="text-slate-400 hover:text-purple-600 p-1.5 transition-colors" title="Edit">
                                <i class="fa-regular fa-pen-to-square"></i>
                            </button>
                            <button onclick="deleteTransaction(${t.id})" class="text-slate-400 hover:text-rose-500 p-1.5 transition-colors" title="Delete">
                                <i class="fa-regular fa-trash-can"></i>
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // ================= KPIs =================
        function updateKPIs() {
            const income = allTransactions.filter(t => t.type === 'Income').reduce((s, t) => s + t.amount, 0);
            const expense = allTransactions.filter(t => t.type === 'Expense').reduce((s, t) => s + t.amount, 0);
            const balance = income - expense;

            document.getElementById('totalBalance').textContent = `Rs. ${balance.toFixed(2)}`;
            document.getElementById('totalIncome').textContent = `Rs. ${income.toFixed(2)}`;
            document.getElementById('totalExpenses').textContent = `Rs. ${expense.toFixed(2)}`;
        }

        // ================= CHARTS =================
        async function renderCharts() {
            const colors = getChartColors();

            try {
                const res = await fetch('/api/dashboard/charts');
                if (res.ok) {
                    const data = await res.json();
                    const ctx1 = document.getElementById('cashFlowChart').getContext('2d');

                    if (cashFlowChart) cashFlowChart.destroy();

                    cashFlowChart = new Chart(ctx1, {
                        type: 'line',
                        data: {
                            labels: data.cashflow?.labels || [],
                            datasets: [
                                {
                                    label: 'Income',
                                    data: data.cashflow?.incomeData || [],
                                    borderColor: '#059669',
                                    backgroundColor: 'rgba(5,150,105,0.1)',
                                    fill: true,
                                    tension: 0.4,
                                    borderWidth: 3
                                },
                                {
                                    label: 'Expense',
                                    data: data.cashflow?.expenseData || [],
                                    borderColor: '#e11d48',
                                    backgroundColor: 'rgba(225,29,72,0.1)',
                                    fill: true,
                                    tension: 0.4,
                                    borderWidth: 3
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: { legend: { labels: { color: colors.text, font: { size: 10 } } } },
                            scales: {
                                x: { grid: { display: false }, ticks: { color: colors.text, font: { size: 9 } } },
                                y: { grid: { color: colors.grid }, ticks: { color: colors.text, font: { size: 9 } } }
                            }
                        }
                    });

                    const ctx2 = document.getElementById('expenseCategoryChart').getContext('2d');
                    if (expenseCatChart) expenseCatChart.destroy();

                    expenseCatChart = new Chart(ctx2, {
                        type: 'doughnut',
                        data: {
                            labels: data.spendingDonut?.labels || [],
                            datasets: [{
                                data: data.spendingDonut?.data || [],
                                backgroundColor: data.spendingDonut?.colors || ['#a486e0', '#8b58b8', '#6366f1', '#818cf8', '#a78bfa'],
                                borderWidth: 0
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            cutout: '70%',
                            plugins: {
                                legend: {
                                    position: 'bottom',
                                    labels: { color: colors.text, font: { size: 9 }, boxWidth: 10 }
                                }
                            }
                        }
                    });
                }
            } catch (err) { console.error(err); }
        }

        function getChartColors() {
            const dark = document.documentElement.classList.contains("dark");
            return {
                text: dark ? "rgba(226,232,240,.65)" : "rgba(15,23,42,.55)",
                grid: dark ? "rgba(255,255,255,.06)" : "rgba(15,23,42,.07)"
            };
        }

        // ================= FILTER =================
        function filterTable() {
            const search = document.getElementById('tableSearch').value.toLowerCase().trim();
            const type = document.getElementById('filterType').value;
            const category = document.getElementById('filterCategory').value;

            filteredTransactions = allTransactions.filter(t => {
                const matchSearch = !search || t.title.toLowerCase().includes(search);
                const matchType = type === 'all' || t.type === type;
                const matchCat = category === 'all' || t.category === category;
                return matchSearch && matchType && matchCat;
            });

            renderTable(filteredTransactions);
        }

        function handleTopSearch(val) {
            document.getElementById('tableSearch').value = val;
            filterTable();
        }

        // ================= ADD =================
        function openAddTransactionModal() {
            const type = document.getElementById('txType')?.value || 'Expense';
            refreshCategoryOptions(type, 'txCategory');
            document.getElementById('addModal').classList.add('show');
        }

        function closeAddModal() {
            document.getElementById('addModal').classList.remove('show');
            document.getElementById('txTitle').value = '';
            document.getElementById('txAmount').value = '';
            setTodayDate();
        }

        async function handleAddTransaction(e) {
            e.preventDefault();

            const title = document.getElementById('txTitle').value.trim();
            const amount = parseFloat(document.getElementById('txAmount').value);
            const type = document.getElementById('txType').value;
            const category = document.getElementById('txCategory').value;
            const date = document.getElementById('txDate').value;

            if (!title || !amount || !category) {
                showToast('Please fill all fields', 'error');
                return;
            }

            const btn = document.getElementById('saveTxBtn');
            const original = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';
            btn.disabled = true;

            try {
                const res = await fetch('/api/transactions', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ title, amount, type, category, date, isRecurring: false, suggestedCategoryId: (typeof _lastSuggestion !== 'undefined' && _lastSuggestion && _lastSuggestion.categoryId) ? _lastSuggestion.categoryId : null })
                });

                if (!res.ok) {
                    const err = await res.json().catch(() => ({}));
                    showToast(err.message || ('Failed to add (HTTP ' + res.status + ')'), 'error');
                    return;
                }

                const data = await res.json().catch(() => ({}));
                closeAddModal();
                showToast('Transaction added!', 'success');
                if (data && data.budgetAlertMessage) showToast(data.budgetAlertMessage, data.budgetAlertSeverity === 'over' ? 'error' : 'success');
                // confetti is optional (CDN may be blocked)
                try {
                    if (type === 'Income' && typeof confetti === 'function') {
                        confetti({ particleCount: 80, spread: 60, origin: { y: 0.7 } });
                    }
                } catch (_) {}
                await loadTransactions();
            } catch (err) {
                console.error(err);
                showToast((err && err.message) ? err.message : 'Error saving', 'error');
            } finally {
                btn.innerHTML = original;
                btn.disabled = false;
            }
        }

        // ================= EDIT =================
        async function openEditModal(id) {
            const tx = allTransactions.find(t => t.id === id);
            if (!tx) return;

            document.getElementById('editId').value = tx.id;
            document.getElementById('editTitle').value = tx.title;
            document.getElementById('editAmount').value = tx.amount;
            document.getElementById('editType').value = tx.type;
            document.getElementById('editCategory').value = tx.category;
            document.getElementById('editDate').value = tx.date;

            document.getElementById('editModal').classList.add('show');
        }

        function closeEditModal() {
            document.getElementById('editModal').classList.remove('show');
        }

        async function handleEditTransaction(e) {
            e.preventDefault();

            const id = document.getElementById('editId').value;
            const title = document.getElementById('editTitle').value.trim();
            const amount = parseFloat(document.getElementById('editAmount').value);
            const type = document.getElementById('editType').value;
            const category = document.getElementById('editCategory').value;
            const date = document.getElementById('editDate').value;

            const btn = document.getElementById('updateTxBtn');
            const original = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Updating...';
            btn.disabled = true;

            try {
                const res = await fetch(`/api/transactions/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: parseInt(id), title, amount, type, category, date })
                });

                if (!res.ok) {
                    showToast('Failed to update', 'error');
                    return;
                }

                closeEditModal();
                showToast('Updated successfully!', 'success');
                await loadTransactions();
            } catch (err) {
                console.error(err);
                showToast('Error updating', 'error');
            } finally {
                btn.innerHTML = original;
                btn.disabled = false;
            }
        }

        // ================= DELETE =================
        async function deleteTransaction(id) {
            if (!confirm('Delete this transaction?')) return;

            try {
                const res = await fetch(`/api/transactions/${id}`, { method: 'DELETE' });
                if (!res.ok) {
                    showToast('Failed to delete', 'error');
                    return;
                }
                showToast('Deleted', 'success');
                await loadTransactions();
            } catch (err) {
                console.error(err);
                showToast('Error deleting', 'error');
            }
        }

        // ================= EXPORT CSV =================
        function exportCSV() {
            if (!allTransactions.length) {
                showToast('No transactions to export', 'error');
                return;
            }

            const headers = ['Title', 'Category', 'Date', 'Type', 'Amount', 'Status'];
            const rows = allTransactions.map(t => [
                `"${t.title}"`,
                t.category,
                t.date,
                t.type,
                t.amount.toFixed(2),
                t.isRecurring ? 'Recurring' : 'Completed'
            ]);

            const csv = [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
            const blob = new Blob([csv], { type: 'text/csv' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `campuscoin-transactions-${new Date().toISOString().slice(0, 10)}.csv`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            window.URL.revokeObjectURL(url);

            showToast('CSV downloaded!', 'success');
        }

        // ================= CSV IMPORT =================
        function openCsvModal() {
            document.getElementById('csvModal').classList.add('show');
            document.getElementById('csvFileInput').value = '';
            document.getElementById('csvPreview').classList.add('hidden');
        }

        function closeCsvModal() {
            document.getElementById('csvModal').classList.remove('show');
        }

        document.getElementById('csvFileInput')?.addEventListener('change', function (e) {
            if (this.files && this.files.length > 0) {
                document.getElementById('csvFileName').textContent = this.files[0].name;
                document.getElementById('csvPreview').classList.remove('hidden');
            } else {
                document.getElementById('csvPreview').classList.add('hidden');
            }
        });

        async function handleCsvUpload(e) {
            e.preventDefault();

            const fileInput = document.getElementById('csvFileInput');
            if (!fileInput.files || fileInput.files.length === 0) {
                showToast('Please select a CSV file', 'error');
                return;
            }

            const file = fileInput.files[0];
            if (!file.name.toLowerCase().endsWith('.csv')) {
                showToast('Only .csv files allowed', 'error');
                return;
            }

            const formData = new FormData();
            formData.append('file', file);

            const btn = document.getElementById('uploadCsvBtn');
            const original = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Importing...';
            btn.disabled = true;

            try {
                const res = await fetch('/api/transactions/import-csv', {
                    method: 'POST',
                    body: formData
                });

                const result = await res.json().catch(() => ({}));

                if (!res.ok) {
                    showToast(result.message || 'Import failed', 'error');
                    return;
                }

                showToast(result.message || 'CSV imported successfully!', 'success');
                if (result.batchSuggestions && result.batchSuggestions.length > 0) {
                    const lines = result.batchSuggestions.slice(0, 8).map(s =>
                        `Row ${s.row}: "${(s.description || '').slice(0, 40)}" → ${s.suggestedCategory} (${s.source})`
                    ).join('\n');
                    showToast(`AI batch suggestions applied to ${result.batchSuggestions.length} row(s). Check categories.`, 'info');
                    console.log('Batch category suggestions:\n' + lines);
                }
                closeCsvModal();

                await loadTransactions();
            } catch (err) {
                console.error('CSV import error:', err);
                showToast('Error importing CSV', 'error');
            } finally {
                btn.innerHTML = original;
                btn.disabled = false;
            }
        }

        
        function addSplitTxPerson(name='') {
            const wrap = document.getElementById('splitTxPeople');
            const row = document.createElement('div');
            row.className = 'flex gap-2';
            row.innerHTML = `<input class="flex-1 px-3 py-2 rounded-xl bg-white/40 dark:bg-white/5 border border-white/50 dark:border-white/10 outline-none stx-name" placeholder="Name" value="${(name||'').replace(/"/g,'&quot;')}" />
                <button type="button" class="glass-btn" onclick="this.parentElement.remove()"><i class="fa-solid fa-xmark"></i></button>`;
            wrap.appendChild(row);
        }
        function openSplitFromTx(t) {
            if (!t || !t.id) return;
            document.getElementById('splitTxId').value = t.id;
            document.getElementById('splitTxDesc').value = t.title || '';
            document.getElementById('splitTxTotal').value = t.amount || '';
            document.getElementById('splitTxIncludeMe').checked = true;
            document.getElementById('splitTxPeople').innerHTML = '';
            addSplitTxPerson();
            addSplitTxPerson();
            document.getElementById('splitFromTxModal').classList.add('show');
        }
        function closeSplitFromTx() {
            document.getElementById('splitFromTxModal').classList.remove('show');
        }
        async function saveSplitFromTx() {
            const existingTransactionId = parseInt(document.getElementById('splitTxId').value, 10);
            const description = document.getElementById('splitTxDesc').value.trim();
            const totalAmount = parseFloat(document.getElementById('splitTxTotal').value);
            const includeMe = document.getElementById('splitTxIncludeMe').checked;
            const participants = [];
            document.querySelectorAll('#splitTxPeople .stx-name').forEach(el => {
                const name = el.value.trim();
                if (name) participants.push({ name });
            });
            if (!description || !totalAmount || !participants.length) {
                showToast('Add description, amount, and at least one roommate', 'error');
                return;
            }
            const btn = document.getElementById('splitTxSaveBtn');
            btn.disabled = true;
            try {
                const res = await fetch('/api/shared-expenses', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({
                        description,
                        totalAmount,
                        equalSplit: true,
                        includeMe,
                        existingTransactionId,
                        participants
                    })
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok) { showToast(data.message || 'Could not create split', 'error'); return; }
                showToast(data.message || 'Split created', 'success');
                closeSplitFromTx();
                // optional: go to bill split
                if (confirm('Split created! Open Bill Split page?')) {
                    window.location.href = '/Dashboard/BillSplit';
                }
            } catch {
                showToast('Network error', 'error');
            } finally {
                btn.disabled = false;
            }
        }

        // ================= THEME =================
        function initializeTheme() {
            if (localStorage.getItem("campuscoin-theme") === "dark") {
                document.documentElement.classList.replace("light", "dark");
                document.body.classList.replace("light-mesh", "dark-mesh");
            }
            updateThemeIcon();
        }

        function toggleTheme() {
            const isDark = document.documentElement.classList.contains("dark");
            if (isDark) {
                document.documentElement.classList.replace("dark", "light");
                document.body.classList.replace("dark-mesh", "light-mesh");
                localStorage.setItem("campuscoin-theme", "light");
            } else {
                document.documentElement.classList.replace("light", "dark");
                document.body.classList.replace("light-mesh", "dark-mesh");
                localStorage.setItem("campuscoin-theme", "dark");
            }
            updateThemeIcon();

            [cashFlowChart, expenseCatChart].forEach(c => {
                if (c) {
                    const colors = getChartColors();
                    if (c.options.plugins.legend.labels) c.options.plugins.legend.labels.color = colors.text;
                    if (c.options.scales?.x) c.options.scales.x.ticks.color = colors.text;
                    if (c.options.scales?.y) {
                        c.options.scales.y.ticks.color = colors.text;
                        c.options.scales.y.grid.color = colors.grid;
                    }
                    c.update();
                }
            });
        }

        function updateThemeIcon() {
            const isDark = document.documentElement.classList.contains("dark");
            document.getElementById("themeIcon").className = isDark ? "fa-solid fa-sun text-amber-300" : "fa-solid fa-moon";
        }

        function toggleSidebar() {
            document.getElementById("sidebar").classList.toggle("open");
            document.getElementById("mobileOverlay").classList.toggle("show");
        }

        function closeSidebar() {
            document.getElementById("sidebar").classList.remove("open");
            document.getElementById("mobileOverlay").classList.remove("show");
        }

        // ================= TOAST =================
        function showToast(message, type = 'info') {
            const container = document.getElementById("toastContainer");
            const toast = document.createElement("div");
            toast.className = "toast ios-glass";

            const iconMap = {
                success: '<i class="fa-solid fa-circle-check text-emerald-500"></i>',
                error: '<i class="fa-solid fa-circle-exclamation text-rose-500"></i>',
                info: '<i class="fa-solid fa-circle-info text-purple-600"></i>'
            };

            toast.innerHTML = `
                <div class="w-9 h-9 rounded-xl bg-purple-600/10 flex items-center justify-center">
                    ${iconMap[type] || iconMap.info}
                </div>
                <div>
                    <div class="text-[10px] font-bold">CampusCoin</div>
                    <div class="text-[9px] opacity-50">${message}</div>
                </div>`;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = "0";
                setTimeout(() => toast.remove(), 300);
            }, 2500);
        }
    </script>

<script src="/js/cc-header-widgets.js" asp-append-version="true"></script>
<script>
        // Category suggestion while typing
        // timer declared above
        // suggestion declared above
        document.addEventListener('DOMContentLoaded', () => {
            const titleEl = document.getElementById('txTitle');
            const typeEl = document.getElementById('txType');
            if (titleEl) {
                titleEl.addEventListener('input', () => {
                    clearTimeout(_suggestTimer);
                    _suggestTimer = setTimeout(suggestCategoryFromTitle, 400);
                });
            }
            if (typeEl) typeEl.addEventListener('change', suggestCategoryFromTitle);
            const applyBtn = document.getElementById('aiSuggestApply');
            if (applyBtn) applyBtn.addEventListener('click', () => {
                if (!_lastSuggestion) return;
                const sel = document.getElementById('txCategory');
                if (!sel) return;
                // try match by text
                for (const opt of sel.options) {
                    if (opt.value === _lastSuggestion.category || opt.text === _lastSuggestion.category
                        || opt.value.toLowerCase() === (_lastSuggestion.category||'').toLowerCase()) {
                        sel.value = opt.value;
                        break;
                    }
                }
                showToast('Category applied: ' + _lastSuggestion.category, 'success');
            });
        });

        async function suggestCategoryFromTitle() {
            const title = (document.getElementById('txTitle')?.value || '').trim();
            const type = document.getElementById('txType')?.value || 'Expense';
            const hint = document.getElementById('aiSuggestHint');
            const text = document.getElementById('aiSuggestText');
            if (!title || title.length < 3) {
                if (hint) hint.classList.add('hidden');
                _lastSuggestion = null;
                return;
            }
            try {
                const res = await fetch('/api/transactions/suggest-category', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ text: title, type })
                });
                if (!res.ok) return;
                const data = await res.json();
                if (data.category) {
                    _lastSuggestion = data;
                    if (text) text.textContent = `Suggested: ${data.category} (${data.source || 'ai'})`;
                    if (hint) hint.classList.remove('hidden');
                    // auto-select if category empty
                    const sel = document.getElementById('txCategory');
                    if (sel && (!sel.value || sel.value === '')) {
                        for (const opt of sel.options) {
                            if (opt.value === data.category || opt.text === data.category) {
                                sel.value = opt.value;
                                break;
                            }
                        }
                    }
                } else {
                    if (hint) hint.classList.add('hidden');
                    _lastSuggestion = null;
                }
            } catch (e) { console.warn(e); }
        }
</script>

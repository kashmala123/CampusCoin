                    <div class="profile" data-cc-profile-btn style="cursor:pointer;display:flex;align-items:center;gap:8px;">
                        <div class="profile-avatar" id="topAvatar" style="width:34px;height:34px;border-radius:11px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:11px;font-weight:800;background:linear-gradient(135deg,#a486e0,#6366f1);">ST</div>
                        <div class="text-[10px] font-bold" id="topStudentName">Student</div>
                        <i class="fa-solid fa-chevron-down text-[8px] opacity-40"></i>
                    </div>
                    <div data-cc-profile-dd class="cc-shared-dd">
                        <a href="/Dashboard/Profile" class="cc-shared-dd-item"><i class="fa-regular fa-user"></i> Profile</a>
                        <a href="/Dashboard/Index" class="cc-shared-dd-item"><i class="fa-solid fa-chart-line"></i> Dashboard</a>
                        <a href="/Auth/Logout" class="cc-shared-dd-item" style="color:#e11d48;"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
                    </div>
                </div>

            </div>
        </header>

        
        <section class="page-header">
            <div>
                <div class="eyebrow">CampusCoin / Student Portal</div>
                <h1 class="page-title">Roommate Bill Split</h1>
                <p class="page-description">Split hostel, canteen, or outing costs and track who still owes you.</p>
            </div>
            <div class="date-pill ios-glass">
                <i class="fa-regular fa-calendar mr-1"></i>
                <span id="currentDate">Loading...</span>
            </div>
        </section>

        <!-- KPI METRICS -->
        <section class="kpi-grid">
            <div class="kpi ios-glass ios-glass-interactive">
                <div class="kpi-icon"><i class="fa-solid fa-folder-open"></i></div>
                <div class="kpi-label">Open splits</div>
                <div class="kpi-value text-purple-600" id="kpiOpen">—</div>
                <div class="kpi-sub">Not fully settled</div>
            </div>
            <div class="kpi ios-glass ios-glass-interactive">
                <div class="kpi-icon"><i class="fa-solid fa-hand-holding-dollar"></i></div>
                <div class="kpi-label">Still owed to you</div>
                <div class="kpi-value text-rose-500" id="kpiOwed">—</div>
                <div class="kpi-sub">Pending from roommates</div>
            </div>
            <div class="kpi ios-glass ios-glass-interactive">
                <div class="kpi-icon"><i class="fa-solid fa-circle-check"></i></div>
                <div class="kpi-label">Settled</div>
                <div class="kpi-value text-emerald-500" id="kpiSettled">—</div>
                <div class="kpi-sub">Fully paid back</div>
            </div>
            <div class="kpi ios-glass ios-glass-interactive">
                <div class="kpi-icon"><i class="fa-solid fa-layer-group"></i></div>
                <div class="kpi-label">All splits</div>
                <div class="kpi-value" id="kpiTotal">—</div>
                <div class="kpi-sub">Lifetime total</div>
            </div>
        </section>

        <!-- CREATE PANEL -->
        <section id="createPanel" class="ios-glass" style="border-radius:27px;padding:22px;margin-top:15px;">
            <div class="flex flex-wrap items-center gap-2 mb-4">
                <div class="font-extrabold text-sm"><i class="fa-solid fa-receipt text-purple-600 mr-1"></i> Create a bill split</div>
                <span class="text-[10px] font-bold opacity-45 ml-auto">Include yourself for fair equal shares</span>
            </div>
            <div class="flex flex-wrap gap-2 mb-3">
                <button type="button" class="glass-btn" onclick="fillQuick('Hostel WiFi')">Hostel WiFi</button>
                <button type="button" class="glass-btn" onclick="fillQuick('Canteen / pizza')">Canteen / pizza</button>
                <button type="button" class="glass-btn" onclick="fillQuick('Group outing')">Group outing</button>
                <button type="button" class="glass-btn" onclick="fillQuick('Shared supplies')">Shared supplies</button>
            </div>
            <div class="grid md:grid-cols-2 gap-3 mb-3">
                <div>
                    <label class="block text-[10px] opacity-60 mb-1.5 font-bold">What did you pay for?</label>
                    <input id="desc" type="text" class="input-field" placeholder="e.g. Hostel WiFi — March" oninput="updatePreview()" />
                </div>
                <div>
                    <label class="block text-[10px] opacity-60 mb-1.5 font-bold">Total amount you paid</label>
                    <input id="total" type="number" min="0.01" step="0.01" class="input-field" placeholder="0.00" oninput="updatePreview()" />
                </div>
            </div>
            <div class="grid md:grid-cols-2 gap-3 mb-3">
                <label class="flex items-center gap-2 text-[12px] font-bold cursor-pointer ios-glass px-3 py-3" style="border-radius:16px;">
                    <input type="checkbox" id="includeMe" checked onchange="updatePreview()" />
                    Include me in the split
                    <span class="text-[10px] font-medium opacity-50">(recommended)</span>
                </label>
                <label class="flex items-center gap-2 text-[12px] font-bold cursor-pointer ios-glass px-3 py-3" style="border-radius:16px;">
                    <input type="checkbox" id="equalSplit" checked onchange="toggleEqual(); updatePreview()" />
                    Equal shares
                </label>
            </div>
            <div class="mb-1">
                <label class="block text-[10px] opacity-60 mb-1.5 font-bold">Roommates / friends</label>
            </div>
            <div id="participants" class="space-y-2 mb-3"></div>
            <button type="button" class="glass-btn mb-3" onclick="addParticipantRow()"><i class="fa-solid fa-user-plus mr-1"></i> Add person</button>
            <div id="previewBox" class="hidden mb-4 text-[12px] px-4 py-3 rounded-2xl" style="background:rgba(139,88,184,.08);border:1px dashed rgba(139,88,184,.25);"></div>
            <div class="flex flex-wrap justify-end gap-2">
                <button type="button" class="glass-btn" onclick="resetForm()">Reset</button>
                <button type="button" class="glass-btn primary-btn" id="saveBtn" onclick="createSplit()"><i class="fa-solid fa-check mr-1"></i> Create split</button>
            </div>
        </section>

        <!-- LIST -->
        <section class="mt-4">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <div class="font-extrabold text-sm">Your splits</div>
                <div class="flex items-center gap-2">
                    <button type="button" class="glass-btn filter-tab active" data-filter="all" onclick="setFilter('all', this)">All</button>
                    <button type="button" class="glass-btn filter-tab" data-filter="open" onclick="setFilter('open', this)">Open</button>
                    <button type="button" class="glass-btn filter-tab" data-filter="settled" onclick="setFilter('settled', this)">Settled</button>
                    <button type="button" class="glass-btn" onclick="loadSplits()"><i class="fa-solid fa-rotate-right"></i></button>
                </div>
            </div>
            <div id="list">
                <div class="ios-glass text-center py-12 text-sm opacity-50" style="border-radius:27px;">Loading…</div>
            </div>
        </section>


    </main>

    
    <!-- EDIT SPLIT MODAL -->
    <div id="editSplitModal" class="modal-overlay">
        <div class="modal-card ios-glass" style="max-width:520px;">
            <div class="flex justify-between items-center mb-4">
                <div class="font-extrabold text-sm">
                    <i class="fa-solid fa-pen text-purple-600 mr-1"></i> Edit bill split
                </div>
                <button type="button" class="action-btn !w-8 !h-8" onclick="closeEditSplit()"><i class="fa-solid fa-xmark text-xs"></i></button>
            </div>
            <input type="hidden" id="editSplitId" />
            <div class="space-y-3 text-xs">
                <div>
                    <label class="block opacity-60 mb-1 font-bold">Description</label>
                    <input id="editDesc" class="input-field" type="text" />
                </div>
                <div>
                    <label class="block opacity-60 mb-1 font-bold">Total amount</label>
                    <input id="editTotal" class="input-field" type="number" min="0.01" step="0.01" />
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <label class="flex items-center gap-2 font-bold cursor-pointer ios-glass px-3 py-2" style="border-radius:14px;">
                        <input type="checkbox" id="editIncludeMe" checked /> Include me
                    </label>
                    <label class="flex items-center gap-2 font-bold cursor-pointer ios-glass px-3 py-2" style="border-radius:14px;">
                        <input type="checkbox" id="editEqualSplit" checked onchange="toggleEditEqual()" /> Equal shares
                    </label>
                </div>
                <div>
                    <label class="block opacity-60 mb-1 font-bold">Roommates</label>
                    <div id="editParticipants" class="space-y-2"></div>
                    <button type="button" class="glass-btn mt-2" onclick="addEditParticipantRow()"><i class="fa-solid fa-user-plus mr-1"></i> Add person</button>
                </div>
                <p class="text-[10px] opacity-50">Settled people keep their settled status if the same name stays.</p>
                <div class="flex gap-2 mt-2">
                    <button type="button" class="glass-btn flex-1 justify-center" onclick="closeEditSplit()">Cancel</button>
                    <button type="button" class="glass-btn primary-btn flex-1 justify-center" id="editSaveBtn" onclick="saveEditSplit()">Save changes</button>
                </div>
            </div>
        </div>
    </div>

    <div id="toastContainer"></div>

    
<script>
        let currentFilter = 'all';
        let _lastSplitItems = [];

        function showToast(message, type = 'success') {
            const container = document.getElementById('toastContainer') || document.body;
            const colors = {
                success: 'bg-emerald-500',
                error: 'bg-rose-500',
                info: 'bg-purple-600'
            };
            const toast = document.createElement('div');
            toast.className = `fixed bottom-6 right-6 z-[99999] px-4 py-3 rounded-2xl text-white text-xs font-bold shadow-lg ${colors[type] || colors.success}`;
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(() => toast.remove(), 3200);
        }

        function money(n) {
            return Number(n || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
        function escapeHtml(s) {
            return String(s || '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
        }
        function fillQuick(text) {
            document.getElementById('desc').value = text;
            updatePreview();
        }
        function addParticipantRow(name = '', amount = '') {
            const wrap = document.getElementById('participants');
            const row = document.createElement('div');
            row.className = 'flex gap-2 items-center participant-row';
            const eq = document.getElementById('equalSplit').checked;
            row.innerHTML = `
                <input class="input-field p-name flex-1" placeholder="Name (e.g. Ali)" value="${escapeHtml(name)}" oninput="updatePreview()" />
                <input class="input-field p-amt w-28 share-amt" type="number" min="0" step="0.01" placeholder="Share" value="${amount}" ${eq ? 'disabled' : ''} oninput="updatePreview()" style="max-width:110px;" />
                <button type="button" class="glass-btn" onclick="this.closest('.participant-row').remove(); updatePreview()"><i class="fa-solid fa-xmark"></i></button>
            `;
            wrap.appendChild(row);
            updatePreview();
        }
        function toggleEqual() {
            const eq = document.getElementById('equalSplit').checked;
            document.querySelectorAll('.share-amt').forEach(el => { el.disabled = eq; if (eq) el.value = ''; });
        }
        function getParticipants() {
            const list = [];
            document.querySelectorAll('.participant-row').forEach(row => {
                const name = row.querySelector('.p-name').value.trim();
                const share = parseFloat(row.querySelector('.p-amt').value);
                if (name) list.push({ name, shareAmount: isNaN(share) ? null : share });
            });
            return list;
        }
        function updatePreview() {
            const box = document.getElementById('previewBox');
            const total = parseFloat(document.getElementById('total').value) || 0;
            const includeMe = document.getElementById('includeMe').checked;
            const equal = document.getElementById('equalSplit').checked;
            const parts = getParticipants();
            if (!total || parts.length === 0) { box.classList.add('hidden'); return; }
            box.classList.remove('hidden');
            let lines = [];
            if (equal) {
                const heads = includeMe ? parts.length + 1 : parts.length;
                const each = total / heads;
                lines.push(`<b>Equal split</b> across <b>${heads}</b> → <b>${money(each)}</b> each`);
                if (includeMe) {
                    lines.push(`Your share: <b>${money(each)}</b> · Roommates owe you: <b>${money(each * parts.length)}</b>`);
                } else {
                    lines.push(`You are owed the full <b>${money(total)}</b>`);
                }
            } else {
                const sum = parts.reduce((a, p) => a + (p.shareAmount || 0), 0);
                lines.push(`Roommate shares: <b>${money(sum)}</b>`);
                if (includeMe) lines.push(`Your implied share: <b>${money(Math.max(0, total - sum))}</b>`);
            }
            box.innerHTML = lines.map(l => `<div>${l}</div>`).join('');
        }
        function resetForm() {
            document.getElementById('desc').value = '';
            document.getElementById('total').value = '';
            document.getElementById('includeMe').checked = true;
            document.getElementById('equalSplit').checked = true;
            document.getElementById('participants').innerHTML = '';
            addParticipantRow();
            addParticipantRow();
            updatePreview();
        }
        async function createSplit() {
            const description = document.getElementById('desc').value.trim();
            const totalAmount = parseFloat(document.getElementById('total').value);
            const equalSplit = document.getElementById('equalSplit').checked;
            const includeMe = document.getElementById('includeMe').checked;
            const participants = getParticipants();
            if (!description || !totalAmount || participants.length === 0) {
                showToast('Add description, amount, and at least one person', 'error');
                return;
            }
            const btn = document.getElementById('saveBtn');
            btn.disabled = true;
            try {
                const res = await fetch('/api/shared-expenses', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ description, totalAmount, equalSplit, includeMe, participants })
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok) { showToast(data.message || 'Failed', 'error'); return; }
                showToast(data.message || 'Split created', 'success');
                resetForm();
                await loadSplits();
            } catch {
                showToast('Network error', 'error');
            } finally {
                btn.disabled = false;
            }
        }
        async function settle(splitId, settleFlag) {
            try {
                const res = await fetch(`/api/shared-expenses/splits/${splitId}/${settleFlag ? 'settle' : 'unsettle'}`, {
                    method: 'POST', credentials: 'same-origin'
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok) { showToast(data.message || 'Failed', 'error'); return; }
                showToast(data.message || 'Updated', 'success');
                await loadSplits();
            } catch { showToast('Network error', 'error'); }
        }
        async function removeSplit(id) {
            if (!confirm('Remove this split? Your expense in Transactions stays.')) return;
            try {
                const res = await fetch(`/api/shared-expenses/${id}`, { method: 'DELETE', credentials: 'same-origin' });
                const data = await res.json().catch(() => ({}));
                if (!res.ok) { showToast(data.message || 'Failed', 'error'); return; }
                showToast(data.message || 'Removed', 'success');
                await loadSplits();
            } catch { showToast('Network error', 'error'); }
        }
        async function copySummary(id) {
            try {
                const res = await fetch(`/api/shared-expenses/${id}/summary-text`, { credentials: 'same-origin' });
                const data = await res.json();
                if (!res.ok) { showToast(data.message || 'Failed', 'error'); return; }
                await navigator.clipboard.writeText(data.text || '');
                showToast('Copied — paste in WhatsApp', 'info');
            } catch { showToast('Could not copy', 'error'); }
        }
        function setFilter(f, el) {
            currentFilter = f;
            document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active', 'primary-btn'));
            el.classList.add('active', 'primary-btn');
            loadSplits();
        }
        async function loadSplits() {
            const box = document.getElementById('list');
            try {
                const res = await fetch('/api/shared-expenses?filter=' + encodeURIComponent(currentFilter), { credentials: 'same-origin' });
                if (res.status === 401) { window.location.href = '/Account/Login'; return; }
                const data = await res.json();
                const s = data.summary || {};
                document.getElementById('kpiOpen').textContent = s.openSplits ?? 0;
                document.getElementById('kpiOwed').textContent = money(s.totalOwedToYou);
                document.getElementById('kpiSettled').textContent = s.settledSplits ?? 0;
                document.getElementById('kpiTotal').textContent = s.totalSplits ?? 0;
                const items = data.items || [];
                _lastSplitItems = items;
                if (!items.length) {
                    box.innerHTML = `<div class="ios-glass text-center py-14" style="border-radius:27px;">
                        <div class="text-3xl mb-2">🧾</div>
                        <div class="font-bold text-sm">No splits yet</div>
                        <div class="text-xs opacity-50 mt-1">Create one when you pay for the group</div>
                    </div>`;
                    return;
                }
                box.innerHTML = items.map(it => `
                    <div class="ios-glass mb-3" style="border-radius:24px;padding:18px;">
                        <div class="flex flex-wrap items-start justify-between gap-2 mb-3">
                            <div>
                                <div class="font-extrabold text-sm">${escapeHtml(it.description || 'Split')}</div>
                                <div class="text-[11px] opacity-50 mt-0.5">
                                    ${new Date(it.createdAt).toLocaleString()} · Total <b>${money(it.totalAmount)}</b>
                                    · ${it.participantCount || 0} people
                                </div>
                            </div>
                            <div class="flex flex-wrap gap-2 items-center">
                                <span class="text-[10px] font-bold px-2.5 py-1 rounded-full ${it.allSettled ? 'bg-emerald-500/15 text-emerald-600' : 'bg-rose-500/10 text-rose-500'}">
                                    ${it.allSettled ? '✓ All settled' : 'Open · ' + money(it.totalOwedToYou) + ' owed'}
                                </span>
                                <button class="glass-btn" title="Edit" onclick="openEditSplitById(${it.id})"><i class="fa-solid fa-pen text-purple-600"></i></button>
                                <button class="glass-btn" title="Copy for WhatsApp" onclick="copySummary(${it.id})"><i class="fa-solid fa-copy"></i></button>
                                <button class="glass-btn" title="Delete" onclick="removeSplit(${it.id})"><i class="fa-solid fa-trash text-rose-500"></i></button>
                            </div>
                        </div>
                        <div class="space-y-2">
                            ${(it.participants || []).map(p => `
                                <div class="flex items-center justify-between gap-2 text-xs px-3 py-2.5 rounded-2xl" style="background:rgba(139,88,184,.07)">
                                    <div>
                                        <b>${escapeHtml(p.name)}</b>
                                        <span class="opacity-50 ml-2">${money(p.shareAmount)}</span>
                                        <span class="ml-2 text-[10px] font-bold ${p.isSettled ? 'text-emerald-600' : 'text-rose-500'}">${p.isSettled ? 'Settled' : 'Pending'}</span>
                                    </div>
                                    <button class="glass-btn ${p.isSettled ? '' : 'primary-btn'}" onclick="settle(${p.splitId}, ${p.isSettled ? 'false' : 'true'})">
                                        ${p.isSettled ? 'Undo' : 'Mark settled'}
                                    </button>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                `).join('');
            } catch {
                box.innerHTML = `<div class="ios-glass text-center py-10 text-rose-500" style="border-radius:27px;">Could not load splits.</div>`;
            }
        }

        // Theme + date (same as other panels)
        function initializeTheme() {
            if (localStorage.getItem("campuscoin-theme") === "dark") {
                document.documentElement.classList.replace("light", "dark");
                document.body.classList.replace("light-mesh", "dark-mesh");
            }
        }
        function toggleTheme() {
            const isDark = document.documentElement.classList.contains("dark");
            if (isDark) {
                document.documentElement.classList.replace("dark", "light");
                document.body.classList.replace("dark-mesh", "light-mesh");
                localStorage.setItem("campuscoin-theme", "light");
            } else {
                document.documentElement.classList.replace("light", "dark");
                document.body.classList.replace("light-mesh", "dark-mesh");
                localStorage.setItem("campuscoin-theme", "dark");
            }
        }
        function setCurrentDate() {
            const el = document.getElementById('currentDate');
            if (el) el.textContent = new Date().toLocaleDateString(undefined, { weekday: 'short', month: 'long', day: 'numeric', year: 'numeric' });
        }
        function openSidebar() { document.getElementById('sidebar')?.classList.add('open'); document.getElementById('mobileOverlay')?.classList.add('show'); }
        function closeSidebar() { document.getElementById('sidebar')?.classList.remove('open'); document.getElementById('mobileOverlay')?.classList.remove('show'); }

        
        function toggleEditEqual() {
            const eq = document.getElementById('editEqualSplit').checked;
            document.querySelectorAll('#editParticipants .share-amt').forEach(el => { el.disabled = eq; if (eq) el.value = ''; });
        }
        function addEditParticipantRow(name = '', amount = '') {
            const wrap = document.getElementById('editParticipants');
            const row = document.createElement('div');
            row.className = 'flex gap-2 items-center';
            const eq = document.getElementById('editEqualSplit').checked;
            row.innerHTML = `
                <input class="input-field ep-name flex-1" value="${escapeHtml(name)}" placeholder="Name" />
                <input class="input-field ep-amt share-amt" type="number" step="0.01" min="0" placeholder="Share" value="${amount || ''}" ${eq ? 'disabled' : ''} style="max-width:110px;" />
                <button type="button" class="glass-btn" onclick="this.parentElement.remove()"><i class="fa-solid fa-xmark"></i></button>
            `;
            wrap.appendChild(row);
        }
        function openEditSplitById(id) {
            const it = (_lastSplitItems || []).find(x => x.id === id);
            if (!it) { showToast('Split not found — refresh and try again', 'error'); return; }
            openEditSplit(it);
        }
        function openEditSplit(it) {
            document.getElementById('editSplitId').value = it.id;
            document.getElementById('editDesc').value = it.description || '';
            document.getElementById('editTotal').value = it.totalAmount || '';
            document.getElementById('editIncludeMe').checked = true;
            document.getElementById('editEqualSplit').checked = true;
            const wrap = document.getElementById('editParticipants');
            wrap.innerHTML = '';
            (it.participants || []).forEach(p => addEditParticipantRow(p.name, p.shareAmount));
            if (!(it.participants || []).length) { addEditParticipantRow(); addEditParticipantRow(); }
            toggleEditEqual();
            document.getElementById('editSplitModal').classList.add('show');
        }
        function closeEditSplit() {
            document.getElementById('editSplitModal').classList.remove('show');
        }
        async function saveEditSplit() {
            const id = document.getElementById('editSplitId').value;
            const description = document.getElementById('editDesc').value.trim();
            const totalAmount = parseFloat(document.getElementById('editTotal').value);
            const includeMe = document.getElementById('editIncludeMe').checked;
            const equalSplit = document.getElementById('editEqualSplit').checked;
            const participants = [];
            document.querySelectorAll('#editParticipants > div').forEach(row => {
                const name = row.querySelector('.ep-name')?.value.trim();
                const share = parseFloat(row.querySelector('.ep-amt')?.value);
                if (name) participants.push({ name, shareAmount: equalSplit ? null : (isNaN(share) ? null : share) });
            });
            if (!description || !totalAmount || !participants.length) {
                showToast('Fill description, amount, and roommates', 'error');
                return;
            }
            const btn = document.getElementById('editSaveBtn');
            btn.disabled = true;
            try {
                const res = await fetch('/api/shared-expenses/' + id, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ description, totalAmount, includeMe, equalSplit, participants })
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok) { showToast(data.message || 'Update failed', 'error'); return; }
                showToast(data.message || 'Updated', 'success');
                closeEditSplit();
                await loadSplits();
            } catch { showToast('Network error', 'error'); }
            finally { btn.disabled = false; }
        }

        document.addEventListener('DOMContentLoaded', () => {
            initializeTheme();
            setCurrentDate();
            resetForm();
            loadSplits();
            // load student name if global helper exists
            fetch('/api/auth/me', { credentials: 'same-origin' }).then(r => r.ok ? r.json() : null).then(u => {
                if (!u) return;
                const name = u.fullName || u.FullName || u.name || 'Student';
                const initials = name.split(' ').map(p => p[0]).join('').slice(0,2).toUpperCase();
                ['sidebarStudentName','topStudentName'].forEach(id => { const el = document.getElementById(id); if (el) el.textContent = name; });
                ['sidebarAvatar','topAvatar'].forEach(id => { const el = document.getElementById(id); if (el) el.textContent = initials; });
            }).catch(() => {});
        });
    </script>

<script src="/js/cc-header-widgets.js" asp-append-version="true"></script>
</body>
</html>
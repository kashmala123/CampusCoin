    </main>

    <div id="toastContainer"></div>

    <script>
        // ================= STATE =================
        let userProfile = null;
        let allCategories = [];

        // ================= INIT =================
        document.addEventListener("DOMContentLoaded", async function () {
            initializeTheme();
            initializeFontSize();
            setDate();
            setupTabSwitching();
            await Promise.all([loadUserProfile(), loadCategories()]);
        });

        function setDate() {
            document.getElementById("currentDate").textContent = new Date().toLocaleDateString("en-US", {
                weekday: "short", month: "long", day: "numeric", year: "numeric"
            });
        }

        // ================= TAB SWITCHING =================
        function setupTabSwitching() {
            document.querySelectorAll('.settings-tab').forEach(tab => {
                tab.addEventListener('click', function () {
                    const tabId = this.dataset.tab;

                    document.querySelectorAll('.settings-tab').forEach(t => t.classList.remove('active'));
                    document.querySelectorAll('.panel-section').forEach(p => p.classList.remove('active'));

                    this.classList.add('active');
                    document.getElementById(`panel-${tabId}`).classList.add('active');

                    if (tabId === 'categories') loadCategories();
                });
            });
        }

        // ================= LOAD USER PROFILE =================
        async function loadUserProfile() {
            try {
                const res = await fetch('/api/auth/me');
                if (!res.ok) throw new Error('Failed to load profile');
                userProfile = await res.json();

                const initials = (userProfile.fullName || 'Student')
                    .split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);

                function setText(id, val) {
                    var el = document.getElementById(id);
                    if (el) el.textContent = val;
                }
                function setVal(id, val) {
                    var el = document.getElementById(id);
                    if (el) el.value = val;
                }

                setText('sidebarAvatar', initials);
                setText('sidebarStudentName', userProfile.fullName || 'Student');
                setText('sidebarStudentRole', userProfile.academicYear || 'Student');
                setText('topAvatar', initials);
                setText('topStudentName', userProfile.fullName || 'Student');

                setText('profileAvatarBig', initials);
                setText('profileNameDisplay', userProfile.fullName || 'Student');
                setText('profileEmailDisplay', userProfile.email || '');

                setVal('profileName', userProfile.fullName || '');
                setVal('profileEmail', userProfile.email || '');
                setVal('profileProgram', userProfile.academicYear || '');
                setVal('profilePhone', userProfile.phoneNumber || '');
                setVal('profileAllowance', userProfile.monthlyAllowanceBaseline || 0);
                setVal('profileSavingsGoal', userProfile.monthlySavingsGoal || 0);
            } catch (err) {
                console.error('Error loading profile:', err);
                showToast('Failed to load profile data', 'error');
            }
        }

        // ================= SAVE PROFILE =================
        async function saveProfileChanges() {
            const fullName = document.getElementById('profileName').value.trim();
            const academicYear = document.getElementById('profileProgram').value.trim();
            const phoneNumber = document.getElementById('profilePhone').value.trim();
            const monthlyAllowanceBaseline = parseFloat(document.getElementById('profileAllowance').value) || 0;
            const monthlySavingsGoal = parseFloat(document.getElementById('profileSavingsGoal').value) || 0;

            if (!fullName) { showToast('Full name is required', 'error'); return; }

            const btn = document.getElementById('saveProfileBtn');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';
            btn.disabled = true;

            try {
                const res = await fetch('/api/auth/profile', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ fullName, academicYear, phoneNumber, monthlyAllowanceBaseline, monthlySavingsGoal })
                });

                if (!res.ok) {
                    const err = await res.json().catch(() => ({}));
                    showToast(err.message || 'Failed to update profile', 'error');
                    return;
                }

                showToast('Profile updated successfully!', 'success');
                await loadUserProfile();
            } catch (err) {
                console.error(err);
                showToast('Error updating profile', 'error');
            } finally {
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }

        // ================= UPDATE PASSWORD =================
        async function updatePassword() {
            const currentPassword = document.getElementById('currentPassword').value;
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;

            if (!currentPassword || !newPassword || !confirmPassword) {
                showToast('Please fill all password fields', 'error'); return;
            }
            if (newPassword !== confirmPassword) {
                showToast('New passwords do not match', 'error'); return;
            }
            if (newPassword.length < 6) {
                showToast('Password must be at least 6 characters', 'error'); return;
            }

            const btn = document.getElementById('updatePasswordBtn');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Updating...';
            btn.disabled = true;

            try {
                const res = await fetch('/api/auth/change-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ currentPassword, newPassword })
                });

                if (!res.ok) {
                    const err = await res.json().catch(() => ({}));
                    showToast(err.message || 'Failed to update password', 'error');
                    return;
                }

                showToast('Password updated successfully!', 'success');
                document.getElementById('currentPassword').value = '';
                document.getElementById('newPassword').value = '';
                document.getElementById('confirmPassword').value = '';
            } catch (err) {
                console.error(err);
                showToast('Error updating password', 'error');
            } finally {
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }

        // ================= LOAD CATEGORIES =================
        async function loadCategories() {
            try {
                const res = await fetch('/api/categories');
                if (!res.ok) throw new Error('Failed to load categories');
                allCategories = await res.json();
                renderCategories();
            } catch (err) {
                console.error('Error loading categories:', err);
                document.getElementById('customCategoriesList').innerHTML =
                    '<div class="text-center py-6 text-xs text-rose-500">Failed to load categories</div>';
            }
        }

        // ================= RENDER CATEGORIES =================
        function renderCategories() {
            const container = document.getElementById('customCategoriesList');
            const customs = allCategories.filter(c => c.isUserCustom);

            if (!customs.length) {
                container.innerHTML = '<div class="text-center py-6 text-xs opacity-40">No custom categories yet. Add your first one above.</div>';
                return;
            }

            container.innerHTML = customs.map(c => `
                <div class="flex justify-between items-center p-3 rounded-xl bg-slate-500/10 border border-slate-300/30 dark:border-slate-700/30">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg ${c.type === 'Income' ? 'bg-emerald-500/20 text-emerald-600' : 'bg-rose-500/20 text-rose-600'} flex items-center justify-center text-xs font-bold">
                            <i class="fa-solid ${c.type === 'Income' ? 'fa-plus' : 'fa-minus'}"></i>
                        </div>
                        <div>
                            <div class="text-xs font-bold">${c.name}</div>
                            <div class="text-[10px] opacity-50">${c.type}</div>
                        </div>
                    </div>
                    <div class="flex gap-1">
                        <button onclick="editCustomCategory(${c.categoryId}, '${c.name.replace(/'/g, "\\'")}')"
                                class="text-purple-600 hover:opacity-75 p-2" title="Edit">
                            <i class="fa-regular fa-pen-to-square"></i>
                        </button>
                        <button onclick="deleteCustomCategory(${c.categoryId})"
                                class="text-rose-500 hover:opacity-75 p-2" title="Delete">
                            <i class="fa-regular fa-trash-can"></i>
                        </button>
                    </div>
                </div>
            `).join('');
        }

        // ================= ADD CUSTOM CATEGORY =================
        async function addCustomCategory() {
            const nameInput = document.getElementById('customCatName');
            const typeEl = document.getElementById('customCatType');
            if (!nameInput) { showToast('Category input not found', 'error'); return; }
            const name = (nameInput.value || '').trim();
            const type = (typeEl && typeEl.value) ? typeEl.value : 'Expense';

            if (!name) {
                showToast('Category name is required', 'error');
                nameInput.focus();
                return;
            }

            try {
                const res = await fetch('/api/categories', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ name: name, type: type, Name: name, Type: type })
                });

                if (!res.ok) {
                    const err = await res.json().catch(() => ({}));
                    showToast(err.message || ('Failed to add category (HTTP ' + res.status + ')'), 'error');
                    return;
                }

                nameInput.value = '';
                showToast('Category added successfully!', 'success');
                await loadCategories();
            } catch (err) {
                console.error(err);
                showToast('Error adding category', 'error');
            }
        }

        // ================= EDIT CUSTOM CATEGORY =================
        function editCustomCategory(id, currentName) {
            const newName = prompt('Edit Category Name:', currentName);
            if (!newName || newName.trim() === '' || newName.trim() === currentName) return;

            updateCustomCategory(id, newName.trim());
        }

        async function updateCustomCategory(id, name) {
            try {
                const res = await fetch(`/api/categories/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, type: 'Expense' })
                });

                if (!res.ok) {
                    const err = await res.json().catch(() => ({}));
                    showToast(err.message || 'Failed to update category', 'error');
                    return;
                }

                showToast('Category updated successfully!', 'success');
                await loadCategories();
            } catch (err) {
                console.error(err);
                showToast('Error updating category', 'error');
            }
        }

        // ================= DELETE CUSTOM CATEGORY =================
        async function deleteCustomCategory(id) {
            if (!confirm('Delete this category? Transactions using it may be affected.')) return;

            try {
                const res = await fetch(`/api/categories/${id}`, { method: 'DELETE' });

                if (!res.ok) {
                    const err = await res.json().catch(() => ({}));
                    showToast(err.message || 'Failed to delete category', 'error');
                    return;
                }

                showToast('Category deleted', 'success');
                await loadCategories();
            } catch (err) {
                console.error(err);
                showToast('Error deleting category', 'error');
            }
        }

        // ================= EXPORT DATA =================
        async function exportData() {
            try {
                showToast('Preparing your data export...', 'info');
                const res = await fetch('/api/reports/export-csv');

                if (!res.ok) {
                    showToast('Export feature not available yet', 'error');
                    return;
                }

                const blob = await res.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `campuscoin-export-${new Date().toISOString().slice(0, 10)}.csv`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                window.URL.revokeObjectURL(url);

                showToast('Data exported successfully!', 'success');
            } catch (err) {
                console.error(err);
                showToast('Error exporting data', 'error');
            }
        }

        // ================= FONT SIZE =================
        function setFontSize(size) {
            document.documentElement.classList.remove('font-small', 'font-medium', 'font-large');
            document.documentElement.classList.add(`font-${size}`);
            localStorage.setItem('campuscoin-fontsize', size);
            updateFontSizeButtons(size);

            const labels = { small: 'Small', medium: 'Medium', large: 'Large' };
            showToast(`Font size set to ${labels[size]}`, 'success');
        }

        function updateFontSizeButtons(activeSize) {
            const sizes = ['Small', 'Medium', 'Large'];

            sizes.forEach(sizeName => {
                const btn = document.getElementById(`fontSize${sizeName}`);
                if (!btn) return;

                const isActive = sizeName.toLowerCase() === activeSize;

                if (isActive) {
                    btn.classList.add('primary-btn', 'text-white');
                    btn.classList.remove('border', 'border-white/50', 'dark:border-white/10');
                } else {
                    btn.classList.remove('primary-btn', 'text-white');
                    btn.classList.add('border', 'border-white/50', 'dark:border-white/10');
                }
            });
        }

        function initializeFontSize() {
            const saved = localStorage.getItem('campuscoin-fontsize') || 'medium';
            document.documentElement.classList.add(`font-${saved}`);
            updateFontSizeButtons(saved);
        }

        // ================= THEME =================
        function initializeTheme() {
            const saved = localStorage.getItem('campuscoin-theme');
            if (saved === 'dark') {
                document.documentElement.classList.replace('light', 'dark');
                document.body.classList.replace('light-mesh', 'dark-mesh');
            }
            updateThemeIcon();
        }

        function toggleTheme() {
            const isDark = document.documentElement.classList.contains('dark');
            if (isDark) {
                document.documentElement.classList.replace('dark', 'light');
                document.body.classList.replace('dark-mesh', 'light-mesh');
                localStorage.setItem('campuscoin-theme', 'light');
            } else {
                document.documentElement.classList.replace('light', 'dark');
                document.body.classList.replace('light-mesh', 'dark-mesh');
                localStorage.setItem('campuscoin-theme', 'dark');
            }
            updateThemeIcon();
        }

        function updateThemeIcon() {
            const icon = document.getElementById('themeIcon');
            const isDark = document.documentElement.classList.contains('dark');
            icon.className = isDark ? 'fa-solid fa-sun text-amber-300' : 'fa-solid fa-moon';
        }

        // ================= SIDEBAR =================
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
            document.getElementById('mobileOverlay').classList.toggle('show');
        }

        function closeSidebar() {
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('mobileOverlay').classList.remove('show');
        }

        // ================= TOAST =================
        function showToast(msg, type = 'info') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = 'toast ios-glass font-bold text-xs';

            const iconMap = {
                success: '<i class="fa-solid fa-circle-check text-emerald-500"></i>',
                error: '<i class="fa-solid fa-circle-exclamation text-rose-500"></i>',
                info: '<i class="fa-solid fa-circle-info text-purple-600"></i>'
            };

            toast.innerHTML = `${iconMap[type] || iconMap.info} <span>${msg}</span>`;
            container.appendChild(toast);

            setTimeout(() => {
                toast.classList.add('hide');
                setTimeout(() => toast.remove(), 300);
            }, 2800);
        }
    </script>

<script src="/js/cc-header-widgets.js" asp-append-version="true"></script>
</body>
</html>
    <div id="toastContainer"></div>

    <script>
        // ===== STATE =====
        let baseConfig = { tuition: 1200, lab: 150, fine: 15 };
        let vouchers = [];
        let notifications = [{ title: "System Ready", text: "Voucher Manager loaded.", unread: true }];
        let charts = {};
        let activeFilter = 'all';

        // ===== INIT =====
        document.addEventListener("DOMContentLoaded", async function () {
            initializeTheme();
            setDate();
            initializeSearch();
            await loadVouchers();
            renderNotifications();
            initializeCharts();
            recalculateKPIs();
        });

        function setDate() {
            document.getElementById("currentDate").textContent =
                new Date().toLocaleDateString("en-US", { weekday: "short", month: "long", day: "numeric", year: "numeric" });
            const today = new Date();
            today.setDate(today.getDate() + 15);
            document.getElementById("bulkDueDate").value = today.toISOString().split('T')[0];
        }

        // ===== API CALLS =====
        async function loadVouchers() {
            try {
                const res = await fetch('/api/admin/vouchers', { credentials: 'same-origin' });
                if (!res.ok) throw new Error("Failed to load vouchers");
                const data = await res.json();
                vouchers = data.map(v => ({
                    id: v.id,
                    voucherCode: v.voucherCode,
                    student: v.studentName,
                    roll: v.rollNo,
                    dept: v.department,
                    tuition: v.tuition,
                    lab: v.lab || 0,
                    discount: v.discount,
                    fine: v.fine,
                    status: v.status,
                    dueDate: v.dueDate,
                    isNew: false
                }));
                renderVoucherTable();
                recalculateKPIs();
            } catch (err) {
                console.error(err);
                document.getElementById("voucherTableBody").innerHTML =
                    `<tr><td colspan="9" class="text-center py-8 text-rose-500">Failed to load vouchers: ${err.message}</td></tr>`;
            }
        }

        function recalculateKPIs() {
            const total = vouchers.length;
            let revenue = 0, discounts = 0, fines = 0;
            vouchers.forEach(v => {
                if (v.status === "Paid") revenue += (v.tuition + v.lab + v.fine - v.discount);
                discounts += v.discount;
                if (v.status === "Overdue") fines += v.fine;
            });
            document.getElementById("kpiTotalVouchers").textContent = total;
            document.getElementById("kpiRevenue").textContent = "$" + revenue.toLocaleString();
            document.getElementById("kpiDiscounts").textContent = "$" + discounts.toLocaleString();
            document.getElementById("kpiFines").textContent = "$" + fines.toLocaleString();
            updateChartsData();
        }

        function renderVoucherTable(searchTerm = "") {
            const tbody = document.getElementById("voucherTableBody");
            const term = (searchTerm || "").toLowerCase().trim();

            const filtered = vouchers.filter(v => {
                const matchesFilter = activeFilter === 'all' || v.status === activeFilter;
                const matchesSearch = !term ||
                    (v.voucherCode || "").toLowerCase().includes(term) ||
                    (v.student || "").toLowerCase().includes(term) ||
                    (v.roll || "").toLowerCase().includes(term) ||
                    (v.dept || "").toLowerCase().includes(term);
                return matchesFilter && matchesSearch;
            });

            tbody.innerHTML = "";
            if (!filtered.length) {
                tbody.innerHTML = `<tr><td colspan="9"><div class="text-center py-8 opacity-40"><i class="fa-solid fa-receipt text-3xl mb-2"></i><div>No vouchers found</div></div></td></tr>`;
                return;
            }

            filtered.forEach(v => {
                const total = (v.tuition + v.lab + v.fine) - v.discount;
                let statusBadge = "";
                if (v.status === "Paid") statusBadge = `<span class="badge badge-success"><i class="fa-solid fa-check"></i> Paid</span>`;
                else if (v.status === "Pending") statusBadge = `<span class="badge badge-warning"><i class="fa-solid fa-clock"></i> Pending</span>`;
                else statusBadge = `<span class="badge badge-danger"><i class="fa-solid fa-circle-exclamation"></i> Overdue</span>`;

                const row = document.createElement("tr");
                if (v.isNew) { row.classList.add("animate-row"); v.isNew = false; }

                row.innerHTML = `
                    <td class="font-bold text-xs">${v.voucherCode || v.id}</td>
                    <td>
                        <div class="font-bold">${v.student}</div>
                        <div class="text-[9px] opacity-40">${v.roll}</div>
                    </td>
                    <td class="font-medium text-xs">${v.dept}</td>
                    <td>
                        <div class="text-[10px]">Tuition: Rs. ${v.tuition}</div>
                        <div class="text-[9px] opacity-45">Lab: Rs. ${v.lab}</div>
                    </td>
                    <td class="text-emerald-500 font-bold">-Rs. ${v.discount}</td>
                    <td class="text-rose-500 font-bold">+Rs. ${v.fine}</td>
                    <td class="font-extrabold text-xs text-violet-600 dark:text-violet-400">Rs. ${total}</td>
                    <td>${statusBadge}</td>
                    <td class="flex items-center gap-1">
                        <button class="glass-btn py-1 px-2 text-[9px]" onclick="openEditModal(${v.id})">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </button>
                        <button class="glass-btn py-1 px-2 text-[9px] text-rose-500" onclick="deleteVoucher(${v.id})">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(row);
            });
        }

        function filterVouchers(type, btn) {
            activeFilter = type;
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            renderVoucherTable(document.getElementById("globalSearch").value);
            showToast(`Filtered by ${type.toUpperCase()}`);
        }

        function initializeSearch() {
            document.getElementById("globalSearch").addEventListener("input", function () {
                renderVoucherTable(this.value);
            });
        }

        // ===== FEE CONFIG =====
        function saveFeeStructure(e) {
            e.preventDefault();
            baseConfig.tuition = Number(document.getElementById("cfgTuition").value);
            baseConfig.lab = Number(document.getElementById("cfgLab").value);
            baseConfig.fine = Number(document.getElementById("cfgFine").value);
            showToast("Base rates updated!");
        }

        // ===== BULK GENERATE (API) =====
        async function handleBulkGenerate(e) {
            e.preventDefault();
            const btn = document.getElementById("btnBulkGen");
            const originalText = btn.innerHTML;
            btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin mr-1"></i> Generating...`;
            btn.disabled = true;

            try {
                const payload = {
                    department: document.getElementById("bulkDept").value,
                    batch: document.getElementById("bulkBatch").value,
                    dueDate: document.getElementById("bulkDueDate").value,
                    tuition: baseConfig.tuition
                };

                const res = await fetch('/api/admin/vouchers/bulk-generate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();

                if (data.success) {
                    addNotification("Bulk Challans Created", `Generated ${data.count} vouchers for ${payload.department}`);
                    await loadVouchers();
                    showToast(`Generated ${data.count} Vouchers!`);
                } else {
                    showToast(data.message || "Bulk generate failed");
                }
            } catch (err) {
                console.error(err);
                showToast("Error: " + err.message);
            } finally {
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }

        // ===== APPLY DISCOUNT (CREATE VOUCHER) =====
        async function applyDiscount(e) {
            e.preventDefault();
            const name = document.getElementById("discStudentName").value.trim();
            const roll = document.getElementById("discStudentRoll").value.trim();
            const dept = document.getElementById("discDept").value;
            const status = document.getElementById("discStatus").value;
            const discVal = Number(document.getElementById("discValue").value);

            try {
                const payload = {
                    studentName: name,
                    department: dept,
                    title: "Semester Fee",
                    semester: "Fall 2026",
                    tuition: baseConfig.tuition,
                    discount: discVal,
                    fine: status === "Overdue" ? baseConfig.fine : 0,
                    dueDate: new Date(Date.now() + 15 * 86400000).toISOString().split('T')[0],
                    status: status
                };

                const res = await fetch('/api/admin/vouchers', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();

                if (data.success) {
                    addNotification("Voucher & Waiver Added", `Applied Rs. ${discVal} waiver for ${name}`);
                    document.getElementById("discStudentName").value = "";
                    document.getElementById("discStudentRoll").value = "";
                    document.getElementById("discValue").value = "";
                    await loadVouchers();
                    showToast(`Added voucher for ${name}!`);
                } else {
                    showToast(data.message || "Failed to add voucher");
                }
            } catch (err) {
                console.error(err);
                showToast("Error: " + err.message);
            }
        }

        // ===== DELETE =====
        async function deleteVoucher(id) {
            if (!confirm("Delete this voucher?")) return;
            try {
                const res = await fetch('/api/admin/vouchers/' + id, { method: 'DELETE' });
                const data = await res.json();
                if (data.success) {
                    await loadVouchers();
                    showToast("Voucher deleted.");
                } else {
                    showToast(data.message || "Delete failed");
                }
            } catch (err) {
                showToast("Error: " + err.message);
            }
        }

        // ===== MODALS =====
        function openBulkModal() { document.getElementById("bulkModal").classList.add("show"); }
        function closeBulkModal() { document.getElementById("bulkModal").classList.remove("show"); }
        function executeQuickBulk() {
            closeBulkModal();
            document.getElementById("btnBulkGen").click();
        }

        function openEditModal(id) {
            const v = vouchers.find(item => item.id === id);
            if (!v) return;
            document.getElementById("editVoucherId").value = v.id;
            document.getElementById("editTuition").value = v.tuition;
            document.getElementById("editDiscount").value = v.discount;
            document.getElementById("editFine").value = v.fine;
            document.getElementById("editStatus").value = v.status;
            document.getElementById("editModal").classList.add("show");
        }
        function closeEditModal() { document.getElementById("editModal").classList.remove("show"); }

        async function saveVoucherEdit(e) {
            e.preventDefault();
            const id = document.getElementById("editVoucherId").value;
            try {
                const payload = {
                    tuition: Number(document.getElementById("editTuition").value),
                    discount: Number(document.getElementById("editDiscount").value),
                    fine: Number(document.getElementById("editFine").value),
                    status: document.getElementById("editStatus").value
                };
                const res = await fetch('/api/admin/vouchers/' + id, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    await loadVouchers();
                    showToast(`Voucher updated!`);
                } else {
                    showToast(data.message || "Update failed");
                }
            } catch (err) {
                showToast("Error: " + err.message);
            }
            closeEditModal();
        }

        // ===== NOTIFICATIONS =====
        function addNotification(title, text) {
            notifications.unshift({ title, text, unread: true });
            renderNotifications();
        }
        function renderNotifications() {
            const list = document.getElementById("notificationList");
            const countEl = document.getElementById("notificationCount");
            list.innerHTML = "";
            countEl.textContent = `${notifications.length} recent`;
            notifications.slice(0, 5).forEach(n => {
                const item = document.createElement("div");
                item.className = "dropdown-item";
                item.innerHTML = `
                    <span class="w-2 h-2 rounded-full bg-violet-500 flex-shrink-0"></span>
                    <span>
                        <span class="block font-bold text-[10px] text-violet-500">${n.title}</span>
                        <span class="block text-[9px] opacity-45 mt-0.5">${n.text}</span>
                    </span>`;
                list.appendChild(item);
            });
        }

        // ===== CHARTS =====
        function getChartColors() {
            const dark = document.documentElement.classList.contains("dark");
            return {
                text: dark ? "rgba(226,232,240,.65)" : "rgba(26,11,46,.55)",
                grid: dark ? "rgba(255,255,255,.06)" : "rgba(26,11,46,.07)"
            };
        }
        function baseChartOptions() {
            const colors = getChartColors();
            return {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { labels: { color: colors.text, usePointStyle: true, boxWidth: 8, font: { size: 10 } } } },
                scales: {
                    x: { grid: { display: false }, ticks: { color: colors.text, font: { size: 9 } } },
                    y: { grid: { color: colors.grid }, ticks: { color: colors.text, font: { size: 9 } } }
                }
            };
        }
        function initializeCharts() {
            const ctx1 = document.getElementById("voucherTrendChart").getContext("2d");
            charts.trend = new Chart(ctx1, {
                type: "line",
                data: {
                    labels: ["May", "Jun", "Jul", "Aug", "Sep", "Oct"],
                    datasets: [
                        { label: "Revenue ($k)", data: [0,0,0,0,0,0], borderColor: "#059669", tension: 0.4, borderWidth: 2 },
                        { label: "Vouchers (Qty)", data: [0,0,0,0,0,0], borderColor: "#8b6ff0", tension: 0.4, borderWidth: 2 }
                    ]
                },
                options: baseChartOptions()
            });

            const ctx2 = document.getElementById("feeBreakdownChart").getContext("2d");
            charts.breakdown = new Chart(ctx2, {
                type: "doughnut",
                data: {
                    labels: ["Tuition", "Discount", "Fine"],
                    datasets: [{ data: [1,1,1], backgroundColor: ["#8b6ff0", "#059669", "#e11d48"], borderWidth: 0 }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false, cutout: "68%",
                    plugins: { legend: { position: "bottom", labels: { color: getChartColors().text, font: { size: 9 } } } }
                }
            });

            const ctx3 = document.getElementById("departmentChart").getContext("2d");
            charts.dept = new Chart(ctx3, {
                type: "bar",
                data: { labels: ["CS", "SE", "BBA", "EE"], datasets: [{ label: "Vouchers", data: [0,0,0,0], backgroundColor: "rgba(139,111,240,0.7)", borderRadius: 6 }] },
                options: baseChartOptions()
            });

            const ctx4 = document.getElementById("discountChart").getContext("2d");
            charts.discount = new Chart(ctx4, {
                type: "bar",
                data: { labels: ["Merit", "Need", "Sports", "Staff"], datasets: [{ label: "Beneficiaries", data: [0,0,0,0], backgroundColor: "rgba(245,158,11,0.7)", borderRadius: 6 }] },
                options: baseChartOptions()
            });

            const ctx5 = document.getElementById("collectionMeterChart").getContext("2d");
            charts.meter = new Chart(ctx5, {
                type: "doughnut",
                data: { labels: ["Paid", "Pending/Overdue"], datasets: [{ data: [0,0], backgroundColor: ["#059669", "#e11d48"], borderWidth: 0 }] },
                options: {
                    responsive: true, maintainAspectRatio: false, cutout: "75%",
                    plugins: { legend: { position: "bottom", labels: { color: getChartColors().text, font: { size: 9 } } } }
                }
            });
        }

        function updateChartsData() {
            if (!charts.dept || !charts.meter) return;
            let cs = 0, se = 0, bba = 0, ee = 0, paid = 0, unpaid = 0;
            let totalTuition = 0, totalDiscount = 0, totalFine = 0;
            vouchers.forEach(v => {
                if ((v.dept || "").includes("Computer")) cs++;
                else if ((v.dept || "").includes("Software")) se++;
                else if ((v.dept || "").includes("Business")) bba++;
                else ee++;
                if (v.status === "Paid") paid++; else unpaid++;
                totalTuition += v.tuition;
                totalDiscount += v.discount;
                totalFine += v.fine;
            });
            charts.dept.data.datasets[0].data = [cs, se, bba, ee];
            charts.dept.update();
            charts.meter.data.datasets[0].data = [paid, unpaid];
            charts.meter.update();
            if (charts.breakdown) {
                charts.breakdown.data.datasets[0].data = [totalTuition, totalDiscount, totalFine];
                charts.breakdown.update();
            }
        }

        // ===== THEME =====
        function initializeTheme() {
            const saved = localStorage.getItem("campuscoin-admin-theme");
            if (saved === "dark") {
                document.documentElement.classList.remove("light");
                document.documentElement.classList.add("dark");
                document.body.classList.remove("light");
                document.body.classList.add("dark-mesh");
            } else {
                document.documentElement.classList.add("light");
                document.body.classList.add("light");
                document.body.classList.remove("dark-mesh");
            }
            updateThemeIcon();
        }
        function toggleTheme() {
            const html = document.documentElement;
            const dark = html.classList.contains("dark");
            if (dark) {
                html.classList.remove("dark"); html.classList.add("light");
                document.body.classList.remove("dark-mesh"); document.body.classList.add("light");
                localStorage.setItem("campuscoin-admin-theme", "light");
            } else {
                html.classList.remove("light"); html.classList.add("dark");
                document.body.classList.remove("light"); document.body.classList.add("dark-mesh");
                localStorage.setItem("campuscoin-admin-theme", "dark");
            }
            updateThemeIcon();
            updateChartsTheme();
        }
        function updateThemeIcon() {
            const icon = document.getElementById("themeIcon");
            const dark = document.documentElement.classList.contains("dark");
            icon.className = dark ? "fa-solid fa-sun text-amber-300" : "fa-solid fa-moon";
        }
        function updateChartsTheme() {
            const colors = getChartColors();
            Object.values(charts).forEach(chart => {
                if (!chart) return;
                if (chart.options.scales) {
                    Object.values(chart.options.scales).forEach(scale => {
                        if (scale.ticks) scale.ticks.color = colors.text;
                        if (scale.grid) scale.grid.color = colors.grid;
                    });
                }
                if (chart.options.plugins?.legend) chart.options.plugins.legend.labels.color = colors.text;
                chart.update();
            });
        }

        // ===== UTILS =====
        function toggleDropdown(id) {
            const target = document.getElementById(id);
            document.querySelectorAll(".dropdown").forEach(d => { if (d.id !== id) d.classList.remove("show"); });
            target.classList.toggle("show");
        }
        document.addEventListener("click", function (event) {
            if (!event.target.closest(".dropdown-wrap")) {
                document.querySelectorAll(".dropdown").forEach(d => d.classList.remove("show"));
            }
        });
        function logoutAdmin() { window.location.href = "/Auth/Logout"; }
        function toggleSidebar() {
            document.getElementById("sidebar").classList.toggle("open");
            document.getElementById("mobileOverlay").classList.toggle("show");
        }
        function closeSidebar() {
            document.getElementById("sidebar").classList.remove("open");
            document.getElementById("mobileOverlay").classList.remove("show");
        }
        function showToast(message) {
            const container = document.getElementById("toastContainer");
            const toast = document.createElement("div");
            toast.className = "toast ios-glass";
            toast.innerHTML = `
                <div class="w-9 h-9 rounded-xl bg-violet-500/10 text-violet-500 flex items-center justify-center">
                    <i class="fa-solid fa-file-invoice-dollar"></i>
                </div>
                <div>
                    <div class="text-[10px] font-bold">Voucher Manager</div>
                    <div class="text-[9px] opacity-50">${message}</div>
                </div>`;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = "0";
                toast.style.transform = "translateY(10px)";
                setTimeout(() => toast.remove(), 300);
            }, 2400);
        }
    </script>
</body>
</html>
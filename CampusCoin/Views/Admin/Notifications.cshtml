                        </linearGradient>
                        <linearGradient id="ccCoinAccent_ad" x1="10" y1="10" x2="34" y2="34" gradientUnits="userSpaceOnUse">
                            <stop offset="0" stop-color="#22c55e"/><stop offset="1" stop-color="#10b981"/>
                        </linearGradient>
                    </defs>
                    <circle cx="22" cy="22" r="21" fill="url(#ccCoinBG_ad)"/>
                    <circle cx="22" cy="22" r="16.5" fill="none" stroke="rgba(255,255,255,.2)" stroke-width="1" stroke-dasharray="1.5 3"/>
                    <path d="M28.5 15c-1.9-2.2-4.7-3.5-7.8-3.5-5.8 0-10.5 4.7-10.5 10.5s4.7 10.5 10.5 10.5c3.1 0 5.9-1.3 7.8-3.5" stroke="url(#ccCoinAccent_ad)" stroke-width="2.6" stroke-linecap="round" fill="none"/>
                </svg>
            </div>
            <div>
                <div class="brand-name cc-brand-title"><b>Cash</b><span>Campus</span></div>
                <div class="brand-sub">ADMIN CONSOLE</div>
            </div>
        </div>
        <nav class="nav">
            <div class="nav-section">Overview</div>
            <a href="/Admin/Index" class="nav-link"><i class="fa-solid fa-chart-line"></i><span>Dashboard</span></a>
            <a href="/Admin/Students" class="nav-link"><i class="fa-solid fa-user-graduate"></i><span>Students</span></a>
            <a href="/Admin/Transactions" class="nav-link"><i class="fa-solid fa-arrow-right-arrow-left"></i><span>Transactions</span></a>
            <a href="/Admin/VoucherManagement" class="nav-link"><i class="fa-solid fa-receipt"></i><span>Voucher Management</span></a>
            <div class="nav-section">Financial Management</div>
            <a href="/Admin/Categories" class="nav-link"><i class="fa-solid fa-layer-group"></i><span>Categories</span></a>
            <a href="/Admin/Budgets" class="nav-link"><i class="fa-solid fa-wallet"></i><span>Budgets</span></a>
            <a href="/Admin/EventManager" class="nav-link"><i class="fa-solid fa-calendar-days"></i><span>Event Manager</span></a>
            <a href="/Admin/SavingGoals" class="nav-link"><i class="fa-solid fa-bullseye"></i><span>Saving Goals</span></a>
            <div class="nav-section">System</div>
            <a href="/Admin/Notifications" class="nav-link active"><i class="fa-solid fa-bell"></i><span>Notifications</span></a>
            <a href="/Admin/Reports" class="nav-link"><i class="fa-solid fa-chart-pie"></i><span>Reports & Analytics</span></a>
            <a href="/Admin/HomepageCms" class="nav-link"><i class="fa-solid fa-pager"></i><span>Homepage CMS</span></a>
            <a href="/Admin/Settings" class="nav-link"><i class="fa-solid fa-sliders"></i><span>Settings</span></a>
        </nav>
        <div class="admin-mini">
            <div class="admin-avatar">AD</div>
            <div class="flex-1 min-w-0">
                <div class="text-[11px] font-bold">Admin</div>
                <div class="text-[9px] opacity-45">System Administrator</div>
            </div>
        </div>
        <a href="/Auth/Logout" class="sidebar-logout-btn" style="display:flex;align-items:center;gap:10px;padding:10px 12px;margin:8px 4px 8px;border-radius:12px;font-size:13px;font-weight:700;color:#e11d48;text-decoration:none;background:rgba(225,29,72,0.08);">
            <i class="fa-solid fa-right-from-bracket"></i> Logout
        </a>
    </aside>

    <main class="lg:ml-80 px-4 sm:px-6 lg:px-8 py-6">

        <header class="ios-glass rounded-3xl p-3.5 mb-6 flex flex-col md:flex-row items-center justify-between gap-3 shadow-xl" style="overflow:visible;position:relative;z-index:50;">
            <div class="flex items-center gap-3 w-full">
                <button onclick="openSidebar()" class="lg:hidden w-11 h-11 rounded-2xl ios-glass flex items-center justify-center">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <div>
                    <p class="text-xs font-bold text-rose-600 dark:text-rose-400 uppercase tracking-wider">Communication</p>
                    <h2 class="text-xl sm:text-2xl font-black tracking-tight">Notifications</h2>
                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400">Broadcast announcements and alerts to all students</p>
                </div>
            </div>

            <div class="flex items-center gap-2 shrink-0 justify-end" style="position:relative;z-index:100;">
                <button onclick="openModal()" class="px-3.5 py-2 rounded-xl text-white font-bold text-xs shadow-md flex items-center gap-1.5 active:scale-95" style="background:linear-gradient(135deg,#8b58b8,#6b3a92);box-shadow:0 8px 20px rgba(107,58,146,.28);">
                    <i class="fa-solid fa-paper-plane text-xs"></i>
                    <span class="hidden sm:inline">New Broadcast</span>
                </button>
                <button onclick="toggleTheme()" class="w-9 h-9 rounded-xl ios-glass flex items-center justify-center text-slate-700 dark:text-amber-300">
                    <i id="themeIcon" class="fa-solid fa-moon text-sm"></i>
                </button>
                <div class="dropdown-wrap" style="position:relative;">
                    <button type="button" class="action-btn" onclick="toggleDropdown('profileDropdown')" title="Account" style="display:inline-flex;align-items:center;gap:8px;padding:6px 10px;">
                        <span style="width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,#a486e0,#6366f1);color:#fff;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;">AD</span>
                        <span class="hidden sm:inline" style="font-size:12px;font-weight:700;">Admin</span>
                        <i class="fa-solid fa-chevron-down" style="font-size:9px;opacity:.5;"></i>
                    </button>
                    <div id="profileDropdown" class="dropdown" style="display:none !important;position:absolute;right:0;top:calc(100% + 10px);min-width:200px;z-index:99999;padding:8px;border-radius:16px;background:#fff;border:1px solid rgba(22,11,33,.1);box-shadow:0 18px 40px rgba(22,11,33,.14);">
                        <a href="/Admin/Settings" style="display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;font-size:13px;font-weight:600;text-decoration:none;color:#1a1420;"><i class="fa-regular fa-user"></i> My Profile</a>
                        <a href="/Admin/Settings" class="dropdown-item" style="display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;font-size:13px;font-weight:600;text-decoration:none;color:inherit;"><i class="fa-solid fa-gear"></i> Settings</a>
                        <button type="button" onclick="logoutAdmin()" class="dropdown-item" style="display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;font-size:13px;font-weight:600;width:100%;border:0;background:transparent;cursor:pointer;color:#e11d48;"><i class="fa-solid fa-right-from-bracket"></i> Logout</button>
                    </div>
                </div>
            </div>
        </header>

        <section class="kpi-grid mb-6">
            <div class="kpi ios-glass ios-glass-interactive">
                <div class="w-10 h-10 rounded-xl bg-purple-600/15 text-purple-600 flex items-center justify-center text-lg mb-3"><i class="fa-solid fa-bell"></i></div>
                <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Total Announcements</p>
                <div id="kpiTotal" class="text-2xl font-black mt-1">0</div>
            </div>
            <div class="kpi ios-glass ios-glass-interactive">
                <div class="w-10 h-10 rounded-xl bg-amber-500/15 text-amber-500 flex items-center justify-center text-lg mb-3"><i class="fa-solid fa-wallet"></i></div>
                <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Budget Alerts</p>
                <div id="kpiBudget" class="text-2xl font-black mt-1">0</div>
            </div>
            <div class="kpi ios-glass ios-glass-interactive">
                <div class="w-10 h-10 rounded-xl bg-rose-500/15 text-rose-500 flex items-center justify-center text-lg mb-3"><i class="fa-solid fa-triangle-exclamation"></i></div>
                <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">System Alerts</p>
                <div id="kpiSystem" class="text-2xl font-black mt-1">0</div>
            </div>
            <div class="kpi ios-glass ios-glass-interactive">
                <div class="w-10 h-10 rounded-xl bg-emerald-500/15 text-emerald-500 flex items-center justify-center text-lg mb-3"><i class="fa-solid fa-circle-check"></i></div>
                <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Delivery Rate</p>

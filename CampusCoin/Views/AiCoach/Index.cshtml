@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@{
    ViewData["Title"] = "AI Coach & Support";
    Layout = null;
    var _csrf = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<!DOCTYPE html>
<html lang="en" class="light">

<head>
    <link rel="stylesheet" href="/css/student-theme.css" />
    <link rel="stylesheet" href="/css/cc-animations.css" />

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Financial Coach & Support — CampusCoin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <link rel="apple-touch-icon" href="/favicon.svg?v=4" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50:'#f6effc',
                            100:'#ede4f6',
                            400: '#a486e0',
                            500: '#8b58b8',
                            600: '#6b3a92',
                        }
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', '-apple-system', 'BlinkMacSystemFont', 'Inter', 'sans-serif']
                    }
                }
            }
        };
    </script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        * {
            transition: background-color 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease, color 0.3s ease;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            min-height: 100vh;
            font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
            background-color: #fbf6f0;
            background-image: radial-gradient(at 0% 0%, rgba(237, 228, 246, 0.9) 0px, transparent 50%), radial-gradient(at 100% 0%, rgba(196, 174, 224, 0.85) 0px, transparent 50%), radial-gradient(at 100% 100%, rgba(255, 225, 230, 0.85) 0px, transparent 50%), radial-gradient(at 0% 100%, rgba(246, 239, 252, 0.9) 0px, transparent 50%), radial-gradient(at 50% 50%, rgba(212, 243, 228, 0.4) 0px, transparent 50%);
            background-attachment: fixed;
        }

            body.dark-mesh {
                background-color: #100a1a;
                background-image: radial-gradient(at 10% 10%, rgba(139, 111, 240, 0.28) 0px, transparent 50%), radial-gradient(at 90% 10%, rgba(155, 111, 216, 0.22) 0px, transparent 50%), radial-gradient(at 90% 90%, rgba(109, 74, 255, 0.28) 0px, transparent 50%), radial-gradient(at 10% 90%, rgba(212, 121, 159, 0.22) 0px, transparent 50%);
                background-attachment: fixed;
            }

        .orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(80px);
            z-index: -1;
            pointer-events: none;
            animation: floatOrb 18s infinite alternate ease-in-out;
        }

        .orb-1 {
            width: 450px;
            height: 450px;
            background: rgba(155, 111, 216, 0.5);
            top: -100px;
            left: -100px;
        }

        .orb-2 {
            width: 480px;
            height: 480px;
            background: rgba(139, 111, 240, 0.45);
            top: 30%;
            right: -120px;
            animation-delay: -5s;
        }

        .orb-3 {
            width: 400px;
            height: 400px;
            background: rgba(212, 121, 159, 0.4);
            bottom: -100px;
            left: 20%;
            animation-delay: -10s;
        }

        @@keyframes floatOrb {
            0% {
                transform: translate(0px, 0px) scale(1);
            }

            50% {
                transform: translate(40px, 60px) scale(1.08);
            }

            100% {
                transform: translate(-30px, 30px) scale(0.95);
            }
        }

        .ios-glass {
            backdrop-filter: blur(32px) saturate(240%);
            -webkit-backdrop-filter: blur(32px) saturate(240%);
            position: relative;
            overflow: hidden;
        }

        .light .ios-glass {
            background: rgba(255, 255, 255, 0.72);
            border: 1.5px solid rgba(255, 255, 255, 0.95);
            box-shadow: 0 20px 40px -12px rgba(109, 74, 255, 0.12), 0 4px 16px -2px rgba(0, 0, 0, 0.04), inset 0 1.5px 2px 0 rgba(255, 255, 255, 1), inset 0 -1.5px 2px 0 rgba(0, 0, 0, 0.03);
            color: #0f172a;
        }

        .dark .ios-glass {
            background: rgba(28, 18, 42, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.45), inset 0 1px 0 0 rgba(255, 255, 255, 0.18);
            color: #f8fafc;
        }

        .ios-glass-interactive {
            transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease, background 0.35s ease;
        }

            .ios-glass-interactive::before {
                content: '';
                position: absolute;
                top: 0;
                left: -150%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.65), transparent);
                transform: skewX(-25deg);
                transition: left 0.75s ease;
                pointer-events: none;
            }

        .dark .ios-glass-interactive::before {
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.15), transparent);
        }

        .ios-glass-interactive:hover::before {
            left: 150%;
        }

        .ios-glass-interactive:hover {
            transform: translateY(-4px);
        }

        /* ========== SIDEBAR ========== */
        .sidebar {
            position: fixed;
            top: 20px;
            left: 20px;
            bottom: 20px;
            width: 240px;
            z-index: 100;
            border-radius: 30px;
            padding: 18px;
            display: flex;
            flex-direction: column;
            transition: transform .35s ease;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 4px 6px 18px;
            flex-shrink: 0;
        }

        .brand-logo {
            width: 46px;
            height: 46px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
            background: linear-gradient(135deg, #8b6ff0, #6d4aff, #4b2568);
            box-shadow: 0 12px 25px rgba(109, 74, 255, 0.32);
            flex-shrink: 0;
        }

        .brand-name {
            font-size: 18px;
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        .brand-sub {
            font-size: 9px;
            font-weight: 800;
            letter-spacing: .16em;
            opacity: .45;
            margin-top: 3px;
        }

        .nav-section {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: .15em;
            font-weight: 800;
            opacity: .4;
            padding: 12px 10px 6px;
            flex-shrink: 0;
        }

        .nav {
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            min-height: 0;
            padding-right: 4px;
        }

            .nav::-webkit-scrollbar {
                width: 4px;
            }

            .nav::-webkit-scrollbar-thumb {
                background: rgba(109, 74, 255, 0.3);
                border-radius: 4px;
            }

            .nav::-webkit-scrollbar-track {
                background: transparent;
            }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 12px;
            margin: 3px 0;
            border-radius: 15px;
            text-decoration: none;
            color: inherit;
            font-size: 12px;
            font-weight: 650;
            transition: all .25s ease;
            white-space: nowrap;
        }

            .nav-link i {
                width: 20px;
                text-align: center;
                opacity: .55;
                flex-shrink: 0;
            }

            .nav-link span {
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .nav-link:hover {
                background: rgba(255,255,255,.30);
                transform: translateX(3px);
            }

        .dark .nav-link:hover {
            background: rgba(255,255,255,.06);
        }

        .nav-link.active {
            color: #6d4aff;
            background: linear-gradient(135deg, rgba(139,111,240,.18), rgba(109,74,255,.14));
            box-shadow: inset 0 0 0 1px rgba(139,111,240,.15), 0 10px 25px rgba(109,74,255,.08);
        }

        .dark .nav-link.active {
            color: #c4aee0;
            background: rgba(139,111,240,.1);
        }

        .student-mini {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 10px;
            border-radius: 18px;
            background: rgba(255,255,255,.30);
            border: 1px solid rgba(255,255,255,.35);
            flex-shrink: 0;
            margin-top: 10px;
        }

        .dark .student-mini {
            background: rgba(255,255,255,.04);
            border-color: rgba(255,255,255,.08);
        }

        .student-avatar {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 11px;
            font-weight: 800;
            background: linear-gradient(135deg, #8b6ff0, #6d4aff);
            flex-shrink: 0;
        }

        /* ========== MAIN ========== */
        .main {
            margin-left: 280px;
            padding: 20px 25px 40px 20px;
            min-height: 100vh;
            width: calc(100% - 280px);
            box-sizing: border-box;
        }

        /* ========== TOPBAR ========== */
        .topbar {
            height: 70px;
            border-radius: 25px;
            padding: 10px 13px;
            display: flex;
            align-items: center;
            gap: 12px;
            position: sticky;
            top: 20px;
            z-index: 10000;
        }

        .search {
            flex: 1;
            max-width: 500px;
            position: relative;
        }

            .search i {
                position: absolute;
                left: 16px;
                top: 50%;
                transform: translateY(-50%);
                opacity: .4;
                font-size: 12px;
            }

            .search input {
                width: 100%;
                border: none;
                outline: none;
                padding: 11px 15px 11px 42px;
                border-radius: 16px;
                background: rgba(255,255,255,.38);
                color: inherit;
                font-size: 12px;
                border: 1px solid rgba(255,255,255,.50);
            }

        .dark .search input {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-left: auto;
        }

        .action-btn {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            border: 1px solid rgba(255,255,255,.55);
            background: rgba(255,255,255,.36);
            color: inherit;
            cursor: pointer;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .dark .action-btn {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .notification-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #f43f5e;
            position: absolute;
            top: 8px;
            right: 8px;
        }

        .profile {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 4px 9px 4px 4px;
            border-radius: 15px;
            cursor: pointer;
            flex-shrink: 0;
        }

        .profile-avatar {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 11px;
            font-weight: 800;
            background: linear-gradient(135deg, #a486e0, #6d4aff);
            flex-shrink: 0;
        }

        .dropdown-wrap {
            position: relative;
        }

        .dropdown {
            position: absolute;
            right: 0;
            top: calc(100% + 10px);
            width: 250px;
            padding: 9px;
            border-radius: 20px;
            opacity: 0;
            pointer-events: none;
            transform: translateY(-8px) scale(.98);
            transition: .2s ease;
            z-index: 200;
        }

            .dropdown.show {
                opacity: 1;
                pointer-events: auto;
                transform: translateY(0) scale(1);
            }

        .dropdown-item {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 10px;
            border: 0;
            background: transparent;
            color: inherit;
            padding: 11px;
            border-radius: 13px;
            cursor: pointer;
            text-align: left;
            font-size: 11px;
        }

        /* ========== PAGE HEADER ========== */
        .page-header {
            display: flex;
            align-items: end;
            justify-content: space-between;
            gap: 20px;
            margin: 28px 3px 20px;
            flex-wrap: wrap;
        }

        .eyebrow {
            color: #6d4aff;
            font-size: 9px;
            font-weight: 850;
            text-transform: uppercase;
            letter-spacing: .18em;
            margin-bottom: 8px;
        }

        .page-title {
            font-size: clamp(28px, 3vw, 40px);
            font-weight: 900;
            letter-spacing: -1.8px;
            line-height: 1;
        }

        .page-description {
            font-size: 11px;
            opacity: .55;
            margin-top: 8px;
            max-width: 560px;
        }

        /* ========== GRID ========== */
        .content-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 20px;
            margin-bottom: 24px;
            width: 100%;
        }

        .bottom-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            width: 100%;
        }

        /* ========== CHAT ========== */
        .chat-box {
            height: 420px;
            overflow-y: auto;
            overflow-x: hidden;
            scroll-behavior: smooth;
            padding-right: 6px;
            display: flex;
            flex-direction: column;
        }

            .chat-box::-webkit-scrollbar {
                width: 5px;
            }

            .chat-box::-webkit-scrollbar-thumb {
                background: rgba(109, 74, 255, 0.3);
                border-radius: 10px;
            }

        .chat-msg {
            max-width: 80%;
            padding: 12px 16px;
            border-radius: 20px;
            font-size: 12px;
            line-height: 1.5;
            margin-bottom: 12px;
            word-wrap: break-word;
            animation: msgIn .35s ease;
        }

        @@keyframes msgIn {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .msg-ai {
            background: rgba(109, 74, 255, 0.12);
            border: 1px solid rgba(109, 74, 255, 0.25);
            border-top-left-radius: 4px;
            align-self: flex-start;
        }

        .msg-user {
            background: linear-gradient(135deg, #8b6ff0, #6d4aff);
            color: white;
            border-top-right-radius: 4px;
            align-self: flex-end;
            margin-left: auto;
        }

        .glass-input {
            width: 100%;
            padding: 12px 16px;
            border-radius: 14px;
            background: rgba(255,255,255,.35);
            border: 1px solid rgba(255,255,255,.5);
            font-size: 12px;
            outline: none;
            color: inherit;
            font-family: inherit;
        }

            .glass-input:focus {
                border-color: rgba(109, 74, 255, 0.5);
                box-shadow: 0 0 0 3px rgba(109, 74, 255, 0.1);
            }

        .dark .glass-input {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.1);
        }

        /* ========== MODAL ========== */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15,23,42,.45);
            backdrop-filter: blur(10px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 300;
            padding: 16px;
        }

            .modal-overlay.show {
                display: flex;
                animation: fadeIn .25s ease;
            }

        @@keyframes fadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        .modal-card {
            width: 100%;
            max-width: 520px;
            padding: 28px;
            border-radius: 28px;
            max-height: 90vh;
            overflow-y: auto;
            animation: modalIn .3s cubic-bezier(.16,1,.3,1);
        }

        @@keyframes modalIn {
            from {
                opacity: 0;
                transform: scale(.95) translateY(10px);
            }

            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        /* ========== MOBILE ========== */
        .mobile-btn {
            display: none;
        }

        .mobile-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15,23,42,.25);
            backdrop-filter: blur(5px);
            z-index: 90;
        }

            .mobile-overlay.show {
                display: block;
            }

        @@media(max-width:1100px) {
            .content-grid {
                grid-template-columns: 1fr;
            }

            .bottom-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media(max-width:950px) {
            .sidebar {
                transform: translateX(-120%);
            }

                .sidebar.open {
                    transform: translateX(0);
                }

            .main {
                margin-left: 0;
                padding: 15px;
                width: 100%;
            }

            .mobile-btn {
                display: flex;
            }
        }

        /* ========== TOAST ========== */
        #toastContainer {
            position: fixed;
            right: 20px;
            bottom: 20px;
            z-index: 999;
            display: flex;
            flex-direction: column;
            gap: 9px;
        }

        .toast {
            min-width: 270px;
            padding: 13px;
            border-radius: 17px;
            display: flex;
            align-items: center;
            gap: 10px;
            animation: toastIn .3s ease;
        }

        @@keyframes toastIn {
            from {
                opacity: 0;
                transform: translateY(15px) scale(.96);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }
    </style>
    <link rel="stylesheet" href="/css/cc-header-widgets.css" asp-append-version="true" />
</head>

<body class="light-mesh min-h-screen text-slate-900 dark:text-slate-100 font-sans">


            </div>
        </section>

        <section class="ios-glass rounded-3xl p-6">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6 pb-4 border-b border-slate-500/10">
                <div class="flex flex-wrap gap-2 text-xs font-bold">
                    <button onclick="filterTab('all')" id="tab-all" class="px-3.5 py-2 rounded-xl bg-purple-600 text-white shadow-md">All (<span id="cnt-all">0</span>)</button>
                    <button onclick="filterTab('budget')" id="tab-budget" class="px-3.5 py-2 rounded-xl bg-slate-500/10 opacity-70 hover:opacity-100">Budget Alerts (<span id="cnt-budget">0</span>)</button>
                    <button onclick="filterTab('system')" id="tab-system" class="px-3.5 py-2 rounded-xl bg-slate-500/10 opacity-70 hover:opacity-100">System (<span id="cnt-system">0</span>)</button>
                </div>
                <button onclick="loadAnnouncements()" class="glass-btn">
                    <i class="fa-solid fa-rotate"></i> Refresh
                </button>
            </div>

            <div id="notifList" class="space-y-3"></div>
        </section>
    </main>

    <!-- MODAL (Add / Edit) -->
    <div id="modal" class="modal-overlay">
        <div class="modal-card ios-glass">
            <div class="flex justify-between items-center mb-4">
                <h3 id="modalTitle" class="font-black text-base">Send Announcement</h3>
                <button onclick="closeModal()" class="w-9 h-9 rounded-xl ios-glass flex items-center justify-center text-slate-500"><i class="fa-solid fa-xmark"></i></button>
            </div>

            <form onsubmit="saveAnnouncement(event)" class="space-y-4 text-xs">
                <input type="hidden" id="mId">

                <div>
                    <label class="block font-bold mb-1.5 opacity-70">Title</label>
                    <input id="mTitle" required type="text" class="w-full p-3 rounded-2xl bg-slate-500/10 border border-slate-500/20 outline-none focus:ring-2 focus:ring-sky-400/60 text-sm" placeholder="e.g. Budget Update">
                </div>

                <div>
                    <label class="block font-bold mb-1.5 opacity-70">Type (auto-detected from title)</label>
                    <p class="text-[10px] opacity-50">Keywords: "budget" → Budget Alert; "maintenance", "system" → System Alert</p>
                </div>

                <div>
                    <label class="block font-bold mb-1.5 opacity-70">Message</label>
                    <textarea id="mMessage" required rows="4" class="w-full p-3 rounded-2xl bg-slate-500/10 border border-slate-500/20 outline-none focus:ring-2 focus:ring-sky-400/60 text-sm" placeholder="Write the announcement..."></textarea>
                </div>

                <div class="flex gap-2 pt-2">
                    <button type="button" onclick="closeModal()" class="glass-btn flex-1 justify-center py-3">Cancel</button>
                    <button type="submit" id="modalSubmitBtn" class="glass-btn primary-btn flex-1 justify-center py-3">
                        <i class="fa-solid fa-paper-plane"></i> Send to All Students
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div id="toast" class="fixed bottom-6 right-6 z-[200] ios-glass rounded-2xl px-5 py-4 shadow-2xl flex items-center gap-3">
        <div id="toastIcon" class="w-9 h-9 rounded-xl bg-emerald-500/15 text-emerald-500 flex items-center justify-center"><i class="fa-solid fa-check"></i></div>
        <div>
            <p id="toastTitle" class="text-xs font-black">Done</p>
            <p id="toastText" class="text-[10px] font-medium text-slate-500 dark:text-slate-400"></p>
        </div>
    </div>

    <script>
        let announcements = [];
        let currentTab = "all";
        const API = "/api/admin/announcements";

        document.addEventListener("DOMContentLoaded", async () => {
            initTheme();
            await loadAnnouncements();
        });

        async function loadAnnouncements() {
            try {
                const r = await fetch(API, { credentials: "same-origin" });
                if (!r.ok) throw new Error(`HTTP ${r.status}`);
                const raw = await r.json();
                announcements = raw.map(a => ({
                    id: a.announcementId,
                    title: a.title,
                    message: a.message,
                    postedBy: a.postedBy,
                    createdAt: a.createdAt,
                    category: classify(a.title, a.message)
                }));
                updateKPIs();
                render();
            } catch (e) { showToast("Load failed", e.message, "danger"); }
        }

        function classify(title, message) {
            const text = ((title || "") + " " + (message || "")).toLowerCase();
            if (text.includes("budget") || text.includes("alert") || text.includes("exceed") || text.includes("limit")) return "budget";
            if (text.includes("maintenance") || text.includes("system") || text.includes("server") || text.includes("downtime") || text.includes("update")) return "system";
            return "info";
        }

        function updateKPIs() {
            const total = announcements.length;
            const budget = announcements.filter(a => a.category === "budget").length;
            const system = announcements.filter(a => a.category === "system").length;

            document.getElementById("kpiTotal").innerText = total;
            document.getElementById("kpiBudget").innerText = budget;
            document.getElementById("kpiSystem").innerText = system;

            document.getElementById("cnt-all").innerText = total;
            document.getElementById("cnt-budget").innerText = budget;
            document.getElementById("cnt-system").innerText = system;
        }

        function filterTab(tab) {
            currentTab = tab;
            ["all", "budget", "system"].forEach(t => {
                const btn = document.getElementById(`tab-${t}`);
                btn.className = t === tab
                    ? "px-3.5 py-2 rounded-xl bg-purple-600 text-white shadow-md font-bold"
                    : "px-3.5 py-2 rounded-xl bg-slate-500/10 opacity-70 hover:opacity-100 font-bold";
            });
            render();
        }

        function render() {
            const list = document.getElementById("notifList");
            list.innerHTML = "";

            let filtered = announcements;
            if (currentTab !== "all") filtered = filtered.filter(a => a.category === currentTab);

            if (!filtered.length) {
                list.innerHTML = `<div class="text-center py-12 opacity-50">
                    <div class="w-16 h-16 rounded-3xl bg-purple-600/10 flex items-center justify-center mx-auto mb-3 text-purple-600 text-xl"><i class="fa-regular fa-bell"></i></div>
                    <p class="font-black">No announcements found</p>
                    <p class="text-xs text-slate-400 mt-1">Click "New Broadcast" to send your first one.</p>
                </div>`;
                return;
            }

            filtered.forEach(a => {
                const iconMap = {
                    budget: { icon: "fa-wallet", color: "text-amber-500", bg: "bg-amber-500/15" },
                    system: { icon: "fa-triangle-exclamation", color: "text-rose-500", bg: "bg-rose-500/15" },
                    info:   { icon: "fa-bullhorn", color: "text-purple-600", bg: "bg-purple-600/15" }
                };
                const cfg = iconMap[a.category] || iconMap.info;

                const card = document.createElement("div");
                card.className = "p-4 rounded-2xl bg-slate-500/10 border border-slate-500/15 flex items-start justify-between gap-4 transition hover:bg-slate-500/15";
                card.innerHTML = `
                    <div class="flex items-start gap-3.5 min-w-0">
                        <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 ${cfg.bg} ${cfg.color}">
                            <i class="fa-solid ${cfg.icon} text-sm"></i>
                        </div>
                        <div class="min-w-0">
                            <h4 class="font-bold text-sm text-slate-800 dark:text-slate-100">${a.title}</h4>
                            <p class="text-[11px] opacity-70 mt-1 leading-snug">${a.message}</p>
                            <div class="flex items-center gap-3 text-[9px] opacity-40 mt-2">
                                <span><i class="fa-regular fa-clock mr-1"></i>${a.createdAt}</span>
                                <span><i class="fa-regular fa-user mr-1"></i>By: ${a.postedBy}</span>
                                <span class="px-2 py-0.5 rounded-full ${cfg.bg} ${cfg.color} font-bold uppercase">${a.category}</span>
                            </div>
                        </div>
                    </div>
                    <div class="flex gap-1 shrink-0">
                        <button onclick="editAnnouncement(${a.id})" title="Edit"
                                class="w-9 h-9 rounded-xl ios-glass flex items-center justify-center text-purple-600 hover:scale-105">
                            <i class="fa-solid fa-pen text-xs"></i>
                        </button>
                        <button onclick="deleteAnnouncement(${a.id})" title="Delete"
                                class="w-9 h-9 rounded-xl ios-glass flex items-center justify-center text-rose-500 hover:scale-105">
                            <i class="fa-regular fa-trash-can text-xs"></i>
                        </button>
                    </div>
                `;
                list.appendChild(card);
            });
        }

        /* ---- ADD NEW (Reset Modal) ---- */
        function openModal() {
            document.getElementById("modalTitle").innerText = "Send Announcement";
            document.getElementById("mId").value = "";
            document.getElementById("mTitle").value = "";
            document.getElementById("mMessage").value = "";
            document.getElementById("modalSubmitBtn").innerHTML = '<i class="fa-solid fa-paper-plane"></i> Send to All Students';
            document.getElementById("modal").classList.add("show");
        }

        /* ---- EDIT EXISTING ---- */
        function editAnnouncement(id) {
            const a = announcements.find(x => x.id === id);
            if (!a) return;

            document.getElementById("modalTitle").innerText = "Edit Announcement";
            document.getElementById("mId").value = a.id;
            document.getElementById("mTitle").value = a.title;
            document.getElementById("mMessage").value = a.message;
            document.getElementById("modalSubmitBtn").innerHTML = '<i class="fa-solid fa-check"></i> Update Announcement';
            document.getElementById("modal").classList.add("show");
        }

        function closeModal() {
            document.getElementById("modal").classList.remove("show");
        }

        /* ---- SAVE (POST for new, PUT for edit) ---- */
        async function saveAnnouncement(e) {
            e.preventDefault();
            const id = document.getElementById("mId").value;
            const payload = {
                title: document.getElementById("mTitle").value.trim(),
                message: document.getElementById("mMessage").value.trim()
            };

            try {
                let url = API;
                let method = "POST";

                if (id) {
                    url = `${API}/${id}`;
                    method = "PUT";
                }

                const r = await fetch(url, {
                    method,
                    headers: { "Content-Type": "application/json" },
                    credentials: "same-origin",
                    body: JSON.stringify(payload)
                });

                const d = await r.json().catch(() => ({}));
                if (!r.ok) throw new Error(d.message || `HTTP ${r.status}`);

                closeModal();
                await loadAnnouncements();
                showToast(id ? "Announcement updated" : "Broadcast sent", id ? "Changes saved." : "All active students notified.");
            } catch (err) { showToast("Save failed", err.message, "danger"); }
        }

        async function deleteAnnouncement(id) {
            if (!confirm("Delete this announcement?")) return;
            try {
                const r = await fetch(`${API}/${id}`, { method: "DELETE", credentials: "same-origin" });
                if (!r.ok) throw new Error(`HTTP ${r.status}`);
                await loadAnnouncements();
                showToast("Announcement deleted", "", "danger");
            } catch (e) { showToast("Delete failed", e.message, "danger"); }
        }

        function initTheme() {
            if (localStorage.getItem("campuscoin-theme") === "dark") {
                document.documentElement.classList.add("dark");
                document.body.classList.add("dark-mesh");
                document.getElementById("themeIcon").className = "fa-solid fa-sun text-lg text-amber-300";
            } else {
                document.body.classList.add("light-mesh");
            }
        }

        function toggleTheme() {
            const html = document.documentElement;
            const icon = document.getElementById("themeIcon");
            if (html.classList.contains("dark")) {
                html.classList.remove("dark"); html.classList.add("light");
                document.body.classList.remove("dark-mesh"); document.body.classList.add("light-mesh");
                icon.className = "fa-solid fa-moon text-sm";
                localStorage.setItem("campuscoin-theme", "light");
            } else {
                html.classList.remove("light"); html.classList.add("dark");
                document.body.classList.remove("light-mesh"); document.body.classList.add("dark-mesh");
                icon.className = "fa-solid fa-sun text-lg text-amber-300";
                localStorage.setItem("campuscoin-theme", "dark");
            }
        }

        function openSidebar() { document.getElementById("sidebar").classList.add("open"); document.getElementById("sidebarOverlay").classList.add("show"); }
        function closeSidebar() { document.getElementById("sidebar").classList.remove("open"); document.getElementById("sidebarOverlay").classList.remove("show"); }

        function showToast(title, text, type = "success") {
            const t = document.getElementById("toast");
            const icon = document.getElementById("toastIcon");
            document.getElementById("toastTitle").innerText = title;
            document.getElementById("toastText").innerText = text || "";
            if (type === "danger") {
                icon.className = "w-9 h-9 rounded-xl bg-rose-500/15 text-rose-500 flex items-center justify-center";
                icon.innerHTML = '<i class="fa-solid fa-trash"></i>';
            } else {
                icon.className = "w-9 h-9 rounded-xl bg-emerald-500/15 text-emerald-500 flex items-center justify-center";
                icon.innerHTML = '<i class="fa-solid fa-check"></i>';
            }
            t.classList.add("show");
            clearTimeout(window.toastTimer);
            window.toastTimer = setTimeout(() => t.classList.remove("show"), 3000);
        }

        document.addEventListener("keydown", e => { if (e.key === "Escape") { closeModal(); closeSidebar(); } });
    </script>


<script>
(function(){
  if (typeof window.toggleDropdown !== 'function') {
    window.toggleDropdown = function(id){
      const t = document.getElementById(id);
      if (!t) return;
      document.querySelectorAll('.dropdown').forEach(d => {
        if (d.id !== id) { d.classList.remove('show'); d.style.setProperty('display','none','important'); d.classList.remove('show'); }
      });
      const open = !t.classList.contains('show');
      t.classList.toggle('show', open);
      t.style.setProperty('display', open ? 'block' : 'none', 'important'); if(open){t.classList.add('show');} else {t.classList.remove('show');}
    };
    document.addEventListener('click', function(e){
      if (!e.target.closest('.dropdown-wrap')) {
        document.querySelectorAll('.dropdown').forEach(d => { d.classList.remove('show'); d.style.setProperty('display','none','important'); d.classList.remove('show'); });
      }
    });
  }
  if (typeof window.logoutAdmin !== 'function') {
    window.logoutAdmin = function(){ window.location.href = '/Auth/Logout'; };
  }
  if (typeof window.quickAction !== 'function') {
    window.quickAction = function(action){
      document.querySelectorAll('.dropdown').forEach(d => { d.classList.remove('show'); d.style.setProperty('display','none','important'); d.classList.remove('show'); });
      const routes = {
        'Add Student': '/Admin/Students',
        'View Transactions': '/Admin/Transactions',
        'Send Notification': '/Admin/Notifications',
        'Generate Report': '/Admin/Reports'
      };
      if (routes[action]) window.location.href = routes[action];
    };
  }
})();
</script>


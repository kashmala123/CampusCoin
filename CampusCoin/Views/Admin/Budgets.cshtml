@{
    Layout = null;
    ViewData["Title"] = "CampusCoin — Budgets & Saving Goals";
}
<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <link rel="stylesheet" href="/css/admin-theme.css" />
    <link rel="stylesheet" href="/css/cc-animations.css" />

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <link rel="apple-touch-icon" href="/favicon.svg?v=4" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: { brand: { 50:'#f6effc', 100:'#ede4f6', 400:'#a486e0', 500:'#8b58b8', 600:'#6b3a92' } },
                    fontFamily: { sans: ['Plus Jakarta Sans','-apple-system','BlinkMacSystemFont','Inter','Segoe UI','Roboto','sans-serif'] }
                }
            }
        };
    </script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        * {
            transition: background-color 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease, color 0.3s ease;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            min-height: 100vh;
            background-color: #fbf6f0;
            background-image: radial-gradient(at 0% 0%, rgba(237, 228, 246, 0.9) 0px, transparent 50%), radial-gradient(at 100% 0%, rgba(196, 174, 224, 0.85) 0px, transparent 50%), radial-gradient(at 100% 100%, rgba(255, 225, 230, 0.85) 0px, transparent 50%), radial-gradient(at 0% 100%, rgba(246, 239, 252, 0.9) 0px, transparent 50%), radial-gradient(at 50% 50%, rgba(212, 243, 228, 0.4) 0px, transparent 50%);
            background-attachment: fixed;
        }

            body.dark-mesh {
                background-color: #100a1a;
                background-image: radial-gradient(at 10% 10%, rgba(99, 102, 241, 0.28) 0px, transparent 50%), radial-gradient(at 90% 10%, rgba(168, 85, 247, 0.22) 0px, transparent 50%), radial-gradient(at 90% 90%, rgba(107, 58, 146, 0.28) 0px, transparent 50%), radial-gradient(at 10% 90%, rgba(236, 72, 153, 0.2) 0px, transparent 50%);
                background-attachment: fixed;
            }

        .orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(80px);
            z-index: -1;
            pointer-events: none;
            animation: floatOrb 18s infinite alternate ease-in-out;
        }

        .orb-1 {
            width: 450px;
            height: 450px;
            background: rgba(192, 132, 252, 0.4);
            top: -100px;
            left: -100px;
        }

        .orb-2 {
            width: 480px;
            height: 480px;
            background: rgba(139, 88, 184, 0.45);
            top: 30%;
            right: -120px;
            animation-delay: -5s;
        }

        .orb-3 {
            width: 400px;
            height: 400px;
            background: rgba(251, 113, 133, 0.35);
            bottom: -100px;
            left: 20%;
            animation-delay: -10s;
        }

        @@keyframes floatOrb {
            0% {
                transform: translate(0px, 0px) scale(1);
            }

            50% {
                transform: translate(40px, 60px) scale(1.08);
            }

            100% {
                transform: translate(-30px, 30px) scale(0.95);
            }
        }

        .ios-glass {
            backdrop-filter: blur(32px) saturate(240%);
            -webkit-backdrop-filter: blur(32px) saturate(240%);
            position: relative;
            overflow: hidden;
        }

        .light .ios-glass {
            background: rgba(255,255,255,.72);
            border: 1.5px solid rgba(255,255,255,.95);
            box-shadow: 0 20px 40px -12px rgba(107,58,146,.12), 0 4px 16px -2px rgba(0,0,0,.04);
            color: #0f172a;
        }

        .dark .ios-glass {
            background: rgba(18,24,38,.58);
            border: 1px solid rgba(255,255,255,.15);
            box-shadow: 0 25px 50px -12px rgba(0,0,0,.45);
            color: #f8fafc;
        }

        .ios-glass-interactive {
            transition: transform .35s cubic-bezier(.16,1,.3,1), box-shadow .35s ease, background .35s ease;
        }

            .ios-glass-interactive:hover {
                transform: translateY(-4px);
            }

        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(150,150,150,.3);
            border-radius: 999px;
        }

        .sidebar {
            position: fixed;
            top: 20px;
            left: 20px;
            bottom: 20px;
            width: 260px;
            z-index: 100;
            border-radius: 30px;
            padding: 18px;
            display: flex;
            flex-direction: column;
            transform: translateX(0);
            transition: transform .35s ease;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 4px 6px 22px;
        }

        .brand-logo {
            width: 46px;
            height: 46px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
            background: linear-gradient(135deg, #a486e0, #8b58b8, #6366f1);
            box-shadow: 0 12px 25px rgba(107,58,146,.28);
        }

        .brand-name {
            font-size: 18px;
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        .brand-sub {
            font-size: 9px;
            font-weight: 800;
            letter-spacing: .16em;
            opacity: .45;
            margin-top: 3px;
        }

        .nav-section {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: .15em;
            font-weight: 800;
            opacity: .4;
            padding: 14px 10px 7px;
        }

        .nav {
            flex: 1;
            overflow-y: auto;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 12px;
            margin: 4px 0;
            border-radius: 15px;
            text-decoration: none;
            color: inherit;
            font-size: 12px;
            font-weight: 650;
            transition: all .25s ease;
        }

            .nav-link i {
                width: 20px;
                text-align: center;
                opacity: .55;
            }

            .nav-link:hover {
                background: rgba(255,255,255,.30);
                transform: translateX(3px);
            }

        .dark .nav-link:hover {
            background: rgba(255,255,255,.06);
        }

        .nav-link.active {
            color: #6b3a92;
            background: linear-gradient(135deg, rgba(139,88,184,.18), rgba(99,102,241,.14));
            box-shadow: inset 0 0 0 1px rgba(139,88,184,.15), 0 10px 25px rgba(107,58,146,.08);
        }

        .dark .nav-link.active {
            color: #c4aee0;
            background: rgba(139,88,184,.10);
        }

        .admin-mini {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 11px;
            border-radius: 18px;
            background: rgba(255,255,255,.30);
            border: 1px solid rgba(255,255,255,.35);
        }

        .dark .admin-mini {
            background: rgba(255,255,255,.04);
            border-color: rgba(255,255,255,.08);
        }

        .admin-avatar {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 11px;
            font-weight: 800;
            background: linear-gradient(135deg, #8b58b8, #6366f1);
        }

        .main {
            margin-left: 300px;
            padding: 20px 25px 40px 0;
            min-height: 100vh;
        }

        .topbar {
            height: 70px;
            border-radius: 25px;
            padding: 10px 13px;
            display: flex;
            align-items: center;
            gap: 12px;
            position: sticky;
            top: 20px;
            z-index: 80;
        }

        .search {
            flex: 1;
            max-width: 500px;
            position: relative;
        }

            .search i {
                position: absolute;
                left: 16px;
                top: 50%;
                transform: translateY(-50%);
                opacity: .4;
                font-size: 12px;
            }

            .search input {
                width: 100%;
                border: none;
                outline: none;
                padding: 11px 15px 11px 42px;
                border-radius: 16px;
                background: rgba(255,255,255,.38);
                color: inherit;
                font-size: 12px;
                border: 1px solid rgba(255,255,255,.50);
            }

        .dark .search input {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-left: auto;
        }

        .action-btn {
            width: 40px;
            height: 40px;
            min-width: 40px;
            border-radius: 14px;
            border: 1px solid rgba(255,255,255,.55);
            background: rgba(255,255,255,.36);
            color: inherit;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .dark .action-btn {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .action-btn:hover {
            transform: translateY(-2px);
            background: rgba(255,255,255,.65);
        }

        .page-header {
            display: flex;
            align-items: end;
            justify-content: space-between;
            gap: 20px;
            margin: 28px 3px 20px;
        }

        .eyebrow {
            color: #6b3a92;
            font-size: 9px;
            font-weight: 850;
            text-transform: uppercase;
            letter-spacing: .18em;
            margin-bottom: 8px;
        }

        .page-title {
            font-size: clamp(28px, 3vw, 40px);
            font-weight: 900;
            letter-spacing: -1.8px;
            line-height: 1;
        }

        .page-description {
            font-size: 12px;
            opacity: .48;
            margin-top: 8px;
        }

        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
        }

        .kpi {
            min-height: 140px;
            padding: 19px;
            border-radius: 25px;
            position: relative;
            overflow: hidden;
        }

        .kpi-icon {
            width: 40px;
            height: 40px;
            border-radius: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(139,88,184,.13);
            color: #6b3a92;
            margin-bottom: 13px;
        }

        .kpi-label {
            font-size: 10px;
            font-weight: 700;
            opacity: .48;
        }

        .kpi-value {
            font-size: 24px;
            font-weight: 900;
            letter-spacing: -1px;
            margin-top: 3px;
        }

        .glass-btn {
            border: 1px solid rgba(255,255,255,.55);
            background: rgba(255,255,255,.38);
            color: inherit;
            border-radius: 13px;
            padding: 9px 12px;
            font-size: 10px;
            font-weight: 750;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .dark .glass-btn {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .glass-btn:hover {
            transform: translateY(-2px);
            background: rgba(255,255,255,.65);
        }

        .primary-btn {
            color: white;
            border: none;
            background: linear-gradient(135deg, #a486e0, #8b58b8, #6366f1);
            box-shadow: 0 10px 22px rgba(107,58,146,.20);
        }

        .modal-overlay {
            position: fixed;
            inset: 0;
            z-index: 300;
            background: rgba(15,23,42,.35);
            backdrop-filter: blur(8px);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transition: all .3s ease;
        }

            .modal-overlay.show {
                opacity: 1;
                pointer-events: auto;
            }

        .modal-card {
            width: 100%;
            max-width: 520px;
            border-radius: 28px;
            padding: 25px;
            transform: scale(.95) translateY(10px);
            transition: all .3s ease;
        }

        .modal-overlay.show .modal-card {
            transform: scale(1) translateY(0);
        }

        #toastContainer {
            position: fixed;
            right: 20px;
            bottom: 20px;
            z-index: 999;
            display: flex;
            flex-direction: column;
            gap: 9px;
        }

        .toast {
            min-width: 270px;
            padding: 13px;
            border-radius: 17px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        @@media(max-width:1200px) {
            .kpi-grid {
                grid-template-columns: repeat(2,1fr);
            }
        }

        @@media(max-width:950px) {
            .sidebar {
                transform: translateX(-120%);
            }

                .sidebar.open {
                    transform: translateX(0);
                }

            .main {
                margin-left: 0;
                padding: 15px;
            }
        }

        @@media(max-width:700px) {
            .kpi-grid {
                grid-template-columns: 1fr;
            }

            .page-header {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
    <link rel="stylesheet" href="/css/cc-header-widgets.css" asp-append-version="true" />
</head>

<body class="light min-h-screen text-slate-900 dark:text-slate-100 font-sans">

    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>

    <div id="mobileOverlay" class="fixed inset-0 bg-slate-900/20 backdrop-blur-sm z-40 hidden" onclick="closeSidebar()"></div>

    <!-- SIDEBAR -->
    <aside id="sidebar" class="sidebar ios-glass">
                <div class="brand cc-brand-block">
            <div class="brand-logo cc-brand-mark" aria-hidden="true">
                <svg viewBox="0 0 44 44" width="36" height="36" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="ccCoinBG_ad" x1="0" y1="0" x2="44" y2="44" gradientUnits="userSpaceOnUse">
                            <stop offset="0" stop-color="#6b3a92"/><stop offset="1" stop-color="#241232"/>
                        </linearGradient>
                        <linearGradient id="ccCoinAccent_ad" x1="10" y1="10" x2="34" y2="34" gradientUnits="userSpaceOnUse">
                            <stop offset="0" stop-color="#d4ff3d"/><stop offset="1" stop-color="#10b981"/>
                        </linearGradient>
                    </defs>
                    <circle cx="22" cy="22" r="21" fill="url(#ccCoinBG_ad)"/>
                    <circle cx="22" cy="22" r="16.5" fill="none" stroke="rgba(255,255,255,.2)" stroke-width="1" stroke-dasharray="1.5 3"/>
                    <path d="M28.5 15c-1.9-2.2-4.7-3.5-7.8-3.5-5.8 0-10.5 4.7-10.5 10.5s4.7 10.5 10.5 10.5c3.1 0 5.9-1.3 7.8-3.5" stroke="url(#ccCoinAccent_ad)" stroke-width="2.6" stroke-linecap="round" fill="none"/>
                    <path d="M31 12c0 2.2-1.3 3.5-3.5 3.5 2.2 0 3.5 1.3 3.5 3.5 0-2.2 1.3-3.5 3.5-3.5-2.2 0-3.5-1.3-3.5-3.5z" fill="#d4ff3d"/>
                </svg>
            </div>
            <div>
                <div class="brand-name cc-brand-title"><b>Cash</b><span>Campus</span></div>
                <div class="brand-sub">ADMIN CONSOLE</div>
            </div>
        </div>

                <nav class="nav">
            <div class="nav-section">Overview</div>
            <a href="/Admin/Index" class="nav-link"><i class="fa-solid fa-chart-line"></i><span>Dashboard</span></a>
            <a href="/Admin/Students" class="nav-link"><i class="fa-solid fa-user-graduate"></i><span>Students</span></a>
            <a href="/Admin/Transactions" class="nav-link"><i class="fa-solid fa-arrow-right-arrow-left"></i><span>Transactions</span></a>
            <a href="/Admin/VoucherManagement" class="nav-link"><i class="fa-solid fa-receipt"></i><span>Voucher Management</span></a>
            <div class="nav-section">Financial Management</div>
            <a href="/Admin/Categories" class="nav-link"><i class="fa-solid fa-layer-group"></i><span>Categories</span></a>
            <a href="/Admin/Budgets" class="nav-link active"><i class="fa-solid fa-wallet"></i><span>Budgets</span></a>
            <a href="/Admin/EventManager" class="nav-link"><i class="fa-solid fa-calendar-days"></i><span>Event Manager</span></a>
            <a href="/Admin/SavingGoals" class="nav-link"><i class="fa-solid fa-bullseye"></i><span>Saving Goals</span></a>
            <div class="nav-section">System</div>
            <a href="/Admin/Notifications" class="nav-link"><i class="fa-solid fa-bell"></i><span>Notifications</span></a>
            <a href="/Admin/Reports" class="nav-link"><i class="fa-solid fa-chart-pie"></i><span>Reports & Analytics</span></a>
            <a href="/Admin/HomepageCms" class="nav-link"><i class="fa-solid fa-pager"></i><span>Homepage CMS</span></a>
            <a href="/Admin/Settings" class="nav-link"><i class="fa-solid fa-sliders"></i><span>Settings</span></a>
        </nav>

        <div class="admin-mini">
            <div class="admin-avatar">AK</div>
            <div class="flex-1 min-w-0">
                <div class="text-[11px] font-bold">Admin</div>
                <div class="text-[9px] opacity-45">System Administrator</div>
            </div>
        </div>
        <a href="/Auth/Logout" style="display:flex;align-items:center;gap:10px;padding:10px 12px;margin-top:8px;border-radius:12px;font-size:13px;font-weight:700;color:#e11d48;text-decoration:none;">
            <i class="fa-solid fa-right-from-bracket"></i> Logout
        </a>
    </aside>

    <!-- MAIN -->
    <main class="main">

        <header class="topbar ios-glass">
            <button class="action-btn lg:hidden" onclick="toggleSidebar()"><i class="fa-solid fa-bars"></i></button>
            <div class="search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input id="globalSearch" oninput="handleSearch()" type="text" placeholder="Search student, category, or goal..." autocomplete="off">
            </div>
            <div class="top-actions">
                <button class="glass-btn primary-btn" onclick="openAddBudgetModal()">
                    <i class="fa-solid fa-plus"></i><span>Add Budget</span>
                </button>
                <button class="glass-btn" onclick="openAddGoalModal()">
                    <i class="fa-solid fa-bullseye text-purple-600"></i><span>Add Goal</span>
                </button>
                <button class="action-btn" onclick="toggleTheme()">
                    <i id="themeIcon" class="fa-solid fa-moon"></i>
                </button>
                <div class="dropdown-wrap" style="position:relative;">
                    <button type="button" class="action-btn" onclick="toggleDropdown('profileDropdown')" title="Account" style="display:inline-flex;align-items:center;gap:8px;padding:0 12px 0 6px;width:auto;min-width:auto;height:40px;border-radius:12px;">
                        <span style="width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,#a486e0,#6366f1);color:#fff;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;">AD</span>
                        <span class="hidden sm:inline" style="font-size:12px;font-weight:700;">Admin</span>
                        <i class="fa-solid fa-chevron-down" style="font-size:9px;opacity:.5;"></i>
                    </button>
                    <div id="profileDropdown" class="dropdown" style="display:none !important;position:absolute;right:0;top:calc(100% + 10px);min-width:200px;z-index:99999;padding:8px;border-radius:16px;background:#fff;border:1px solid rgba(22,11,33,.1);box-shadow:0 18px 40px rgba(22,11,33,.14);">
                        <a href="/Admin/Settings" class="dropdown-item" style="display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;font-size:13px;font-weight:600;text-decoration:none;color:inherit;"><i class="fa-regular fa-user"></i> My Profile</a>
                        <a href="/Admin/Settings" class="dropdown-item" style="display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;font-size:13px;font-weight:600;text-decoration:none;color:inherit;"><i class="fa-solid fa-gear"></i> Settings</a>
                        <button type="button" onclick="logoutAdmin()" class="dropdown-item" style="display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;font-size:13px;font-weight:600;width:100%;border:0;background:transparent;cursor:pointer;color:#e11d48;"><i class="fa-solid fa-right-from-bracket"></i> Logout</button>
                    </div>
                </div>
            </div>
        </header>

        <section class="page-header">
            <div>
                <div class="eyebrow">Financial Management / Overview</div>
                <h1 class="page-title">Budgets & Saving Goals</h1>
                <p class="page-description">Monitor student spending allocations, over-budget warnings, and targeted saving goal progress.</p>
            </div>
            <div class="flex gap-2">
                <button class="glass-btn primary-btn" onclick="switchTab('all')" id="tabAll">Overview</button>
                <button class="glass-btn" onclick="switchTab('budgets')" id="tabBudgets"><i class="fa-solid fa-wallet text-purple-600"></i> Student Budgets</button>
                <button class="glass-btn" onclick="switchTab('goals')" id="tabGoals"><i class="fa-solid fa-bullseye text-emerald-500"></i> Saving Goals</button>
            </div>
        </section>

        <!-- KPI GRID -->
        <section class="kpi-grid mb-6">
            <div class="kpi ios-glass ios-glass-interactive">
                <div class="kpi-icon"><i class="fa-solid fa-wallet"></i></div>
                <div class="kpi-label">Total Allocated Budget</div>
                <div class="kpi-value" id="kpiTotalBudget">Rs. 0</div>
            </div>
            <div class="kpi ios-glass ios-glass-interactive">
                <div class="kpi-icon text-amber-500"><i class="fa-solid fa-chart-line"></i></div>
                <div class="kpi-label">Total Budget Used</div>
                <div class="kpi-value" id="kpiBudgetUsed">Rs. 0</div>
            </div>
            <div class="kpi ios-glass ios-glass-interactive">
                <div class="kpi-icon text-rose-500"><i class="fa-solid fa-circle-exclamation"></i></div>
                <div class="kpi-label">Over-budget Students</div>
                <div class="kpi-value text-rose-500" id="kpiOverBudgetCount">0 Students</div>
            </div>
            <div class="kpi ios-glass ios-glass-interactive">
                <div class="kpi-icon text-emerald-500"><i class="fa-solid fa-piggy-bank"></i></div>
                <div class="kpi-label">Active Saving Goals</div>
                <div class="kpi-value" id="kpiGoalTotal">Rs. 0 Saved</div>
            </div>
        </section>

        <!-- CHARTS -->
        <section class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
            <div class="lg:col-span-2 ios-glass p-6 rounded-[28px]">
                <div class="flex justify-between items-center mb-4">
                    <div>
                        <div class="text-sm font-bold">Category Allocation vs Actual Spent</div>
                        <div class="text-[10px] opacity-45">Platform-wide expenditure comparison</div>
                    </div>
                    <span class="text-[9px] px-2.5 py-1 rounded-full bg-purple-600/10 text-purple-600 font-bold">Live Synced</span>
                </div>
                <div class="h-[230px]"><canvas id="budgetvsActualChart"></canvas></div>
            </div>
            <div class="ios-glass p-6 rounded-[28px] flex flex-col justify-between">
                <div>
                    <div class="text-sm font-bold">Budget Status Distribution</div>
                    <div class="text-[10px] opacity-45">Student thresholds tracking</div>
                    <div class="h-[170px] mt-2"><canvas id="budgetStatusChart"></canvas></div>
                </div>
                <div class="text-[10px] text-center opacity-60 mt-2">
                    <i class="fa-solid fa-circle-info text-amber-500 mr-1"></i> <span id="overBudgetWarnText">0 students require budget adjustment</span>
                </div>
            </div>
        </section>

        <!-- BUDGETS SECTION -->
        <section id="budgetSection" class="ios-glass p-6 rounded-[28px] mb-8">
            <div class="flex justify-between items-center mb-5 flex-wrap gap-3">
                <div>
                    <h3 class="font-black text-sm">Student Budgets & Usage Tracker</h3>
                    <p class="text-[10px] opacity-45">Track individual spending limits and send automated over-budget notifications.</p>
                </div>
                <button class="glass-btn primary-btn" onclick="openAddBudgetModal()"><i class="fa-solid fa-plus"></i> New Budget</button>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead>
                        <tr class="border-b border-slate-500/10 text-[10px] opacity-50 uppercase tracking-wider">
                            <th class="pb-3 px-2">Student</th>
                            <th class="pb-3 px-2">Category</th>
                            <th class="pb-3 px-2">Allocated</th>
                            <th class="pb-3 px-2">Used Amount</th>
                            <th class="pb-3 px-2 min-w-[150px]">Usage Progress</th>
                            <th class="pb-3 px-2">Status</th>
                            <th class="pb-3 px-2 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="budgetTableBody"></tbody>
                </table>
            </div>
        </section>

        <!-- SAVING GOALS SECTION -->
        <section id="goalSection">
            <div class="flex justify-between items-center mb-5">
                <div>
                    <h3 class="font-black text-sm">Active Saving Goals</h3>
                    <p class="text-[10px] opacity-45">Gamified student savings targets and milestone tracking.</p>
                </div>
                <button class="glass-btn primary-btn" onclick="openAddGoalModal()"><i class="fa-solid fa-plus"></i> New Goal</button>
            </div>
            <div id="savingGoalsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4"></div>
        </section>

    </main>

    <!-- BUDGET MODAL -->
    <div id="budgetModal" class="modal-overlay">
        <div class="modal-card ios-glass">
            <div class="flex justify-between items-center mb-4">
                <h3 id="budgetModalTitle" class="font-black text-base">Add Student Budget</h3>
                <button onclick="closeBudgetModal()" class="text-xs opacity-50 hover:opacity-100"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <form id="budgetForm" onsubmit="saveBudget(event)" class="space-y-4 text-xs">
                <input type="hidden" id="budgetId">
                <div>
                    <label class="block font-bold mb-1 opacity-70">Student</label>
                    <select id="budStudent" required class="w-full p-3 rounded-xl bg-slate-500/10 border border-slate-500/20 outline-none"></select>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-bold mb-1 opacity-70">Category</label>
                        <select id="budCategory" class="w-full p-3 rounded-xl bg-slate-500/10 border border-slate-500/20 outline-none"></select>
                    </div>
                    <div>
                        <label class="block font-bold mb-1 opacity-70">Allocated Amount (Rs.)</label>
                        <input type="number" id="budLimit" required min="1" step="0.01" class="w-full p-3 rounded-xl bg-slate-500/10 border border-slate-500/20 outline-none" placeholder="500">
                    </div>
                </div>
                <div class="flex gap-2 pt-2">
                    <button type="button" onclick="closeBudgetModal()" class="glass-btn flex-1 justify-center">Cancel</button>
                    <button type="submit" class="glass-btn primary-btn flex-1 justify-center">Save Budget</button>
                </div>
            </form>
        </div>
    </div>

    <!-- GOAL MODAL -->
    <div id="goalModal" class="modal-overlay">
        <div class="modal-card ios-glass">
            <div class="flex justify-between items-center mb-4">
                <h3 id="goalModalTitle" class="font-black text-base">Add Saving Goal</h3>
                <button onclick="closeGoalModal()" class="text-xs opacity-50 hover:opacity-100"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <form id="goalForm" onsubmit="saveGoal(event)" class="space-y-4 text-xs">
                <input type="hidden" id="goalId">
                <div>
                    <label class="block font-bold mb-1 opacity-70">Student</label>
                    <select id="goalStudent" required class="w-full p-3 rounded-xl bg-slate-500/10 border border-slate-500/20 outline-none"></select>
                </div>
                <div>
                    <label class="block font-bold mb-1 opacity-70">Goal Name</label>
                    <input type="text" id="goalTitle" required class="w-full p-3 rounded-xl bg-slate-500/10 border border-slate-500/20 outline-none" placeholder="e.g. New MacBook Pro M3">
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-bold mb-1 opacity-70">Target Amount (Rs.)</label>
                        <input type="number" id="goalTarget" required min="1" step="0.01" class="w-full p-3 rounded-xl bg-slate-500/10 border border-slate-500/20 outline-none" placeholder="1500">
                    </div>
                    <div>
                        <label class="block font-bold mb-1 opacity-70">Current Saved (Rs.)</label>
                        <input type="number" id="goalSaved" required min="0" step="0.01" class="w-full p-3 rounded-xl bg-slate-500/10 border border-slate-500/20 outline-none" placeholder="450">
                    </div>
                </div>
                <div>
                    <label class="block font-bold mb-1 opacity-70">Target Completion Date</label>
                    <input type="date" id="goalDate" required class="w-full p-3 rounded-xl bg-slate-500/10 border border-slate-500/20 outline-none">
                </div>
                <div class="flex gap-2 pt-2">
                    <button type="button" onclick="closeGoalModal()" class="glass-btn flex-1 justify-center">Cancel</button>
                    <button type="submit" class="glass-btn primary-btn flex-1 justify-center">Save Goal</button>
                </div>
            </form>
        </div>
    </div>

    <div id="toastContainer"></div>

    <script>
        let budgets = [];
        let goals = [];
        let studentsList = [];
        let categoriesList = [];
        let chart1 = null, chart2 = null;
        const BUD_API = "/api/admin/budgets";
        const GOAL_API = "/api/admin/saving-goals";

        document.addEventListener("DOMContentLoaded", async () => {
            initializeTheme();
            await Promise.all([loadStudents(), loadCategories()]);
            await Promise.all([loadBudgets(), loadGoals()]);
        });

        async function loadStudents() {
            try {
                const r = await fetch(`${BUD_API}/students`, { credentials: "same-origin" });
                studentsList = await r.json();
            } catch (e) { console.error(e); }
        }
        async function loadCategories() {
            try {
                const r = await fetch(`${BUD_API}/categories`, { credentials: "same-origin" });
                categoriesList = await r.json();
            } catch (e) { console.error(e); }
        }

        async function loadBudgets() {
            try {
                const r = await fetch(BUD_API, { credentials: "same-origin" });
                if (!r.ok) throw new Error(`HTTP ${r.status}`);
                budgets = await r.json();
                renderBudgets();
                updateKPIs();
                updateCharts();
            } catch (e) { showToast("Budgets load failed: " + e.message); }
        }
        async function loadGoals() {
            try {
                const r = await fetch(GOAL_API, { credentials: "same-origin" });
                if (!r.ok) throw new Error(`HTTP ${r.status}`);
                goals = await r.json();
                renderGoals();
                updateKPIs();
            } catch (e) { showToast("Goals load failed: " + e.message); }
        }

        function renderBudgets(searchTerm = "") {
            const tbody = document.getElementById("budgetTableBody");
            tbody.innerHTML = "";
            const term = searchTerm.toLowerCase().trim();
            const filtered = term
                ? budgets.filter(b => (b.student || "").toLowerCase().includes(term) || (b.category || "").toLowerCase().includes(term))
                : budgets;

            if (!filtered.length) {
                tbody.innerHTML = `<tr><td colspan="7" class="text-center py-8 opacity-40">No budget records found</td></tr>`;
                return;
            }

            filtered.forEach(b => {
                const limit = Number(b.limit) || 0;
                const used = Number(b.used) || 0;
                const percent = limit > 0 ? Math.round((used / limit) * 100) : 0;
                let badge, barColor;
                if (percent >= 100) { badge = `<span class="px-2 py-0.5 rounded-full bg-rose-500/10 text-rose-500 font-bold text-[9px]"><i class="fa-solid fa-triangle-exclamation mr-1"></i>Over-budget</span>`; barColor = "bg-rose-500"; }
                else if (percent >= (b.threshold || 85)) { badge = `<span class="px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-500 font-bold text-[9px]"><i class="fa-solid fa-clock mr-1"></i>Near Limit</span>`; barColor = "bg-amber-500"; }
                else { badge = `<span class="px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-500 font-bold text-[9px]"><i class="fa-solid fa-circle-check mr-1"></i>On Track</span>`; barColor = "bg-emerald-500"; }

                const tr = document.createElement("tr");
                tr.className = "border-b border-slate-500/10 hover:bg-slate-500/5";
                tr.innerHTML = `
                    <td class="py-3 px-2 font-bold">${b.student}</td>
                    <td class="py-3 px-2">${b.category}</td>
                    <td class="py-3 px-2">Rs. ${limit.toLocaleString()}</td>
                    <td class="py-3 px-2 font-black">${used > limit ? `<span class="text-rose-500">Rs. ${used.toLocaleString()}</span>` : `Rs. ${used.toLocaleString()}`}</td>
                    <td class="py-3 px-2">
                        <div class="flex items-center gap-2">
                            <div class="w-full bg-slate-500/20 h-1.5 rounded-full overflow-hidden">
                                <div class="h-full rounded-full ${barColor}" style="width: ${Math.min(percent, 100)}%"></div>
                            </div>
                            <span class="text-[9px] font-bold opacity-60">${percent}%</span>
                        </div>
                    </td>
                    <td class="py-3 px-2">${badge}</td>
                    <td class="py-3 px-2 text-right">
                        <button onclick="notifyStudentBudget(${b.id})" title="Send Alert" class="p-1 hover:text-amber-500"><i class="fa-regular fa-bell"></i></button>
                        <button onclick="openEditBudgetModal(${b.id})" title="Edit" class="p-1 hover:text-purple-600"><i class="fa-regular fa-pen-to-square"></i></button>
                        <button onclick="deleteBudget(${b.id})" title="Delete" class="p-1 hover:text-rose-500"><i class="fa-regular fa-trash-can"></i></button>
                    </td>`;
                tbody.appendChild(tr);
            });
        }

        function renderGoals(searchTerm = "") {
            const grid = document.getElementById("savingGoalsGrid");
            grid.innerHTML = "";
            const term = searchTerm.toLowerCase().trim();
            const filtered = term
                ? goals.filter(g => (g.student || "").toLowerCase().includes(term) || (g.title || "").toLowerCase().includes(term))
                : goals;

            if (!filtered.length) {
                grid.innerHTML = `<div class="col-span-full text-center py-8 opacity-40 text-xs">No saving goals found</div>`;
                return;
            }

            filtered.forEach(g => {
                const target = Number(g.target) || 0;
                const saved = Number(g.saved) || 0;
                const percent = target > 0 ? Math.min(Math.round((saved / target) * 100), 100) : 0;
                const card = document.createElement("div");
                card.className = "ios-glass ios-glass-interactive p-5 rounded-[24px] flex flex-col justify-between";
                card.innerHTML = `
                    <div>
                        <div class="flex justify-between items-start mb-3">
                            <div class="w-10 h-10 rounded-xl flex items-center justify-center text-white" style="background:${g.color}">
                                <i class="fa-solid ${g.icon}"></i>
                            </div>
                            <span class="text-[9px] px-2 py-0.5 rounded-full bg-slate-500/10 font-bold">${percent === 100 ? 'Achieved 🎉' : 'In Progress'}</span>
                        </div>
                        <div class="font-black text-sm">${g.title}</div>
                        <div class="text-[10px] opacity-50 mb-3">Student: ${g.student}</div>
                    </div>
                    <div>
                        <div class="flex justify-between text-[10px] font-bold mb-1">
                            <span>Rs. ${saved.toLocaleString()} saved</span>
                            <span class="opacity-45">Target: Rs. ${target.toLocaleString()}</span>
                        </div>
                        <div class="w-full bg-slate-500/20 h-2 rounded-full overflow-hidden mb-3">
                            <div class="h-full rounded-full" style="width:${percent}%; background:${g.color}"></div>
                        </div>
                        <div class="flex justify-between items-center text-[9px] opacity-50 border-t border-slate-500/10 pt-2">
                            <span>Target: ${g.date || "—"}</span>
                            <div class="flex gap-2">
                                <button onclick="quickDeposit(${g.id})" class="hover:text-emerald-500 font-bold"><i class="fa-solid fa-plus"></i> Deposit</button>
                                <button onclick="editGoal(${g.id})" class="hover:text-purple-600"><i class="fa-regular fa-pen-to-square"></i></button>
                                <button onclick="deleteGoal(${g.id})" class="hover:text-rose-500"><i class="fa-regular fa-trash-can"></i></button>
                            </div>
                        </div>
                    </div>`;
                grid.appendChild(card);
            });
        }

        function updateKPIs() {
            const totAlloc = budgets.reduce((s, b) => s + Number(b.limit || 0), 0);
            const totUsed = budgets.reduce((s, b) => s + Number(b.used || 0), 0);
            const over = budgets.filter(b => Number(b.used) > Number(b.limit)).length;
            const totSaved = goals.reduce((s, g) => s + Number(g.saved || 0), 0);

            document.getElementById("kpiTotalBudget").textContent = `Rs. ${totAlloc.toLocaleString()}`;
            document.getElementById("kpiBudgetUsed").textContent = `Rs. ${totUsed.toLocaleString()}`;
            document.getElementById("kpiOverBudgetCount").textContent = `${over} Students`;
            document.getElementById("kpiGoalTotal").textContent = `Rs. ${totSaved.toLocaleString()}`;
            document.getElementById("overBudgetWarnText").textContent = `${over} student(s) exceeding monthly spending threshold.`;
        }

        function handleSearch() {
            const term = document.getElementById("globalSearch").value;
            renderBudgets(term);
            renderGoals(term);
        }

        /* MODALS */
        function fillStudentDropdown(sel, selectedId = null) {
            sel.innerHTML = "";
            studentsList.forEach(s => {
                const o = document.createElement("option");
                o.value = s.userId;
                o.textContent = `${s.fullName}${s.academicYear ? ' (' + s.academicYear + ')' : ''}`;
                sel.appendChild(o);
            });
            if (selectedId) sel.value = selectedId;
        }
        function fillCategoryDropdown(sel, selectedId = null) {
            sel.innerHTML = "";
            categoriesList.forEach(c => {
                const o = document.createElement("option");
                o.value = c.categoryId;
                o.textContent = c.name;
                sel.appendChild(o);
            });
            if (selectedId) sel.value = selectedId;
        }

        function openAddBudgetModal() {
            document.getElementById("budgetModalTitle").textContent = "Add Student Budget";
            document.getElementById("budgetId").value = "";
            document.getElementById("budgetForm").reset();
            fillStudentDropdown(document.getElementById("budStudent"));
            fillCategoryDropdown(document.getElementById("budCategory"));
            document.getElementById("budgetModal").classList.add("show");
        }
        function openEditBudgetModal(id) {
            const b = budgets.find(x => x.id === id);
            if (!b) return;
            document.getElementById("budgetModalTitle").textContent = "Edit Student Budget";
            document.getElementById("budgetId").value = b.id;
            fillStudentDropdown(document.getElementById("budStudent"), b.userId);
            fillCategoryDropdown(document.getElementById("budCategory"), b.categoryId);
            document.getElementById("budLimit").value = b.limit;
            document.getElementById("budgetModal").classList.add("show");
        }
        function closeBudgetModal() { document.getElementById("budgetModal").classList.remove("show"); }

        async function saveBudget(e) {
            e.preventDefault();
            const id = document.getElementById("budgetId").value;
            const payload = {
                userId: Number(document.getElementById("budStudent").value),
                categoryId: Number(document.getElementById("budCategory").value),
                limit: Number(document.getElementById("budLimit").value)
            };
            try {
                const url = id ? `${BUD_API}/${id}` : BUD_API;
                const method = id ? "PUT" : "POST";
                const r = await fetch(url, { method, headers: { "Content-Type": "application/json" }, credentials: "same-origin", body: JSON.stringify(payload) });
                const d = await r.json().catch(() => ({}));
                if (!r.ok) throw new Error(d.message || `HTTP ${r.status}`);
                closeBudgetModal();
                await loadBudgets();
                showToast(id ? "Budget updated successfully" : "New budget added successfully");
            } catch (e) { showToast("Save failed: " + e.message); }
        }

        async function deleteBudget(id) {
            if (!confirm("Delete this student budget record?")) return;
            try {
                const r = await fetch(`${BUD_API}/${id}`, { method: "DELETE", credentials: "same-origin" });
                if (!r.ok) throw new Error(`HTTP ${r.status}`);
                await loadBudgets();
                showToast("Budget record removed");
            } catch (e) { showToast("Delete failed: " + e.message); }
        }

        async function notifyStudentBudget(id) {
            try {
                const r = await fetch(`${BUD_API}/${id}/notify`, { method: "POST", credentials: "same-origin" });
                const d = await r.json();
                if (!r.ok) throw new Error(d.message || `HTTP ${r.status}`);
                showToast(`Notification sent (${d.percent}% budget used)`);
            } catch (e) { showToast("Notify failed: " + e.message); }
        }

        function openAddGoalModal() {
            document.getElementById("goalModalTitle").textContent = "Add Saving Goal";
            document.getElementById("goalId").value = "";
            document.getElementById("goalForm").reset();
            fillStudentDropdown(document.getElementById("goalStudent"));
            const d = new Date(); d.setMonth(d.getMonth() + 6);
            document.getElementById("goalDate").value = d.toISOString().split("T")[0];
            document.getElementById("goalModal").classList.add("show");
        }
        function editGoal(id) {
            const g = goals.find(x => x.id === id);
            if (!g) return;
            document.getElementById("goalModalTitle").textContent = "Edit Saving Goal";
            document.getElementById("goalId").value = g.id;
            fillStudentDropdown(document.getElementById("goalStudent"), g.userId);
            document.getElementById("goalTitle").value = g.title;
            document.getElementById("goalTarget").value = g.target;
            document.getElementById("goalSaved").value = g.saved;
            document.getElementById("goalDate").value = g.date || "";
            document.getElementById("goalModal").classList.add("show");
        }
        function closeGoalModal() { document.getElementById("goalModal").classList.remove("show"); }

        async function saveGoal(e) {
            e.preventDefault();
            const id = document.getElementById("goalId").value;
            const payload = {
                userId: Number(document.getElementById("goalStudent").value),
                title: document.getElementById("goalTitle").value.trim(),
                target: Number(document.getElementById("goalTarget").value),
                saved: Number(document.getElementById("goalSaved").value),
                date: document.getElementById("goalDate").value
            };
            try {
                const url = id ? `${GOAL_API}/${id}` : GOAL_API;
                const method = id ? "PUT" : "POST";
                const r = await fetch(url, { method, headers: { "Content-Type": "application/json" }, credentials: "same-origin", body: JSON.stringify(payload) });
                const d = await r.json().catch(() => ({}));
                if (!r.ok) throw new Error(d.message || `HTTP ${r.status}`);
                closeGoalModal();
                await loadGoals();
                showToast(id ? "Goal updated" : "New saving goal created");
            } catch (e) { showToast("Save failed: " + e.message); }
        }

        async function quickDeposit(id) {
            try {
                const r = await fetch(`${GOAL_API}/${id}/deposit`, {
                    method: "POST", headers: { "Content-Type": "application/json" },
                    credentials: "same-origin", body: JSON.stringify({ amount: 100 })
                });
                if (!r.ok) throw new Error(`HTTP ${r.status}`);
                await loadGoals();
                showToast("Rs. 100 added to goal");
            } catch (e) { showToast("Deposit failed: " + e.message); }
        }

        async function deleteGoal(id) {
            if (!confirm("Delete this saving goal?")) return;
            try {
                const r = await fetch(`${GOAL_API}/${id}`, { method: "DELETE", credentials: "same-origin" });
                if (!r.ok) throw new Error(`HTTP ${r.status}`);
                await loadGoals();
                showToast("Saving goal removed");
            } catch (e) { showToast("Delete failed: " + e.message); }
        }

        /* CHARTS */
        function initCharts() {
            const grid = document.documentElement.classList.contains("dark") ? "rgba(255,255,255,0.08)" : "rgba(0,0,0,0.06)";
            const c1 = document.getElementById("budgetvsActualChart");
            const c2 = document.getElementById("budgetStatusChart");
            if (!c1 || !c2) return;

            chart1 = new Chart(c1.getContext("2d"), {
                type: 'bar',
                data: getChart1Data(),
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { labels: { font: { size: 10 } } } },
                    scales: { x: { grid: { display: false }, ticks: { font: { size: 9 } } }, y: { grid: { color: grid }, beginAtZero: true, ticks: { font: { size: 9 } } } }
                }
            });
            chart2 = new Chart(c2.getContext("2d"), {
                type: 'doughnut',
                data: getChart2Data(),
                options: {
                    responsive: true, maintainAspectRatio: false, cutout: '70%',
                    plugins: { legend: { position: 'bottom', labels: { font: { size: 9 } } } }
                }
            });
        }
        function getChart1Data() {
            const cats = [...new Set(budgets.map(b => b.category))];
            const allocated = cats.map(c => budgets.filter(b => b.category === c).reduce((s, b) => s + Number(b.limit || 0), 0));
            const spent = cats.map(c => budgets.filter(b => b.category === c).reduce((s, b) => s + Number(b.used || 0), 0));
            return {
                labels: cats,
                datasets: [
                    { label: 'Allocated', data: allocated, backgroundColor: 'rgba(139, 88, 184, 0.7)', borderRadius: 6 },
                    { label: 'Actual Spent', data: spent, backgroundColor: 'rgba(244, 63, 94, 0.7)', borderRadius: 6 }
                ]
            };
        }
        function getChart2Data() {
            const over = budgets.filter(b => Number(b.used) > Number(b.limit)).length;
            const near = budgets.filter(b => Number(b.used) <= Number(b.limit) && (Number(b.used) / Number(b.limit) * 100) >= (b.threshold || 85)).length;
            const safe = budgets.length - over - near;
            return { labels: ['On Track', 'Near Limit', 'Over Budget'], datasets: [{ data: [safe, near, over], backgroundColor: ['#10b981', '#f59e0b', '#f43f5e'], borderWidth: 0 }] };
        }
        function updateCharts() {
            if (!chart1 || !chart2) { initCharts(); return; }
            chart1.data = getChart1Data(); chart1.update();
            chart2.data = getChart2Data(); chart2.update();
        }

        /* TABS */
        function switchTab(type) {
            document.querySelectorAll(".page-header button").forEach(b => b.classList.remove("primary-btn"));
            if (type === 'all') {
                document.getElementById("tabAll").classList.add("primary-btn");
                document.getElementById("budgetSection").style.display = "block";
                document.getElementById("goalSection").style.display = "block";
            } else if (type === 'budgets') {
                document.getElementById("tabBudgets").classList.add("primary-btn");
                document.getElementById("budgetSection").style.display = "block";
                document.getElementById("goalSection").style.display = "none";
            } else if (type === 'goals') {
                document.getElementById("tabGoals").classList.add("primary-btn");
                document.getElementById("budgetSection").style.display = "none";
                document.getElementById("goalSection").style.display = "block";
            }
            setTimeout(() => { try { chart1?.resize(); chart2?.resize(); } catch (e) {} }, 50);
        }

        /* THEME */
        function toggleTheme() {
            const html = document.documentElement;
            const dark = html.classList.contains("dark");
            if (dark) {
                html.classList.remove("dark"); html.classList.add("light");
                document.body.classList.remove("dark-mesh"); document.body.classList.add("light");
                localStorage.setItem("campuscoin-admin-theme", "light");
            } else {
                html.classList.remove("light"); html.classList.add("dark");
                document.body.classList.remove("light"); document.body.classList.add("dark-mesh");
                localStorage.setItem("campuscoin-admin-theme", "dark");
            }
            updateThemeIcon();
            loadBudgets();
        }
        function initializeTheme() {
            if (localStorage.getItem("campuscoin-admin-theme") === "dark") {
                document.documentElement.classList.add("dark");
                document.body.classList.add("dark-mesh");
            }
            updateThemeIcon();
        }
        function updateThemeIcon() {
            document.getElementById("themeIcon").className = document.documentElement.classList.contains("dark") ? "fa-solid fa-sun text-amber-300" : "fa-solid fa-moon";
        }

        /* SIDEBAR */
        function toggleSidebar() { document.getElementById("sidebar").classList.toggle("open"); document.getElementById("mobileOverlay").classList.toggle("hidden"); }
        function closeSidebar() { document.getElementById("sidebar").classList.remove("open"); document.getElementById("mobileOverlay").classList.add("hidden"); }

        /* TOAST */
        function showToast(msg) {
            const c = document.getElementById("toastContainer");
            const t = document.createElement("div");
            t.className = "toast ios-glass";
            t.innerHTML = `<div class="w-8 h-8 rounded-xl bg-purple-600/10 text-purple-600 flex items-center justify-center"><i class="fa-solid fa-check"></i></div><div class="text-[10px] font-bold">${msg}</div>`;
            c.appendChild(t);
            setTimeout(() => t.remove(), 2500);
        }

        document.addEventListener("keydown", e => { if (e.key === "Escape") { closeBudgetModal(); closeGoalModal(); closeSidebar(); } });
    </script>

<script>
(function(){
  if (typeof window.toggleDropdown !== 'function') {
    window.toggleDropdown = function(id){
      const t = document.getElementById(id);
      if (!t) return;
      document.querySelectorAll('.dropdown').forEach(d => {
        if (d.id !== id) { d.classList.remove('show'); d.style.display = 'none'; }
      });
      const open = !t.classList.contains('show');
      t.classList.toggle('show', open);
      t.style.display = open ? 'block' : 'none';
    };
    document.addEventListener('click', function(e){
      if (!e.target.closest('.dropdown-wrap')) {
        document.querySelectorAll('.dropdown').forEach(d => { d.classList.remove('show'); d.style.display = 'none'; });
      }
    });
  }
  if (typeof window.logoutAdmin !== 'function') {
    window.logoutAdmin = function(){ window.location.href = '/Auth/Logout'; };
  }
  if (typeof window.quickAction !== 'function') {
    window.quickAction = function(action){
      document.querySelectorAll('.dropdown').forEach(d => { d.classList.remove('show'); d.style.display='none'; });
      const routes = {
        'Add Student': '/Admin/Students',
        'View Transactions': '/Admin/Transactions',
        'Send Notification': '/Admin/Notifications',
        'Generate Report': '/Admin/Reports'
      };
      if (routes[action]) window.location.href = routes[action];
    };
  }
})();
</script>


<script>
(function(){

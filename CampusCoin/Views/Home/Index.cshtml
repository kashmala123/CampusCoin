        /* ════════════════════════════════════════════════════════════
           CATEGORIES
           ════════════════════════════════════════════════════════════ */
        .cc-landing .cat-section {
            position: relative;
            padding: 120px 0;
            overflow: hidden;
            background:
                radial-gradient(ellipse 50% 45% at 10% 10%, rgba(212, 243, 228, .5), transparent 65%),
                radial-gradient(ellipse 50% 45% at 92% 20%, rgba(255, 225, 230, .55), transparent 65%),
                radial-gradient(ellipse 55% 50% at 50% 100%, rgba(237, 228, 246, .55), transparent 70%),
                linear-gradient(180deg, #fbf6f0 0%, #f6eee4 100%);
            isolation: isolate;
        }
        .cc-landing .cat-bg { position: absolute; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
        .cc-landing .cat-orb { position: absolute; border-radius: 50%; filter: blur(100px); opacity: .5; }
        .cc-landing .cat-orb-1 { width: 480px; height: 480px; top: -10%; left: -8%; background: radial-gradient(circle, rgba(110, 207, 168, .55), transparent 70%); animation: catFloatA 22s ease-in-out infinite; }
        .cc-landing .cat-orb-2 { width: 540px; height: 540px; bottom: -20%; right: -10%; background: radial-gradient(circle, rgba(212, 121, 159, .45), transparent 70%); animation: catFloatB 26s ease-in-out infinite; }
        .cc-landing .cat-orb-3 { width: 340px; height: 340px; top: 45%; left: 45%; background: radial-gradient(circle, rgba(155, 111, 216, .3), transparent 70%); animation: catFloatA 30s ease-in-out infinite reverse; }
        @@keyframes catFloatA { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(40px, -30px) scale(1.1); } }
        @@keyframes catFloatB { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(-40px, 30px) scale(1.15); } }
        .cc-landing .cat-grid-dots {
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(107, 58, 146, .07) 1px, transparent 1px);
            background-size: 28px 28px;
            -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black, transparent);
                    mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black, transparent);
            pointer-events: none;
        }
        .cc-landing .cat-section .wrap { position: relative; z-index: 1; }

        /* Symmetrical 2-column grid */
        .cc-landing .cat-grid-equal {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 22px;
            align-items: stretch;
            grid-auto-rows: auto;
            margin-top: 10px;
        }
        .cc-landing .cat-grid-equal .cat-panel {
            display: flex;
            flex-direction: column;
            height: 100%;
        }
        .cc-landing .cat-grid-equal .cat-list {
            flex: 0 1 auto;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .cc-landing .cat-grid-equal .cat-row {
            display: grid;
            grid-template-columns: 40px 1fr auto;
            align-items: center;
            min-height: 60px;
        }

        .cc-landing .cat-panel {
            position: relative;
            overflow: hidden;
            border-radius: 28px;
            padding: 28px 26px 22px;
            backdrop-filter: blur(28px) saturate(180%);
            -webkit-backdrop-filter: blur(28px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, .9);
            box-shadow:

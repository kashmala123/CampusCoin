    <!-- ══════════ CATEGORIES — 2 content-filled panels ══════════ -->
    @{
        var catDensity = Model?.Get("cat_card_density", "comfortable") ?? "comfortable";
        var catRadius = Model?.Get("cat_card_radius", "22") ?? "22";
        var catEqual = (Model?.Get("cat_card_equal_height", "0") ?? "0") == "1";
        var catStyle = $"--cat-radius:{catRadius}px;";
    }
    <section class="section cat-section cc-sec-categories" id="categories" data-cat-density="@catDensity" style="@catStyle">
        <div class="cat-bg" aria-hidden="true">
            <span class="cat-orb cat-orb-1"></span>
            <span class="cat-orb cat-orb-2"></span>
            <span class="cat-orb cat-orb-3"></span>
            <span class="cat-grid-dots"></span>
        </div>

        <div class="wrap">
            <div class="section-head center">
                <span class="label"><i class="ri-price-tag-3-line"></i> @(Model?.Get("categories_label", "Categories that fit real life"))</span>
                <h2>Built for how students<br><em>actually spend.</em></h2>
                <p>@(Model?.Get("categories_subtitle", "From canteen food to hostel rent — every category is designed around student life. Add your own any time."))</p>
            </div>

            <div class="cat-grid cat-grid-equal" style="@(catEqual ? "align-items:stretch!important;" : "align-items:start!important;")">

                <!-- INCOME -->
                <div class="cat-panel income">
                    <span class="cat-panel-glow" aria-hidden="true"></span>

                    <div class="cat-panel-head">
                        <div class="cat-panel-icon"><i class="ri-arrow-down-line"></i></div>
                        <div class="cat-panel-info">
                            <h3>@(Model?.Get("income_title", "Income"))</h3>
                            <small>@(Model?.Get("income_subtitle", "Where your money comes from"))</small>
                        </div>
                        <div class="cat-panel-total">
                            @{ var incomeTotal = Model?.Get("income_total","32500") ?? "32500"; }
                            <b data-cat-count="@incomeTotal" data-prefix="Rs. ">Rs. @incomeTotal</b>
                            <small>this month</small>
                        </div>
                    </div>

                    <div class="cat-list-scroll">
                        <ul class="cat-list">
                        @if (Model?.IncomeItems != null)
                        {
                            foreach (var item in Model.IncomeItems)
                            {
                                <li class="cat-row">
                                    <span class="cat-ic mint"><i class="@item.Icon"></i></span>
                                    <div class="cat-info">
                                        <b>@item.Name</b>
                                        <div class="cat-bar"><i style="--pct: @(item.Percent)%"></i></div>
                                    </div>
                                    <span class="cat-amt">Rs. @item.Amount.ToString("N0")</span>
                                </li>
                            }
                        }
                        </ul>
                    </div>
                    <ul class="cat-list cat-list-footer">
                        <li class="cat-row add-row">
                            <span class="cat-ic"><i class="ri-add-line"></i></span>
                            <div class="cat-info">
                                <b class="muted">Add your own</b>
                                <small>Custom income source</small>
                            </div>
                            <span class="cat-arrow"><i class="ri-arrow-right-line"></i></span>
                        </li>
                    </ul>
                </div>

                <!-- EXPENSES -->
                <div class="cat-panel expense">
                    <span class="cat-panel-glow" aria-hidden="true"></span>

                    <div class="cat-panel-head">
                        <div class="cat-panel-icon"><i class="ri-arrow-up-line"></i></div>
                        <div class="cat-panel-info">
                            <h3>@(Model?.Get("expense_title", "Expenses"))</h3>
                            <small>@(Model?.Get("expense_subtitle", "Where it actually goes"))</small>
                        </div>
                        <div class="cat-panel-total">
                            @{ var expenseTotal = Model?.Get("expense_total","24850") ?? "24850"; }
                            <b data-cat-count="@expenseTotal" data-prefix="Rs. ">Rs. @expenseTotal</b>
                            <small>this month</small>
                        </div>
                    </div>

                    <div class="cat-list-scroll">
                        <ul class="cat-list">
                        @if (Model?.ExpenseItems != null)
                        {
                            foreach (var item in Model.ExpenseItems)
                            {
                                <li class="cat-row">
                                    <span class="cat-ic rose"><i class="@item.Icon"></i></span>
                                    <div class="cat-info">
                                        <b>@item.Name</b>
                                        <div class="cat-bar"><i style="--pct: @(item.Percent)%"></i></div>
                                    </div>
                                    <span class="cat-amt">Rs. @item.Amount.ToString("N0")</span>
                                </li>
                            }
                        }
                        </ul>
                    </div>
                    <ul class="cat-list cat-list-footer">
                        <li class="cat-row add-row">
                            <span class="cat-ic"><i class="ri-add-line"></i></span>
                            <div class="cat-info">
                                <b class="muted">Add your own</b>
                                <small>Custom expense category</small>
                            </div>
                            <span class="cat-arrow"><i class="ri-arrow-right-line"></i></span>
                        </li>
                    </ul>
                </div>

            </div>

            <div class="cat-custom cc-sec-manage">
                <span class="cat-custom-glow"></span>
                <div class="cat-custom-text">
                    <span class="cat-custom-icon">
                        <i class="ri-shapes-line"></i>
                        <span class="cat-custom-icon-ring"></span>
                    </span>
                    <div>
                        <b>@(Model?.Get("categories_cta_title", "Manage your own categories"))</b>
                        <small>@(Model?.Get("categories_cta_text", "Add, edit, or delete any category — your categories, your rules."))</small>
                    </div>
                </div>
                <a class="cat-custom-cta" asp-controller="Account" asp-action="Register">
                    @(Model?.Get("categories_cta_button", "Try it")) <i class="ri-arrow-right-line"></i>
                </a>
            </div>
        </div>
    </section>


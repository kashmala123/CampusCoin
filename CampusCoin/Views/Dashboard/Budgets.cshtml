        </nav>

        <div class="student-mini">
            <div class="student-avatar" id="sidebarAvatar">AR</div>
            <div class="flex-1 min-w-0">
                <div class="text-[11px] font-bold truncate" id="sidebarStudentName">Loading...</div>
                <div class="text-[9px] opacity-45 truncate" id="sidebarStudentRole">Student</div>
            </div>
            <i class="fa-solid fa-graduation-cap text-xs opacity-35"></i>
        </div>
        <a href="/Auth/Logout" style="display:flex;align-items:center;gap:10px;padding:10px 12px;margin-top:8px;border-radius:12px;font-size:13px;font-weight:700;color:#e11d48;text-decoration:none;">
            <i class="fa-solid fa-right-from-bracket"></i> Logout
        </a>
    </aside>
    <main class="main">
        <header class="topbar ios-glass">
            <button class="action-btn mobile-btn" onclick="toggleSidebar()"><i class="fa-solid fa-bars"></i></button>
            <div class="search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" placeholder="Search budgets..." id="searchInput" oninput="handleSearch(this.value)">
            </div>

            <div class="top-actions">
                <button class="glass-btn primary-btn" onclick="openAddBudgetModal()"><i class="fa-solid fa-plus mr-1"></i> Add Budget</button>
                <button class="action-btn" onclick="toggleTheme()"><i id="themeIcon" class="fa-solid fa-moon"></i></button>

                <div class="dropdown-wrap cc-notif-wrap" style="position:relative;z-index:10002;overflow:visible;">
                    <button type="button" class="action-btn cc-notif-btn" title="Notifications" aria-label="Notifications">
                        <i class="fa-regular fa-bell"></i>
                        <span class="cc-notif-dot hidden"></span>
                    </button>
                    <div class="cc-notif-popover" role="menu">
                        <div class="cc-notif-head">
                            <div class="cc-notif-title"><i class="fa-solid fa-bell"></i> Notifications</div>
                            <button type="button" class="cc-notif-markall">Mark all read</button>
                        </div>
                        <div class="cc-notif-list">
                            <div class="cc-notif-empty">Loading…</div>
                        </div>
                        <a href="/Dashboard/Notifications" class="cc-notif-footer">View all notifications →</a>
                    </div>
                </div>
                <div class="dropdown-wrap" style="position:relative;z-index:10002;overflow:visible;">
                    <div class="profile" data-cc-profile-btn style="cursor:pointer;display:flex;align-items:center;gap:8px;">
                        <div class="profile-avatar" id="topAvatar" style="width:34px;height:34px;border-radius:11px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:11px;font-weight:800;background:linear-gradient(135deg,#a486e0,#6366f1);">ST</div>
                        <div class="text-[10px] font-bold" id="topStudentName">Student</div>
                        <i class="fa-solid fa-chevron-down text-[8px] opacity-40"></i>
                    </div>
                    <div data-cc-profile-dd class="cc-shared-dd">
                        <a href="/Dashboard/Profile" class="cc-shared-dd-item"><i class="fa-regular fa-user"></i> Profile</a>
                        <a href="/Dashboard/Index" class="cc-shared-dd-item"><i class="fa-solid fa-chart-line"></i> Dashboard</a>
                        <a href="/Auth/Logout" class="cc-shared-dd-item" style="color:#e11d48;"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
                    </div>
                </div>

            </div>
        </header>

        <section class="page-header">
            <div>
                <div class="eyebrow">CampusCoin / Student Portal</div>
                <h1 class="page-title">My Budgets</h1>
                <p class="page-description">Manage your monthly category limits and keep your university expenses in check.</p>
            </div>
            <div class="date-pill ios-glass">
                <i class="fa-regular fa-calendar mr-1"></i>
                <span id="currentDate">Loading...</span>
            </div>
        </section>

        <!-- KPI METRICS -->
        <section class="kpi-grid">
            <div class="kpi ios-glass ios-glass-interactive">
                <div class="kpi-icon"><i class="fa-solid fa-wallet"></i></div>
                <div class="kpi-label">Total Monthly Budget</div>
                <div class="kpi-value text-purple-600" id="kpiTotalBudget">Rs. 0.00</div>
            </div>
            <div class="kpi ios-glass ios-glass-interactive">
                <div class="kpi-icon"><i class="fa-solid fa-chart-pie"></i></div>
                <div class="kpi-label">Total Spent So Far</div>
                <div class="kpi-value text-rose-500" id="kpiTotalSpent">Rs. 0.00</div>
            </div>
            <div class="kpi ios-glass ios-glass-interactive">
                <div class="kpi-icon"><i class="fa-solid fa-piggy-bank"></i></div>
                <div class="kpi-label">Remaining Balance</div>
                <div class="kpi-value text-emerald-500" id="kpiRemaining">Rs. 0.00</div>
            </div>
        </section>

        <!-- BUDGET CARDS -->
        <section class="budget-grid" id="budgetContainer">
            <div class="text-center py-12 col-span-2 text-xs opacity-40">Loading budgets...</div>
        </section>

        <!-- CHART -->
        <section class="chart-section">
            <div class="chart-card ios-glass ios-glass-interactive">
                <div>
                    <div class="chart-title">Budget Allocation vs Actual Spend</div>
                    <div class="chart-sub">Comparison across active categories</div>
                </div>
                <div class="chart-container">
                    <canvas id="budgetBarChart"></canvas>
                </div>
            </div>
        </section>
    </main>

    <!-- ADD BUDGET MODAL -->
    <div id="addBudgetModal" class="modal-overlay">
        <div class="modal-card ios-glass">
            <div class="flex justify-between items-center mb-4">
                <div class="font-extrabold text-sm">
                    <i class="fa-solid fa-sliders text-purple-600 mr-1"></i> Set Category Budget
                </div>
                <button class="action-btn !w-8 !h-8" onclick="closeAddBudgetModal()">
                    <i class="fa-solid fa-xmark text-xs"></i>
                </button>
            </div>
            <form onsubmit="handleAddBudget(event)" class="space-y-3 text-xs">
                <div>
                    <label class="block opacity-60 mb-1">Category</label>
                    <select id="budgetCategory" required
                            class="w-full px-3 py-2.5 rounded-xl bg-white/40 dark:bg-white/5 border border-white/50 dark:border-white/10 outline-none">
                        <option value="">Loading...</option>
                    </select>
                </div>
                <div>
                    <label class="block opacity-60 mb-1">Monthly Limit (Rs.)</label>
                    <input type="number" step="1" id="budgetLimit" required placeholder="e.g. 250"
                           class="w-full px-3 py-2.5 rounded-xl bg-white/40 dark:bg-white/5 border border-white/50 dark:border-white/10 outline-none focus:ring-2 focus:ring-sky-400">
                </div>
                <div class="flex gap-2 mt-5">
                    <button type="button" onclick="closeAddBudgetModal()" class="glass-btn flex-1 justify-center">Cancel</button>
                    <button type="submit" class="glass-btn primary-btn flex-1 justify-center" id="saveBudgetBtn">Set Budget</button>
                </div>
            </form>
        </div>
    </div>

    <!-- EDIT BUDGET MODAL -->
    <div id="editBudgetModal" class="modal-overlay">
        <div class="modal-card ios-glass">
            <div class="flex justify-between items-center mb-4">
                <div class="font-extrabold text-sm">
                    <i class="fa-solid fa-pen text-purple-600 mr-1"></i> Edit Budget Limit
                </div>
                <button class="action-btn !w-8 !h-8" onclick="closeEditBudgetModal()">
                    <i class="fa-solid fa-xmark text-xs"></i>
                </button>
            </div>
            <form onsubmit="handleEditBudget(event)" class="space-y-3 text-xs">
                <input type="hidden" id="editBudgetId">
                <input type="hidden" id="editBudgetCategoryId">
                <div>
                    <label class="block opacity-60 mb-1">Category</label>
                    <input type="text" id="editBudgetCategoryName" readonly
                           class="w-full px-3 py-2.5 rounded-xl bg-white/20 dark:bg-white/5 border border-white/50 dark:border-white/10 outline-none opacity-60">
                </div>
                <div>
                    <label class="block opacity-60 mb-1">New Monthly Limit (Rs.)</label>
                    <input type="number" step="1" id="editBudgetLimit" required
                           class="w-full px-3 py-2.5 rounded-xl bg-white/40 dark:bg-white/5 border border-white/50 dark:border-white/10 outline-none focus:ring-2 focus:ring-sky-400">
                </div>
                <div class="flex gap-2 mt-5">
                    <button type="button" onclick="closeEditBudgetModal()" class="glass-btn flex-1 justify-center">Cancel</button>
                    <button type="submit" class="glass-btn primary-btn flex-1 justify-center" id="updateBudgetBtn">Update</button>
                </div>
            </form>
        </div>
    </div>

    <div id="toastContainer"></div>

    <script>
        let budgetChartInstance = null;
        let allBudgets = [];
        let allCategories = [];

        const categoryIcons = {
            'Food': 'fa-utensils',
            'Transport': 'fa-bus',
            'Academics': 'fa-book-open',
            'Books': 'fa-book-open',
            'Entertainment': 'fa-film',
            'Hostel/Rent': 'fa-home',
            'Subscriptions': 'fa-repeat',
            'Miscellaneous': 'fa-ellipsis',
            'Allowance': 'fa-hand-holding-dollar',
            'Scholarship': 'fa-award',
            'Part-time Job': 'fa-briefcase',
            'Gift': 'fa-gift',
            'Other Income': 'fa-coins'
        };

        const categoryColors = {
            'Food': { text: 'text-amber-500', bg: 'bg-amber-500/10' },
            'Transport': { text: 'text-purple-600', bg: 'bg-purple-600/10' },
            'Academics': { text: 'text-purple-500', bg: 'bg-purple-500/10' },
            'Books': { text: 'text-emerald-500', bg: 'bg-emerald-500/10' },
            'Entertainment': { text: 'text-pink-500', bg: 'bg-pink-500/10' },
            'Hostel/Rent': { text: 'text-indigo-500', bg: 'bg-indigo-500/10' },
            'Subscriptions': { text: 'text-rose-500', bg: 'bg-rose-500/10' }
        };

        document.addEventListener("DOMContentLoaded", async function () {
            initializeTheme();
            setDate();
            await Promise.all([loadCategories(), loadBudgets(), loadUserInfo()]);
        });

        function setDate() {
            document.getElementById("currentDate").textContent = new Date().toLocaleDateString("en-US", {
                weekday: "short", month: "long", day: "numeric", year: "numeric"
            });
        }

        // ================= USER INFO =================
        async function loadUserInfo() {
            try {
                const res = await fetch('/api/dashboard/summary');
                if (!res.ok) return;
                const data = await res.json();

                if (data.userName) {
                    const initials = data.userName.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);
                    document.getElementById('sidebarAvatar').textContent = initials;
                    document.getElementById('sidebarStudentName').textContent = data.userName;
                    var topName = document.getElementById('topStudentName');
                    if (topName) topName.textContent = data.userName;
                    var topAv = document.getElementById('topAvatar');
                    if (topAv) topAv.textContent = data.userName.split(' ').map(function(n){return n[0];}).join('').toUpperCase().slice(0,2);
                }
                if (data.userAcademicYear) {
                    document.getElementById('sidebarStudentRole').textContent = data.userAcademicYear;
                }
            } catch (err) { console.error('Error loading user:', err); }
        }

        // ================= CATEGORIES =================
        async function loadCategories() {
            try {
                const res = await fetch('/api/categories');
                if (!res.ok) throw new Error('Failed to load categories');
                allCategories = await res.json();

                const select = document.getElementById('budgetCategory');
                const expenseCats = allCategories.filter(c => c.type === 'Expense');

                select.innerHTML = '<option value="">-- Select Category --</option>' +
                    expenseCats.map(c => `<option value="${c.categoryId}">${c.name}</option>`).join('');
            } catch (err) { console.error('Error loading categories:', err); }
        }

        // ================= BUDGETS =================
        async function loadBudgets() {
            try {
                const res = await fetch('/api/budgets');
                if (!res.ok) throw new Error('Failed to load budgets');
                allBudgets = await res.json();

                renderBudgetCards();
                updateKPIs();
                renderChart();
            } catch (err) {
                console.error('Error loading budgets:', err);
                document.getElementById('budgetContainer').innerHTML =
                    '<div class="text-center py-12 col-span-2 text-xs text-rose-500">Failed to load budgets</div>';
            }
        }

        // ================= RENDER CARDS =================
        function renderBudgetCards() {
            const container = document.getElementById('budgetContainer');

            if (!allBudgets || allBudgets.length === 0) {
                container.innerHTML = `
                    <div class="col-span-2 text-center py-12 ios-glass rounded-3xl">
                        <i class="fa-solid fa-wallet text-4xl opacity-20 mb-3"></i>
                        <div class="text-sm font-bold opacity-60">No budgets defined yet</div>
                        <div class="text-xs opacity-40 mt-1">Click "Add Budget" to set your first category limit</div>
                    </div>`;
                return;
            }

            container.innerHTML = allBudgets.map(b => {
                const catName = b.categoryName || 'Unknown';
                const icon = categoryIcons[catName] || 'fa-tag';
                const colors = categoryColors[catName] || { text: 'text-purple-600', bg: 'bg-purple-600/10' };

                const pct = Math.min(100, b.percentageUsed || 0);
                const status = b.status || 'Safe';
                const remaining = b.remainingAmount || 0;

                let statusColor, progressColor, statusIcon;
                if (status === 'Exceeded') {
                    statusColor = 'bg-rose-500/10 text-rose-500';
                    progressColor = '#f43f5e';
                    statusIcon = 'fa-triangle-exclamation';
                } else if (status === 'Warning') {
                    statusColor = 'bg-amber-500/10 text-amber-500';
                    progressColor = '#f59e0b';
                    statusIcon = 'fa-triangle-exclamation';
                } else {
                    statusColor = 'bg-emerald-500/10 text-emerald-500';
                    progressColor = '#10b981';
                    statusIcon = 'fa-circle-check';
                }

                return `
                    <div class="budget-card ios-glass ios-glass-interactive">
                        <div class="budget-top">
                            <div class="flex items-center gap-3">
                                <div class="budget-icon ${colors.text} ${colors.bg}"><i class="fa-solid ${icon}"></i></div>
                                <div>
                                    <div class="text-[13px] font-bold">${catName}</div>
                                    <div class="text-[9px] opacity-45">Monthly Limit</div>
                                </div>
                            </div>
                            <span class="text-[10px] font-bold px-2.5 py-1 rounded-lg ${statusColor}">${pct}% Used</span>
                        </div>
                        <div class="flex justify-between text-[11px] font-semibold mt-2">
                            <span>Spent: Rs. ${(b.spentAmount || 0).toFixed(2)}</span>
                            <span class="opacity-50">Limit: Rs. ${(b.limitAmount || 0).toFixed(2)}</span>
                        </div>
                        <div class="progress-track">
                            <div class="progress-fill" style="width: ${pct}%; background: ${progressColor};"></div>
                        </div>
                        <div class="flex justify-between items-center mt-3 text-[9px] opacity-60">
                            <span>
                                <i class="fa-solid ${statusIcon} mr-1" style="color: ${progressColor};"></i>
                                Rs. ${remaining.toFixed(2)} remaining
                            </span>
                            <div class="flex gap-1">
                                <button class="glass-btn text-[9px] py-1 px-2"
                                        onclick="openEditBudgetModal(${b.budgetId})">
                                    <i class="fa-solid fa-pen"></i> Edit
                                </button>
                                <button class="glass-btn text-[9px] py-1 px-2 text-rose-500"
                                        onclick="deleteBudget(${b.budgetId})">
                                    <i class="fa-regular fa-trash-can"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        // ================= KPIs =================
        function updateKPIs() {
            const totalLimit = allBudgets.reduce((s, b) => s + (b.limitAmount || 0), 0);
            const totalSpent = allBudgets.reduce((s, b) => s + (b.spentAmount || 0), 0);
            const remaining = totalLimit - totalSpent;

            document.getElementById('kpiTotalBudget').textContent = `Rs. ${totalLimit.toFixed(2)}`;
            document.getElementById('kpiTotalSpent').textContent = `Rs. ${totalSpent.toFixed(2)}`;
            document.getElementById('kpiRemaining').textContent = `Rs. ${remaining.toFixed(2)}`;
        }

        // ================= CHART =================
        function renderChart() {
            const colors = getChartColors();
            const ctx = document.getElementById('budgetBarChart').getContext('2d');

            if (budgetChartInstance) budgetChartInstance.destroy();

            const labels = allBudgets.map(b => b.categoryName);
            const limits = allBudgets.map(b => b.limitAmount);
            const spent = allBudgets.map(b => b.spentAmount);

            budgetChartInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels.length ? labels : ['No budgets'],
                    datasets: [
                        {
                            label: 'Budget Limit',
                            data: limits.length ? limits : [0],
                            backgroundColor: 'rgba(139,88,184,0.45)',
                            borderRadius: 8
                        },
                        {
                            label: 'Actual Spend',
                            data: spent.length ? spent : [0],
                            backgroundColor: '#8b58b8',
                            borderRadius: 8
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { labels: { color: colors.text, font: { size: 10 } } }
                    },
                    scales: {
                        x: { grid: { display: false }, ticks: { color: colors.text, font: { size: 9 } } },
                        y: { grid: { color: colors.grid }, ticks: { color: colors.text, font: { size: 9 } } }
                    }
                }
            });
        }

        function getChartColors() {
            const dark = document.documentElement.classList.contains("dark");
            return {
                text: dark ? "rgba(226,232,240,.65)" : "rgba(15,23,42,.55)",
                grid: dark ? "rgba(255,255,255,.06)" : "rgba(15,23,42,.07)"
            };
        }

        // ================= ADD BUDGET =================
        function openAddBudgetModal() {
            document.getElementById('addBudgetModal').classList.add('show');
        }

        function closeAddBudgetModal() {
            document.getElementById('addBudgetModal').classList.remove('show');
            document.getElementById('budgetLimit').value = '';
            document.getElementById('budgetCategory').value = '';
        }

        async function handleAddBudget(e) {
            e.preventDefault();

            const categoryId = parseInt(document.getElementById('budgetCategory').value);
            const limitAmount = parseFloat(document.getElementById('budgetLimit').value);

            if (!categoryId) { showToast('Please select a category', 'error'); return; }
            if (!limitAmount || limitAmount <= 0) { showToast('Please enter a valid limit', 'error'); return; }

            const btn = document.getElementById('saveBudgetBtn');
            const original = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';
            btn.disabled = true;

            try {
                const res = await fetch('/api/budgets', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ categoryId, limitAmount })
                });

                if (!res.ok) {
                    const err = await res.json().catch(() => ({}));
                    showToast(err.message || 'Failed to add budget', 'error');
                    return;
                }

                closeAddBudgetModal();
                showToast('Budget set successfully!', 'success');
                await loadBudgets();
            } catch (err) {
                console.error(err);
                showToast('Error saving budget', 'error');
            } finally {
                btn.innerHTML = original;
                btn.disabled = false;
            }
        }

        // ================= EDIT BUDGET =================
        function openEditBudgetModal(budgetId) {
            const budget = allBudgets.find(b => b.budgetId === budgetId);
            if (!budget) return;

            document.getElementById('editBudgetId').value = budget.budgetId;
            document.getElementById('editBudgetCategoryId').value = budget.categoryId;
            document.getElementById('editBudgetCategoryName').value = budget.categoryName;
            document.getElementById('editBudgetLimit').value = budget.limitAmount;

            document.getElementById('editBudgetModal').classList.add('show');
        }

        function closeEditBudgetModal() {
            document.getElementById('editBudgetModal').classList.remove('show');
        }

        async function handleEditBudget(e) {
            e.preventDefault();

            const categoryId = parseInt(document.getElementById('editBudgetCategoryId').value);
            const limitAmount = parseFloat(document.getElementById('editBudgetLimit').value);

            const btn = document.getElementById('updateBudgetBtn');
            const original = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Updating...';
            btn.disabled = true;

            try {
                // POST endpoint upsert karta hai (already setBudget mein update logic hai)
                const res = await fetch('/api/budgets', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ categoryId, limitAmount })
                });

                if (!res.ok) {
                    showToast('Failed to update budget', 'error');
                    return;
                }

                closeEditBudgetModal();
                showToast('Budget updated!', 'success');
                await loadBudgets();
            } catch (err) {
                console.error(err);
                showToast('Error updating budget', 'error');
            } finally {
                btn.innerHTML = original;
                btn.disabled = false;
            }
        }

        // ================= DELETE =================
        async function deleteBudget(id) {
            if (!confirm('Remove this category budget limit?')) return;

            try {
                const res = await fetch(`/api/budgets/${id}`, { method: 'DELETE' });
                if (!res.ok) {
                    showToast('Failed to delete budget', 'error');
                    return;
                }
                showToast('Budget removed', 'success');
                await loadBudgets();
            } catch (err) {
                console.error(err);
                showToast('Error deleting budget', 'error');
            }
        }

        // ================= SEARCH =================
        function handleSearch(val) {
            const cards = document.querySelectorAll('.budget-card');
            cards.forEach(card => {
                const text = card.innerText.toLowerCase();
                card.style.display = text.includes(val.toLowerCase()) ? 'block' : 'none';
            });
        }

        // ================= THEME =================
        function initializeTheme() {
            const saved = localStorage.getItem("campuscoin-theme");
            if (saved === "dark") {
                document.documentElement.classList.replace("light", "dark");
                document.body.classList.replace("light-mesh", "dark-mesh");
            }
            updateThemeIcon();
        }

        function toggleTheme() {
            const isDark = document.documentElement.classList.contains("dark");
            if (isDark) {
                document.documentElement.classList.replace("dark", "light");
                document.body.classList.replace("dark-mesh", "light-mesh");
                localStorage.setItem("campuscoin-theme", "light");
            } else {
                document.documentElement.classList.replace("light", "dark");
                document.body.classList.replace("light-mesh", "dark-mesh");
                localStorage.setItem("campuscoin-theme", "dark");
            }
            updateThemeIcon();

            if (budgetChartInstance) {
                const colors = getChartColors();
                budgetChartInstance.options.plugins.legend.labels.color = colors.text;
                budgetChartInstance.options.scales.x.ticks.color = colors.text;
                budgetChartInstance.options.scales.y.ticks.color = colors.text;
                budgetChartInstance.options.scales.y.grid.color = colors.grid;
                budgetChartInstance.update();
            }
        }

        function updateThemeIcon() {
            const isDark = document.documentElement.classList.contains("dark");
            document.getElementById("themeIcon").className = isDark ? "fa-solid fa-sun text-amber-300" : "fa-solid fa-moon";
        }

        function toggleSidebar() {
            document.getElementById("sidebar").classList.toggle("open");
            document.getElementById("mobileOverlay").classList.toggle("show");
        }

        function closeSidebar() {
            document.getElementById("sidebar").classList.remove("open");
            document.getElementById("mobileOverlay").classList.remove("show");
        }

        // ================= TOAST =================
        function showToast(message, type = 'info') {
            const container = document.getElementById("toastContainer");
            const toast = document.createElement("div");
            toast.className = "toast ios-glass";

            const iconMap = {
                success: '<i class="fa-solid fa-circle-check text-emerald-500"></i>',
                error: '<i class="fa-solid fa-circle-exclamation text-rose-500"></i>',
                info: '<i class="fa-solid fa-circle-info text-purple-600"></i>'
            };

            toast.innerHTML = `
                <div class="w-9 h-9 rounded-xl bg-purple-600/10 flex items-center justify-center">
                    ${iconMap[type] || iconMap.info}
                </div>
                <div>
                    <div class="text-[10px] font-bold">CampusCoin</div>
                    <div class="text-[9px] opacity-50">${message}</div>
                </div>`;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = "0";
                setTimeout(() => toast.remove(), 300);
            }, 2500);
        }
    </script>

<script src="/js/cc-header-widgets.js" asp-append-version="true"></script>
</body>
</html>
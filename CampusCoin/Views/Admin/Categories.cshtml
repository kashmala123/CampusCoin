@{
    Layout = null;
    ViewData["Title"] = "CampusCoin — Categories";
}
<!DOCTYPE html>
<html lang="en" class="light">

<head>
    <link rel="stylesheet" href="/css/admin-theme.css" />
    <link rel="stylesheet" href="/css/cc-animations.css" />

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <link rel="apple-touch-icon" href="/favicon.svg?v=4" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: { brand: { 50:'#f6effc',100:'#ede4f6',400:'#a486e0',500:'#8b58b8',600:'#6b3a92' } },
                    fontFamily: { sans: ['Plus Jakarta Sans','-apple-system','BlinkMacSystemFont','Inter','Segoe UI','Roboto','sans-serif'] }
                }
            }
        };
    </script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        * {
            transition: background-color 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease, color 0.3s ease;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            min-height: 100vh;
            background-color: #fbf6f0;
            background-image: radial-gradient(at 0% 0%, rgba(237, 228, 246, 0.9) 0px, transparent 50%), radial-gradient(at 100% 0%, rgba(196, 174, 224, 0.85) 0px, transparent 50%), radial-gradient(at 100% 100%, rgba(255, 225, 230, 0.85) 0px, transparent 50%), radial-gradient(at 0% 100%, rgba(246, 239, 252, 0.9) 0px, transparent 50%), radial-gradient(at 50% 50%, rgba(212, 243, 228, 0.4) 0px, transparent 50%);
            background-attachment: fixed;
        }

            body.dark-mesh {
                background-color: #100a1a;
                background-image: radial-gradient(at 10% 10%, rgba(99, 102, 241, 0.28) 0px, transparent 50%), radial-gradient(at 90% 10%, rgba(168, 85, 247, 0.22) 0px, transparent 50%), radial-gradient(at 90% 90%, rgba(107, 58, 146, 0.28) 0px, transparent 50%), radial-gradient(at 10% 90%, rgba(236, 72, 153, 0.2) 0px, transparent 50%);
                background-attachment: fixed;
            }

        .orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(80px);
            z-index: -1;
            pointer-events: none;
            animation: floatOrb 18s infinite alternate ease-in-out;
        }

        .orb-1 {
            width: 450px;
            height: 450px;
            background: rgba(192, 132, 252, 0.4);
            top: -100px;
            left: -100px;
        }

        .orb-2 {
            width: 480px;
            height: 480px;
            background: rgba(139, 88, 184, 0.45);
            top: 30%;
            right: -120px;
            animation-delay: -5s;
        }

        .orb-3 {
            width: 400px;
            height: 400px;
            background: rgba(251, 113, 133, 0.35);
            bottom: -100px;
            left: 20%;
            animation-delay: -10s;
        }

        @@keyframes floatOrb {
            0% {
                transform: translate(0px, 0px) scale(1);
            }

            50% {
                transform: translate(40px, 60px) scale(1.08);
            }

            100% {
                transform: translate(-30px, 30px) scale(0.95);
            }
        }

        .ios-glass {
            backdrop-filter: blur(32px) saturate(240%);
            -webkit-backdrop-filter: blur(32px) saturate(240%);
            position: relative;
            overflow: hidden;
        }

        .light .ios-glass {
            background: rgba(255,255,255,.72);
            border: 1.5px solid rgba(255,255,255,.95);
            box-shadow: 0 20px 40px -12px rgba(107,58,146,.12), 0 4px 16px -2px rgba(0,0,0,.04);
            color: #0f172a;
        }

        .dark .ios-glass {
            background: rgba(18,24,38,.58);
            border: 1px solid rgba(255,255,255,.15);
            box-shadow: 0 25px 50px -12px rgba(0,0,0,.45);
            color: #f8fafc;
        }

        .sidebar {
            position: fixed;
            top: 20px;
            left: 20px;
            bottom: 20px;
            width: 260px;
            z-index: 100;
            border-radius: 30px;
            padding: 18px;
            display: flex;
            flex-direction: column;
            transform: translateX(0);
            transition: transform .35s ease;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 4px 6px 22px;
        }

        .brand-logo {
            width: 46px;
            height: 46px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
            background: linear-gradient(135deg, #a486e0, #8b58b8, #6366f1);
            box-shadow: 0 12px 25px rgba(107,58,146,.28);
        }

        .brand-name {
            font-size: 18px;
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        .brand-sub {
            font-size: 9px;
            font-weight: 800;
            letter-spacing: .16em;
            opacity: .45;
            margin-top: 3px;
        }

        .nav-section {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: .15em;
            font-weight: 800;
            opacity: .4;
            padding: 14px 10px 7px;
        }

        .nav {
            flex: 1;
            overflow-y: auto;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 12px;
            margin: 4px 0;
            border-radius: 15px;
            text-decoration: none;
            color: inherit;
            font-size: 12px;
            font-weight: 650;
            transition: all .25s ease;
        }

            .nav-link i {
                width: 20px;
                text-align: center;
                opacity: .55;
            }

            .nav-link:hover {
                background: rgba(255,255,255,.30);
                transform: translateX(3px);
            }

        .dark .nav-link:hover {
            background: rgba(255,255,255,.06);
        }

        .nav-link.active {
            color: #6b3a92;
            background: linear-gradient(135deg, rgba(139,88,184,.18), rgba(99,102,241,.14));
            box-shadow: inset 0 0 0 1px rgba(139,88,184,.15), 0 10px 25px rgba(107,58,146,.08);
        }

        .dark .nav-link.active {
            color: #c4aee0;
            background: rgba(139,88,184,.10);
        }

        .admin-mini {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 11px;
            border-radius: 18px;
            background: rgba(255,255,255,.30);
            border: 1px solid rgba(255,255,255,.35);
        }

        .dark .admin-mini {
            background: rgba(255,255,255,.04);
            border-color: rgba(255,255,255,.08);
        }

        .admin-avatar {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 11px;
            font-weight: 800;
            background: linear-gradient(135deg, #8b58b8, #6366f1);
        }

        .main {
            margin-left: 300px;
            padding: 20px 25px 40px 0;
            min-height: 100vh;
        }

        .topbar {
            height: 70px;
            border-radius: 25px;
            padding: 10px 13px;
            display: flex;
            align-items: center;
            gap: 12px;
            position: sticky;
            top: 20px;
            z-index: 80;
        }

        .search {
            flex: 1;
            max-width: 450px;
            position: relative;
        }

            .search i {
                position: absolute;
                left: 16px;
                top: 50%;
                transform: translateY(-50%);
                opacity: .4;
                font-size: 12px;
            }

            .search input {
                width: 100%;
                border: none;
                outline: none;
                padding: 11px 15px 11px 42px;
                border-radius: 16px;
                background: rgba(255,255,255,.38);
                color: inherit;
                font-size: 12px;
                border: 1px solid rgba(255,255,255,.50);
            }

        .dark .search input {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-left: auto;
        }

        .action-btn {
            width: 40px;
            height: 40px;
            min-width: 40px;
            border-radius: 14px;
            border: 1px solid rgba(255,255,255,.55);
            background: rgba(255,255,255,.36);
            color: inherit;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .dark .action-btn {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .glass-btn {
            border: 1px solid rgba(255,255,255,.55);
            background: rgba(255,255,255,.38);
            color: inherit;
            border-radius: 14px;
            padding: 9px 14px;
            font-size: 11px;
            font-weight: 750;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .dark .glass-btn {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .primary-btn {
            color: white;
            border: none;
            background: linear-gradient(135deg, #a486e0, #8b58b8, #6366f1);
            box-shadow: 0 10px 22px rgba(107,58,146,.20);
        }

        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
        }

        .kpi {
            min-height: 110px;
            padding: 18px;
            border-radius: 22px;
        }

        .kpi-icon {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(139,88,184,.13);
            color: #6b3a92;
            margin-bottom: 10px;
        }

        .cat-card {
            padding: 16px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            transition: transform .25s ease;
        }

            .cat-card:hover {
                transform: translateY(-3px);
            }

        .modal-bg {
            background: rgba(15,23,42,.35);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }

        #toastContainer {
            position: fixed;
            right: 20px;
            bottom: 20px;
            z-index: 999;
            display: flex;
            flex-direction: column;
            gap: 9px;
        }

        .toast {
            min-width: 250px;
            padding: 12px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        @@media(max-width:1200px) {
            .kpi-grid {
                grid-template-columns: repeat(2,1fr);
            }
        }

        @@media(max-width:950px) {
            .sidebar {
                transform: translateX(-120%);
            }

                .sidebar.open {
                    transform: translateX(0);
                }

            .main {
                margin-left: 0;
                padding: 15px;
            }
        }

        @@media(max-width:700px) {
            .kpi-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
    <link rel="stylesheet" href="/css/cc-header-widgets.css" asp-append-version="true" />
</head>

<body class="light min-h-screen text-slate-900 dark:text-slate-100 font-sans">

    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>

    <div id="mobileOverlay" class="fixed inset-0 bg-slate-900/20 backdrop-blur-sm z-90 hidden" onclick="closeSidebar()"></div>

    <!-- SIDEBAR -->
    <aside id="sidebar" class="sidebar ios-glass">
                <div class="brand cc-brand-block">
            <div class="brand-logo cc-brand-mark" aria-hidden="true">
                <svg viewBox="0 0 44 44" width="36" height="36" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="ccCoinBG_ad" x1="0" y1="0" x2="44" y2="44" gradientUnits="userSpaceOnUse">
                            <stop offset="0" stop-color="#6b3a92"/><stop offset="1" stop-color="#241232"/>
                        </linearGradient>
                        <linearGradient id="ccCoinAccent_ad" x1="10" y1="10" x2="34" y2="34" gradientUnits="userSpaceOnUse">
                            <stop offset="0" stop-color="#d4ff3d"/><stop offset="1" stop-color="#10b981"/>
                        </linearGradient>
                    </defs>
                    <circle cx="22" cy="22" r="21" fill="url(#ccCoinBG_ad)"/>
                    <circle cx="22" cy="22" r="16.5" fill="none" stroke="rgba(255,255,255,.2)" stroke-width="1" stroke-dasharray="1.5 3"/>
                    <path d="M28.5 15c-1.9-2.2-4.7-3.5-7.8-3.5-5.8 0-10.5 4.7-10.5 10.5s4.7 10.5 10.5 10.5c3.1 0 5.9-1.3 7.8-3.5" stroke="url(#ccCoinAccent_ad)" stroke-width="2.6" stroke-linecap="round" fill="none"/>
                    <path d="M31 12c0 2.2-1.3 3.5-3.5 3.5 2.2 0 3.5 1.3 3.5 3.5 0-2.2 1.3-3.5 3.5-3.5-2.2 0-3.5-1.3-3.5-3.5z" fill="#d4ff3d"/>
                </svg>
            </div>
            <div>
                <div class="brand-name cc-brand-title"><b>Cash</b><span>Campus</span></div>
                <div class="brand-sub">ADMIN CONSOLE</div>
            </div>
        </div>

                <nav class="nav">
            <div class="nav-section">Overview</div>
            <a href="/Admin/Index" class="nav-link"><i class="fa-solid fa-chart-line"></i><span>Dashboard</span></a>
            <a href="/Admin/Students" class="nav-link"><i class="fa-solid fa-user-graduate"></i><span>Students</span></a>
            <a href="/Admin/Transactions" class="nav-link"><i class="fa-solid fa-arrow-right-arrow-left"></i><span>Transactions</span></a>
            <a href="/Admin/VoucherManagement" class="nav-link"><i class="fa-solid fa-receipt"></i><span>Voucher Management</span></a>
            <div class="nav-section">Financial Management</div>
            <a href="/Admin/Categories" class="nav-link active"><i class="fa-solid fa-layer-group"></i><span>Categories</span></a>
            <a href="/Admin/Budgets" class="nav-link"><i class="fa-solid fa-wallet"></i><span>Budgets</span></a>
            <a href="/Admin/SpendingAlerts" class="nav-link"><i class="fa-solid fa-triangle-exclamation"></i><span>Spending Alerts</span></a>
            <a href="/Admin/Comparison" class="nav-link"><i class="fa-solid fa-chart-column"></i><span>Comparison</span></a>
            <a href="/Admin/EventManager" class="nav-link"><i class="fa-solid fa-calendar-days"></i><span>Event Manager</span></a>
            <a href="/Admin/SavingGoals" class="nav-link"><i class="fa-solid fa-bullseye"></i><span>Saving Goals</span></a>
            <div class="nav-section">System</div>
            <a href="/Admin/Notifications" class="nav-link"><i class="fa-solid fa-bell"></i><span>Notifications</span></a>
            <a href="/Admin/Reports" class="nav-link"><i class="fa-solid fa-chart-pie"></i><span>Reports & Analytics</span></a>
            <a href="/Admin/HomepageCms" class="nav-link"><i class="fa-solid fa-pager"></i><span>Homepage CMS</span></a>
            <a href="/Admin/Settings" class="nav-link"><i class="fa-solid fa-sliders"></i><span>Settings</span></a>
        </nav>

        <div class="admin-mini">
            <div class="admin-avatar">AK</div>
            <div class="flex-1 min-w-0">
                <div class="text-[11px] font-bold">Admin</div>
                <div class="text-[9px] opacity-45">System Administrator</div>
            </div>
        </div>
        <a href="/Auth/Logout" style="display:flex;align-items:center;gap:10px;padding:10px 12px;margin-top:8px;border-radius:12px;font-size:13px;font-weight:700;color:#e11d48;text-decoration:none;">
            <i class="fa-solid fa-right-from-bracket"></i> Logout
        </a>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="main">

        <!-- TOP BAR with ADD button -->
        <header class="topbar ios-glass">
            <button class="action-btn lg:hidden" onclick="toggleSidebar()"><i class="fa-solid fa-bars"></i></button>

            <div class="search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input id="globalSearch" oninput="renderCategories()" type="text" placeholder="Search categories..." autocomplete="off">
            </div>

            <div class="top-actions">
                <button class="glass-btn primary-btn" onclick="openCategoryModal()">
                    <i class="fa-solid fa-plus"></i>
                    <span>Add Category</span>
                </button>
                <button class="action-btn" onclick="toggleTheme()">
                    <i id="themeIcon" class="fa-solid fa-moon"></i>
                </button>
                <div class="dropdown-wrap" style="position:relative;">
                    <button type="button" class="action-btn" onclick="toggleDropdown('profileDropdown')" title="Account" style="display:inline-flex;align-items:center;gap:8px;padding:0 12px 0 6px;width:auto;min-width:auto;height:40px;border-radius:12px;">
                        <span style="width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,#a486e0,#6366f1);color:#fff;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;">AD</span>
                        <span class="hidden sm:inline" style="font-size:12px;font-weight:700;">Admin</span>
                        <i class="fa-solid fa-chevron-down" style="font-size:9px;opacity:.5;"></i>
                    </button>
                    <div id="profileDropdown" class="dropdown" style="display:none !important;position:absolute;right:0;top:calc(100% + 10px);min-width:200px;z-index:99999;padding:8px;border-radius:16px;background:#fff;border:1px solid rgba(22,11,33,.1);box-shadow:0 18px 40px rgba(22,11,33,.14);">
                        <a href="/Admin/Settings" class="dropdown-item" style="display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;font-size:13px;font-weight:600;text-decoration:none;color:inherit;"><i class="fa-regular fa-user"></i> My Profile</a>
                        <a href="/Admin/Settings" class="dropdown-item" style="display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;font-size:13px;font-weight:600;text-decoration:none;color:inherit;"><i class="fa-solid fa-gear"></i> Settings</a>
                        <button type="button" onclick="logoutAdmin()" class="dropdown-item" style="display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;font-size:13px;font-weight:600;width:100%;border:0;background:transparent;cursor:pointer;color:#e11d48;"><i class="fa-solid fa-right-from-bracket"></i> Logout</button>
                    </div>
                </div>
            </div>
        </header>

        <!-- PAGE HEADER -->
        <section class="mt-7 mb-5 flex flex-col md:flex-row md:items-end justify-between gap-4">
            <div>
                <div class="text-purple-600 text-[9px] font-extrabold uppercase tracking-widest mb-1">System Settings</div>
                <h1 class="text-3xl lg:text-4xl font-black tracking-tight">Default Categories</h1>
                <p class="text-xs opacity-50 mt-1">Manage system-wide categories available to all students.</p>
            </div>

            <div class="flex items-center gap-2">
                <select id="typeFilter" onchange="renderCategories()" class="p-2.5 rounded-xl bg-slate-500/10 border border-slate-500/20 text-xs font-bold outline-none">
                    <option value="ALL">All Types</option>
                    <option value="Income">Income</option>
                    <option value="Expense">Expense</option>
                </select>
            </div>
        </section>

        <!-- KPI -->
        <section class="kpi-grid mb-6">
            <div class="kpi ios-glass">
                <div class="kpi-icon text-purple-500"><i class="fa-solid fa-layer-group"></i></div>
                <div class="text-[10px] opacity-50 font-bold">Total Categories</div>
                <div class="text-2xl font-black mt-1" id="kpiTotal">0</div>
            </div>
            <div class="kpi ios-glass">
                <div class="kpi-icon text-emerald-500"><i class="fa-solid fa-arrow-down"></i></div>
                <div class="text-[10px] opacity-50 font-bold">Income Categories</div>
                <div class="text-2xl font-black mt-1 text-emerald-500" id="kpiIncome">0</div>
            </div>
            <div class="kpi ios-glass">
                <div class="kpi-icon text-rose-500"><i class="fa-solid fa-arrow-up"></i></div>
                <div class="text-[10px] opacity-50 font-bold">Expense Categories</div>
                <div class="text-2xl font-black mt-1 text-rose-500" id="kpiExpense">0</div>
            </div>
        </section>

        <!-- CATEGORIES GRID -->
        <section class="ios-glass p-6 rounded-[28px]">
            <div class="flex justify-between items-center mb-4">
                <h3 class="font-black text-sm">All Categories</h3>
                <span id="catCount" class="text-[10px] opacity-40">0 records</span>
            </div>

            <div id="categoriesGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>
        </section>

    </main>

    <!-- ADD/EDIT MODAL -->
    <div id="categoryModal" class="fixed inset-0 z-[100] modal-bg flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-300">
        <div id="categoryModalBox" class="ios-glass rounded-[28px] w-full max-w-md p-6 shadow-2xl transform scale-95 transition-all duration-300">
            <div class="flex items-center justify-between mb-5">
                <div>
                    <div class="text-purple-600 text-[9px] font-extrabold uppercase tracking-widest mb-1">Default Category</div>
                    <h2 id="catModalTitle" class="text-xl font-black">Add Category</h2>
                </div>
                <button onclick="closeCategoryModal()" class="action-btn">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form onsubmit="saveCategory(event)" class="space-y-4">
                <input type="hidden" id="editCatId">

                <div>
                    <label class="block text-[10px] font-black uppercase tracking-wider opacity-60 mb-2">Category Name</label>
                    <input id="catName" required type="text" placeholder="e.g. Food & Dining"
                           class="w-full px-4 py-3 rounded-2xl bg-slate-500/10 border border-slate-500/20 text-sm font-semibold outline-none focus:ring-2 focus:ring-sky-400/60">
                </div>

                <div>
                    <label class="block text-[10px] font-black uppercase tracking-wider opacity-60 mb-2">Type</label>
                    <select id="catType" class="w-full px-4 py-3 rounded-2xl bg-slate-500/10 border border-slate-500/20 text-sm font-semibold outline-none focus:ring-2 focus:ring-sky-400/60">
                        <option value="Expense">Expense</option>
                        <option value="Income">Income</option>
                    </select>
                </div>

                <div class="flex justify-end gap-3 pt-3">
                    <button type="button" onclick="closeCategoryModal()" class="glass-btn">Cancel</button>
                    <button type="submit" class="glass-btn primary-btn">
                        <i class="fa-solid fa-check"></i> Save
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div id="toastContainer"></div>

    <script>
        let categories = [];
        const CAT_API = "/api/admin/categories";

        document.addEventListener("DOMContentLoaded", () => {
            initializeTheme();
            loadCategories();
        });

        /* ========== LOAD ========== */
        async function loadCategories() {
            try {
                const res = await fetch(CAT_API, { credentials: "same-origin" });
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                categories = await res.json();
                updateKPIs();
                renderCategories();
            } catch (err) {
                console.error(err);
                showToast("Load failed: " + err.message);
            }
        }

        function updateKPIs() {
            document.getElementById("kpiTotal").innerText   = categories.length;
            document.getElementById("kpiIncome").innerText  = categories.filter(c => c.type === "Income").length;
            document.getElementById("kpiExpense").innerText = categories.filter(c => c.type === "Expense").length;
        }

        /* ========== RENDER ========== */
        function renderCategories() {
            const q = (document.getElementById("globalSearch").value || "").toLowerCase().trim();
            const type = document.getElementById("typeFilter").value;

            const list = categories.filter(c => {
                const matchQ = !q || c.name.toLowerCase().includes(q);
                const matchT = type === "ALL" || c.type === type;
                return matchQ && matchT;
            });

            const grid = document.getElementById("categoriesGrid");
            grid.innerHTML = "";
            document.getElementById("catCount").innerText = `${list.length} records`;

            if (!list.length) {
                grid.innerHTML = `<div class="col-span-full text-center py-12 opacity-50">
                    <i class="fa-solid fa-layer-group text-3xl mb-3"></i>
                    <p class="text-sm font-bold">No categories found</p>
                </div>`;
                return;
            }

            list.forEach(c => {
                const isIncome = c.type === "Income";
                const card = document.createElement("div");
                card.className = "cat-card ios-glass";
                card.innerHTML = `
                    <div class="flex items-center gap-3 min-w-0">
                        <div class="w-11 h-11 rounded-xl ${isIncome ? 'bg-emerald-500/15 text-emerald-500' : 'bg-rose-500/15 text-rose-500'} flex items-center justify-center shrink-0">
                            <i class="fa-solid ${isIncome ? 'fa-arrow-down' : 'fa-arrow-up'}"></i>
                        </div>
                        <div class="min-w-0">
                            <p class="text-sm font-black truncate">${c.name}</p>
                            <p class="text-[10px] font-bold uppercase tracking-wider ${isIncome ? 'text-emerald-500' : 'text-rose-500'}">${c.type}</p>
                        </div>
                    </div>
                    <div class="flex gap-1 shrink-0">
                        <button onclick="editCategory(${c.categoryId})" title="Edit" class="action-btn" style="width:36px;height:36px;border-radius:12px;">
                            <i class="fa-solid fa-pen text-xs text-indigo-500"></i>
                        </button>
                        <button onclick="deleteCategory(${c.categoryId}, '${c.name.replace(/'/g, "\\'")}')" title="Delete" class="action-btn" style="width:36px;height:36px;border-radius:12px;">
                            <i class="fa-regular fa-trash-can text-xs text-rose-500"></i>
                        </button>
                    </div>`;
                grid.appendChild(card);
            });
        }

        /* ========== MODAL ========== */
        function openCategoryModal(cat = null) {
            const modal = document.getElementById("categoryModal");
            const box   = document.getElementById("categoryModalBox");

            if (cat) {
                document.getElementById("catModalTitle").innerText = "Edit Category";
                document.getElementById("editCatId").value = cat.categoryId;
                document.getElementById("catName").value   = cat.name;
                document.getElementById("catType").value   = cat.type;
            } else {
                document.getElementById("catModalTitle").innerText = "Add Category";
                document.getElementById("editCatId").value = "";
                document.getElementById("catName").value   = "";
                document.getElementById("catType").value   = "Expense";
            }

            modal.classList.remove("opacity-0", "pointer-events-none");
            box.classList.remove("scale-95"); box.classList.add("scale-100");
        }

        function closeCategoryModal() {
            const modal = document.getElementById("categoryModal");
            const box   = document.getElementById("categoryModalBox");
            modal.classList.add("opacity-0", "pointer-events-none");
            box.classList.remove("scale-100"); box.classList.add("scale-95");
        }

        function editCategory(id) {
            const cat = categories.find(c => c.categoryId === id);
            if (cat) openCategoryModal(cat);
        }

        /* ========== SAVE ========== */
        async function saveCategory(event) {
            event.preventDefault();
            const editId = document.getElementById("editCatId").value;
            const payload = {
                name: document.getElementById("catName").value.trim(),
                type: document.getElementById("catType").value
            };

            try {
                let url = CAT_API, method = "POST";
                if (editId) { url = `${CAT_API}/${editId}`; method = "PUT"; }

                const res = await fetch(url, {
                    method, headers: { "Content-Type": "application/json" },
                    credentials: "same-origin", body: JSON.stringify(payload)
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(data.message || `HTTP ${res.status}`);

                closeCategoryModal();
                await loadCategories();
                showToast(editId ? "Category updated" : "Category added");
            } catch (err) {
                showToast("Save failed: " + err.message);
            }
        }

        /* ========== DELETE ========== */
        async function deleteCategory(id, name) {
            if (!confirm(`Delete category "${name}"?`)) return;
            try {
                const res = await fetch(`${CAT_API}/${id}`, { method: "DELETE", credentials: "same-origin" });
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                await loadCategories();
                showToast("Category deleted");
            } catch (err) {
                showToast("Delete failed: " + err.message);
            }
        }

        /* ========== THEME / SIDEBAR / TOAST ========== */
        function toggleTheme() {
            const html = document.documentElement;
            const dark = html.classList.contains("dark");
            if (dark) {
                html.classList.remove("dark"); html.classList.add("light");
                document.body.classList.remove("dark-mesh");
                localStorage.setItem("campuscoin-admin-theme", "light");
            } else {
                html.classList.remove("light"); html.classList.add("dark");
                document.body.classList.add("dark-mesh");
                localStorage.setItem("campuscoin-admin-theme", "dark");
            }
            updateThemeIcon();
        }

        function initializeTheme() {
            if (localStorage.getItem("campuscoin-admin-theme") === "dark") {
                document.documentElement.classList.add("dark");
                document.body.classList.add("dark-mesh");
            }
            updateThemeIcon();
        }

        function updateThemeIcon() {
            document.getElementById("themeIcon").className = document.documentElement.classList.contains("dark") ? "fa-solid fa-sun text-amber-300" : "fa-solid fa-moon";
        }

        function toggleSidebar() { document.getElementById("sidebar").classList.toggle("open"); document.getElementById("mobileOverlay").classList.remove("hidden"); }
        function closeSidebar() { document.getElementById("sidebar").classList.remove("open"); document.getElementById("mobileOverlay").classList.add("hidden"); }

        function showToast(msg) {
            const container = document.getElementById("toastContainer");
            const toast = document.createElement("div");
            toast.className = "toast ios-glass";
            toast.innerHTML = `<div class="w-7 h-7 rounded-lg bg-purple-600/10 text-purple-600 flex items-center justify-center"><i class="fa-solid fa-check text-xs"></i></div><div class="text-[10px] font-bold">${msg}</div>`;
            container.appendChild(toast);
            setTimeout(() => toast.remove(), 2500);
        }

        document.addEventListener("keydown", e => { if (e.key === "Escape") closeCategoryModal(); });
    </script>

<script>
(function(){
  if (typeof window.toggleDropdown !== 'function') {
    window.toggleDropdown = function(id){
      const t = document.getElementById(id);
      if (!t) return;
      document.querySelectorAll('.dropdown').forEach(d => {
        if (d.id !== id) { d.classList.remove('show'); d.style.display = 'none'; }
      });
      const open = !t.classList.contains('show');
      t.classList.toggle('show', open);
      t.style.display = open ? 'block' : 'none';
    };
    document.addEventListener('click', function(e){
      if (!e.target.closest('.dropdown-wrap')) {
        document.querySelectorAll('.dropdown').forEach(d => { d.classList.remove('show'); d.style.display = 'none'; });
      }
    });
  }
  if (typeof window.logoutAdmin !== 'function') {
    window.logoutAdmin = function(){ window.location.href = '/Auth/Logout'; };
  }
  if (typeof window.quickAction !== 'function') {
    window.quickAction = function(action){
      document.querySelectorAll('.dropdown').forEach(d => { d.classList.remove('show'); d.style.display='none'; });
      const routes = {
        'Add Student': '/Admin/Students',
        'View Transactions': '/Admin/Transactions',
        'Send Notification': '/Admin/Notifications',
        'Generate Report': '/Admin/Reports'
      };
      if (routes[action]) window.location.href = routes[action];
    };
  }
})();
</script>


<script>
(function(){
  window.toggleDropdown = function(id){
    document.querySelectorAll('.dropdown').forEach(function(d){
      if(d.id !== id){ d.classList.remove('show'); d.style.setProperty('display','none','important'); }
    });
    var t = document.getElementById(id);
    if(!t) return;
    var open = !(t.classList.contains('show'));
    if(open){ t.classList.add('show'); t.style.setProperty('display','block','important'); }
    else { t.classList.remove('show'); t.style.setProperty('display','none','important'); }
  };
  document.addEventListener('click', function(e){
    if(!e.target.closest('.dropdown-wrap')){
      document.querySelectorAll('.dropdown').forEach(function(d){
        d.classList.remove('show'); d.style.setProperty('display','none','important');
      });
    }
  });
})();
</script>


@{
    ViewData["Title"] = "Voucher Management";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="light">

<head>
    <link rel="stylesheet" href="/css/admin-theme.css" />
    <link rel="stylesheet" href="/css/cc-animations.css" />

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Voucher Management — CashCampus</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <link rel="apple-touch-icon" href="/favicon.svg?v=4" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: { 50:'#f6effc', 100:'#ede4f6', 400:'#a486e0', 500:'#8b6ff0', 600:'#6d4aff' }
                    },
                    fontFamily: { sans: ['Plus Jakarta Sans','-apple-system','BlinkMacSystemFont','Inter','sans-serif'] }
                }
            }
        };
    </script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        * {
            transition: background-color 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease, color 0.3s ease;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            min-height: 100vh;
            font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
            background-color: #fbf6f0;
            background-image: radial-gradient(at 0% 0%, rgba(237,228,246,0.9) 0px, transparent 50%), radial-gradient(at 100% 0%, rgba(196,174,224,0.85) 0px, transparent 50%), radial-gradient(at 100% 100%, rgba(255,225,230,0.85) 0px, transparent 50%), radial-gradient(at 0% 100%, rgba(246,239,252,0.9) 0px, transparent 50%);
            background-attachment: fixed;
        }

            body.dark-mesh {
                background-color: #100a1a;
                background-image: radial-gradient(at 10% 10%, rgba(139,111,240,0.28) 0px, transparent 50%), radial-gradient(at 90% 10%, rgba(155,111,216,0.22) 0px, transparent 50%), radial-gradient(at 90% 90%, rgba(109,74,255,0.28) 0px, transparent 50%), radial-gradient(at 10% 90%, rgba(212,121,159,0.22) 0px, transparent 50%);
            }

        .orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(80px);
            z-index: -1;
            pointer-events: none;
            animation: floatOrb 18s infinite alternate ease-in-out;
        }

        .orb-1 {
            width: 450px;
            height: 450px;
            background: rgba(155,111,216,0.5);
            top: -100px;
            left: -100px;
        }

        .orb-2 {
            width: 480px;
            height: 480px;
            background: rgba(139,111,240,0.45);
            top: 30%;
            right: -120px;
            animation-delay: -5s;
        }

        .orb-3 {
            width: 400px;
            height: 400px;
            background: rgba(212,121,159,0.4);
            bottom: -100px;
            left: 20%;
            animation-delay: -10s;
        }

        @@keyframes floatOrb {
            0% {
                transform: translate(0px, 0px) scale(1);
            }

            50% {
                transform: translate(40px, 60px) scale(1.08);
            }

            100% {
                transform: translate(-30px, 30px) scale(0.95);
            }
        }

        .ios-glass {
            backdrop-filter: blur(32px) saturate(240%);
            -webkit-backdrop-filter: blur(32px) saturate(240%);
            position: relative;
        }

        .light .ios-glass {
            background: rgba(255,255,255,0.72);
            border: 1.5px solid rgba(255,255,255,0.95);
            box-shadow: 0 20px 40px -12px rgba(109,74,255,0.12), 0 4px 16px -2px rgba(0,0,0,0.04), inset 0 1.5px 2px 0 rgba(255,255,255,1);
            color: #1a0b2e;
        }

        .dark .ios-glass {
            background: rgba(28,18,42,0.6);
            border: 1px solid rgba(255,255,255,0.15);
            box-shadow: 0 25px 50px -12px rgba(0,0,0,0.45), inset 0 1px 0 0 rgba(255,255,255,0.18);
            color: #f8fafc;
        }

        .ios-glass-interactive {
            transition: transform 0.35s cubic-bezier(0.16,1,0.3,1), box-shadow 0.35s ease, background 0.35s ease;
        }

            .ios-glass-interactive:hover {
                transform: translateY(-4px);
            }

        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(150,150,150,0.3);
            border-radius: 999px;
        }

        .sidebar {
            position: fixed;
            top: 20px;
            left: 20px;
            bottom: 20px;
            width: 260px;
            z-index: 100;
            border-radius: 30px;
            padding: 18px;
            display: flex;
            flex-direction: column;
            transform: translateX(0);
            transition: transform .35s ease;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 4px 6px 22px;
        }

        .brand-logo {
            width: 46px;
            height: 46px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
            background: linear-gradient(135deg,#8b6ff0,#6d4aff,#4b2568);
            box-shadow: 0 12px 25px rgba(109,74,255,0.32);
        }

        .brand-name {
            font-size: 18px;
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        .brand-sub {
            font-size: 9px;
            font-weight: 800;
            letter-spacing: .16em;
            opacity: .45;
            margin-top: 3px;
        }

        .nav-section {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: .15em;
            font-weight: 800;
            opacity: .4;
            padding: 14px 10px 7px;
        }

        .nav {
            flex: 1;
            overflow-y: auto;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 12px;
            margin: 4px 0;
            border-radius: 15px;
            text-decoration: none;
            color: inherit;
            font-size: 12px;
            font-weight: 650;
            transition: all .25s ease;
        }

            .nav-link i {
                width: 20px;
                text-align: center;
                opacity: .55;
            }

            .nav-link:hover {
                background: rgba(255,255,255,.30);
                transform: translateX(3px);
            }

        .dark .nav-link:hover {
            background: rgba(255,255,255,.06);
        }

        .nav-link.active {
            color: #6d4aff;
            background: linear-gradient(135deg, rgba(139,111,240,.18), rgba(109,74,255,.14));
            box-shadow: inset 0 0 0 1px rgba(139,111,240,.15);
        }

        .dark .nav-link.active {
            color: #c4aee0;
            background: rgba(139,111,240,.1);
        }

        .admin-mini {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 11px;
            border-radius: 18px;
            background: rgba(255,255,255,.30);
            border: 1px solid rgba(255,255,255,.35);
        }

        .admin-avatar {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 11px;
            font-weight: 800;
            background: linear-gradient(135deg,#8b6ff0,#6d4aff);
        }

        .main {
            margin-left: 300px;
            padding: 20px 25px 40px 0;
            min-height: 100vh;
        }

        .topbar {
            height: 70px;
            border-radius: 25px;
            padding: 10px 13px;
            display: flex;
            align-items: center;
            gap: 12px;
            position: sticky;
            top: 20px;
            z-index: 99999;
        }

        .search {
            flex: 1;
            max-width: 500px;
            position: relative;
        }

            .search i {
                position: absolute;
                left: 16px;
                top: 50%;
                transform: translateY(-50%);
                opacity: .4;
                font-size: 12px;
            }

            .search input {
                width: 100%;
                border: none;
                outline: none;
                padding: 11px 15px 11px 42px;
                border-radius: 16px;
                background: rgba(255,255,255,.38);
                color: inherit;
                font-size: 12px;
                border: 1px solid rgba(255,255,255,.50);
            }

        .dark .search input {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-left: auto;
        }

        .action-btn {
            width: 40px;
            height: 40px;
            min-width: 40px;
            border-radius: 14px;
            border: 1px solid rgba(255,255,255,.55);
            background: rgba(255,255,255,.36);
            color: inherit;
            cursor: pointer;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .dark .action-btn {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .action-btn:hover {
            transform: translateY(-2px);
            background: rgba(255,255,255,.65);
        }

        .notification-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #f43f5e;
            position: absolute;
            top: 8px;
            right: 8px;
        }

        .profile {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 4px 9px 4px 4px;
            border-radius: 15px;
            cursor: pointer;
        }

        .profile-avatar {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 11px;
            font-weight: 800;
            background: linear-gradient(135deg,#8b6ff0,#6d4aff);
        }

        .dropdown-wrap {
            position: relative;
        }

        .dropdown {
            position: absolute;
            right: 0;
            top: calc(100% + 12px);
            width: 250px;
            padding: 9px;
            border-radius: 20px;
            opacity: 0;
            pointer-events: none;
            transform: translateY(-8px) scale(.98);
            transition: .2s ease;
            z-index: 99999;
            background: rgba(255,255,255,0.95);
            backdrop-filter: blur(25px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.15);
        }

        .dark .dropdown {
            background: rgba(28,18,42,0.95);
        }

        .dropdown.show {
            opacity: 1;
            pointer-events: auto;
            transform: translateY(0) scale(1);
        }

        .dropdown-item {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 10px;
            border: 0;
            background: transparent;
            color: inherit;
            padding: 11px;
            border-radius: 13px;
            cursor: pointer;
            text-align: left;
            font-size: 11px;
            text-decoration: none;
        }

            .dropdown-item:hover {
                background: rgba(139,111,240,.1);
            }

        .page-header {
            display: flex;
            align-items: end;
            justify-content: space-between;
            gap: 20px;
            margin: 28px 3px 20px;
        }

        .eyebrow {
            color: #6d4aff;
            font-size: 9px;
            font-weight: 850;
            text-transform: uppercase;
            letter-spacing: .18em;
            margin-bottom: 8px;
        }

        .page-title {
            font-size: clamp(28px, 3vw, 40px);
            font-weight: 900;
            letter-spacing: -1.8px;
            line-height: 1;
        }

        .page-description {
            font-size: 12px;
            opacity: .48;
            margin-top: 8px;
        }

        .date-pill {
            padding: 10px 14px;
            border-radius: 15px;
            font-size: 10px;
            font-weight: 700;
            white-space: nowrap;
        }

        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 15px;
        }

        .kpi {
            min-height: 155px;
            padding: 19px;
            border-radius: 25px;
            position: relative;
            overflow: hidden;
        }

            .kpi::after {
                content: '';
                position: absolute;
                width: 110px;
                height: 110px;
                border-radius: 50%;
                right: -45px;
                top: -45px;
                background: rgba(139,111,240,.08);
                pointer-events: none;
            }

        .kpi-icon {
            width: 40px;
            height: 40px;
            border-radius: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(139,111,240,.13);
            color: #6d4aff;
            margin-bottom: 13px;
        }

        .kpi-label {
            font-size: 10px;
            font-weight: 700;
            opacity: .48;
        }

        .kpi-value {
            font-size: 25px;
            font-weight: 900;
            letter-spacing: -1px;
            margin-top: 3px;
        }

        .kpi-change {
            font-size: 9px;
            font-weight: 750;
            margin-top: 5px;
        }

        .positive {
            color: #059669;
        }

        .negative {
            color: #e11d48;
        }

        .chart-grid {
            display: grid;
            grid-template-columns: 1.8fr 1fr;
            gap: 15px;
            margin-top: 15px;
        }

        .chart-card {
            border-radius: 27px;
            padding: 20px;
            min-height: 350px;
        }

        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            margin-bottom: 17px;
        }

        .chart-title {
            font-size: 14px;
            font-weight: 850;
        }

        .chart-sub {
            font-size: 9px;
            opacity: .45;
            margin-top: 3px;
        }

        .select, .input-field {
            border: 1px solid rgba(255,255,255,.55);
            background: rgba(255,255,255,.38);
            color: inherit;
            border-radius: 12px;
            padding: 8px 10px;
            outline: none;
            font-size: 11px;
            width: 100%;
        }

        .dark .select, .dark .input-field {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .chart-container {
            height: 260px;
            position: relative;
        }

        .three-grid {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 15px;
            margin-top: 15px;
        }

        .small-chart {
            min-height: 330px;
        }

        .panel {
            padding: 20px;
            border-radius: 27px;
        }

        .panel-title {
            font-size: 14px;
            font-weight: 850;
        }

        .panel-sub {
            font-size: 9px;
            opacity: .45;
            margin-top: 3px;
        }

        .table-wrap {
            overflow-x: auto;
            margin-top: 17px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            padding: 10px 8px;
            text-align: left;
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: .08em;
            opacity: .5;
            white-space: nowrap;
        }

        td {
            padding: 12px 8px;
            border-top: 1px solid rgba(148,163,184,.12);
            font-size: 11px;
            white-space: nowrap;
        }

        @@keyframes rowFadeIn {
            from {
                opacity: 0;
                transform: translateY(-10px) scale(0.98);
                background: rgba(139,111,240,0.25);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
                background: transparent;
            }
        }

        .animate-row {
            animation: rowFadeIn 0.6s cubic-bezier(0.16,1,0.3,1) forwards;
        }

        .badge {
            padding: 5px 9px;
            border-radius: 99px;
            font-size: 9px;
            font-weight: 800;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .badge-danger {
            background: rgba(225,29,72,0.12);
            color: #e11d48;
        }

        .badge-warning {
            background: rgba(245,158,11,0.12);
            color: #d97706;
        }

        .badge-success {
            background: rgba(16,185,129,0.12);
            color: #059669;
        }

        .glass-btn {
            border: 1px solid rgba(255,255,255,.55);
            background: rgba(255,255,255,.38);
            color: inherit;
            border-radius: 13px;
            padding: 9px 12px;
            font-size: 10px;
            font-weight: 750;
            cursor: pointer;
            font-family: inherit;
            transition: all 0.3s ease;
        }

        .dark .glass-btn {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .glass-btn:hover {
            transform: translateY(-2px);
            background: rgba(255,255,255,.65);
        }

        .primary-btn {
            color: white;
            border: none;
            background: linear-gradient(135deg,#8b6ff0,#6d4aff,#4b2568);
            box-shadow: 0 10px 22px rgba(109,74,255,.25);
        }

        .modal {
            position: fixed;
            inset: 0;
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: rgba(15,23,42,0.4);
            backdrop-filter: blur(8px);
            opacity: 0;
            pointer-events: none;
            transition: all 0.3s ease;
        }

            .modal.show {
                opacity: 1;
                pointer-events: auto;
            }

        .modal-content {
            width: 100%;
            max-width: 520px;
            border-radius: 28px;
            padding: 24px;
            transform: scale(0.95);
            transition: transform 0.3s ease;
        }

        .modal.show .modal-content {
            transform: scale(1);
        }

        .mobile-btn {
            display: none;
        }

        .mobile-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15,23,42,.25);
            backdrop-filter: blur(5px);
            z-index: 90;
        }

            .mobile-overlay.show {
                display: block;
            }

        @@media(max-width:1200px) {
            .kpi-grid {
                grid-template-columns: repeat(2,1fr);
            }

            .three-grid {
                grid-template-columns: repeat(2,1fr);
            }
        }

        @@media(max-width:950px) {
            .sidebar {
                transform: translateX(-120%);
            }

                .sidebar.open {
                    transform: translateX(0);
                }

            .main {
                margin-left: 0;
                padding: 15px;
            }

            .mobile-btn {
                display: flex;
            }

            .chart-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media(max-width:700px) {
            .kpi-grid, .three-grid {
                grid-template-columns: 1fr;
            }

            .page-header {
                flex-direction: column;
                align-items: flex-start;
            }
        }

        #toastContainer {
            position: fixed;
            right: 20px;
            bottom: 20px;
            z-index: 999;
            display: flex;
            flex-direction: column;
            gap: 9px;
        }

        .toast {
            min-width: 270px;
            padding: 13px;
            border-radius: 17px;
            display: flex;
            align-items: center;
            gap: 10px;
            animation: toastIn .3s ease;
        }

        @@keyframes toastIn {
            from {
                opacity: 0;
                transform: translateY(15px) scale(.96);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }
    </style>
    <link rel="stylesheet" href="/css/cc-header-widgets.css" asp-append-version="true" />
</head>

<body class="light min-h-screen text-slate-900 dark:text-slate-100 font-sans">

    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>

    <div id="mobileOverlay" class="mobile-overlay" onclick="closeSidebar()"></div>

    <!-- SIDEBAR -->
    <aside id="sidebar" class="sidebar ios-glass">
                <div class="brand cc-brand-block">
            <div class="brand-logo cc-brand-mark" aria-hidden="true">
                <svg viewBox="0 0 44 44" width="36" height="36" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="ccCoinBG_ad2" x1="0" y1="0" x2="44" y2="44" gradientUnits="userSpaceOnUse">
                            <stop offset="0" stop-color="#6b3a92"/><stop offset="1" stop-color="#241232"/>
                        </linearGradient>
                        <linearGradient id="ccCoinAccent_ad2" x1="10" y1="10" x2="34" y2="34" gradientUnits="userSpaceOnUse">
                            <stop offset="0" stop-color="#d4ff3d"/><stop offset="1" stop-color="#10b981"/>
                        </linearGradient>
                    </defs>
                    <circle cx="22" cy="22" r="21" fill="url(#ccCoinBG_ad2)"/>
                    <circle cx="22" cy="22" r="16.5" fill="none" stroke="rgba(255,255,255,.2)" stroke-width="1" stroke-dasharray="1.5 3"/>
                    <path d="M28.5 15c-1.9-2.2-4.7-3.5-7.8-3.5-5.8 0-10.5 4.7-10.5 10.5s4.7 10.5 10.5 10.5c3.1 0 5.9-1.3 7.8-3.5" stroke="url(#ccCoinAccent_ad2)" stroke-width="2.6" stroke-linecap="round" fill="none"/>
                    <path d="M31 12c0 2.2-1.3 3.5-3.5 3.5 2.2 0 3.5 1.3 3.5 3.5 0-2.2 1.3-3.5 3.5-3.5-2.2 0-3.5-1.3-3.5-3.5z" fill="#d4ff3d"/>
                </svg>
            </div>
            <div>
                <div class="brand-name cc-brand-title"><b>Cash</b><span>Campus</span></div>
                <div class="brand-sub">ADMIN CONSOLE</div>
            </div>
        </div>

                <nav class="nav">
            <div class="nav-section">Overview</div>
            <a href="/Admin/Index" class="nav-link"><i class="fa-solid fa-chart-line"></i><span>Dashboard</span></a>
            <a href="/Admin/Students" class="nav-link"><i class="fa-solid fa-user-graduate"></i><span>Students</span></a>
            <a href="/Admin/Transactions" class="nav-link"><i class="fa-solid fa-arrow-right-arrow-left"></i><span>Transactions</span></a>
            <a href="/Admin/VoucherManagement" class="nav-link active"><i class="fa-solid fa-receipt"></i><span>Voucher Management</span></a>
            <div class="nav-section">Financial Management</div>
            <a href="/Admin/Categories" class="nav-link"><i class="fa-solid fa-layer-group"></i><span>Categories</span></a>

@{
    ViewData["Title"] = "Events";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <link rel="stylesheet" href="/css/student-theme.css" />
    <link rel="stylesheet" href="/css/cc-animations.css" />

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Campus Events — CampusCoin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <link rel="apple-touch-icon" href="/favicon.svg?v=4" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = { darkMode: 'class' };
    </script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        * {
            transition: background-color 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease, color 0.3s ease;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            min-height: 100vh;
            font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
            background-color: #fbf6f0;
            background-image: radial-gradient(at 0% 0%,rgba(237,228,246,.9) 0px,transparent 50%),radial-gradient(at 100% 0%,rgba(196,174,224,.85) 0px,transparent 50%),radial-gradient(at 100% 100%,rgba(255,225,230,.85) 0px,transparent 50%),radial-gradient(at 0% 100%,rgba(246,239,252,.9) 0px,transparent 50%);
            background-attachment: fixed;
        }

            body.dark-mesh {
                background-color: #100a1a;
                background-image: radial-gradient(at 10% 10%,rgba(139, 88, 184,.28) 0px,transparent 50%),radial-gradient(at 90% 10%,rgba(139, 88, 184,.22) 0px,transparent 50%),radial-gradient(at 90% 90%,rgba(99,102,241,.28) 0px,transparent 50%),radial-gradient(at 10% 90%,rgba(99,102,241,.22) 0px,transparent 50%);
                background-attachment: fixed;
            }

        .orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(80px);
            z-index: -1;
            pointer-events: none;
            animation: floatOrb 18s infinite alternate ease-in-out;
        }

        .orb-1 {
            width: 450px;
            height: 450px;
            background: rgba(139, 88, 184,.5);
            top: -100px;
            left: -100px;
        }

        .orb-2 {
            width: 480px;
            height: 480px;
            background: rgba(139, 88, 184,.45);
            top: 30%;
            right: -120px;
            animation-delay: -5s;
        }

        .orb-3 {
            width: 400px;
            height: 400px;
            background: rgba(99,102,241,.4);
            bottom: -100px;
            left: 20%;
            animation-delay: -10s;
        }

        @@keyframes floatOrb {
            0% {
                transform: translate(0,0) scale(1);
            }

            50% {
                transform: translate(40px,60px) scale(1.08);
            }

            100% {
                transform: translate(-30px,30px) scale(.95);
            }
        }

        .ios-glass {
            backdrop-filter: blur(32px) saturate(240%);
            -webkit-backdrop-filter: blur(32px) saturate(240%);
            position: relative;
            overflow: hidden;
        }

        .light .ios-glass {
            background: rgba(255,255,255,.72);
            border: 1.5px solid rgba(255,255,255,.95);
            box-shadow: 0 20px 40px -12px rgba(99,102,241,.12),inset 0 1.5px 2px 0 rgba(255,255,255,1);
            color: #1a0b2e;
        }

        .dark .ios-glass {
            background: rgba(28,18,42,.6);
            border: 1px solid rgba(255,255,255,.15);
            box-shadow: 0 25px 50px -12px rgba(0,0,0,.45);
            color: #f8fafc;
        }

        .ios-glass-interactive {
            transition: transform .35s cubic-bezier(.16,1,.3,1),box-shadow .35s ease;
        }

            .ios-glass-interactive:hover {
                transform: translateY(-4px);
            }

        .sidebar {
            position: fixed;
            top: 20px;
            left: 20px;
            bottom: 20px;
            width: 260px;
            z-index: 100;
            border-radius: 30px;
            padding: 18px;
            display: flex;
            flex-direction: column;
            transition: transform .35s ease;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 4px 6px 22px;
        }

        .brand-logo {
            width: 46px;
            height: 46px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
            background: linear-gradient(135deg,#a486e0,#8b58b8,#6366f1);
            box-shadow: 0 12px 25px rgba(99,102,241,.32);
        }

        .brand-name {
            font-size: 18px;
            font-weight: 800;
            letter-spacing: -.5px;
        }

        .brand-sub {
            font-size: 9px;
            font-weight: 800;
            letter-spacing: .16em;
            opacity: .45;
            margin-top: 3px;
        }

        .nav-section {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: .15em;
            font-weight: 800;
            opacity: .4;
            padding: 14px 10px 7px;
        }

        .nav {
            flex: 1;
            overflow-y: auto;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 12px;
            margin: 4px 0;
            border-radius: 15px;
            text-decoration: none;
            color: inherit;
            font-size: 12px;
            font-weight: 650;
            transition: all .25s ease;
        }

            .nav-link i {
                width: 20px;
                text-align: center;
                opacity: .55;
            }

            .nav-link:hover {
                background: rgba(255,255,255,.30);
                transform: translateX(3px);
            }

        .dark .nav-link:hover {
            background: rgba(255,255,255,.06);
        }

        .nav-link.active {
            color: #6366f1;
            background: linear-gradient(135deg,rgba(139, 88, 184,.18),rgba(99,102,241,.14));
            box-shadow: inset 0 0 0 1px rgba(139, 88, 184,.15);
        }

        .dark .nav-link.active {
            color: #bae6fd;
            background: rgba(139, 88, 184,.1);
        }

        .student-mini {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 11px;
            border-radius: 18px;
            background: rgba(255,255,255,.30);
            border: 1px solid rgba(255,255,255,.35);
        }

        .dark .student-mini {
            background: rgba(255,255,255,.04);
            border-color: rgba(255,255,255,.08);
        }

        .student-avatar {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 11px;
            font-weight: 800;
            background: linear-gradient(135deg,#a486e0,#6366f1);
        }

        .main {
            margin-left: 300px;
            padding: 20px 25px 40px 0;
            min-height: 100vh;
        }

        .topbar {
            height: 70px;
            border-radius: 25px;
            padding: 10px 13px;
            display: flex;
            align-items: center;
            gap: 12px;
            position: sticky;
            top: 20px;
            z-index: 80;
        }

        .search {
            flex: 1;
            max-width: 500px;
            position: relative;
        }

            .search i {
                position: absolute;
                left: 16px;
                top: 50%;
                transform: translateY(-50%);
                opacity: .4;
                font-size: 12px;
            }

            .search input {
                width: 100%;
                border: none;
                outline: none;
                padding: 11px 15px 11px 42px;
                border-radius: 16px;
                background: rgba(255,255,255,.38);
                color: inherit;
                font-size: 12px;
                border: 1px solid rgba(255,255,255,.50);
            }

        .dark .search input {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-left: auto;
        }

        .action-btn {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            border: 1px solid rgba(255,255,255,.55);
            background: rgba(255,255,255,.36);
            color: inherit;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .dark .action-btn {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .profile {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 4px 9px 4px 4px;
            border-radius: 15px;
            cursor: pointer;
        }

        .profile-avatar {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 11px;
            font-weight: 800;
            background: linear-gradient(135deg,#a486e0,#6366f1);
        }

        
        .profile-name-wrap {
            display: flex;
            flex-direction: column;
            line-height: 1.15;
            max-width: 120px;
        }
        .profile-name-wrap .text-\[10px\] {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .profile {
            background: rgba(255,255,255,.36);
            border: 1px solid rgba(255,255,255,.55);
        }
        .dark .profile, body.dark-mesh .profile {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .page-header {
            display: flex;
            align-items: end;
            justify-content: space-between;
            gap: 20px;
            margin: 28px 3px 20px;
        }

        .eyebrow {
            color: #6366f1;
            font-size: 9px;
            font-weight: 850;
            text-transform: uppercase;
            letter-spacing: .18em;
            margin-bottom: 8px;
        }

        .page-title {
            font-size: clamp(28px,3vw,40px);
            font-weight: 900;
            letter-spacing: -1.8px;
            line-height: 1;
        }

        .page-description {
            font-size: 11px;
            opacity: .55;
            margin-top: 8px;
        }

        .filter-btn {
            padding: 8px 18px;
            border-radius: 14px;
            font-size: 11px;
            font-weight: 700;
            border: 1px solid rgba(255,255,255,.4);
            background: rgba(255,255,255,.2);
            cursor: pointer;
            transition: all .25s ease;
        }

        .dark .filter-btn {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .filter-btn.active {
            background: linear-gradient(135deg,#a486e0,#6366f1);
            color: #fff;
            border-color: transparent;
            box-shadow: 0 8px 20px rgba(99,102,241,.3);
        }

        .glass-input {
            width: 100%;
            padding: 12px 16px;
            border-radius: 14px;
            background: rgba(255,255,255,.35);
            border: 1px solid rgba(255,255,255,.5);
            font-size: 12px;
            outline: none;
            color: inherit;
        }

        .dark .glass-input {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.1);
        }

        .mobile-btn {
            display: none;
        }

        .mobile-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15,23,42,.25);
            backdrop-filter: blur(5px);
            z-index: 90;
        }

            .mobile-overlay.show {
                display: block;
            }

        @@media(max-width:950px) {
            .sidebar {
                transform: translateX(-120%);
            }

                .sidebar.open {
                    transform: translateX(0);
                }

            .main {
                margin-left: 0;
                padding: 15px;
            }

            .mobile-btn {
                display: flex;
            }
        }

        #toastContainer {
            position: fixed;
            right: 20px;
            bottom: 20px;
            z-index: 999;
            display: flex;
            flex-direction: column;
            gap: 9px;
        }

        .toast {
            min-width: 270px;
            padding: 13px;
            border-radius: 17px;
            display: flex;
            align-items: center;
            gap: 10px;
            animation: toastIn .3s ease;
        }

        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.55);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 400;
            padding: 16px;
        }
        .modal-overlay.show { display: flex; }

        .modal-card {
            width: 100%;
            max-width: 400px;
            padding: 28px 24px;
            border-radius: 28px;
            animation: modalIn .28s ease;
        }
        @@keyframes modalIn {
            from { opacity: 0; transform: translateY(18px) scale(0.96); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        .pass-code-box {
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            letter-spacing: 0.08em;
            font-size: 1.15rem;
            font-weight: 800;
            background: linear-gradient(135deg, rgba(139,88,184,0.12), rgba(56,189,248,0.12));
            border: 1.5px dashed rgba(139,88,184,0.35);
            border-radius: 16px;
            padding: 14px 16px;
            text-align: center;
            color: #6b3a92;
        }
        .dark .pass-code-box { color: #c4b5fd; border-color: rgba(196,181,253,0.35); }

        @@keyframes toastIn {
            from {
                opacity: 0;
                transform: translateY(15px) scale(.96);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }
    </style>
    <link rel="stylesheet" href="/css/cc-header-widgets.css" asp-append-version="true" />
</head>

<body class="light light-mesh min-h-screen text-slate-900 dark:text-slate-100 font-sans">

    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    <div id="mobileOverlay" class="mobile-overlay" onclick="closeSidebar()"></div>

    <!-- SIDEBAR -->
    <aside id="sidebar" class="sidebar ios-glass">
                <div class="brand cc-brand-block">
            <div class="brand-logo cc-brand-mark" aria-hidden="true">
                <svg viewBox="0 0 44 44" width="36" height="36" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="ccCoinBG_sb" x1="0" y1="0" x2="44" y2="44" gradientUnits="userSpaceOnUse">
                            <stop offset="0" stop-color="#6b3a92"/><stop offset="1" stop-color="#241232"/>
                        </linearGradient>
                        <linearGradient id="ccCoinAccent_sb" x1="10" y1="10" x2="34" y2="34" gradientUnits="userSpaceOnUse">
                            <stop offset="0" stop-color="#d4ff3d"/><stop offset="1" stop-color="#10b981"/>
                        </linearGradient>
                    </defs>
                    <circle cx="22" cy="22" r="21" fill="url(#ccCoinBG_sb)"/>
                    <circle cx="22" cy="22" r="16.5" fill="none" stroke="rgba(255,255,255,.2)" stroke-width="1" stroke-dasharray="1.5 3"/>
                    <path d="M28.5 15c-1.9-2.2-4.7-3.5-7.8-3.5-5.8 0-10.5 4.7-10.5 10.5s4.7 10.5 10.5 10.5c3.1 0 5.9-1.3 7.8-3.5" stroke="url(#ccCoinAccent_sb)" stroke-width="2.6" stroke-linecap="round" fill="none"/>
                    <path d="M31 12c0 2.2-1.3 3.5-3.5 3.5 2.2 0 3.5 1.3 3.5 3.5 0-2.2 1.3-3.5 3.5-3.5-2.2 0-3.5-1.3-3.5-3.5z" fill="#d4ff3d"/>
                </svg>
            </div>
            <div>
                <div class="brand-name cc-brand-title"><b>Cash</b><span>Campus</span></div>
                <div class="brand-sub">STUDENT PORTAL</div>
            </div>
        </div>

                <nav class="nav">
            <div class="nav-section">Main Menu</div>
            <a href="/Dashboard/Index" class="nav-link"><i class="fa-solid fa-chart-line"></i><span>Dashboard</span></a>
            <a href="/Dashboard/Transactions" class="nav-link"><i class="fa-solid fa-arrow-right-arrow-left"></i><span>My Transactions</span></a>
            <a href="/FeeVouchers" class="nav-link"><i class="fa-solid fa-receipt"></i><span>Fee Vouchers</span></a>
            <a href="/Dashboard/Wallet" class="nav-link"><i class="fa-solid fa-wallet"></i><span>Wallet</span></a>
            <a href="/Dashboard/Budgets" class="nav-link"><i class="fa-solid fa-wallet"></i><span>My Budgets</span></a>
            <a href="/Dashboard/Categories" class="nav-link"><i class="fa-solid fa-tags"></i><span>My Categories</span></a>
            <a href="/Dashboard/BillSplit" class="nav-link"><i class="fa-solid fa-people-arrows"></i><span>Bill Split</span></a>
            <a href="/Dashboard/SavingGoals" class="nav-link"><i class="fa-solid fa-bullseye"></i><span>Saving Goals</span></a>
            <a href="/Events" class="nav-link active"><i class="fa-solid fa-calendar-days"></i><span>Events</span></a>
            <a href="/Dashboard/Recurring" class="nav-link"><i class="fa-solid fa-arrows-rotate"></i><span>Recurring</span></a>
            <div class="nav-section">Personal</div>
            <a href="/Dashboard/FinancialHealth" class="nav-link"><i class="fa-solid fa-heart-pulse"></i><span>Financial Score</span></a>
            <a href="/Dashboard/Reports" class="nav-link"><i class="fa-solid fa-chart-column"></i><span>Reports</span></a>
            <a href="/Dashboard/Bookmarks" class="nav-link"><i class="fa-solid fa-bookmark"></i><span>Bookmarks</span></a>
            <a href="/Dashboard/Notifications" class="nav-link"><i class="fa-solid fa-bell"></i><span>Inbox & Chats</span></a>
            <a href="/AiCoach" class="nav-link"><i class="fa-solid fa-robot"></i><span>AI Coach & Support</span></a>
            <a href="/Dashboard/Profile" class="nav-link"><i class="fa-solid fa-sliders"></i><span>Profile</span></a>
        </nav>

        <div class="student-mini">
            <div class="student-avatar" id="sidebarAvatar">AR</div>
            <div class="flex-1 min-w-0">
                <div class="text-[11px] font-bold truncate" id="sidebarStudentName">Loading...</div>
                <div class="text-[9px] opacity-45 truncate" id="sidebarStudentRole">Student</div>
            </div>
            <i class="fa-solid fa-graduation-cap text-xs opacity-35"></i>
        </div>
        <a href="/Auth/Logout" style="display:flex;align-items:center;gap:10px;padding:10px 12px;margin-top:8px;border-radius:12px;font-size:13px;font-weight:700;color:#e11d48;text-decoration:none;">
            <i class="fa-solid fa-right-from-bracket"></i> Logout
        </a>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="main">

        <header class="topbar ios-glass">
            <button class="action-btn mobile-btn" onclick="toggleSidebar()">
                <i class="fa-solid fa-bars"></i>
            </button>

            <div class="search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input id="globalSearch" type="text" placeholder="Search events, workshops..." autocomplete="off">
            </div>

            <div class="top-actions">
                <button class="action-btn" onclick="toggleTheme()" type="button" title="Toggle theme">
                    <i id="themeIcon" class="fa-solid fa-moon"></i>
                </button>

                <div class="dropdown-wrap cc-notif-wrap" style="position:relative;z-index:10002;overflow:visible;">
                    <button type="button" class="action-btn cc-notif-btn" title="Notifications" aria-label="Notifications">
                        <i class="fa-regular fa-bell"></i>
                        <span class="cc-notif-dot hidden"></span>
                    </button>
                    <div class="cc-notif-popover" role="menu">
                        <div class="cc-notif-head">
                            <div class="cc-notif-title"><i class="fa-solid fa-bell"></i> Notifications</div>
                            <button type="button" class="cc-notif-markall">Mark all read</button>
                        </div>
                        <div class="cc-notif-list">
                            <div class="cc-notif-empty">Loading…</div>
                        </div>
                        <a href="/Dashboard/Notifications" class="cc-notif-footer">View all notifications →</a>
                    </div>
                </div>

                <div class="dropdown-wrap" style="position:relative;z-index:10002;overflow:visible;">
                    <div class="profile" data-cc-profile-btn style="cursor:pointer;display:flex;align-items:center;gap:8px;">
                        <div class="profile-avatar" id="topAvatar">ST</div>
                        <div class="profile-name-wrap">
                            <div class="text-[10px] font-bold" id="topStudentName">Loading...</div>
                            <div class="text-[8px] opacity-45">Student</div>
                        </div>
                        <i class="fa-solid fa-chevron-down text-[8px] opacity-40"></i>
                    </div>
                    <div data-cc-profile-dd class="cc-shared-dd">
                        <a href="/Dashboard/Profile" class="cc-shared-dd-item"><i class="fa-regular fa-user"></i> Profile</a>
                        <a href="/" class="cc-shared-dd-item"><i class="fa-solid fa-globe"></i> Public Website</a>
                        <a href="/Auth/Logout" class="cc-shared-dd-item" style="color:#e11d48;"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
                    </div>
                </div>
            </div>
        </header>

        <section class="page-header">
            <div>
                <div class="eyebrow">CampusCoin / Campus Life</div>
                <h1 class="page-title">Campus Events 🎟️</h1>
                <p class="page-description">Explore, register, and manage digital entry passes for campus activities.</p>
            </div>
            <div class="px-4 py-2 rounded-2xl ios-glass text-[11px] font-bold flex items-center gap-2">
                <i class="fa-solid fa-ticket text-purple-600"></i>
                <span>Wallet: <strong class="text-purple-700 dark:text-purple-400 font-extrabold" id="walletBalance">Rs. 0</strong></span>
            </div>
        </section>

        <section class="ios-glass rounded-3xl p-5 mb-8">
            <div class="flex flex-col md:flex-row items-center justify-between gap-4">
                <div class="flex flex-wrap gap-2 w-full md:w-auto">
                    <button class="filter-btn active" onclick="filterStatus('Upcoming', this)">Upcoming</button>
                    <button class="filter-btn" onclick="filterStatus('Registered', this)">My Passes (<span id="regCount">0</span>)</button>
                    <button class="filter-btn" onclick="filterStatus('Past', this)">Past</button>
                </div>
                <div class="flex flex-wrap gap-2 w-full md:w-auto">
                    <button class="filter-btn active" onclick="filterCategory('All', this)">All</button>
                    <button class="filter-btn" onclick="filterCategory('Tech', this)">Tech</button>
                    <button class="filter-btn" onclick="filterCategory('Workshops', this)">Workshops</button>
                    <button class="filter-btn" onclick="filterCategory('Sports', this)">Sports</button>
                    <button class="filter-btn" onclick="filterCategory('Cultural', this)">Cultural</button>
                </div>
            </div>
        </section>

        <section id="eventGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="col-span-full text-center py-12 ios-glass rounded-3xl">
                <i class="fa-solid fa-spinner fa-spin text-2xl opacity-40"></i>
                <p class="text-xs font-bold opacity-50 mt-3">Loading events...</p>
            </div>
        </section>

    </main>

    <!-- EVENT PASS MODAL -->
    <div id="passModal" class="modal-overlay" onclick="if(event.target===this) closePassModal()">
        <div class="modal-card ios-glass">
            <div class="flex justify-between items-start mb-4">
                <div class="flex items-center gap-2">
                    <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-emerald-400 to-teal-500 flex items-center justify-center text-white shadow-lg shadow-emerald-500/30">
                        <i class="fa-solid fa-ticket text-sm"></i>
                    </div>
                    <div>
                        <div class="text-[11px] font-bold uppercase tracking-wider opacity-50">Digital Entry Pass</div>
                        <h3 class="text-base font-extrabold leading-tight" id="passModalTitle">Event</h3>
                    </div>
                </div>
                <button onclick="closePassModal()" class="w-8 h-8 rounded-xl ios-glass flex items-center justify-center opacity-70 hover:opacity-100 transition">
                    <i class="fa-solid fa-xmark text-xs"></i>
                </button>
            </div>

            <div class="pass-code-box mb-4" id="passModalCode">PASS-XXXX-X</div>

            <div class="grid grid-cols-2 gap-3 mb-5 text-[12px]">
                <div class="ios-glass rounded-2xl p-3">
                    <div class="opacity-50 text-[10px] font-bold uppercase mb-0.5">Venue</div>
                    <div class="font-semibold" id="passModalVenue">—</div>
                </div>
                <div class="ios-glass rounded-2xl p-3">
                    <div class="opacity-50 text-[10px] font-bold uppercase mb-0.5">Date</div>
                    <div class="font-semibold" id="passModalDate">—</div>
                </div>
                <div class="ios-glass rounded-2xl p-3 col-span-2">
                    <div class="opacity-50 text-[10px] font-bold uppercase mb-0.5">Category</div>
                    <div class="font-semibold" id="passModalCategory">—</div>
                </div>
            </div>

            <p class="text-[11px] opacity-50 text-center mb-4">Show this pass at the venue entrance. Keep it handy offline.</p>

            <button onclick="closePassModal()" class="w-full py-3 rounded-2xl text-xs font-bold text-white bg-gradient-to-r from-emerald-500 to-teal-600 shadow-md hover:opacity-95 transition">
                Got it
            </button>
        </div>
    </div>

    <div id="toastContainer"></div>

    <script>
        let campusEvents = [];
        let selectedStatusFilter = "Upcoming";
        let selectedCategoryFilter = "All";
        let currentSelectedEvent = null;
        let currentUserName = "Student";
        let walletBalance = 0;

        document.addEventListener("DOMContentLoaded", async () => {
            initializeTheme();
            await loadUserInfo();
            await loadEvents();
            initializeSearch();
        });

        // ═══════════════════ USER INFO (Wallet = MonthlyAllowanceBaseline) ═══════════════════
        async function loadUserInfo() {
            try {
                // ✅ Wallet ke liye /api/auth/me use karo
                const userRes = await fetch('/api/auth/me');
                if (!userRes.ok) return;
                const userData = await userRes.json();

                const name = userData.fullName || 'Student';
                const initials = name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);
                currentUserName = name;
                walletBalance = userData.monthlyAllowanceBaseline || 0;

                document.getElementById("sidebarStudentName").textContent = name;
                document.getElementById("topStudentName").textContent = name;
                document.getElementById("sidebarAvatar").textContent = initials;
                document.getElementById("topAvatar").textContent = initials;
                document.getElementById("walletBalance").textContent = `Rs. ${walletBalance.toLocaleString()}`;
            } catch (err) { console.error('User info failed', err); }
        }

        async function loadEvents() {
            try {
                const res = await fetch('/api/events', { credentials: 'same-origin' });
                if (!res.ok) throw new Error('HTTP ' + res.status);
                const data = await res.json();
                campusEvents = Array.isArray(data) ? data : [];
                renderEventCatalog();
            } catch (err) {
                console.error('Events load failed', err);
                campusEvents = [];
                const grid = document.getElementById("eventGrid");
                if (grid) grid.innerHTML =
                    '<div class="col-span-full text-center py-12 ios-glass rounded-3xl">Failed to load events</div>';
            }
        }

        function renderEventCatalog(searchTerm = "") {
            const grid = document.getElementById("eventGrid");
            const term = (searchTerm || document.getElementById("globalSearch").value || "").toLowerCase().trim();

            const filtered = campusEvents.filter(evt => {
                const matchesStatus = (selectedStatusFilter === "Registered") ? evt.registered : (evt.status === selectedStatusFilter || selectedStatusFilter === "All");
                const matchesCategory = (selectedCategoryFilter === "All" || evt.category === selectedCategoryFilter);
                const matchesSearch = evt.title.toLowerCase().includes(term) || (evt.venue || '').toLowerCase().includes(term);
                return matchesStatus && matchesCategory && matchesSearch;
            });

            document.getElementById("regCount").textContent = campusEvents.filter(e => e.registered).length;
            grid.innerHTML = "";

            if (!filtered.length) {
                grid.innerHTML = `
                    <div class="col-span-full text-center py-12 ios-glass rounded-3xl">
                        <i class="fa-solid fa-calendar-xmark text-3xl opacity-30 mb-2"></i>
                        <p class="text-xs font-bold opacity-50">No events found.</p>
                    </div>`;
                return;
            }

            filtered.forEach(evt => {
                const isFree = evt.fee === 0;
                const feeBadge = isFree
                    ? `<span class="bg-emerald-500 text-white text-[9px] font-extrabold px-2.5 py-1 rounded-lg">FREE</span>`
                    : `<span class="bg-purple-700 text-white text-[9px] font-extrabold px-2.5 py-1 rounded-lg">Rs. ${evt.fee}</span>`;

                const card = document.createElement("div");
                card.className = "ios-glass ios-glass-interactive rounded-3xl overflow-hidden flex flex-col justify-between";
                card.innerHTML = `
                    <div>
                        <div class="h-44 w-full relative overflow-hidden">
                            <img src="${evt.image}" alt="${evt.title}" class="w-full h-full object-cover" onerror="this.src='https://via.placeholder.com/400x200/8b6ff0/ffffff?text=Event'">
                            <div class="absolute top-3 left-3 flex gap-2">
                                ${feeBadge}
                                <span class="bg-black/60 backdrop-blur-md text-white text-[9px] font-bold px-2.5 py-1 rounded-lg">${evt.category}</span>
                            </div>
                            <div class="absolute bottom-3 right-3 bg-amber-500 text-slate-950 text-[9px] font-black px-2.5 py-1 rounded-lg shadow-md">
                                <i class="fa-solid fa-chair mr-1"></i> ${evt.seatsLeft} Seats Left
                            </div>
                        </div>
                        <div class="p-5">
                            <h3 class="font-extrabold text-sm mb-2 leading-snug">${evt.title}</h3>
                            <p class="text-[11px] opacity-70 mb-4 line-clamp-2">${evt.description}</p>
                            <div class="space-y-1.5 text-[10px] opacity-80 font-semibold mb-4">
                                <div class="flex items-center gap-2"><i class="fa-solid fa-calendar-day text-purple-600 w-4"></i> ${evt.date} • ${evt.time || ''}</div>
                                <div class="flex items-center gap-2"><i class="fa-solid fa-location-dot text-rose-500 w-4"></i> ${evt.venue}</div>
                            </div>
                        </div>
                    </div>
                    <div class="p-5 pt-0">
                        ${evt.registered ? `
                            <button onclick="viewEventPass(${evt.id})" class="w-full py-2.5 rounded-xl text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 shadow-md flex items-center justify-center gap-2">
                                <i class="fa-solid fa-qrcode"></i> View Pass (${evt.passCode})
                            </button>
                        ` : `
                            <button onclick="registerEvent(${evt.id})" class="w-full py-2.5 rounded-xl text-xs font-bold text-white bg-gradient-to-r from-sky-600 to-indigo-600 shadow-md hover:opacity-95 flex items-center justify-center gap-2">
                                <i class="fa-solid fa-ticket"></i> Register Now
                            </button>
                        `}
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function filterStatus(status, btn) {
            selectedStatusFilter = status;
            btn.parentElement.querySelectorAll(".filter-btn").forEach(b => b.classList.remove("active"));
            btn.classList.add("active");
            renderEventCatalog();
        }

        function filterCategory(cat, btn) {
            selectedCategoryFilter = cat;
            btn.parentElement.querySelectorAll(".filter-btn").forEach(b => b.classList.remove("active"));
            btn.classList.add("active");
            renderEventCatalog();
        }

        function initializeSearch() {
            document.getElementById("globalSearch").addEventListener("input", function () {
                renderEventCatalog(this.value);
            });
        }

        async function registerEvent(eventId) {
            if (!confirm('Confirm registration? Payment will be deducted from your wallet if the event has a fee.')) return;

            try {
                const res = await fetch(`/api/events/${eventId}/register`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({})
                });
                const data = await res.json();
                if (data.success) {
                    showToast('Registered successfully!');
                    await loadUserInfo();
                    await loadEvents();
                    // Show the nice pass modal after short delay so list updates
                    setTimeout(() => {
                        const evt = campusEvents.find(e => e.id === eventId);
                        if (evt) {
                            evt.passCode = data.passCode || evt.passCode;
                            evt.registered = true;
                            openPassModal(evt);
                        } else {
                            openPassModal({ title: 'Event', passCode: data.passCode, venue: '—', date: '—', category: '—' });
                        }
                    }, 200);
                } else {
                    showToast(data.message || 'Registration failed');
                }
            } catch (err) {
                showToast('Registration error');
            }
        }

        function viewEventPass(eventId) {
            const evt = campusEvents.find(e => e.id === eventId);
            if (!evt) return;
            openPassModal(evt);
        }

        function openPassModal(evt) {
            document.getElementById('passModalTitle').textContent = evt.title || 'Event';
            document.getElementById('passModalCode').textContent = evt.passCode || '—';
            document.getElementById('passModalVenue').textContent = evt.venue || '—';
            document.getElementById('passModalDate').textContent = evt.date || '—';
            document.getElementById('passModalCategory').textContent = evt.category || 'General';
            document.getElementById('passModal').classList.add('show');
        }

        function closePassModal() {
            document.getElementById('passModal').classList.remove('show');
        }

        function toggleSidebar() {
            document.getElementById("sidebar").classList.toggle("open");
            document.getElementById("mobileOverlay").classList.toggle("show");
        }
        function closeSidebar() {
            document.getElementById("sidebar").classList.remove("open");
            document.getElementById("mobileOverlay").classList.remove("show");
        }

        function initializeTheme() {
            const saved = localStorage.getItem("campuscoin-theme");
            if (saved === "dark") {
                document.documentElement.classList.replace("light", "dark");
                document.body.classList.replace("light", "dark-mesh");
            }
            updateThemeIcon();
        }
        function toggleTheme() {
            const isDark = document.documentElement.classList.contains("dark");
            if (isDark) {
                document.documentElement.classList.replace("dark", "light");
                document.body.classList.replace("dark-mesh", "light");
                localStorage.setItem("campuscoin-theme", "light");
            } else {
                document.documentElement.classList.replace("light", "dark");
                document.body.classList.replace("light", "dark-mesh");
                localStorage.setItem("campuscoin-theme", "dark");
            }
            updateThemeIcon();
        }
        function updateThemeIcon() {
            const icon = document.getElementById("themeIcon");
            const isDark = document.documentElement.classList.contains("dark");
            icon.className = isDark ? "fa-solid fa-sun text-amber-300" : "fa-solid fa-moon";
        }

        function showToast(msg) {
            const c = document.getElementById("toastContainer");
            const t = document.createElement("div");
            t.className = "toast ios-glass font-bold text-xs";
            t.innerHTML = `<i class="fa-solid fa-circle-info text-purple-600"></i> ${msg}`;
            c.appendChild(t);
            setTimeout(() => { t.style.opacity = '0'; setTimeout(() => t.remove(), 300); }, 2500);
        }
    </script>

<script src="/js/cc-header-widgets.js" asp-append-version="true"></script>
</body>
</html>
@section Scripts {
    <style>
        .lg-field-error {
            display: none;
            margin-top: 6px;
            padding: 8px 12px;
            border-radius: 10px;
            background: rgba(239, 68, 68, 0.08);
            border: 1px solid rgba(239, 68, 68, 0.22);
            color: #b91c1c;
            font-size: 12.5px;
            font-weight: 600;
            line-height: 1.35;
            animation: lgErrIn .22s ease;
        }
        .lg-field-error.show { display: block; }
        .lg-input.invalid {
            border-color: rgba(239, 68, 68, 0.55) !important;
            box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.12) !important;
        }
        .lg-input.invalid i.ico { color: #ef4444 !important; }
        @@keyframes lgErrIn {
            from { opacity: 0; transform: translateY(-4px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        #errorAlert {
            display: none;
            margin-bottom: 16px;
            padding: 12px 16px;
            border-radius: 12px;
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.28);
            color: #b91c1c;
            font-size: 13px;
            font-weight: 600;
        }
        #errorAlert.show { display: block; }
    </style>
    <script>
        function showFieldError(inputId, message) {
            const input = document.getElementById(inputId);
            if (!input) return;
            const wrap = input.closest('.lg-input') || input.parentElement;
            if (wrap) wrap.classList.add('invalid');
            let err = document.getElementById(inputId + 'Error');
            if (!err) {
                err = document.createElement('div');
                err.id = inputId + 'Error';
                err.className = 'lg-field-error';
                const field = input.closest('.lg-field') || wrap.parentElement;
                field.appendChild(err);
            }
            err.textContent = message;
            err.classList.add('show');
        }

        function clearFieldError(inputId) {
            const input = document.getElementById(inputId);
            if (input) {
                const wrap = input.closest('.lg-input') || input.parentElement;
                if (wrap) wrap.classList.remove('invalid');
            }
            const err = document.getElementById(inputId + 'Error');
            if (err) { err.classList.remove('show'); err.textContent = ''; }
        }

        function clearAllLoginErrors() {
            ['email', 'password'].forEach(clearFieldError);
            const box = document.getElementById('errorAlert');
            if (box) { box.classList.remove('show'); box.style.display = 'none'; }
        }

        function validateLogin() {
            clearAllLoginErrors();
            let ok = true;
            const email = (document.getElementById('email')?.value || '').trim();
            const password = document.getElementById('password')?.value || '';

            if (!email) {
                showFieldError('email', 'Email is required.');
                ok = false;
            } else if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email)) {
                showFieldError('email', 'Please enter a valid email address.');
                ok = false;
            }

            if (!password) {
                showFieldError('password', 'Password is required.');
                ok = false;
            } else if (password.length < 6) {
                showFieldError('password', 'Password must be at least 6 characters.');
                ok = false;
            }
            return ok;
        }

        async function handleLogin(e) {
            e.preventDefault();
            if (!validateLogin()) return false;

            const email = document.getElementById('email').value.trim();
            const password = document.getElementById('password').value;
            const rememberMe = document.querySelector('input[name="remember"]')?.checked || false;
            const btn = document.querySelector('.lg-cta');
            let alertBox = document.getElementById('errorAlert');
            if (!alertBox) {
                alertBox = document.createElement('div');
                alertBox.id = 'errorAlert';
                const form = document.getElementById('loginForm');
                if (form) form.parentNode.insertBefore(alertBox, form);
            }

            const originalHtml = btn ? btn.innerHTML : '';
            if (btn) { btn.innerHTML = '<span>Signing In...</span>'; btn.disabled = true; }
            alertBox.classList.remove('show');
            alertBox.style.display = 'none';

            try {
                const res = await fetch('/Auth/Login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email, password: password, rememberMe: rememberMe })
                });
                const raw = await res.text();
                let data = {};
                try { data = JSON.parse(raw); } catch (_) {}

                if (res.ok && data.success) {
                    window.location.href = data.redirectUrl || '/Dashboard/Index';
                    return false;
                } else {
                    alertBox.textContent = data.message || ('Login failed (HTTP ' + res.status + ')');
                    alertBox.classList.add('show');
                    alertBox.style.display = 'block';
                    if (btn) { btn.innerHTML = originalHtml; btn.disabled = false; }
                }
            } catch (err) {
                alertBox.textContent = 'Network or server error. Is the backend running?';
                alertBox.classList.add('show');
                alertBox.style.display = 'block';
                if (btn) { btn.innerHTML = originalHtml; btn.disabled = false; }
            }
            return false;
        }

        document.addEventListener('DOMContentLoaded', function () {
            ['email', 'password'].forEach(function (id) {
                const el = document.getElementById(id);
                if (el) el.addEventListener('input', function () { clearFieldError(id); });
            });
            const toggle = document.getElementById('pwToggle');
            const input = document.getElementById('password');
            if (toggle && input) {
                toggle.addEventListener('click', function () {
                    const isPw = input.type === 'password';
                    input.type = isPw ? 'text' : 'password';
                    const icon = toggle.querySelector('i');
                    if (icon) icon.className = isPw ? 'ri-eye-off-line' : 'ri-eye-line';
                    toggle.setAttribute('aria-label', isPw ? 'Hide password' : 'Show password');
                });
            }
        });
    
        document.addEventListener('DOMContentLoaded', function () {
            try {
                var flash = sessionStorage.getItem('cc_flash');
                if (flash) {
                    sessionStorage.removeItem('cc_flash');
                    var alertBox = document.getElementById('errorAlert');
                    if (alertBox) {
                        alertBox.innerHTML = '<i class="fa-solid fa-circle-check" style="margin-right:8px;"></i>' + flash;
                        alertBox.classList.add('show');
                        alertBox.style.display = 'block';
                        alertBox.style.background = 'rgba(16, 185, 129, 0.12)';
                        alertBox.style.borderColor = 'rgba(16, 185, 129, 0.32)';
                        alertBox.style.color = '#047857';
                        alertBox.style.borderRadius = '14px';
                        alertBox.style.padding = '14px 16px';
                        alertBox.style.fontWeight = '600';
                    }
                }
            } catch (_) {}
        });
</script>
}

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="light">

<head>
    <link rel="stylesheet" href="/css/student-theme.css" />
    <link rel="stylesheet" href="/css/cc-animations.css" />

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CampusCoin — Recurring Transactions</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <link rel="apple-touch-icon" href="/favicon.svg?v=4" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: { brand: { 50:'#f6effc', 100:'#ede4f6', 400:'#a486e0', 500:'#8b58b8', 600:'#6b3a92' } },
                    fontFamily: { sans: ['Plus Jakarta Sans','-apple-system', 'BlinkMacSystemFont', 'Inter', 'Segoe UI', 'Roboto', 'sans-serif'] }
                }
            }
        };
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        * {
            transition: background-color 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease, color 0.3s ease;
        }

        html {
            scroll-behavior: smooth;
        }

        body.light-mesh {
            background-color: #fbf6f0;
            background-image: radial-gradient(at 0% 0%, rgba(237, 228, 246, 0.9) 0px, transparent 50%), radial-gradient(at 100% 0%, rgba(196, 174, 224, 0.85) 0px, transparent 50%), radial-gradient(at 100% 100%, rgba(255, 225, 230, 0.85) 0px, transparent 50%), radial-gradient(at 0% 100%, rgba(246, 239, 252, 0.9) 0px, transparent 50%), radial-gradient(at 50% 50%, rgba(212, 243, 228, 0.4) 0px, transparent 50%);
            background-attachment: fixed;
        }

        body.dark-mesh {
            background-color: #100a1a;
            background-image: radial-gradient(at 10% 10%, rgba(99, 102, 241, 0.28) 0px, transparent 50%), radial-gradient(at 90% 10%, rgba(168, 85, 247, 0.22) 0px, transparent 50%), radial-gradient(at 90% 90%, rgba(107, 58, 146, 0.28) 0px, transparent 50%), radial-gradient(at 10% 90%, rgba(236, 72, 153, 0.2) 0px, transparent 50%);
            background-attachment: fixed;
        }

        .orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(80px);
            z-index: -1;
            pointer-events: none;
            animation: floatOrb 18s infinite alternate ease-in-out;
        }

        .orb-1 {
            width: 450px;
            height: 450px;
            background: rgba(192, 132, 252, 0.4);
            top: -100px;
            left: -100px;
        }

        .orb-2 {
            width: 480px;
            height: 480px;
            background: rgba(139, 88, 184, 0.45);
            top: 30%;
            right: -120px;
            animation-delay: -5s;
        }

        .orb-3 {
            width: 400px;
            height: 400px;
            background: rgba(251, 113, 133, 0.35);
            bottom: -100px;
            left: 20%;
            animation-delay: -10s;
        }

        @@keyframes floatOrb {
            0% {
                transform: translate(0px, 0px) scale(1);
            }

            50% {
                transform: translate(40px, 60px) scale(1.08);
            }

            100% {
                transform: translate(-30px, 30px) scale(0.95);
            }
        }

        .ios-glass {
            backdrop-filter: blur(32px) saturate(240%);
            -webkit-backdrop-filter: blur(32px) saturate(240%);
            position: relative;
            overflow: hidden;
        }

        .light .ios-glass {
            background: rgba(255, 255, 255, 0.72);
            border: 1.5px solid rgba(255, 255, 255, 0.95);
            box-shadow: 0 20px 40px -12px rgba(107, 58, 146, 0.12), 0 4px 16px -2px rgba(0, 0, 0, 0.04), inset 0 1.5px 2px 0 rgba(255, 255, 255, 1);
            color: #0f172a;
        }

        .dark .ios-glass {
            background: rgba(18, 24, 38, 0.58);
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.45), inset 0 1px 0 0 rgba(255, 255, 255, 0.18);
            color: #f8fafc;
        }

        .ios-glass-interactive {
            transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease;
        }

            .ios-glass-interactive:hover {
                transform: translateY(-4px);
            }

        .sidebar {
            position: fixed;
            top: 20px;
            left: 20px;
            bottom: 20px;
            width: 260px;
            z-index: 100;
            border-radius: 30px;
            padding: 18px;
            display: flex;
            flex-direction: column;
            transition: transform .35s ease;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 4px 6px 22px;
        }

        .brand-logo {
            width: 46px;
            height: 46px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
            background: linear-gradient(135deg, #a486e0, #8b58b8, #6366f1);
            box-shadow: 0 12px 25px rgba(107, 58, 146, .28);
        }

        .brand-name {
            font-size: 18px;
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        .brand-sub {
            font-size: 9px;
            font-weight: 800;
            letter-spacing: .16em;
            opacity: .45;
            margin-top: 3px;
        }

        .nav-section {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: .15em;
            font-weight: 800;
            opacity: .4;
            padding: 14px 10px 7px;
        }

        .nav {
            flex: 1;
            overflow-y: auto;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 12px;
            margin: 4px 0;
            border-radius: 15px;
            text-decoration: none;
            color: inherit;
            font-size: 12px;
            font-weight: 650;
            transition: all .25s ease;
        }

            .nav-link i {
                width: 20px;
                text-align: center;
                opacity: .55;
            }

            .nav-link:hover {
                background: rgba(255,255,255,.30);
                transform: translateX(3px);
            }

        .dark .nav-link:hover {
            background: rgba(255,255,255,.06);
        }

        .nav-link.active {
            color: #6b3a92;
            background: linear-gradient(135deg, rgba(139,88,184,.18), rgba(99,102,241,.14));
            box-shadow: inset 0 0 0 1px rgba(139,88,184,.15), 0 10px 25px rgba(107,58,146,.08);
        }

        .dark .nav-link.active {
            color: #c4aee0;
            background: rgba(139,88,184,.10);
        }

        .student-mini {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 11px;
            border-radius: 18px;
            background: rgba(255,255,255,.30);
            border: 1px solid rgba(255,255,255,.35);
        }

        .dark .student-mini {
            background: rgba(255,255,255,.04);
            border-color: rgba(255,255,255,.08);
        }

        .student-avatar {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 11px;
            font-weight: 800;
            background: linear-gradient(135deg, #8b58b8, #6366f1);
        }

        .main {
            margin-left: 300px;
            padding: 20px 25px 40px 0;
            min-height: 100vh;
        }

        .topbar {
            height: 70px;
            border-radius: 25px;
            padding: 10px 13px;
            display: flex;
            align-items: center;
            gap: 12px;
            position: sticky;
            top: 20px;
            z-index: 80;
        }

        .search {
            flex: 1;
            max-width: 500px;
            position: relative;
        }

            .search i {
                position: absolute;
                left: 16px;
                top: 50%;
                transform: translateY(-50%);
                opacity: .4;
                font-size: 12px;
            }

            .search input {
                width: 100%;
                border: none;
                outline: none;
                padding: 11px 15px 11px 42px;
                border-radius: 16px;
                background: rgba(255,255,255,.38);
                color: inherit;
                font-size: 12px;
                border: 1px solid rgba(255,255,255,.50);
            }

        .dark .search input {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-left: auto;
        }

        .action-btn {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            border: 1px solid rgba(255,255,255,.55);
            background: rgba(255,255,255,.36);
            color: inherit;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .dark .action-btn {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .page-header {
            display: flex;
            align-items: end;
            justify-content: space-between;
            gap: 20px;
            margin: 28px 3px 20px;
        }

        .eyebrow {
            color: #6b3a92;
            font-size: 9px;
            font-weight: 850;
            text-transform: uppercase;
            letter-spacing: .18em;
            margin-bottom: 8px;
        }

        .page-title {
            font-size: clamp(28px, 3vw, 40px);
            font-weight: 900;
            letter-spacing: -1.8px;
            line-height: 1;
        }

        .page-description {
            font-size: 12px;
            opacity: .48;
            margin-top: 8px;
        }

        .date-pill {
            padding: 10px 14px;
            border-radius: 15px;
            font-size: 10px;
            font-weight: 700;
            white-space: nowrap;
        }

        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
        }

        .kpi {
            min-height: 145px;
            padding: 19px;
            border-radius: 25px;
            position: relative;
            overflow: hidden;
        }

        .kpi-icon {
            width: 40px;
            height: 40px;
            border-radius: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(139,88,184,.13);
            color: #6b3a92;
            margin-bottom: 13px;
        }

        .kpi-label {
            font-size: 10px;
            font-weight: 700;
            opacity: .48;
        }

        .kpi-value {
            font-size: 25px;
            font-weight: 900;
            letter-spacing: -1px;
            margin-top: 3px;
        }

        .rec-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            margin-top: 15px;
        }

        .rec-card {
            border-radius: 27px;
            padding: 22px;
            position: relative;
        }

        .rec-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 14px;
        }

        .rec-icon {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .glass-btn {
            border: 1px solid rgba(255,255,255,.55);
            background: rgba(255,255,255,.38);
            color: inherit;
            border-radius: 13px;
            padding: 9px 12px;
            font-size: 10px;
            font-weight: 750;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .dark .glass-btn {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .glass-btn:hover {
            transform: translateY(-2px);
            background: rgba(255,255,255,.65);
        }

        .primary-btn {
            color: white;
            border: none;
            background: linear-gradient(135deg, #a486e0, #8b58b8, #6366f1);
            box-shadow: 0 10px 22px rgba(107,58,146,.20);
        }

        .toggle-switch {
            position: relative;
            display: inline-block;
            width: 44px;
            height: 24px;
        }

            .toggle-switch input {
                opacity: 0;
                width: 0;
                height: 0;
            }

        .slider {
            position: absolute;
            cursor: pointer;
            inset: 0;
            background-color: rgba(0,0,0,0.15);
            transition: .3s;
            border-radius: 24px;
        }

        .dark .slider {
            background-color: rgba(255,255,255,0.15);
        }

        .slider:before {
            position: absolute;
            content: "";
            height: 18px;
            width: 18px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: .3s;
            border-radius: 50%;
        }

        input:checked + .slider {
            background-color: #10b981;
        }

            input:checked + .slider:before {
                transform: translateX(20px);
            }

        .mobile-btn {
            display: none;
        }

        .mobile-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15,23,42,.25);
            backdrop-filter: blur(5px);
            z-index: 90;
        }

            .mobile-overlay.show {
                display: block;
            }

        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15,23,42,.4);
            backdrop-filter: blur(8px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 300;
        }

            .modal-overlay.show {
                display: flex;
            }

        .modal-card {
            width: 100%;
            max-width: 440px;
            padding: 24px;
            border-radius: 28px;
        }

        #toastContainer {
            position: fixed;
            right: 20px;
            bottom: 20px;
            z-index: 999;
            display: flex;
            flex-direction: column;
            gap: 9px;
        }

        .toast {
            min-width: 270px;
            padding: 13px;
            border-radius: 17px;
            display: flex;
            align-items: center;
            gap: 10px;
            animation: toastIn .3s ease;
        }

        @@keyframes toastIn {
            from {
                opacity: 0;
                transform: translateY(15px) scale(.96);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        @@media(max-width:950px) {
            .sidebar {
                transform: translateX(-120%);
            }

                .sidebar.open {
                    transform: translateX(0);
                }

            .main {
                margin-left: 0;
                padding: 15px;
            }

            .mobile-btn {
                display: flex;
            }

            .rec-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media(max-width:700px) {
            .kpi-grid {
                grid-template-columns: 1fr;
            }

            .page-header {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    
        /* Dark-theme native select options (readable) */
        select, select option {
            color: #e2e8f0;
            background-color: #0f172a;
        }
        html.light select, html.light select option,
        body:not(.dark) select option {
            color: #0f172a;
            background-color: #ffffff;
        }
        .dark select, .dark select option,
        html.dark select, html.dark select option {
            color: #fbf6f0 !important;
            background-color: #1e293b !important;
        }
        #budgetCategory, #budgetCategory option {
            color: #fbf6f0 !important;
            background-color: #1e293b !important;
        }
</style>
    <link rel="stylesheet" href="/css/cc-header-widgets.css" asp-append-version="true" />
</head>

<body class="light-mesh min-h-screen text-slate-900 dark:text-slate-100 font-sans">

<style id="cc-breadcrumb-style">
.cc-breadcrumb{display:flex;flex-wrap:wrap;align-items:center;gap:6px;font-size:11px;font-weight:700;opacity:.7;margin-bottom:8px;}
.cc-breadcrumb a{color:inherit;text-decoration:none;opacity:.85;}
.cc-breadcrumb a:hover{opacity:1;text-decoration:underline;}
.cc-breadcrumb .sep{opacity:.4;}
.cc-loading-overlay{position:fixed;inset:0;background:rgba(15,23,42,.35);backdrop-filter:blur(4px);z-index:99998;display:none;align-items:center;justify-content:center;}
.cc-loading-overlay.show{display:flex;}
.cc-loading-box{padding:18px 22px;border-radius:16px;background:rgba(15,23,42,.92);color:#e2e8f0;font-size:13px;font-weight:700;display:flex;align-items:center;gap:10px;box-shadow:0 12px 40px rgba(0,0,0,.3);}
</style>
<div id="ccLoadingOverlay" class="cc-loading-overlay"><div class="cc-loading-box"><i class="fa-solid fa-spinner fa-spin"></i> Loading…</div></div>
<script>
window.ccShowLoading=function(on){var el=document.getElementById('ccLoadingOverlay');if(el)el.classList.toggle('show',!!on);};
</script>

<nav class="cc-breadcrumb" aria-label="Breadcrumb">
            <a href="/Dashboard/Index">Dashboard</a>
            <span class="sep">/</span>
            <span>Recurring</span>
        </nav>


    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>

    <div id="mobileOverlay" class="mobile-overlay" onclick="closeSidebar()"></div>

    <!-- SIDEBAR -->
    <aside id="sidebar" class="sidebar ios-glass no-print">
                <div class="brand cc-brand-block">
            <div class="brand-logo cc-brand-mark" aria-hidden="true">
                <svg viewBox="0 0 44 44" width="36" height="36" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="ccCoinBG_sb" x1="0" y1="0" x2="44" y2="44" gradientUnits="userSpaceOnUse">
                            <stop offset="0" stop-color="#6b3a92"/><stop offset="1" stop-color="#241232"/>
                        </linearGradient>
                        <linearGradient id="ccCoinAccent_sb" x1="10" y1="10" x2="34" y2="34" gradientUnits="userSpaceOnUse">
                            <stop offset="0" stop-color="#d4ff3d"/><stop offset="1" stop-color="#10b981"/>
                        </linearGradient>
                    </defs>
                    <circle cx="22" cy="22" r="21" fill="url(#ccCoinBG_sb)"/>
                    <circle cx="22" cy="22" r="16.5" fill="none" stroke="rgba(255,255,255,.2)" stroke-width="1" stroke-dasharray="1.5 3"/>
                    <path d="M28.5 15c-1.9-2.2-4.7-3.5-7.8-3.5-5.8 0-10.5 4.7-10.5 10.5s4.7 10.5 10.5 10.5c3.1 0 5.9-1.3 7.8-3.5" stroke="url(#ccCoinAccent_sb)" stroke-width="2.6" stroke-linecap="round" fill="none"/>
                    <path d="M31 12c0 2.2-1.3 3.5-3.5 3.5 2.2 0 3.5 1.3 3.5 3.5 0-2.2 1.3-3.5 3.5-3.5-2.2 0-3.5-1.3-3.5-3.5z" fill="#d4ff3d"/>
                </svg>
            </div>
            <div>
                <div class="brand-name cc-brand-title"><b>Cash</b><span>Campus</span></div>
                <div class="brand-sub">STUDENT PORTAL</div>
            </div>
        </div>

        <nav class="nav">
            <div class="nav-section">Main Menu</div>
            <a href="/Dashboard/Index" class="nav-link"><i class="fa-solid fa-chart-line"></i><span>Dashboard</span></a>
            <a href="/Dashboard/Transactions" class="nav-link"><i class="fa-solid fa-arrow-right-arrow-left"></i><span>My Transactions</span></a>
            <a href="/FeeVouchers" class="nav-link"><i class="fa-solid fa-receipt"></i><span>Fee Vouchers</span></a>
            <a href="/Dashboard/Budgets" class="nav-link"><i class="fa-solid fa-wallet"></i><span>My Budgets</span></a>
            <a href="/Dashboard/Categories" class="nav-link"><i class="fa-solid fa-tags"></i><span>My Categories</span></a>
            <a href="/Dashboard/BillSplit" class="nav-link"><i class="fa-solid fa-people-arrows"></i><span>Bill Split</span></a>
            <a href="/Dashboard/SavingGoals" class="nav-link"><i class="fa-solid fa-bullseye"></i><span>Saving Goals</span></a>
            <a href="/Events" class="nav-link"><i class="fa-solid fa-calendar-days"></i><span>Events</span></a>
            <a href="/Dashboard/Recurring" class="nav-link active"><i class="fa-solid fa-arrows-rotate"></i><span>Recurring</span></a>
            <div class="nav-section">Personal</div>
            <a href="/Dashboard/FinancialHealth" class="nav-link"><i class="fa-solid fa-heart-pulse"></i><span>Financial Score</span></a>
            <a href="/Dashboard/Reports" class="nav-link"><i class="fa-solid fa-chart-column"></i><span>Reports</span></a>
            <a href="/Dashboard/Bookmarks" class="nav-link"><i class="fa-solid fa-bookmark"></i><span>Bookmarks</span></a>
            <a href="/Dashboard/Notifications" class="nav-link"><i class="fa-solid fa-bell"></i><span>Inbox & Chats</span></a>
            <a href="/AiCoach" class="nav-link"><i class="fa-solid fa-robot"></i><span>AI Coach & Support</span></a>
            <a href="/Dashboard/Profile" class="nav-link"><i class="fa-solid fa-sliders"></i><span>Profile</span></a>
        </nav>

        <div class="student-mini">
            <div class="student-avatar" id="sidebarAvatar">AR</div>
            <div class="flex-1 min-w-0">
                <div class="text-[11px] font-bold truncate" id="sidebarStudentName">Loading...</div>
                <div class="text-[9px] opacity-45 truncate" id="sidebarStudentRole">Student</div>
            </div>
            <i class="fa-solid fa-graduation-cap text-xs opacity-35"></i>
        </div>
        <a href="/Auth/Logout" style="display:flex;align-items:center;gap:10px;padding:10px 12px;margin-top:8px;border-radius:12px;font-size:13px;font-weight:700;color:#e11d48;text-decoration:none;">
            <i class="fa-solid fa-right-from-bracket"></i> Logout
        </a>
    </aside>

    <!-- MAIN -->
    <main class="main">

        <!-- TOPBAR -->
        <header class="topbar ios-glass">
            <button class="action-btn mobile-btn" onclick="toggleSidebar()">
                <i class="fa-solid fa-bars"></i>
            </button>
            <div class="search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" id="searchInput" placeholder="Search recurring transactions..." oninput="filterCards(this.value)">
            </div>
            <div class="top-actions">
                <button class="glass-btn" onclick="processDue()" title="Process all due recurring transactions">
                    <i class="fa-solid fa-play text-amber-500"></i>
                    <span class="quick-label ml-1">Run Due</span>
                </button>
                <button class="glass-btn primary-btn" onclick="openAddModal()">
                    <i class="fa-solid fa-plus mr-1"></i> Add Recurring
                </button>
                <button class="action-btn" onclick="toggleTheme()"><i id="themeIcon" class="fa-solid fa-moon"></i></button>

                <div class="dropdown-wrap cc-notif-wrap" style="position:relative;z-index:10002;overflow:visible;">
                    <button type="button" class="action-btn cc-notif-btn" title="Notifications" aria-label="Notifications">
                        <i class="fa-regular fa-bell"></i>
                        <span class="cc-notif-dot hidden"></span>
                    </button>
                    <div class="cc-notif-popover" role="menu">
                        <div class="cc-notif-head">
                            <div class="cc-notif-title"><i class="fa-solid fa-bell"></i> Notifications</div>
                            <button type="button" class="cc-notif-markall">Mark all read</button>
                        </div>
                        <div class="cc-notif-list">
                            <div class="cc-notif-empty">Loading…</div>
                        </div>
                        <a href="/Dashboard/Notifications" class="cc-notif-footer">View all notifications →</a>
                    </div>
                </div>
                <div class="dropdown-wrap" style="position:relative;z-index:10002;overflow:visible;">
                    <div class="profile" data-cc-profile-btn style="cursor:pointer;display:flex;align-items:center;gap:8px;">
                        <div class="profile-avatar" id="topAvatar" style="width:34px;height:34px;border-radius:11px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:11px;font-weight:800;background:linear-gradient(135deg,#a486e0,#6366f1);">ST</div>
                        <div class="text-[10px] font-bold" id="topStudentName">Student</div>
                        <i class="fa-solid fa-chevron-down text-[8px] opacity-40"></i>
                    </div>
                    <div data-cc-profile-dd class="cc-shared-dd">
                        <a href="/Dashboard/Profile" class="cc-shared-dd-item"><i class="fa-regular fa-user"></i> Profile</a>
                        <a href="/Dashboard/Index" class="cc-shared-dd-item"><i class="fa-solid fa-chart-line"></i> Dashboard</a>
                        <a href="/Auth/Logout" class="cc-shared-dd-item" style="color:#e11d48;"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
                    </div>
                </div>

            </div>
        </header>

        <section class="page-header">
            <div>
                <div class="eyebrow">CampusCoin / Automated Entries</div>
                <h1 class="page-title">Recurring Transactions</h1>
                <p class="page-description">Set up auto-repeating transactions like monthly allowance, rent, and subscriptions.</p>
            </div>
            <div class="date-pill ios-glass">
                <i class="fa-regular fa-calendar mr-1"></i>
                <span id="currentDate">Loading...</span>
            </div>
        </section>

        <!-- KPIs -->
        <section class="kpi-grid">
            <div class="kpi ios-glass ios-glass-interactive">
                <div class="kpi-icon"><i class="fa-solid fa-arrows-rotate"></i></div>
                <div class="kpi-label">Total Recurring</div>
                <div class="kpi-value text-purple-600" id="kpiTotal">0</div>
            </div>
            <div class="kpi ios-glass ios-glass-interactive">
                <div class="kpi-icon"><i class="fa-solid fa-circle-check"></i></div>
                <div class="kpi-label">Active</div>
                <div class="kpi-value text-emerald-500" id="kpiActive">0</div>
            </div>
            <div class="kpi ios-glass ios-glass-interactive">
                <div class="kpi-icon"><i class="fa-solid fa-pause"></i></div>
                <div class="kpi-label">Paused</div>
                <div class="kpi-value text-amber-500" id="kpiPaused">0</div>
            </div>
        </section>

        <!-- RECURRING CARDS -->
        <section class="rec-grid" id="recContainer">
            <div class="text-center py-12 col-span-2 text-xs opacity-40">Loading recurring transactions...</div>
        </section>
    </main>

    <!-- ADD MODAL -->
    <div id="addModal" class="modal-overlay">
        <div class="modal-card ios-glass">
            <div class="flex justify-between items-center mb-4">
                <div class="font-extrabold text-sm">
                    <i class="fa-solid fa-arrows-rotate text-purple-600 mr-1"></i> Add Recurring Transaction
                </div>
                <button class="action-btn !w-8 !h-8" onclick="closeAddModal()">
                    <i class="fa-solid fa-xmark text-xs"></i>
                </button>
            </div>
            <form onsubmit="handleAdd(event)" class="space-y-3 text-xs">
                <div>
                    <label class="block opacity-60 mb-1">Description</label>
                    <input type="text" id="recDesc" required placeholder="e.g. Monthly Allowance, Netflix"
                           class="w-full px-3 py-2.5 rounded-xl bg-white/40 dark:bg-white/5 border border-white/50 dark:border-white/10 outline-none focus:ring-2 focus:ring-sky-400">
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block opacity-60 mb-1">Amount (Rs.)</label>
                        <input type="number" step="0.01" id="recAmount" required placeholder="0.00"
                               class="w-full px-3 py-2.5 rounded-xl bg-white/40 dark:bg-white/5 border border-white/50 dark:border-white/10 outline-none focus:ring-2 focus:ring-sky-400">
                    </div>
                    <div>
                        <label class="block opacity-60 mb-1">Type</label>
                        <select id="recType" class="w-full px-3 py-2.5 rounded-xl bg-white/40 dark:bg-white/5 border border-white/50 dark:border-white/10 outline-none">
                            <option value="Expense">Expense</option>
                            <option value="Income">Income</option>
                        </select>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block opacity-60 mb-1">Category</label>
                        <select id="recCategory" required
                                class="w-full px-3 py-2.5 rounded-xl bg-white/40 dark:bg-white/5 border border-white/50 dark:border-white/10 outline-none">
                            <option value="">Loading...</option>
                        </select>
                    </div>
                    <div>
                        <label class="block opacity-60 mb-1">Frequency</label>
                        <select id="recFreq" class="w-full px-3 py-2.5 rounded-xl bg-white/40 dark:bg-white/5 border border-white/50 dark:border-white/10 outline-none">
                            <option value="Weekly">Weekly</option>
                            <option value="Monthly" selected>Monthly</option>
                            <option value="Yearly">Yearly</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label class="block opacity-60 mb-1">Next Run Date</label>
                    <input type="date" id="recNextDate" required
                           class="w-full px-3 py-2.5 rounded-xl bg-white/40 dark:bg-white/5 border border-white/50 dark:border-white/10 outline-none focus:ring-2 focus:ring-sky-400">
                </div>
                <div class="flex gap-2 mt-5">
                    <button type="button" onclick="closeAddModal()" class="glass-btn flex-1 justify-center">Cancel</button>
                    <button type="submit" id="saveBtn" class="glass-btn primary-btn flex-1 justify-center">Save</button>
                </div>
            </form>
        </div>
    </div>

    <div id="toastContainer"></div>

    <script>
        let allRecurring = [];
        let allCategories = [];

        document.addEventListener("DOMContentLoaded", async function () {
            initializeTheme();
            setDate();
            setDefaultNextDate();
            await Promise.all([loadUserInfo(), loadCategories(), loadRecurring()]);
        });

        function setDate() {
            document.getElementById("currentDate").textContent = new Date().toLocaleDateString("en-US", {
                weekday: "short", month: "long", day: "numeric", year: "numeric"
            });
        }

        function setDefaultNextDate() {
            const tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            document.getElementById('recNextDate').value = tomorrow.toISOString().split('T')[0];
        }

        async function loadUserInfo() {
            try {
                let data = null;
                let res = await fetch('/api/dashboard/summary');
                if (res.ok) data = await res.json();
                if (!data || !(data.userName || data.fullName)) {
                    res = await fetch('/api/auth/me');
                    if (res.ok) data = await res.json();
                }
                if (!data) return;
                const name = data.userName || data.fullName || 'Student';
                const year = data.userAcademicYear || data.academicYear || 'Student';
                const initials = name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2) || 'ST';
                function setTxt(id, val) { const el = document.getElementById(id); if (el) el.textContent = val; }
                setTxt('sidebarAvatar', initials);
                setTxt('sidebarStudentName', name);
                setTxt('sidebarStudentRole', year);
                setTxt('topAvatar', initials);
                setTxt('topStudentName', name);
            } catch (err) { console.error(err); }
        }

        async function loadCategories() {
            try {
                const res = await fetch('/api/categories');
                if (!res.ok) return;
                allCategories = await res.json();
                const sel = document.getElementById('recCategory');
                sel.innerHTML = '<option value="">-- Select --</option>' +
                    allCategories.map(c => `<option value="${c.categoryId}">${c.name} (${c.type})</option>`).join('');
            } catch (err) { console.error(err); }
        }

        async function loadRecurring() {
            try {
                const res = await fetch('/api/recurring');
                if (!res.ok) throw new Error('Failed');
                allRecurring = await res.json();
                renderCards();
                updateKPIs();
            } catch (err) {
                console.error(err);
                document.getElementById('recContainer').innerHTML =
                    '<div class="text-center py-12 col-span-2 text-xs text-rose-500">Failed to load</div>';
            }
        }

        function renderCards() {
            const container = document.getElementById('recContainer');

            if (!allRecurring.length) {
                container.innerHTML = `
                    <div class="col-span-2 text-center py-12 ios-glass rounded-3xl">
                        <i class="fa-solid fa-arrows-rotate text-4xl opacity-20 mb-3"></i>
                        <div class="text-sm font-bold opacity-60">No recurring transactions yet</div>
                        <div class="text-xs opacity-40 mt-1">Click "Add Recurring" to set up auto-repeating entries</div>
                    </div>`;
                return;
            }

            container.innerHTML = allRecurring.map(r => {
                const isIncome = r.type === "Income";
                const color = isIncome
                    ? { text: 'text-emerald-500', bg: 'bg-emerald-500/10', icon: 'fa-arrow-down' }
                    : { text: 'text-rose-500', bg: 'bg-rose-500/10', icon: 'fa-arrow-up' };

                const freqIcon = r.frequency === 'Weekly' ? 'fa-calendar-week'
                    : r.frequency === 'Yearly' ? 'fa-calendar' : 'fa-calendar-day';

                return `
                    <div class="rec-card ios-glass ios-glass-interactive" data-search="${r.description} ${r.categoryName}">
                        <div class="rec-top">
                            <div class="flex items-center gap-3">
                                <div class="rec-icon ${color.text} ${color.bg}">
                                    <i class="fa-solid ${color.icon}"></i>
                                </div>
                                <div>
                                    <div class="text-[13px] font-bold">${r.description}</div>
                                    <div class="text-[10px] opacity-50">
                                        <i class="fa-solid ${freqIcon} mr-1"></i>${r.frequency} &bull; ${r.categoryName}
                                    </div>
                                </div>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" ${r.isActive ? 'checked' : ''} onchange="toggleActive(${r.recurringId})">
                                <span class="slider"></span>
                            </label>
                        </div>
                        <div class="flex justify-between items-end mt-3">
                            <div>
                                <div class="text-[10px] opacity-50">Next run</div>
                                <div class="text-[12px] font-bold">${r.nextRunDate}</div>
                            </div>
                            <div class="text-right">
                                <div class="text-[10px] opacity-50">Amount</div>
                                <div class="text-[16px] font-black ${color.text}">
                                    ${isIncome ? '+' : '-'}Rs. ${r.amount.toFixed(2)}
                                </div>
                            </div>
                        </div>
                        <div class="flex justify-end gap-1 mt-3">
                            <button class="glass-btn text-[9px] py-1 px-2 text-rose-500" onclick="deleteRec(${r.recurringId})">
                                <i class="fa-regular fa-trash-can"></i> Delete
                            </button>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function updateKPIs() {
            document.getElementById('kpiTotal').textContent = allRecurring.length;
            document.getElementById('kpiActive').textContent = allRecurring.filter(r => r.isActive).length;
            document.getElementById('kpiPaused').textContent = allRecurring.filter(r => !r.isActive).length;
        }

        function filterCards(val) {
            const term = val.toLowerCase().trim();
            document.querySelectorAll('.rec-card').forEach(card => {
                const text = card.dataset.search.toLowerCase();
                card.style.display = text.includes(term) ? 'block' : 'none';
            });
        }

        // ================= ADD =================
        function openAddModal() {
            document.getElementById('addModal').classList.add('show');
        }

        function closeAddModal() {
            document.getElementById('addModal').classList.remove('show');
            document.getElementById('recDesc').value = '';
            document.getElementById('recAmount').value = '';
            setDefaultNextDate();
        }

        async function handleAdd(e) {
            e.preventDefault();

            const payload = {
                description: document.getElementById('recDesc').value.trim(),
                amount: parseFloat(document.getElementById('recAmount').value),
                type: document.getElementById('recType').value,
                categoryId: parseInt(document.getElementById('recCategory').value),
                frequency: document.getElementById('recFreq').value,
                nextRunDate: document.getElementById('recNextDate').value
            };

            if (!payload.description || !payload.amount || !payload.categoryId) {
                showToast('Please fill all fields', 'error');
                return;
            }

            const btn = document.getElementById('saveBtn');
            const original = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';
            btn.disabled = true;

            try {
                const res = await fetch('/api/recurring', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (!res.ok) {
                    const err = await res.json().catch(() => ({}));
                    showToast(err.message || 'Failed to add', 'error');
                    return;
                }

                closeAddModal();
                showToast('Recurring transaction created!', 'success');
                await loadRecurring();
            } catch (err) {
                console.error(err);
                showToast('Error saving', 'error');
            } finally {
                btn.innerHTML = original;
                btn.disabled = false;
            }
        }

        // ================= TOGGLE =================
        async function toggleActive(id) {
            try {
                const res = await fetch(`/api/recurring/${id}/toggle`, { method: 'PUT' });
                if (!res.ok) { showToast('Failed to toggle', 'error'); return; }
                const data = await res.json();
                showToast(data.message, 'success');
                await loadRecurring();
            } catch (err) {
                console.error(err);
                showToast('Error toggling', 'error');
            }
        }

        // ================= DELETE =================
        async function deleteRec(id) {
            if (!confirm('Delete this recurring transaction?')) return;
            try {
                const res = await fetch(`/api/recurring/${id}`, { method: 'DELETE' });
                if (!res.ok) { showToast('Failed', 'error'); return; }
                showToast('Deleted', 'success');
                await loadRecurring();
            } catch (err) {
                console.error(err);
                showToast('Error deleting', 'error');
            }
        }

        // ================= PROCESS DUE =================
        async function processDue() {
            if (!confirm('Process all due recurring transactions now?')) return;

            try {
                const res = await fetch('/api/recurring/process-due', { method: 'POST' });
                if (!res.ok) { showToast('Failed', 'error'); return; }
                const data = await res.json();
                showToast(data.message, 'success');
                await loadRecurring();
            } catch (err) {
                console.error(err);
                showToast('Error', 'error');
            }
        }

        // ================= THEME =================
        function initializeTheme() {
            if (localStorage.getItem("campuscoin-theme") === "dark") {
                document.documentElement.classList.replace("light", "dark");
                document.body.classList.replace("light-mesh", "dark-mesh");
            }
            updateThemeIcon();
        }

        function toggleTheme() {
            const isDark = document.documentElement.classList.contains("dark");
            if (isDark) {
                document.documentElement.classList.replace("dark", "light");
                document.body.classList.replace("dark-mesh", "light-mesh");
                localStorage.setItem("campuscoin-theme", "light");
            } else {
                document.documentElement.classList.replace("light", "dark");
                document.body.classList.replace("light-mesh", "dark-mesh");
                localStorage.setItem("campuscoin-theme", "dark");
            }
            updateThemeIcon();
        }

        function updateThemeIcon() {
            const isDark = document.documentElement.classList.contains("dark");
            document.getElementById("themeIcon").className = isDark ? 'fa-solid fa-sun text-amber-300' : 'fa-solid fa-moon';
        }

        function toggleSidebar() {
            document.getElementById("sidebar").classList.toggle("open");
            document.getElementById("mobileOverlay").classList.toggle("show");
        }

        function closeSidebar() {
            document.getElementById("sidebar").classList.remove("open");
            document.getElementById("mobileOverlay").classList.remove("show");
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById("toastContainer");
            const toast = document.createElement("div");
            toast.className = "toast ios-glass";
            const iconMap = {
                success: '<i class="fa-solid fa-circle-check text-emerald-500"></i>',
                error: '<i class="fa-solid fa-circle-exclamation text-rose-500"></i>',
                info: '<i class="fa-solid fa-circle-info text-purple-600"></i>'
            };
            toast.innerHTML = `
                <div class="w-9 h-9 rounded-xl bg-purple-600/10 flex items-center justify-center">
                    ${iconMap[type] || iconMap.info}
                </div>
                <div>
                    <div class="text-[10px] font-bold">CampusCoin</div>
                    <div class="text-[9px] opacity-50">${message}</div>
                </div>`;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = "0";
                setTimeout(() => toast.remove(), 300);
            }, 2500);
        }
    </script>

<script src="/js/cc-header-widgets.js" asp-append-version="true"></script>
</body>
</html>
                                <span class="lg-coin-symbol">₹</span>
                                <span class="lg-coin-shine"></span>
                            </span>
                        </div>
                    </div>

                    <span class="lg-spark s1"></span>
                    <span class="lg-spark s2"></span>
                    <span class="lg-spark s3"></span>
                    <span class="lg-spark s4"></span>
                    <span class="lg-spark s5"></span>
                    <span class="lg-spark s6"></span>

                    <div class="lg-orbit">
                        <span class="lg-dot d1"></span>
                        <span class="lg-dot d2"></span>
                        <span class="lg-dot d3"></span>
                        <span class="lg-dot d4"></span>
                        <span class="lg-dot d5"></span>
                        <span class="lg-dot d6"></span>
                    </div>

                    <div class="lg-card lg-card-1">
                        <span class="lg-card-icon violet"><i class="ri-mail-send-line"></i></span>
                        <div>
                            <b>Link sent</b>
                            <small>Check your inbox</small>
                        </div>
                    </div>

                    <div class="lg-card lg-card-2">
                        <span class="lg-card-icon gold"><i class="ri-time-line"></i></span>
                        <div>
                            <b>30 min</b>
                            <small>Link validity</small>
                        </div>
                    </div>

                </div>
            </div>

            <div class="lg-trusts">
                <span class="lg-trust"><i class="ri-lock-2-line"></i> Encrypted</span>
                <span class="lg-trust"><i class="ri-shield-check-line"></i> Secure</span>
                <span class="lg-trust"><i class="ri-heart-line"></i> Free forever</span>
            </div>

        </div>
    </aside>

    <!-- ══════════ RIGHT · Glass form ══════════ -->
    <main class="lg-form-panel">
        <div class="lg-card-wrap">

            <div class="lg-head">
                <h2>Let's get you back in.</h2>
                <p>Enter your email and we'll send a reset link.</p>
            </div>

            <div class="lg-info">
                <span class="lg-info-icon"><i class="ri-shield-keyhole-line"></i></span>
                <div class="lg-info-text">
                    <b>Secure reset</b>
                    <small>The link works for 30 minutes and can only be used once.</small>
                </div>
            </div>

            <div id="fpAlert" class="lg-form-alert" hidden></div>

            <form id="forgotForm" method="post" action="/Auth/ForgotPassword" novalidate>
                @Html.AntiForgeryToken()

                <div class="lg-field">
                    <label for="email">Email address</label>
                    <div class="lg-input">
                        <i class="ri-mail-line ico"></i>
                        <input type="email" id="email" name="email"
                               placeholder="you@@university.edu" autocomplete="email" />
                    </div>
                    <div class="lg-field-error" id="emailError"></div>
                </div>

                <button type="submit" class="lg-cta" id="fpSubmit">
                    Send reset link <i class="ri-send-plane-line"></i>
                </button>

                <p class="lg-trust-note">
                    <i class="ri-shield-check-line"></i>
                    Your data stays encrypted &amp; private
                </p>
            </form>

            <p class="lg-foot">
                Remembered it?
                <a asp-controller="Account" asp-action="Login">
                    <i class="ri-arrow-left-line"></i> Back to sign in
                </a>
            </p>

        </div>
    </main>

</div>

@section Scripts {
    <style>
        .lg-field-error {
            display: none;
            margin-top: 6px;
            padding: 8px 12px;
            border-radius: 10px;
            background: rgba(239, 68, 68, 0.08);
            border: 1px solid rgba(239, 68, 68, 0.22);
            color: #b91c1c;
            font-size: 12.5px;
            font-weight: 600;
            line-height: 1.35;
            animation: lgErrIn .22s ease;
        }
        .lg-field-error.show { display: block; }
        .lg-input.invalid {
            border-color: rgba(239, 68, 68, 0.55) !important;
            box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.12) !important;
        }
        .lg-input.invalid i.ico { color: #ef4444 !important; }
        @@keyframes lgErrIn {
            from { opacity: 0; transform: translateY(-4px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .lg-form-alert {
            display: none;
            margin-bottom: 16px;
            padding: 12px 16px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 600;
            line-height: 1.4;
        }
        .lg-form-alert.show { display: block; }
        .lg-form-alert.success {
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid rgba(16, 185, 129, 0.28);
            color: #047857;
        }
        .lg-form-alert.error {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.28);
            color: #b91c1c;
        }
    </style>
    <script>
        (function () {
            const form = document.getElementById('forgotForm');
            if (!form) return;
            const AT = String.fromCharCode(64);
                    const emailRe = new RegExp('^[^\\s' + AT + ']+' + AT + '[^\\s' + AT + ']+\\.[^\\s' + AT + ']+$');

            function showFieldError(inputId, message) {
                const input = document.getElementById(inputId);
                if (!input) return;
                const wrap = input.closest('.lg-input');
                if (wrap) wrap.classList.add('invalid');
                const err = document.getElementById(inputId + 'Error');
                if (err) { err.textContent = message; err.classList.add('show'); }
            }
            function clearFieldError(inputId) {
                const input = document.getElementById(inputId);
                if (input) {
                    const wrap = input.closest('.lg-input');
                    if (wrap) wrap.classList.remove('invalid');
                }
                const err = document.getElementById(inputId + 'Error');
                if (err) { err.textContent = ''; err.classList.remove('show'); }
            }

            const emailEl = document.getElementById('email');
            if (emailEl) emailEl.addEventListener('input', () => clearFieldError('email'));

            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                clearFieldError('email');
                const alertBox = document.getElementById('fpAlert');
                if (alertBox) { alertBox.classList.remove('show', 'success', 'error'); alertBox.hidden = true; }

                const email = (emailEl && emailEl.value || '').trim();
                if (!email) { showFieldError('email', 'Please enter your email address.'); return; }
                if (!emailRe.test(email)) { showFieldError('email', 'Please enter a valid email address.'); return; }

                const btn = document.getElementById('fpSubmit');
                const original = btn ? btn.innerHTML : '';
                if (btn) { btn.disabled = true; btn.innerHTML = 'Sending… <i class="ri-loader-4-line"></i>'; }

                try {
                    const res = await fetch('/Auth/ForgotPassword', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify({ email })
                    });
                    const raw = await res.text();
                    let data = {};
                    try { data = JSON.parse(raw); } catch (_) {}

                    if (alertBox) {
                        alertBox.hidden = false;
                        alertBox.classList.add('show');
                        if (res.ok && data.success) {
                            alertBox.classList.add('success');
                            alertBox.textContent = data.message || 'If an account exists, a reset link has been sent to your email.';
                            form.reset();
                        } else {
                            alertBox.classList.add('error');
                            alertBox.textContent = data.message || 'Could not send reset link. Please try again.';
                        }
                    }
                } catch (err) {
                    if (alertBox) {
                        alertBox.hidden = false;
                        alertBox.classList.add('show', 'error');
                        alertBox.textContent = 'Network error. Please try again.';
                    }
                } finally {
                    if (btn) { btn.disabled = false; btn.innerHTML = original; }
                }
            });
        })();
    </script>
}


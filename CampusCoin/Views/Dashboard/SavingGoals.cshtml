            <a href="/Dashboard/Transactions" class="nav-link"><i class="fa-solid fa-arrow-right-arrow-left"></i><span>My Transactions</span></a>
            <a href="/FeeVouchers" class="nav-link"><i class="fa-solid fa-receipt"></i><span>Fee Vouchers</span></a>
            <a href="/Dashboard/Budgets" class="nav-link"><i class="fa-solid fa-wallet"></i><span>My Budgets</span></a>

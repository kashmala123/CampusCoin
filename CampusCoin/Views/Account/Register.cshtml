                                <span class="lg-select-value placeholder">Select year</span>
                                <i class="ri-arrow-down-s-line lg-select-arrow"></i>
                            </div>
                            <ul class="lg-select-menu" role="listbox">
                                <li data-value="1st Year" role="option">1st Year</li>
                                <li data-value="2nd Year" role="option">2nd Year</li>
                                <li data-value="3rd Year" role="option">3rd Year</li>
                                <li data-value="4th Year" role="option">4th Year</li>
                                <li data-value="Postgrad" role="option">Postgraduate</li>
                            </ul>
                        </div>
                    </div>

                    <div class="lg-field">
                        <label for="allowance">Monthly allowance</label>
                        <div class="lg-input">
                            <i class="ri-wallet-3-line ico"></i>
                            <input type="number" id="allowance" name="allowance"
                                   placeholder="Rs. 350" min="0" step="50" />
                        </div>
                    </div>
                </div>

                <div class="lg-field">
                    <label for="password">Password</label>
                    <div class="lg-input">
                        <i class="ri-lock-2-line ico"></i>
                        <input type="password" id="password" name="password"
                               placeholder="At least 8 characters"
                               autocomplete="new-password" />
                        <button type="button" class="lg-toggle" id="pwToggle" aria-label="Show password">
                            <i class="ri-eye-line"></i>

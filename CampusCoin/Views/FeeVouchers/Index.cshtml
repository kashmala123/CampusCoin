    <!-- CHALLAN PRINT AREA -->
    <div id="challanPrintArea" class="bg-white text-black p-6">
        <div class="text-center mb-4 border-b-2 border-black pb-2">
            <h1 class="text-xl font-bold uppercase">CampusCoin University</h1>
            <p class="text-xs">Official 3-Copy Bank Deposit Challan</p>
        </div>
        <div class="grid grid-cols-3 gap-4 text-[10px]">
            @for (int i = 1; i <= 3; i++)
            {
                var copyName = i == 1 ? "BANK COPY" : i == 2 ? "COLLEGE COPY" : "STUDENT COPY";
                var signText = i == 1 ? "Bank Cashier Sign" : i == 2 ? "Accounts Dept Sign" : "Depositor Sign";
                <div class="border p-3 border-black">
                    <div class="font-bold text-center border-b pb-1 mb-2">@i. @copyName</div>
                    <div class="space-y-1">
                        <p><strong>Bank:</strong> HBL / Allied Bank</p>
                        <p><strong>A/C:</strong> CampusCoin Higher Ed</p>
                        <p><strong>A/C No:</strong> 0042-7901238801</p>
                        <hr class="my-1">
                        <p><strong>Voucher:</strong> <span id="ch@(i)_id"></span></p>
                        <p><strong>Student:</strong> <span id="studentName">Student</span></p>
                        <p><strong>Semester:</strong> <span id="ch@(i)_sem"></span></p>
                        <p><strong>Title:</strong> <span id="ch@(i)_title"></span></p>
                        <p><strong>Due:</strong> <span id="ch@(i)_date"></span></p>
                        <hr class="my-1">
                        <p>Fee: Rs. <span id="ch@(i)_base"></span></p>
                        <p>Fine: Rs. <span id="ch@(i)_fine"></span></p>
                        <p class="text-xs font-bold mt-1">Total: Rs. <span id="ch@(i)_total"></span></p>
                    </div>
                    <div class="mt-8 pt-2 border-t border-dashed text-center">@signText</div>
                </div>
            }
        </div>
    </div>

    <div id="toastContainer"></div>

    <script>
        let vouchers = [];
        let summary = {};
        let currentStatusFilter = "All";
        let activeVoucherForPay = null;
        let charts = {};

        document.addEventListener("DOMContentLoaded", async () => {
            initializeTheme();
            setDate();
            await loadUserInfo();
            await loadSummary();
            await loadVouchers();
            initializeCharts();
            initializeSearch();
        });

        function setDate() {
            document.getElementById("currentDate").textContent =
                new Date().toLocaleDateString("en-US", { weekday: "short", month: "long", day: "numeric", year: "numeric" });
        }

        // ═══════════════════ USER INFO ═══════════════════
        async function loadUserInfo() {
            try {
                const res = await fetch('/api/auth/me', { credentials: 'same-origin' });
                if (!res.ok) return;
                const data = await res.json();
                const name = data.fullName || data.FullName || 'Student';
                const initials = name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);
                document.getElementById("sidebarStudentName").textContent = name;
                document.getElementById("topStudentName").textContent = name;
                document.getElementById("sidebarAvatar").textContent = initials;
                document.getElementById("topAvatar").textContent = initials;
                document.querySelectorAll("[id^='studentName']").forEach(el => el.textContent = name);
            } catch (err) { console.error(err); }
        }

        // ═══════════════════ SUMMARY (Wallet = MonthlyAllowanceBaseline) ═══════════════════
        async function loadSummary() {
            try {
                // Fee vouchers ka summary
                const res = await fetch('/api/feevouchers/summary', { credentials: 'same-origin' });
                const data = await res.json();
                summary = data;

                // Wallet ke liye /api/auth/me use karo
                const userRes = await fetch('/api/auth/me', { credentials: 'same-origin' });
                const userData = await userRes.json();
                const walletValue = userData.monthlyAllowanceBaseline || 0;

                document.getElementById("kpiTotalDue").dataset.counter = data.totalDue;
                document.getElementById("kpiLateFine").dataset.counter = data.totalFine;
                document.getElementById("kpiWallet").dataset.counter = walletValue;   // ✅ Sahi wallet
                document.getElementById("kpiDueDate").textContent = data.upcomingDueDate
                    ? new Date(data.upcomingDueDate).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
                    : "No pending";
                document.getElementById("modalWalletBalance").textContent = walletValue.toLocaleString();

                animateCounters();
            } catch (err) { console.error('Summary failed', err); }
        }

        async function loadVouchers() {
            try {
                const res = await fetch('/api/feevouchers', { credentials: 'same-origin' });
                vouchers = await res.json();
                renderVouchersTable();
                updateCharts();
            } catch (err) {
                document.getElementById("vouchersTableBody").innerHTML =
                    '<tr><td colspan="9" class="py-8 text-center opacity-50">Failed to load</td></tr>';
            }
        }

        function animateCounters() {
            document.querySelectorAll("[data-counter]").forEach(el => {
                const target = Number(el.dataset.counter);
                const start = performance.now();
                const duration = 1000;
                function update(time) {
                    const progress = Math.min((time - start) / duration, 1);
                    const eased = 1 - Math.pow(1 - progress, 3);
                    el.textContent = Math.round(target * eased).toLocaleString();
                    if (progress < 1) requestAnimationFrame(update);
                }
                requestAnimationFrame(update);
            });
        }

        function renderVouchersTable(searchTerm = "") {
            const tbody = document.getElementById("vouchersTableBody");
            const term = (searchTerm || document.getElementById("globalSearch").value || "").toLowerCase().trim();
            const selectedSem = document.getElementById("semesterFilter").value;

            const filtered = vouchers.filter(v => {
                const matchesStatus = currentStatusFilter === "All" || v.status === currentStatusFilter;
                const matchesSem = selectedSem === "All" || v.semester === selectedSem;
                const matchesSearch = v.voucherCode.toLowerCase().includes(term) ||
                                      v.title.toLowerCase().includes(term) ||
                                      v.semester.toLowerCase().includes(term);
                return matchesStatus && matchesSem && matchesSearch;
            });

            tbody.innerHTML = "";
            if (!filtered.length) {
                tbody.innerHTML = `<tr><td colspan="9" class="py-8 text-center opacity-50">
                    <i class="fa-solid fa-folder-open text-2xl mb-2 block"></i>No fee vouchers found.</td></tr>`;
                return;
            }

            filtered.forEach(v => {
                const total = v.amount + v.fine;
                let badgeClass = v.status === "Paid" ? "status-paid" : v.status === "Overdue" ? "status-overdue" : "status-pending";
                let dot = v.status === "Paid" ? "🟣" : v.status === "Overdue" ? "🔴" : "🟡";
                const tr = document.createElement("tr");
                tr.className = "hover:bg-slate-500/5 transition-colors";
                tr.innerHTML = `
                    <td class="py-4 px-3 font-extrabold text-purple-700 dark:text-purple-400">${v.voucherCode}</td>
                    <td class="py-4 px-3 font-bold">${v.title}</td>
                    <td class="py-4 px-3 opacity-70">${v.semester}</td>
                    <td class="py-4 px-3">Rs. ${v.amount.toLocaleString()}</td>
                    <td class="py-4 px-3 ${v.fine > 0 ? 'text-rose-500 font-bold' : 'opacity-40'}">Rs. ${v.fine.toLocaleString()}</td>
                    <td class="py-4 px-3 font-black text-sm">Rs. ${total.toLocaleString()}</td>
                    <td class="py-4 px-3 opacity-70">${v.dueDate}</td>
                    <td class="py-4 px-3"><span class="status-badge ${badgeClass}">${dot} ${v.status}</span></td>
                    <td class="py-4 px-3 text-right">
                        <div class="flex items-center justify-end gap-2">
                            ${v.status !== "Paid" ? `
                                <button class="glass-btn primary-btn" onclick="openPaymentModal(${v.id})">
                                    <i class="fa-solid fa-credit-card"></i> Pay Now</button>
                            ` : `<span class="text-[10px] text-violet-500 font-bold mr-2"><i class="fa-solid fa-circle-check"></i> Cleared</span>`}
                            <button class="glass-btn" onclick="downloadChallanPDF(${v.id})">
                                <i class="fa-solid fa-file-pdf text-rose-500"></i> PDF</button>
                        </div>
                    </td>`;
                tbody.appendChild(tr);
            });
        }

        function filterStatus(status, btn) {
            currentStatusFilter = status;
            document.querySelectorAll(".filter-btn").forEach(b => b.classList.remove("active"));
            btn.classList.add("active");
            renderVouchersTable();
        }

        function initializeSearch() {
            document.getElementById("globalSearch").addEventListener("input", function () {
                renderVouchersTable(this.value);
            });
        }

        function openPaymentModal(voucherId) {
            const v = vouchers.find(x => x.id === voucherId);
            if (!v) return;
            activeVoucherForPay = v;
            const total = v.amount + v.fine;
            document.getElementById("modalVoucherSub").textContent = `Voucher: #${v.voucherCode} (${v.semester})`;
            document.getElementById("modalFeeTitle").textContent = v.title;
            document.getElementById("modalDueDateInfo").textContent = `Due: ${v.dueDate}`;
            document.getElementById("modalAmount").textContent = `Rs. ${total.toLocaleString()}`;
            document.getElementById("paymentModal").classList.add("show");
        }

        function closePaymentModal() {
            document.getElementById("paymentModal").classList.remove("show");
            activeVoucherForPay = null;
        }

        function selectPayMethod(method, el) {
            document.querySelectorAll(".pay-tab").forEach(t => t.classList.remove("active"));
            el.classList.add("active");
            document.getElementById("payMethodWallet").classList.add("hidden");
            document.getElementById("payMethodOnline").classList.add("hidden");
            document.getElementById("payMethodReceipt").classList.add("hidden");
            if (method === 'wallet') document.getElementById("payMethodWallet").classList.remove("hidden");
            if (method === 'online') document.getElementById("payMethodOnline").classList.remove("hidden");
            if (method === 'receipt') document.getElementById("payMethodReceipt").classList.remove("hidden");
        }

        async function executePayment(methodName) {
            if (!activeVoucherForPay) return;
            try {
                const res = await fetch(`/api/feevouchers/${activeVoucherForPay.id}/pay`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ paymentMethod: methodName })
                });
                const data = await res.json();
                if (!data.success) { showToast(data.message || 'Payment failed'); return; }
                closePaymentModal();
                showToast(`✅ Payment successful via ${methodName}!`);
                await loadVouchers();
                await loadSummary();
            } catch (err) { showToast('Payment error'); }
        }

        function downloadChallanPDF(voucherId) {
            const v = vouchers.find(x => x.id === voucherId);
            if (!v) return;
            const total = v.amount + v.fine;
            for (let i = 1; i <= 3; i++) {
                document.getElementById(`ch${i}_id`).textContent = v.voucherCode;
                document.getElementById(`ch${i}_sem`).textContent = v.semester;
                document.getElementById(`ch${i}_title`).textContent = v.title;
                document.getElementById(`ch${i}_date`).textContent = v.dueDate;
                document.getElementById(`ch${i}_base`).textContent = v.amount.toLocaleString();
                document.getElementById(`ch${i}_fine`).textContent = v.fine.toLocaleString();
                document.getElementById(`ch${i}_total`).textContent = total.toLocaleString();
            }
            showToast("Preparing 3-Copy Challan...");
            setTimeout(() => window.print(), 600);
        }

        function getChartColors() {
            const dark = document.documentElement.classList.contains("dark");
            return {
                text: dark ? "rgba(226,232,240,.65)" : "rgba(26,11,46,.55)",
                grid: dark ? "rgba(255,255,255,.06)" : "rgba(26,11,46,.07)"
            };
        }

        function initializeCharts() {
            const ctx1 = document.getElementById("statusChart").getContext("2d");
            charts.status = new Chart(ctx1, {
                type: "doughnut",
                data: { labels: ["Paid", "Pending", "Overdue"], datasets: [{ data: [0, 0, 0], backgroundColor: ["#10b981", "#f59e0b", "#f43f5e"], borderWidth: 0 }] },
                options: { responsive: true, maintainAspectRatio: false, cutout: "70%", plugins: { legend: { position: "bottom", labels: { color: getChartColors().text, font: { size: 10 } } } } }
            });
            const ctx2 = document.getElementById("historyChart").getContext("2d");
            charts.history = new Chart(ctx2, {
                type: "bar",
                data: {
                    labels: ["Semester 1", "Semester 2", "Semester 3", "Semester 4"],
                    datasets: [
                        { label: "Paid (Rs.)", data: [0, 0, 0, 0], backgroundColor: "#10b981", borderRadius: 6 },
                        { label: "Pending (Rs.)", data: [0, 0, 0, 0], backgroundColor: "#f43f5e", borderRadius: 6 }
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { position: "top", labels: { color: getChartColors().text, font: { size: 9 } } } },
                    scales: {
                        x: { stacked: true, grid: { display: false }, ticks: { color: getChartColors().text, font: { size: 9 } } },
                        y: { stacked: true, grid: { color: getChartColors().grid }, ticks: { color: getChartColors().text, font: { size: 9 } } }
                    }
                }
            });
        }

        function updateCharts() {
            let paid = 0, pending = 0, overdue = 0;
            vouchers.forEach(v => {
                if (v.status === 'Paid') paid++;
                else if (v.status === 'Overdue') overdue++;
                else pending++;
            });
            if (charts.status) { charts.status.data.datasets[0].data = [paid, pending, overdue]; charts.status.update(); }
            if (charts.history) {
                const semPaid = { "Semester 1": 0, "Semester 2": 0, "Semester 3": 0, "Semester 4": 0 };
                const semPending = { "Semester 1": 0, "Semester 2": 0, "Semester 3": 0, "Semester 4": 0 };
                vouchers.forEach(v => {
                    if (semPaid[v.semester] === undefined) return;
                    if (v.status === "Paid") semPaid[v.semester] += v.amount;
                    else semPending[v.semester] += v.amount + v.fine;
                });
                charts.history.data.datasets[0].data = Object.values(semPaid);
                charts.history.data.datasets[1].data = Object.values(semPending);
                charts.history.update();
            }
        }

        function toggleSidebar() {
            document.getElementById("sidebar").classList.toggle("open");
            document.getElementById("mobileOverlay").classList.toggle("show");
        }
        function closeSidebar() {
            document.getElementById("sidebar").classList.remove("open");
            document.getElementById("mobileOverlay").classList.remove("show");
        }

        function initializeTheme() {
            const saved = localStorage.getItem("campuscoin-theme");
            if (saved === "dark") {
                document.documentElement.classList.replace("light", "dark");
                document.body.classList.replace("light", "dark-mesh");
            }
            updateThemeIcon();
        }

        function toggleTheme() {
            const isDark = document.documentElement.classList.contains("dark");
            if (isDark) {
                document.documentElement.classList.replace("dark", "light");
                document.body.classList.replace("dark-mesh", "light");
                localStorage.setItem("campuscoin-theme", "light");
            } else {
                document.documentElement.classList.replace("light", "dark");
                document.body.classList.replace("light", "dark-mesh");
                localStorage.setItem("campuscoin-theme", "dark");
            }
            updateThemeIcon();
        }

        function updateThemeIcon() {
            const icon = document.getElementById("themeIcon");
            const isDark = document.documentElement.classList.contains("dark");
            icon.className = isDark ? "fa-solid fa-sun text-amber-300" : "fa-solid fa-moon";
        }

        function logoutStudent() { window.location.href = "/Auth/Logout"; }

        function showToast(msg) {
            const c = document.getElementById("toastContainer");
            const t = document.createElement("div");
            t.className = "toast ios-glass font-bold text-xs";
            t.innerHTML = `<i class="fa-solid fa-circle-info text-purple-600"></i> ${msg}`;
            c.appendChild(t);
            setTimeout(() => { t.style.opacity = '0'; setTimeout(() => t.remove(), 300); }, 2500);
        }
    </script>

<script src="/js/cc-header-widgets.js" asp-append-version="true"></script>
</body>
</html>
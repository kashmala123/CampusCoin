    <main class="main">
        <header class="topbar ios-glass">
            <button class="action-btn mobile-btn" onclick="toggleSidebar()"><i class="fa-solid fa-bars"></i></button>
            <div class="search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" placeholder="Search saving goals..." id="searchInput" oninput="handleSearch(this.value)">
            </div>

            <div class="top-actions">
                <button class="glass-btn primary-btn" onclick="openAddGoalModal()"><i class="fa-solid fa-plus mr-1"></i> New Goal</button>
                <button class="action-btn" onclick="toggleTheme()"><i id="themeIcon" class="fa-solid fa-moon"></i></button>

                <div class="dropdown-wrap cc-notif-wrap" style="position:relative;z-index:10002;overflow:visible;">
                    <button type="button" class="action-btn cc-notif-btn" title="Notifications" aria-label="Notifications">
                        <i class="fa-regular fa-bell"></i>
                        <span class="cc-notif-dot hidden"></span>
                    </button>
                    <div class="cc-notif-popover" role="menu">
                        <div class="cc-notif-head">
                            <div class="cc-notif-title"><i class="fa-solid fa-bell"></i> Notifications</div>
                            <button type="button" class="cc-notif-markall">Mark all read</button>
                        </div>
                        <div class="cc-notif-list">
                            <div class="cc-notif-empty">Loading…</div>
                        </div>
                        <a href="/Dashboard/Notifications" class="cc-notif-footer">View all notifications →</a>
                    </div>
                </div>
                <div class="dropdown-wrap" style="position:relative;z-index:10002;overflow:visible;">
                    <div class="profile" data-cc-profile-btn style="cursor:pointer;display:flex;align-items:center;gap:8px;">
                        <div class="profile-avatar" id="topAvatar" style="width:34px;height:34px;border-radius:11px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:11px;font-weight:800;background:linear-gradient(135deg,#a486e0,#6366f1);">ST</div>
                        <div class="text-[10px] font-bold" id="topStudentName">Student</div>
                        <i class="fa-solid fa-chevron-down text-[8px] opacity-40"></i>
                    </div>
                    <div data-cc-profile-dd class="cc-shared-dd">
                        <a href="/Dashboard/Profile" class="cc-shared-dd-item"><i class="fa-regular fa-user"></i> Profile</a>
                        <a href="/Dashboard/Index" class="cc-shared-dd-item"><i class="fa-solid fa-chart-line"></i> Dashboard</a>
                        <a href="/Auth/Logout" class="cc-shared-dd-item" style="color:#e11d48;"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
                    </div>
                </div>

            </div>
        </header>

        <section class="page-header">
            <div>
                <div class="eyebrow">CampusCoin / Student Portal</div>
                <h1 class="page-title">Saving Goals</h1>
                <p class="page-description">Set targets, fund your future milestones, and track your savings growth visually.</p>
            </div>
            <div class="date-pill ios-glass">
                <i class="fa-regular fa-calendar mr-1"></i>
                <span id="currentDate">Loading...</span>
            </div>
        </section>

        <!-- KPI METRICS -->
        <section class="kpi-grid">
            <div class="kpi ios-glass ios-glass-interactive">
                <div class="kpi-icon"><i class="fa-solid fa-bullseye"></i></div>
                <div class="kpi-label">Total Target Amount</div>
                <div class="kpi-value text-purple-600" id="kpiTarget">Rs. 0.00</div>
            </div>
            <div class="kpi ios-glass ios-glass-interactive">
                <div class="kpi-icon"><i class="fa-solid fa-vault"></i></div>
                <div class="kpi-label">Total Saved Amount</div>
                <div class="kpi-value text-emerald-500" id="kpiSaved">Rs. 0.00</div>
            </div>
            <div class="kpi ios-glass ios-glass-interactive">
                <div class="kpi-icon"><i class="fa-solid fa-chart-line"></i></div>
                <div class="kpi-label">Overall Progress</div>
                <div class="kpi-value text-indigo-500" id="kpiProgress">0%</div>
            </div>
        </section>

        <!-- CHARTS -->
        <section class="charts-grid">
            <div class="chart-card ios-glass ios-glass-interactive">
                <div>
                    <div class="chart-title">Savings Growth Trend</div>
                    <div class="chart-sub">Monthly accumulated savings progression</div>
                </div>
                <div class="chart-container">
                    <canvas id="savingsTrendChart"></canvas>
                </div>
            </div>

            <div class="chart-card ios-glass ios-glass-interactive">
                <div>
                    <div class="chart-title">Goal Distribution Share</div>
                    <div class="chart-sub">Proportion of saved funds per goal</div>
                </div>
                <div class="chart-container">
                    <canvas id="goalShareChart"></canvas>
                </div>
            </div>
        </section>

        <!-- GOALS GRID -->
        <section class="goals-grid" id="goalsContainer">
            <div class="text-center py-12 col-span-3 text-xs opacity-40">Loading saving goals...</div>
        </section>
    </main>

    <!-- ADD GOAL MODAL -->
    <div id="addGoalModal" class="modal-overlay">
        <div class="modal-card ios-glass">
            <div class="flex justify-between items-center mb-4">
                <div class="font-extrabold text-sm">
                    <i class="fa-solid fa-bullseye text-purple-600 mr-1"></i> Create Saving Goal
                </div>
                <button class="action-btn !w-8 !h-8" onclick="closeAddGoalModal()">
                    <i class="fa-solid fa-xmark text-xs"></i>
                </button>
            </div>
            <form onsubmit="handleAddGoal(event)" class="space-y-3 text-xs">
                <div>
                    <label class="block opacity-60 mb-1">Goal Name</label>
                    <input type="text" id="goalName" required placeholder="e.g. New Laptop, Trip, Emergency Fund"
                           class="w-full px-3 py-2.5 rounded-xl bg-white/40 dark:bg-white/5 border border-white/50 dark:border-white/10 outline-none focus:ring-2 focus:ring-sky-400">
                </div>
                <div>
                    <label class="block opacity-60 mb-1">Target Amount (Rs.)</label>
                    <input type="number" step="0.01" id="goalTarget" required placeholder="1500"
                           class="w-full px-3 py-2.5 rounded-xl bg-white/40 dark:bg-white/5 border border-white/50 dark:border-white/10 outline-none focus:ring-2 focus:ring-sky-400">
                </div>
                <div>
                    <label class="block opacity-60 mb-1">Starting Amount (Rs.) <span class="opacity-50">— optional</span></label>
                    <input type="number" step="0.01" id="goalStart" placeholder="0"
                           class="w-full px-3 py-2.5 rounded-xl bg-white/40 dark:bg-white/5 border border-white/50 dark:border-white/10 outline-none focus:ring-2 focus:ring-sky-400">
                </div>
                <div class="flex gap-2 mt-5">
                    <button type="button" onclick="closeAddGoalModal()" class="glass-btn flex-1 justify-center">Cancel</button>
                    <button type="submit" class="glass-btn primary-btn flex-1 justify-center" id="saveGoalBtn">Create Goal</button>
                </div>
            </form>
        </div>
    </div>

    <!-- CONTRIBUTE MODAL -->
    <div id="contributeModal" class="modal-overlay">
        <div class="modal-card ios-glass">
            <div class="flex justify-between items-center mb-4">
                <div class="font-extrabold text-sm">
                    <i class="fa-solid fa-vault text-emerald-500 mr-1"></i> Deposit Towards Goal
                </div>
                <button class="action-btn !w-8 !h-8" onclick="closeContributeModal()">
                    <i class="fa-solid fa-xmark text-xs"></i>
                </button>
            </div>
            <form onsubmit="handleContribute(event)" class="space-y-3 text-xs">
                <input type="hidden" id="contributeGoalId">
                <div class="p-3 rounded-xl bg-purple-600/10 border border-sky-500/20">
                    <div class="text-[10px] opacity-60 mb-1">Depositing to:</div>
                    <div class="text-[13px] font-bold" id="contributeGoalName">--</div>
                </div>
                <div>
                    <label class="block opacity-60 mb-1">Deposit Amount (Rs.)</label>
                    <input type="number" step="0.01" id="contributeAmount" required placeholder="50.00"
                           class="w-full px-3 py-2.5 rounded-xl bg-white/40 dark:bg-white/5 border border-white/50 dark:border-white/10 outline-none focus:ring-2 focus:ring-emerald-400">
                </div>
                <div class="flex gap-2 mt-5">
                    <button type="button" onclick="closeContributeModal()" class="glass-btn flex-1 justify-center">Cancel</button>
                    <button type="submit" class="glass-btn primary-btn flex-1 justify-center" id="depositBtn">
                        <i class="fa-solid fa-vault mr-1"></i> Deposit
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div id="toastContainer"></div>

    <script>
        let trendChart = null;
        let shareChart = null;
        let allGoals = [];

        const goalIcons = ['fa-laptop-code', 'fa-plane-departure', 'fa-graduation-cap', 'fa-house', 'fa-car', 'fa-mobile-screen', 'fa-gift', 'fa-shield-halved'];
        const goalColors = [
            { text: 'text-purple-600', bg: 'bg-purple-600/10', solid: '#a486e0' },
            { text: 'text-indigo-500', bg: 'bg-indigo-500/10', solid: '#6366f1' },
            { text: 'text-emerald-500', bg: 'bg-emerald-500/10', solid: '#10b981' },
            { text: 'text-amber-500', bg: 'bg-amber-500/10', solid: '#f59e0b' },
            { text: 'text-purple-500', bg: 'bg-purple-500/10', solid: '#a855f7' },
            { text: 'text-rose-500', bg: 'bg-rose-500/10', solid: '#f43f5e' }
        ];

        document.addEventListener("DOMContentLoaded", async function () {
            initializeTheme();
            setDate();
            await Promise.all([loadUserInfo(), loadGoals()]);
        });

        function setDate() {
            document.getElementById("currentDate").textContent = new Date().toLocaleDateString("en-US", {
                weekday: "short", month: "long", day: "numeric", year: "numeric"
            });
        }

        // ================= USER INFO =================
        async function loadUserInfo() {
            try {
                const res = await fetch('/api/dashboard/summary');
                if (!res.ok) return;
                const data = await res.json();
                if (data.userName) {
                    const initials = data.userName.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);
                    document.getElementById('sidebarAvatar').textContent = initials;
                    document.getElementById('sidebarStudentName').textContent = data.userName;
                    var topName = document.getElementById('topStudentName');
                    if (topName) topName.textContent = data.userName;
                    var topAv = document.getElementById('topAvatar');
                    if (topAv) topAv.textContent = data.userName.split(' ').map(function(n){return n[0];}).join('').toUpperCase().slice(0,2);
                }
                if (data.userAcademicYear) document.getElementById('sidebarStudentRole').textContent = data.userAcademicYear;
            } catch (err) { console.error(err); }
        }

        // ================= LOAD GOALS =================
        async function loadGoals() {
            try {
                const res = await fetch('/api/savings-goals');
                if (!res.ok) throw new Error('Failed to load goals');
                allGoals = await res.json();

                renderGoalCards();
                updateKPIs();
                renderCharts();
            } catch (err) {
                console.error('Error loading goals:', err);
                document.getElementById('goalsContainer').innerHTML =
                    '<div class="text-center py-12 col-span-3 text-xs text-rose-500">Failed to load goals</div>';
            }
        }

        // ================= RENDER CARDS =================
        function renderGoalCards() {
            const container = document.getElementById('goalsContainer');

            if (!allGoals || allGoals.length === 0) {
                container.innerHTML = `
                    <div class="col-span-3 text-center py-12 ios-glass rounded-3xl">
                        <i class="fa-solid fa-bullseye text-4xl opacity-20 mb-3"></i>
                        <div class="text-sm font-bold opacity-60">No saving goals yet</div>
                        <div class="text-xs opacity-40 mt-1">Click "New Goal" to create your first target</div>
                    </div>`;
                return;
            }

            container.innerHTML = allGoals.map((g, idx) => {
                const icon = goalIcons[idx % goalIcons.length];
                const color = goalColors[idx % goalColors.length];
                const pct = Math.min(100, g.progressPercentage || 0);
                const left = (g.targetAmount || 0) - (g.currentAmount || 0);
                const isDone = g.isAchieved;

                let statusBadge, progressColor, statusText;
                if (isDone) {
                    statusBadge = 'bg-violet-500/10 text-violet-500';
                    progressColor = '#7c3aed';
                    statusText = `<i class="fa-solid fa-check-circle mr-1"></i> Achieved!`;
                } else if (pct >= 75) {
                    statusBadge = 'bg-purple-600/10 text-purple-600';
                    progressColor = '#8b58b8';
                    statusText = `<i class="fa-regular fa-clock mr-1"></i> ${g.targetDate ? 'Due ' + g.targetDate : 'Almost there'}`;
                } else {
                    statusBadge = color.bg + ' ' + color.text;
                    progressColor = color.solid;
                    statusText = `<i class="fa-regular fa-clock mr-1"></i> ${g.targetDate ? 'Due ' + g.targetDate : 'In progress'}`;
                }

                return `
                    <div class="goal-card ios-glass ios-glass-interactive">
                        <div class="goal-top">
                            <div class="flex items-center gap-3">
                                <div class="goal-icon ${color.text} ${color.bg}">
                                    <i class="fa-solid ${icon}"></i>
                                </div>
                                <div>
                                    <div class="text-[13px] font-bold">${g.goalName}</div>
                                    <div class="text-[9px] opacity-45">Target: Rs. ${(g.targetAmount || 0).toFixed(2)}</div>
                                </div>
                            </div>
                            <span class="text-[10px] font-bold px-2.5 py-1 rounded-lg ${statusBadge}">${pct.toFixed(0)}%</span>
                        </div>
                        <div class="flex justify-between text-[11px] font-semibold mt-2">
                            <span>Saved: Rs. ${(g.currentAmount || 0).toFixed(2)}</span>
                            <span class="opacity-50">Left: Rs. ${left.toFixed(2)}</span>
                        </div>
                        <div class="progress-track">
                            <div class="progress-fill" style="width: ${pct}%; background: ${progressColor};"></div>
                        </div>
                        <div class="flex justify-between items-center mt-3 text-[9px]">
                            <span class="opacity-60">${statusText}</span>
                            <div class="flex gap-1">
                                ${!isDone ? `
                                <button class="glass-btn text-[9px] py-1 px-2.5"
                                        onclick="openContributeModal(${g.goalId}, '${g.goalName.replace(/'/g, "\\'")}')">
                                    <i class="fa-solid fa-plus"></i> Funds
                                </button>
                                ` : ''}
                                <button class="glass-btn text-[9px] py-1 px-2 text-rose-500"
                                        onclick="deleteGoal(${g.goalId})" title="Delete">
                                    <i class="fa-regular fa-trash-can"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        // ================= KPIs =================
        function updateKPIs() {
            const totalTarget = allGoals.reduce((s, g) => s + (g.targetAmount || 0), 0);
            const totalSaved = allGoals.reduce((s, g) => s + (g.currentAmount || 0), 0);
            const overall = totalTarget > 0 ? (totalSaved / totalTarget) * 100 : 0;

            document.getElementById('kpiTarget').textContent = `Rs. ${totalTarget.toFixed(2)}`;
            document.getElementById('kpiSaved').textContent = `Rs. ${totalSaved.toFixed(2)}`;
            document.getElementById('kpiProgress').textContent = `${overall.toFixed(1)}%`;
        }

        // ================= CHARTS =================
        function renderCharts() {
            const colors = getChartColors();

            // 1. Trend chart — cumulative saved per goal over time
            // Simulate using each goal's contribution
            const ctx1 = document.getElementById('savingsTrendChart').getContext('2d');
            if (trendChart) trendChart.destroy();

            const months = ['May', 'Jun', 'Jul', 'Aug', 'Sep'];
            const totalSaved = allGoals.reduce((s, g) => s + (g.currentAmount || 0), 0);
            const trendData = [
                totalSaved * 0.2,
                totalSaved * 0.35,
                totalSaved * 0.55,
                totalSaved * 0.78,
                totalSaved
            ].map(v => Math.round(v * 100) / 100);

            trendChart = new Chart(ctx1, {
                type: 'line',
                data: {
                    labels: months,
                    datasets: [{
                        label: 'Accumulated Savings (Rs.)',
                        data: trendData,
                        borderColor: '#8b58b8',
                        backgroundColor: 'rgba(107,58,146,0.12)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { labels: { color: colors.text, font: { size: 10 } } } },
                    scales: {
                        x: { grid: { display: false }, ticks: { color: colors.text, font: { size: 9 } } },
                        y: { grid: { color: colors.grid }, ticks: { color: colors.text, font: { size: 9 } } }
                    }
                }
            });

            // 2. Goal share doughnut
            const ctx2 = document.getElementById('goalShareChart').getContext('2d');
            if (shareChart) shareChart.destroy();

            const labels = allGoals.map(g => g.goalName);
            const data = allGoals.map(g => g.currentAmount || 0);
            const bgColors = allGoals.map((g, i) => goalColors[i % goalColors.length].solid);

            shareChart = new Chart(ctx2, {
                type: 'doughnut',
                data: {
                    labels: labels.length ? labels : ['No goals yet'],
                    datasets: [{
                        data: data.length ? data : [1],
                        backgroundColor: bgColors.length ? bgColors : ['#e2e8f0'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '68%',
                    plugins: {
                        legend: { position: 'bottom', labels: { color: colors.text, font: { size: 9 }, boxWidth: 10 } }
                    }
                }
            });
        }

        function getChartColors() {
            const dark = document.documentElement.classList.contains("dark");
            return {
                text: dark ? "rgba(226,232,240,.65)" : "rgba(15,23,42,.55)",
                grid: dark ? "rgba(255,255,255,.06)" : "rgba(15,23,42,.07)"
            };
        }

        // ================= ADD GOAL =================
        function openAddGoalModal() {
            document.getElementById('addGoalModal').classList.add('show');
        }

        function closeAddGoalModal() {
            document.getElementById('addGoalModal').classList.remove('show');
            document.getElementById('goalName').value = '';
            document.getElementById('goalTarget').value = '';
            document.getElementById('goalStart').value = '';
        }

        async function handleAddGoal(e) {
            e.preventDefault();

            const goalName = document.getElementById('goalName').value.trim();
            const targetAmount = parseFloat(document.getElementById('goalTarget').value);
            const currentAmount = parseFloat(document.getElementById('goalStart').value) || 0;

            if (!goalName) { showToast('Please enter a goal name', 'error'); return; }
            if (!targetAmount || targetAmount <= 0) { showToast('Please enter a valid target', 'error'); return; }

            const btn = document.getElementById('saveGoalBtn');
            const original = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Creating...';
            btn.disabled = true;

            try {
                const res = await fetch('/api/savings-goals', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ goalName, targetAmount, currentAmount })
                });

                if (!res.ok) {
                    const err = await res.json().catch(() => ({}));
                    showToast(err.message || 'Failed to create goal', 'error');
                    return;
                }

                closeAddGoalModal();
                showToast('Goal created successfully!', 'success');
                confetti({ particleCount: 80, spread: 60, origin: { y: 0.7 } });
                await loadGoals();
            } catch (err) {
                console.error(err);
                showToast('Error creating goal', 'error');
            } finally {
                btn.innerHTML = original;
                btn.disabled = false;
            }
        }

        // ================= CONTRIBUTE =================
        function openContributeModal(goalId, goalName) {
            document.getElementById('contributeGoalId').value = goalId;
            document.getElementById('contributeGoalName').textContent = goalName;
            document.getElementById('contributeAmount').value = '';
            document.getElementById('contributeModal').classList.add('show');
        }

        function closeContributeModal() {
            document.getElementById('contributeModal').classList.remove('show');
        }

        async function handleContribute(e) {
            e.preventDefault();

            const goalId = document.getElementById('contributeGoalId').value;
            const amount = parseFloat(document.getElementById('contributeAmount').value);

            if (!amount || amount <= 0) { showToast('Please enter a valid amount', 'error'); return; }

            const btn = document.getElementById('depositBtn');
            const original = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Depositing...';
            btn.disabled = true;

            try {
                const res = await fetch(`/api/savings-goals/${goalId}/contribute`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ amount })
                });

                if (!res.ok) {
                    const err = await res.json().catch(() => ({}));
                    showToast(err.message || 'Failed to deposit', 'error');
                    return;
                }

                closeContributeModal();
                showToast('Deposit successful!', 'success');
                confetti({ particleCount: 70, spread: 50, origin: { y: 0.6 } });
                await loadGoals();
            } catch (err) {
                console.error(err);
                showToast('Error depositing', 'error');
            } finally {
                btn.innerHTML = original;
                btn.disabled = false;
            }
        }

        // ================= DELETE GOAL =================
        async function deleteGoal(id) {
            if (!confirm('Delete this saving goal? This cannot be undone.')) return;

            try {
                const res = await fetch(`/api/savings-goals/${id}`, { method: 'DELETE' });
                if (!res.ok) {
                    showToast('Failed to delete goal', 'error');
                    return;
                }
                showToast('Goal deleted', 'success');
                await loadGoals();
            } catch (err) {
                console.error(err);
                showToast('Error deleting goal', 'error');
            }
        }

        // ================= SEARCH =================
        function handleSearch(val) {
            const cards = document.querySelectorAll('.goal-card');
            cards.forEach(card => {
                const text = card.innerText.toLowerCase();
                card.style.display = text.includes(val.toLowerCase()) ? 'block' : 'none';
            });
        }

        // ================= THEME =================
        function initializeTheme() {
            if (localStorage.getItem("campuscoin-theme") === "dark") {
                document.documentElement.classList.replace("light", "dark");
                document.body.classList.replace("light-mesh", "dark-mesh");
            }
            updateThemeIcon();
        }

        function toggleTheme() {
            const isDark = document.documentElement.classList.contains("dark");
            if (isDark) {
                document.documentElement.classList.replace("dark", "light");
                document.body.classList.replace("dark-mesh", "light-mesh");
                localStorage.setItem("campuscoin-theme", "light");
            } else {
                document.documentElement.classList.replace("light", "dark");
                document.body.classList.replace("light-mesh", "dark-mesh");
                localStorage.setItem("campuscoin-theme", "dark");
            }
            updateThemeIcon();

            [trendChart, shareChart].forEach(c => {
                if (c) {
                    const colors = getChartColors();
                    if (c.options.plugins.legend.labels) c.options.plugins.legend.labels.color = colors.text;
                    if (c.options.scales?.x) c.options.scales.x.ticks.color = colors.text;
                    if (c.options.scales?.y) { c.options.scales.y.ticks.color = colors.text; c.options.scales.y.grid.color = colors.grid; }
                    c.update();
                }
            });
        }

        function updateThemeIcon() {
            const isDark = document.documentElement.classList.contains("dark");
            document.getElementById("themeIcon").className = isDark ? "fa-solid fa-sun text-amber-300" : "fa-solid fa-moon";
        }

        function toggleSidebar() {
            document.getElementById("sidebar").classList.toggle("open");
            document.getElementById("mobileOverlay").classList.toggle("show");
        }

        function closeSidebar() {
            document.getElementById("sidebar").classList.remove("open");
            document.getElementById("mobileOverlay").classList.remove("show");
        }

        // ================= TOAST =================
        function showToast(message, type = 'info') {
            const container = document.getElementById("toastContainer");
            const toast = document.createElement("div");
            toast.className = "toast ios-glass";

            const iconMap = {
                success: '<i class="fa-solid fa-circle-check text-emerald-500"></i>',
                error: '<i class="fa-solid fa-circle-exclamation text-rose-500"></i>',
                info: '<i class="fa-solid fa-circle-info text-purple-600"></i>'
            };

            toast.innerHTML = `
                <div class="w-9 h-9 rounded-xl bg-purple-600/10 flex items-center justify-center">
                    ${iconMap[type] || iconMap.info}
                </div>
                <div>
                    <div class="text-[10px] font-bold">CampusCoin</div>
                    <div class="text-[9px] opacity-50">${message}</div>
                </div>`;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = "0";
                setTimeout(() => toast.remove(), 300);
            }, 2500);
        }
    </script>

<script src="/js/cc-header-widgets.js" asp-append-version="true"></script>
</body>
</html>
@{
    ViewData["Title"] = "My Categories";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CampusCoin — My Categories</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <link rel="stylesheet" href="/css/student-theme.css" />
    <link rel="stylesheet" href="/css/cc-animations.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: { brand: { 50:'#f6effc',100:'#ede4f6',400:'#a486e0',500:'#8b58b8',600:'#6b3a92' } },
                    fontFamily: { sans: ['Plus Jakarta Sans','-apple-system','BlinkMacSystemFont','Inter','sans-serif'] }
                }
            }
        };
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { transition: background-color .4s ease,border-color .4s ease,box-shadow .4s ease,color .3s ease; }
        html { scroll-behavior: smooth; }
        body {
            min-height: 100vh;
            font-family: 'Plus Jakarta Sans',system-ui,sans-serif;
            background-color: #fbf6f0;
            background-image: radial-gradient(at 0% 0%,rgba(237,228,246,.9) 0px,transparent 50%),radial-gradient(at 100% 0%,rgba(196,174,224,.85) 0px,transparent 50%),radial-gradient(at 100% 100%,rgba(255,225,230,.85) 0px,transparent 50%),radial-gradient(at 0% 100%,rgba(246,239,252,.9) 0px,transparent 50%);
            background-attachment: fixed;
        }
        body.dark-mesh {
            background-color: #100a1a;
            background-image: radial-gradient(at 10% 10%,rgba(139,88,184,.28) 0px,transparent 50%),radial-gradient(at 90% 10%,rgba(139,88,184,.22) 0px,transparent 50%),radial-gradient(at 90% 90%,rgba(99,102,241,.28) 0px,transparent 50%),radial-gradient(at 10% 90%,rgba(99,102,241,.22) 0px,transparent 50%);
            background-attachment: fixed;
        }
        .orb { position: fixed; border-radius: 50%; filter: blur(80px); z-index: -1; pointer-events: none; animation: floatOrb 18s infinite alternate ease-in-out; }
        .orb-1 { width: 450px; height: 450px; background: rgba(139,88,184,.5); top: -100px; left: -100px; }
        .orb-2 { width: 480px; height: 480px; background: rgba(139,88,184,.45); top: 30%; right: -120px; animation-delay: -5s; }
        .orb-3 { width: 400px; height: 400px; background: rgba(99,102,241,.4); bottom: -100px; left: 20%; animation-delay: -10s; }
        @@keyframes floatOrb {
            0% { transform: translate(0,0) scale(1); }
            50% { transform: translate(40px,60px) scale(1.08); }
            100% { transform: translate(-30px,30px) scale(.95); }
        }
        .ios-glass {
            backdrop-filter: blur(32px) saturate(240%);
            -webkit-backdrop-filter: blur(32px) saturate(240%);
            position: relative; overflow: hidden;
        }
        .light .ios-glass {
            background: rgba(255,255,255,.72);
            border: 1.5px solid rgba(255,255,255,.95);
            box-shadow: 0 20px 40px -12px rgba(99,102,241,.12),inset 0 1.5px 2px 0 rgba(255,255,255,1);
            color: #1a0b2e;
        }
        .dark .ios-glass {
            background: rgba(28,18,42,.6);
            border: 1px solid rgba(255,255,255,.15);
            box-shadow: 0 25px 50px -12px rgba(0,0,0,.45);
            color: #f8fafc;
        }
        .ios-glass-interactive { transition: transform .35s cubic-bezier(.16,1,.3,1),box-shadow .35s ease; }
        .ios-glass-interactive:hover { transform: translateY(-4px); }
        .sidebar {
            position: fixed; top: 20px; left: 20px; bottom: 20px; width: 260px; z-index: 100;
            border-radius: 30px; padding: 18px; display: flex; flex-direction: column;
            transition: transform .35s ease;
        }
        .brand { display: flex; align-items: center; gap: 12px; padding: 4px 6px 22px; }
        .brand-logo {
            width: 46px; height: 46px; border-radius: 16px; display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: 20px;
            background: linear-gradient(135deg,#a486e0,#8b58b8,#6366f1);
            box-shadow: 0 12px 25px rgba(99,102,241,.32);
        }
        .brand-name { font-size: 18px; font-weight: 800; letter-spacing: -.5px; }
        .brand-sub { font-size: 9px; font-weight: 800; letter-spacing: .16em; opacity: .45; margin-top: 3px; }
        .nav-section { font-size: 9px; text-transform: uppercase; letter-spacing: .15em; font-weight: 800; opacity: .4; padding: 14px 10px 7px; }
        .nav { flex: 1; overflow-y: auto; }
        .nav-link {
            display: flex; align-items: center; gap: 12px; padding: 11px 12px; margin: 4px 0;
            border-radius: 15px; text-decoration: none; color: inherit; font-size: 12px; font-weight: 650;
            transition: all .25s ease;
        }
        .nav-link i { width: 20px; text-align: center; opacity: .55; }
        .nav-link:hover { background: rgba(255,255,255,.30); transform: translateX(3px); }
        .dark .nav-link:hover { background: rgba(255,255,255,.06); }
        .nav-link.active {
            color: #6366f1;
            background: linear-gradient(135deg,rgba(139,88,184,.18),rgba(99,102,241,.14));
            box-shadow: inset 0 0 0 1px rgba(139,88,184,.15);
        }
        .dark .nav-link.active { color: #bae6fd; background: rgba(139,88,184,.1); }
        .student-mini {
            display: flex; align-items: center; gap: 9px; padding: 11px; border-radius: 18px;
            background: rgba(255,255,255,.30); border: 1px solid rgba(255,255,255,.35);
        }
        .dark .student-mini { background: rgba(255,255,255,.04); border-color: rgba(255,255,255,.08); }
        .student-avatar {
            width: 36px; height: 36px; border-radius: 12px; display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: 11px; font-weight: 800; background: linear-gradient(135deg,#a486e0,#6366f1);
        }
        .main { margin-left: 300px; padding: 20px 25px 40px 0; min-height: 100vh; }
        .topbar {
            height: 70px; border-radius: 25px; padding: 10px 13px; display: flex; align-items: center; gap: 12px;
            position: sticky; top: 20px; z-index: 80;
        }
        .search { flex: 1; max-width: 500px; position: relative; }
        .search i { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); opacity: .4; font-size: 12px; }
        .search input {
            width: 100%; border: none; outline: none; padding: 11px 15px 11px 42px; border-radius: 16px;
            background: rgba(255,255,255,.38); color: inherit; font-size: 12px; border: 1px solid rgba(255,255,255,.50);
        }
        .dark .search input { background: rgba(255,255,255,.05); border-color: rgba(255,255,255,.08); }
        .top-actions { display: flex; align-items: center; gap: 7px; margin-left: auto; }
        .action-btn {
            width: 42px; height: 42px; border-radius: 14px; border: 1px solid rgba(255,255,255,.55);
            background: rgba(255,255,255,.36); color: inherit; cursor: pointer; position: relative;
            display: flex; align-items: center; justify-content: center;
        }
        .dark .action-btn { background: rgba(255,255,255,.05); border-color: rgba(255,255,255,.08); }
        .profile { display: flex; align-items: center; gap: 9px; padding: 4px 9px 4px 4px; border-radius: 15px; cursor: pointer; }
        .profile-avatar {
            width: 36px; height: 36px; border-radius: 12px; display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: 11px; font-weight: 800; background: linear-gradient(135deg,#a486e0,#6366f1);
        }
        .page-header { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin: 28px 3px 20px; }
        .eyebrow { color: #6366f1; font-size: 9px; font-weight: 850; text-transform: uppercase; letter-spacing: .18em; margin-bottom: 8px; }
        .page-title { font-size: clamp(28px,3vw,40px); font-weight: 900; letter-spacing: -1.8px; line-height: 1; }
        .page-description { font-size: 12px; opacity: .48; margin-top: 8px; }
        .kpi-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 15px; }
        .kpi { min-height: 130px; padding: 19px; border-radius: 25px; position: relative; overflow: hidden; }
        .kpi::after {
            content: ''; position: absolute; width: 110px; height: 110px; border-radius: 50%;
            right: -45px; top: -45px; background: rgba(139,88,184,.08); pointer-events: none;
        }
        .kpi-icon {
            width: 40px; height: 40px; border-radius: 13px; display: flex; align-items: center; justify-content: center;
            background: rgba(139,88,184,.13); color: #6366f1; margin-bottom: 13px;
        }
        .kpi-label { font-size: 10px; font-weight: 700; opacity: .48; }
        .kpi-value { font-size: 25px; font-weight: 900; letter-spacing: -1px; margin-top: 3px; }
        .glass-btn {
            border: 1px solid rgba(255,255,255,.55); background: rgba(255,255,255,.38); color: inherit;
            border-radius: 13px; padding: 8px 12px; font-size: 10px; font-weight: 750; cursor: pointer;
            display: inline-flex; align-items: center; gap: 6px;
        }
        .dark .glass-btn { background: rgba(255,255,255,.05); border-color: rgba(255,255,255,.08); }
        .primary-btn {
            color: white; border: none;
            background: linear-gradient(135deg,#a486e0,#8b58b8,#6366f1);
            box-shadow: 0 10px 22px rgba(99,102,241,.25);
        }
        .mobile-btn { display: none; }
        .mobile-overlay { display: none; position: fixed; inset: 0; background: rgba(15,23,42,.25); backdrop-filter: blur(5px); z-index: 90; }
        .mobile-overlay.show { display: block; }
        .modal-overlay {
            position: fixed; inset: 0; background: rgba(15,23,42,.5); backdrop-filter: blur(10px);
            display: none; align-items: center; justify-content: center; z-index: 300; padding: 15px;
        }
        .modal-overlay.show { display: flex; }
        .modal-card { width: 100%; max-width: 440px; padding: 24px; border-radius: 28px; max-height: 90vh; overflow-y: auto; }
        .status-badge {
            display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 999px;
            font-size: 10px; font-weight: 800;
        }
        .badge-default { background: rgba(99,102,241,.12); color: #6366f1; }
        .badge-custom { background: rgba(16,185,129,.12); color: #059669; }
        .badge-income { background: rgba(16,185,129,.15); color: #10b981; }
        .badge-expense { background: rgba(244,63,94,.12); color: #f43f5e; }
        .filter-btn {
            padding: 8px 16px; border-radius: 14px; font-size: 11px; font-weight: 700;
            border: 1px solid rgba(255,255,255,.4); background: rgba(255,255,255,.2); cursor: pointer;
        }
        .dark .filter-btn { background: rgba(255,255,255,.05); border-color: rgba(255,255,255,.08); }
        .filter-btn.active {
            background: linear-gradient(135deg,#a486e0,#6366f1); color: white; border-color: transparent;
            box-shadow: 0 8px 18px rgba(99,102,241,.28);
        }
        #toastContainer { position: fixed; right: 20px; bottom: 20px; z-index: 999; display: flex; flex-direction: column; gap: 9px; }
        .toast {
            min-width: 270px; padding: 13px; border-radius: 17px; display: flex; align-items: center; gap: 10px;
            animation: toastIn .3s ease;
        }
        @@keyframes toastIn {
            from { opacity: 0; transform: translateY(15px) scale(.96); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
        @@media(max-width:1200px) { .kpi-grid { grid-template-columns: 1fr 1fr; } }
        @@media(max-width:950px) {
            .sidebar { transform: translateX(-120%); }
            .sidebar.open { transform: translateX(0); }
            .main { margin-left: 0; padding: 15px; }
            .mobile-btn { display: flex; }
        }
        @@media(max-width:700px) {
            .kpi-grid { grid-template-columns: 1fr; }
            .page-header { flex-direction: column; align-items: flex-start; }
        }
        .topbar.ios-glass, .topbar, .top-actions, .dropdown-wrap { overflow: visible !important; }
        .topbar { z-index: 200 !important; }
    </style>
    <link rel="stylesheet" href="/css/cc-header-widgets.css" asp-append-version="true" />
</head>
<body class="light-mesh min-h-screen text-slate-900 dark:text-slate-100 font-sans">

    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    <div id="mobileOverlay" class="mobile-overlay" onclick="closeSidebar()"></div>

    <!-- SIDEBAR -->
    <aside id="sidebar" class="sidebar ios-glass">
        <div class="brand cc-brand-block">
            <div class="brand-logo cc-brand-mark" aria-hidden="true">
                <svg viewBox="0 0 44 44" width="36" height="36" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="ccCoinBG_sb" x1="0" y1="0" x2="44" y2="44" gradientUnits="userSpaceOnUse">
                            <stop offset="0" stop-color="#6b3a92"/><stop offset="1" stop-color="#241232"/>
                        </linearGradient>
                        <linearGradient id="ccCoinAccent_sb" x1="10" y1="10" x2="34" y2="34" gradientUnits="userSpaceOnUse">
                            <stop offset="0" stop-color="#d4ff3d"/><stop offset="1" stop-color="#10b981"/>
                        </linearGradient>
                    </defs>
                    <circle cx="22" cy="22" r="21" fill="url(#ccCoinBG_sb)"/>
                    <circle cx="22" cy="22" r="16.5" fill="none" stroke="rgba(255,255,255,.2)" stroke-width="1" stroke-dasharray="1.5 3"/>
                    <path d="M28.5 15c-1.9-2.2-4.7-3.5-7.8-3.5-5.8 0-10.5 4.7-10.5 10.5s4.7 10.5 10.5 10.5c3.1 0 5.9-1.3 7.8-3.5" stroke="url(#ccCoinAccent_sb)" stroke-width="2.6" stroke-linecap="round" fill="none"/>
                    <path d="M31 12c0 2.2-1.3 3.5-3.5 3.5 2.2 0 3.5 1.3 3.5 3.5 0-2.2 1.3-3.5 3.5-3.5-2.2 0-3.5-1.3-3.5-3.5z" fill="#d4ff3d"/>
                </svg>
            </div>
            <div>
                <div class="brand-name cc-brand-title"><b>Cash</b><span>Campus</span></div>
                <div class="brand-sub">STUDENT PORTAL</div>
            </div>
        </div>

        <nav class="nav">
            <div class="nav-section">Main Menu</div>
            <a href="/Dashboard/Index" class="nav-link"><i class="fa-solid fa-chart-line"></i><span>Dashboard</span></a>
            <a href="/Dashboard/Transactions" class="nav-link"><i class="fa-solid fa-arrow-right-arrow-left"></i><span>My Transactions</span></a>
            <a href="/FeeVouchers" class="nav-link"><i class="fa-solid fa-receipt"></i><span>Fee Vouchers</span></a>
            <a href="/Dashboard/Wallet" class="nav-link"><i class="fa-solid fa-wallet"></i><span>Wallet</span></a>
            <a href="/Dashboard/Budgets" class="nav-link"><i class="fa-solid fa-wallet"></i><span>My Budgets</span></a>
            <a href="/Dashboard/Categories" class="nav-link active"><i class="fa-solid fa-tags"></i><span>My Categories</span></a>
            <a href="/Dashboard/BillSplit" class="nav-link"><i class="fa-solid fa-people-arrows"></i><span>Bill Split</span></a>
            <a href="/Dashboard/SavingGoals" class="nav-link"><i class="fa-solid fa-bullseye"></i><span>Saving Goals</span></a>
            <a href="/Events" class="nav-link"><i class="fa-solid fa-calendar-days"></i><span>Events</span></a>
            <a href="/Dashboard/Recurring" class="nav-link"><i class="fa-solid fa-arrows-rotate"></i><span>Recurring</span></a>
            <div class="nav-section">Personal</div>
            <a href="/Dashboard/FinancialHealth" class="nav-link"><i class="fa-solid fa-heart-pulse"></i><span>Financial Score</span></a>
            <a href="/Dashboard/Reports" class="nav-link"><i class="fa-solid fa-chart-column"></i><span>Reports</span></a>
            <a href="/Dashboard/Bookmarks" class="nav-link"><i class="fa-solid fa-bookmark"></i><span>Bookmarks</span></a>
            <a href="/Dashboard/Notifications" class="nav-link"><i class="fa-solid fa-bell"></i><span>Inbox & Chats</span></a>
            <a href="/AiCoach" class="nav-link"><i class="fa-solid fa-robot"></i><span>AI Coach & Support</span></a>
            <a href="/Dashboard/Profile" class="nav-link"><i class="fa-solid fa-sliders"></i><span>Profile</span></a>
        </nav>

        <div class="student-mini">
            <div class="student-avatar" id="sidebarAvatar">ST</div>
            <div class="flex-1 min-w-0">
                <div class="text-[11px] font-bold truncate" id="sidebarStudentName">Loading...</div>
                <div class="text-[9px] opacity-45 truncate" id="sidebarStudentRole">Student</div>
            </div>
            <i class="fa-solid fa-graduation-cap text-xs opacity-35"></i>
        </div>
    </aside>

    <!-- MAIN -->
    <main class="main">
        <header class="topbar ios-glass">
            <button class="action-btn mobile-btn" onclick="toggleSidebar()"><i class="fa-solid fa-bars"></i></button>
            <div class="search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input id="globalSearch" type="text" placeholder="Search categories..." autocomplete="off">
            </div>
            <div class="top-actions">
                <button class="action-btn" onclick="toggleTheme()"><i id="themeIcon" class="fa-solid fa-moon"></i></button>
                <div class="dropdown-wrap cc-notif-wrap">
                    <button type="button" class="action-btn cc-notif-btn" title="Notifications" aria-label="Notifications">
                        <i class="fa-regular fa-bell"></i>
                        <span class="cc-notif-dot hidden"></span>
                    </button>
                    <div class="cc-notif-popover" role="menu">
                        <div class="cc-notif-head">
                            <div class="cc-notif-title"><i class="fa-solid fa-bell"></i> Notifications</div>
                            <button type="button" class="cc-notif-markall">Mark all read</button>
                        </div>
                        <div class="cc-notif-list"><div class="cc-notif-empty">Loading…</div></div>
                        <a href="/Dashboard/Notifications" class="cc-notif-footer">View all notifications →</a>
                    </div>
                </div>
                <div class="dropdown-wrap">
                    <div class="profile" data-cc-profile-btn style="cursor:pointer;display:flex;align-items:center;gap:8px;">
                        <div class="profile-avatar" id="topAvatar">ST</div>
                        <div class="text-[10px] font-bold" id="topStudentName">Student</div>
                        <i class="fa-solid fa-chevron-down text-[8px] opacity-40"></i>
                    </div>
                    <div data-cc-profile-dd class="cc-shared-dd">
                        <a href="/Dashboard/Profile" class="cc-shared-dd-item"><i class="fa-regular fa-user"></i> Profile</a>
                        <a href="/Dashboard/Index" class="cc-shared-dd-item"><i class="fa-solid fa-chart-line"></i> Dashboard</a>
                        <a href="/Auth/Logout" class="cc-shared-dd-item" style="color:#e11d48;"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
                    </div>
                </div>
            </div>
        </header>

        <section class="page-header">
            <div>
                <div class="eyebrow">CampusCoin / Organize</div>
                <h1 class="page-title">My Categories 🏷️</h1>
                <p class="page-description">Add your own income & expense categories. Defaults stay safe — only yours can be edited or deleted.</p>
            </div>
            <button class="glass-btn primary-btn text-xs font-bold py-3 px-5" onclick="openAddModal()">
                <i class="fa-solid fa-plus"></i> Add Category
            </button>
        </section>

        <section class="kpi-grid mb-5">
            <div class="kpi ios-glass ios-glass-interactive">
                <div class="kpi-icon"><i class="fa-solid fa-tags"></i></div>
                <div class="kpi-label">Total Categories</div>
                <div class="kpi-value" id="kpiTotal">0</div>
            </div>
            <div class="kpi ios-glass ios-glass-interactive">
                <div class="kpi-icon"><i class="fa-solid fa-user-pen"></i></div>
                <div class="kpi-label">My Custom</div>
                <div class="kpi-value text-emerald-600 dark:text-emerald-400" id="kpiCustom">0</div>
            </div>
            <div class="kpi ios-glass ios-glass-interactive">
                <div class="kpi-icon"><i class="fa-solid fa-lock"></i></div>
                <div class="kpi-label">Default (System)</div>
                <div class="kpi-value text-purple-600 dark:text-purple-400" id="kpiDefault">0</div>
            </div>
        </section>

        <div class="flex flex-wrap items-center gap-2 mb-4">
            <button class="filter-btn active" onclick="filterType('All', this)">All</button>
            <button class="filter-btn" onclick="filterType('Expense', this)"><i class="fa-solid fa-arrow-trend-down text-rose-500 mr-1"></i> Expense</button>
            <button class="filter-btn" onclick="filterType('Income', this)"><i class="fa-solid fa-arrow-trend-up text-emerald-500 mr-1"></i> Income</button>
            <button class="filter-btn" onclick="filterType('Custom', this)"><i class="fa-solid fa-star text-amber-500 mr-1"></i> My Custom</button>
        </div>

        <section class="ios-glass rounded-3xl p-5 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs border-collapse">
                    <thead>
                        <tr class="border-b border-slate-200 dark:border-slate-700/60 opacity-60 text-[10px] uppercase font-extrabold tracking-wider">
                            <th class="pb-3 px-3">Name</th>
                            <th class="pb-3 px-3">Type</th>
                            <th class="pb-3 px-3">Source</th>
                            <th class="pb-3 px-3 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="catTableBody" class="divide-y divide-slate-200/50 dark:divide-slate-800/50 font-medium">
                        <tr><td colspan="4" class="py-8 text-center opacity-50">Loading...</td></tr>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <!-- ADD / EDIT MODAL -->
    <div id="catModal" class="modal-overlay">
        <div class="modal-card ios-glass">
            <div class="flex justify-between items-center mb-4">
                <div>
                    <h3 class="text-base font-black" id="modalTitle">Add Category</h3>
                    <p class="text-[10px] opacity-50">Only your custom categories can be edited later.</p>
                </div>
                <button class="action-btn !w-8 !h-8" onclick="closeModal()"><i class="fa-solid fa-xmark text-xs"></i></button>
            </div>
            <form onsubmit="saveCategory(event)" class="space-y-3 text-xs">
                <input type="hidden" id="editId" value="">
                <div>
                    <label class="block opacity-60 mb-1 font-bold">Category Name</label>
                    <input type="text" id="catName" required maxlength="50" placeholder="e.g. Cafe, Side Hustle"
                           class="w-full px-3 py-2.5 rounded-xl bg-white/40 dark:bg-white/5 border border-white/50 dark:border-white/10 outline-none focus:ring-2 focus:ring-sky-400">
                </div>
                <div>
                    <label class="block opacity-60 mb-1 font-bold">Type</label>
                    <select id="catType" required
                            class="w-full px-3 py-2.5 rounded-xl bg-white/40 dark:bg-white/5 border border-white/50 dark:border-white/10 outline-none">
                        <option value="Expense">Expense</option>
                        <option value="Income">Income</option>
                    </select>
                </div>
                <button type="submit" class="glass-btn primary-btn w-full justify-center py-3 text-xs font-bold">
                    <i class="fa-solid fa-check"></i> <span id="saveBtnText">Save Category</span>
                </button>
            </form>
        </div>
    </div>

    <div id="toastContainer"></div>

    <script>
        let categories = [];
        let currentFilter = "All";
        let editMode = false;

        document.addEventListener("DOMContentLoaded", async () => {
            initializeTheme();
            await loadUserInfo();
            await loadCategories();
            document.getElementById("globalSearch").addEventListener("input", () => renderTable());
        });

        async function loadUserInfo() {
            try {
                const res = await fetch('/api/auth/me', { credentials: 'same-origin' });
                if (!res.ok) return;
                const data = await res.json();
                const name = data.fullName || data.FullName || data.userName || 'Student';
                const initials = name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);
                document.getElementById("sidebarStudentName").textContent = name;
                document.getElementById("topStudentName").textContent = name;
                document.getElementById("sidebarAvatar").textContent = initials;
                document.getElementById("topAvatar").textContent = initials;
                if (data.userAcademicYear || data.academicYear) {
                    document.getElementById("sidebarStudentRole").textContent = data.userAcademicYear || data.academicYear;
                }
            } catch (e) { console.error(e); }
        }

        async function loadCategories() {
            try {
                const res = await fetch('/api/categories', { credentials: 'same-origin' });
                if (!res.ok) throw new Error('HTTP ' + res.status);
                const data = await res.json();
                categories = Array.isArray(data) ? data : [];
                updateStats();
                renderTable();
            } catch (err) {
                console.error(err);
                document.getElementById("catTableBody").innerHTML =
                    '<tr><td colspan="4" class="py-8 text-center text-rose-500">Failed to load categories</td></tr>';
            }
        }

        function updateStats() {
            document.getElementById("kpiTotal").textContent = categories.length;
            document.getElementById("kpiCustom").textContent = categories.filter(c => c.isUserCustom).length;
            document.getElementById("kpiDefault").textContent = categories.filter(c => c.isDefault || !c.isUserCustom).length;
        }

        function filterType(type, btn) {
            currentFilter = type;
            document.querySelectorAll(".filter-btn").forEach(b => b.classList.remove("active"));
            btn.classList.add("active");
            renderTable();
        }

        function renderTable() {
            const tbody = document.getElementById("catTableBody");
            const term = (document.getElementById("globalSearch").value || "").toLowerCase().trim();

            let list = categories.filter(c => {
                if (currentFilter === "Expense" && c.type !== "Expense") return false;
                if (currentFilter === "Income" && c.type !== "Income") return false;
                if (currentFilter === "Custom" && !c.isUserCustom) return false;
                if (term && !(c.name || "").toLowerCase().includes(term)) return false;
                return true;
            });

            // Custom first, then defaults; alpha within
            list.sort((a, b) => {
                if (a.isUserCustom !== b.isUserCustom) return a.isUserCustom ? -1 : 1;
                return (a.name || "").localeCompare(b.name || "");
            });

            tbody.innerHTML = "";
            if (!list.length) {
                tbody.innerHTML = `<tr><td colspan="4" class="py-10 text-center opacity-50">
                    <i class="fa-solid fa-folder-open text-2xl mb-2 block"></i>No categories found.</td></tr>`;
                return;
            }

            list.forEach(c => {
                const typeBadge = c.type === "Income"
                    ? `<span class="status-badge badge-income">Income</span>`
                    : `<span class="status-badge badge-expense">Expense</span>`;
                const sourceBadge = c.isUserCustom
                    ? `<span class="status-badge badge-custom"><i class="fa-solid fa-star text-[8px]"></i> My Custom</span>`
                    : `<span class="status-badge badge-default"><i class="fa-solid fa-lock text-[8px]"></i> Default</span>`;

                const actions = c.isUserCustom
                    ? `<button class="glass-btn" onclick="openEditModal(${c.categoryId})" title="Edit"><i class="fa-solid fa-pen text-purple-600"></i></button>
                       <button class="glass-btn" onclick="deleteCategory(${c.categoryId})" title="Delete"><i class="fa-solid fa-trash text-rose-500"></i></button>`
                    : `<span class="text-[10px] opacity-40 font-bold">Locked</span>`;

                const tr = document.createElement("tr");
                tr.className = "hover:bg-slate-500/5 transition-colors";
                tr.innerHTML = `
                    <td class="py-3.5 px-3 font-extrabold">${escapeHtml(c.name)}</td>
                    <td class="py-3.5 px-3">${typeBadge}</td>
                    <td class="py-3.5 px-3">${sourceBadge}</td>
                    <td class="py-3.5 px-3 text-right"><div class="flex items-center justify-end gap-2">${actions}</div></td>`;
                tbody.appendChild(tr);
            });
        }

        function escapeHtml(s) {
            return String(s || "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
        }

        function openAddModal() {
            editMode = false;
            document.getElementById("editId").value = "";
            document.getElementById("catName").value = "";
            document.getElementById("catType").value = "Expense";
            document.getElementById("catType").disabled = false;
            document.getElementById("modalTitle").textContent = "Add Category";
            document.getElementById("saveBtnText").textContent = "Save Category";
            document.getElementById("catModal").classList.add("show");
        }

        function openEditModal(id) {
            const c = categories.find(x => x.categoryId === id);
            if (!c || !c.isUserCustom) return;
            editMode = true;
            document.getElementById("editId").value = id;
            document.getElementById("catName").value = c.name;
            document.getElementById("catType").value = c.type;
            document.getElementById("catType").disabled = true; // type locked on edit
            document.getElementById("modalTitle").textContent = "Edit Category";
            document.getElementById("saveBtnText").textContent = "Update Category";
            document.getElementById("catModal").classList.add("show");
        }

        function closeModal() {
            document.getElementById("catModal").classList.remove("show");
        }

        async function saveCategory(e) {
            e.preventDefault();
            const name = document.getElementById("catName").value.trim();
            const type = document.getElementById("catType").value;
            const id = document.getElementById("editId").value;

            if (!name) { showToast("Name is required"); return; }

            try {
                let res;
                if (editMode && id) {
                    res = await fetch(`/api/categories/${id}`, {
                        method: "PUT",
                        headers: { "Content-Type": "application/json" },
                        credentials: "same-origin",
                        body: JSON.stringify({ name, type })
                    });
                } else {
                    res = await fetch("/api/categories", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        credentials: "same-origin",
                        body: JSON.stringify({ name, type })
                    });
                }
                const data = await res.json().catch(() => ({}));
                if (!res.ok) {
                    showToast(data.message || "Failed to save");
                    return;
                }
                closeModal();
                showToast(editMode ? "Category updated" : "Category added");
                await loadCategories();
            } catch (err) {
                console.error(err);
                showToast("Network error");
            }
        }

        async function deleteCategory(id) {
            if (!confirm("Delete this category? This cannot be undone.")) return;
            try {
                const res = await fetch(`/api/categories/${id}`, {
                    method: "DELETE",
                    credentials: "same-origin"
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok) {
                    showToast(data.message || "Cannot delete");
                    return;
                }
                showToast("Category deleted");
                await loadCategories();
            } catch (err) {
                showToast("Network error");
            }
        }

        function toggleSidebar() {
            document.getElementById("sidebar").classList.toggle("open");
            document.getElementById("mobileOverlay").classList.toggle("show");
        }
        function closeSidebar() {
            document.getElementById("sidebar").classList.remove("open");
            document.getElementById("mobileOverlay").classList.remove("show");
        }

        function initializeTheme() {
            const saved = localStorage.getItem("campuscoin-theme");
            if (saved === "dark") {
                document.documentElement.classList.replace("light", "dark");
                document.body.classList.remove("light-mesh");
                document.body.classList.add("dark-mesh");
            }
            updateThemeIcon();
        }
        function toggleTheme() {
            const isDark = document.documentElement.classList.contains("dark");
            if (isDark) {
                document.documentElement.classList.replace("dark", "light");
                document.body.classList.remove("dark-mesh");
                document.body.classList.add("light-mesh");
                localStorage.setItem("campuscoin-theme", "light");
            } else {
                document.documentElement.classList.replace("light", "dark");
                document.body.classList.remove("light-mesh");
                document.body.classList.add("dark-mesh");
                localStorage.setItem("campuscoin-theme", "dark");
            }
            updateThemeIcon();
        }
        function updateThemeIcon() {
            const icon = document.getElementById("themeIcon");
            const isDark = document.documentElement.classList.contains("dark");
            icon.className = isDark ? "fa-solid fa-sun text-amber-300" : "fa-solid fa-moon";
        }

        function showToast(msg) {
            const c = document.getElementById("toastContainer");
            const t = document.createElement("div");
            t.className = "toast ios-glass font-bold text-xs";
            t.innerHTML = `<i class="fa-solid fa-circle-info text-purple-600"></i> ${msg}`;
            c.appendChild(t);
            setTimeout(() => { t.style.opacity = "0"; setTimeout(() => t.remove(), 300); }, 2500);
        }
    </script>
    <script src="/js/cc-header-widgets.js" asp-append-version="true"></script>
</body>
</html>

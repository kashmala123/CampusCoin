@{
    Layout = null;
    ViewData["Title"] = "Transactions - CampusCoin Admin";
}
<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <link rel="stylesheet" href="/css/admin-theme.css" />
    <link rel="stylesheet" href="/css/cc-animations.css" />

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <link rel="apple-touch-icon" href="/favicon.svg?v=4" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: { brand: { 50:'#f6effc', 100:'#ede4f6', 400:'#a486e0', 500:'#8b58b8', 600:'#6b3a92' } },
                    fontFamily: { sans: ['Plus Jakarta Sans','-apple-system','BlinkMacSystemFont','Inter','Segoe UI','Roboto','sans-serif'] }
                }
            }
        };
    </script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        * {
            transition: background-color 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease, color 0.3s ease;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            min-height: 100vh;
            background-color: #fbf6f0;
            background-image: radial-gradient(at 0% 0%, rgba(237, 228, 246, 0.9) 0px, transparent 50%), radial-gradient(at 100% 0%, rgba(196, 174, 224, 0.85) 0px, transparent 50%), radial-gradient(at 100% 100%, rgba(255, 225, 230, 0.85) 0px, transparent 50%), radial-gradient(at 0% 100%, rgba(246, 239, 252, 0.9) 0px, transparent 50%), radial-gradient(at 50% 50%, rgba(212, 243, 228, 0.4) 0px, transparent 50%);
            background-attachment: fixed;
        }

            body.dark-mesh {
                background-color: #100a1a;
                background-image: radial-gradient(at 10% 10%, rgba(99, 102, 241, 0.28) 0px, transparent 50%), radial-gradient(at 90% 10%, rgba(168, 85, 247, 0.22) 0px, transparent 50%), radial-gradient(at 90% 90%, rgba(107, 58, 146, 0.28) 0px, transparent 50%), radial-gradient(at 10% 90%, rgba(236, 72, 153, 0.2) 0px, transparent 50%);
                background-attachment: fixed;
            }

        .orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(80px);
            z-index: -1;
            pointer-events: none;
            animation: floatOrb 18s infinite alternate ease-in-out;
        }

        .orb-1 {
            width: 450px;
            height: 450px;
            background: rgba(192, 132, 252, 0.4);
            top: -100px;
            left: -100px;
        }

        .orb-2 {
            width: 480px;
            height: 480px;
            background: rgba(139, 88, 184, 0.45);
            top: 30%;
            right: -120px;
            animation-delay: -5s;
        }

        .orb-3 {
            width: 400px;
            height: 400px;
            background: rgba(251, 113, 133, 0.35);
            bottom: -100px;
            left: 20%;
            animation-delay: -10s;
        }

        @@keyframes floatOrb {
            0% {
                transform: translate(0px, 0px) scale(1);
            }

            50% {
                transform: translate(40px, 60px) scale(1.08);
            }

            100% {
                transform: translate(-30px, 30px) scale(0.95);
            }
        }

        .ios-glass {
            backdrop-filter: blur(32px) saturate(240%);
            -webkit-backdrop-filter: blur(32px) saturate(240%);
            position: relative;
            overflow: hidden;
        }

        .light .ios-glass {
            background: rgba(255,255,255,.72);
            border: 1.5px solid rgba(255,255,255,.95);
            box-shadow: 0 20px 40px -12px rgba(107,58,146,.12), 0 4px 16px -2px rgba(0,0,0,.04);
            color: #0f172a;
        }

        .dark .ios-glass {
            background: rgba(18,24,38,.58);
            border: 1px solid rgba(255,255,255,.15);
            box-shadow: 0 25px 50px -12px rgba(0,0,0,.45);
            color: #f8fafc;
        }

        .ios-glass-interactive {
            transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease, background 0.35s ease;
        }

            .ios-glass-interactive:hover {
                transform: translateY(-4px);
            }

        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(150, 150, 150, 0.3);
            border-radius: 999px;
        }

        .sidebar {
            position: fixed;
            top: 20px;
            left: 20px;
            bottom: 20px;
            width: 260px;
            z-index: 100;
            border-radius: 30px;
            padding: 18px;
            display: flex;
            flex-direction: column;
            transform: translateX(0);
            transition: transform .35s ease;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 4px 6px 22px;
        }

        .brand-logo {
            width: 46px;
            height: 46px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
            background: linear-gradient(135deg, #a486e0, #8b58b8, #6366f1);
            box-shadow: 0 12px 25px rgba(107, 58, 146, .28);
        }

        .brand-name {
            font-size: 18px;
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        .brand-sub {
            font-size: 9px;
            font-weight: 800;
            letter-spacing: .16em;
            opacity: .45;
            margin-top: 3px;
        }

        .nav-section {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: .15em;
            font-weight: 800;
            opacity: .4;
            padding: 14px 10px 7px;
        }

        .nav {
            flex: 1;
            overflow-y: auto;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 12px;
            margin: 4px 0;
            border-radius: 15px;
            text-decoration: none;
            color: inherit;
            font-size: 12px;
            font-weight: 650;
            transition: all .25s ease;
        }

            .nav-link i {
                width: 20px;
                text-align: center;
                opacity: .55;
            }

            .nav-link:hover {
                background: rgba(255,255,255,.30);
                transform: translateX(3px);
            }

        .dark .nav-link:hover {
            background: rgba(255,255,255,.06);
        }

        .nav-link.active {
            color: #6b3a92;
            background: linear-gradient(135deg, rgba(139,88,184,.18), rgba(99,102,241,.14));
            box-shadow: inset 0 0 0 1px rgba(139,88,184,.15), 0 10px 25px rgba(107,58,146,.08);
        }

        .dark .nav-link.active {
            color: #c4aee0;
            background: rgba(139,88,184,.10);
        }

        .admin-mini {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 11px;
            border-radius: 18px;
            background: rgba(255,255,255,.30);
            border: 1px solid rgba(255,255,255,.35);
        }

        .dark .admin-mini {
            background: rgba(255,255,255,.04);
            border-color: rgba(255,255,255,.08);
        }

        .admin-avatar {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 11px;
            font-weight: 800;
            background: linear-gradient(135deg, #8b58b8, #6366f1);
        }

        .main {
            margin-left: 300px;
            padding: 20px 25px 40px 0;
            min-height: 100vh;
        }

        .topbar {
            height: 70px;
            border-radius: 25px;
            padding: 10px 13px;
            display: flex;
            align-items: center;
            gap: 12px;
            position: sticky;
            top: 20px;
            z-index: 80;
        }

        .search {
            flex: 1;
            max-width: 500px;
            position: relative;
        }

            .search i {
                position: absolute;
                left: 16px;
                top: 50%;
                transform: translateY(-50%);
                opacity: .4;
                font-size: 12px;
            }

            .search input {
                width: 100%;
                border: none;
                outline: none;
                padding: 11px 15px 11px 42px;
                border-radius: 16px;
                background: rgba(255,255,255,.38);
                color: inherit;
                font-size: 12px;
                border: 1px solid rgba(255,255,255,.50);
            }

        .dark .search input {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-left: auto;
        }

        .action-btn {
            width: 40px;
            height: 40px;
            min-width: 40px;
            border-radius: 14px;
            border: 1px solid rgba(255,255,255,.55);
            background: rgba(255,255,255,.36);
            color: inherit;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .dark .action-btn {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .action-btn:hover {
            transform: translateY(-2px);
            background: rgba(255,255,255,.65);
        }

        .page-header {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 20px;
            margin: 28px 3px 20px;
        }

        .eyebrow {
            color: #6b3a92;
            font-size: 9px;
            font-weight: 850;
            text-transform: uppercase;
            letter-spacing: .18em;
            margin-bottom: 8px;
        }

        .page-title {
            font-size: clamp(28px, 3vw, 40px);
            font-weight: 900;
            letter-spacing: -1.8px;
            line-height: 1;
        }

        .page-description {
            font-size: 12px;
            opacity: .48;
            margin-top: 8px;
        }

        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
        }

        .kpi {
            min-height: 140px;
            padding: 19px;
            border-radius: 25px;
            position: relative;
            overflow: hidden;
        }

        .kpi-icon {
            width: 40px;
            height: 40px;
            border-radius: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(139,88,184,.13);
            color: #6b3a92;
            margin-bottom: 13px;
        }

        .kpi-label {
            font-size: 10px;
            font-weight: 700;
            opacity: .48;
        }

        .kpi-value {
            font-size: 24px;
            font-weight: 900;
            letter-spacing: -1px;
            margin-top: 3px;
        }

        .glass-btn {
            border: 1px solid rgba(255,255,255,.55);
            background: rgba(255,255,255,.38);
            color: inherit;
            border-radius: 13px;
            padding: 8px 14px;
            font-size: 11px;
            font-weight: 750;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .dark .glass-btn {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .glass-btn:hover {
            transform: translateY(-2px);
            background: rgba(255,255,255,.65);
        }

        .primary-btn {
            color: white;
            border: none;
            background: linear-gradient(135deg, #a486e0, #8b58b8, #6366f1);
            box-shadow: 0 10px 22px rgba(107,58,146,.20);
        }

        .chart-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 15px;
            margin-top: 15px;
        }

        .chart-card {
            border-radius: 27px;
            padding: 20px;
            min-height: 300px;
        }

        .chart-title {
            font-size: 14px;
            font-weight: 850;
        }

        .chart-sub {
            font-size: 9px;
            opacity: .45;
            margin-top: 3px;
        }

        .table-panel {
            border-radius: 27px;
            padding: 20px;
            margin-top: 15px;
        }

        .filters-bar {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 15px;
        }

        .filter-group {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            align-items: center;
        }

        .select, .input-field {
            border: 1px solid rgba(255,255,255,.55);
            background: rgba(255,255,255,.38);
            color: inherit;
            border-radius: 12px;
            padding: 8px 12px;
            outline: none;
            font-size: 11px;
        }

        .dark .select, .dark .input-field {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            padding: 10px 8px;
            text-align: left;
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: .08em;
            opacity: .4;
            white-space: nowrap;
        }

        td {
            padding: 12px 8px;
            border-top: 1px solid rgba(148,163,184,.12);
            font-size: 11px;
            white-space: nowrap;
        }

        .modal-overlay {
            position: fixed;
            inset: 0;
            z-index: 300;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(15,23,42,0.4);
            backdrop-filter: blur(8px);
            opacity: 0;
            pointer-events: none;
            transition: all 0.3s ease;
        }

            .modal-overlay.active {
                opacity: 1;
                pointer-events: auto;
            }

        .modal-card {
            width: 100%;
            max-width: 500px;
            border-radius: 28px;
            padding: 24px;
            transform: scale(0.95);
            transition: all 0.3s ease;
        }

        .modal-overlay.active .modal-card {
            transform: scale(1);
        }

        #toastContainer {
            position: fixed;
            right: 20px;
            bottom: 20px;
            z-index: 999;
            display: flex;
            flex-direction: column;
            gap: 9px;
        }

        .toast {
            min-width: 270px;
            padding: 13px;
            border-radius: 17px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .mobile-btn {
            display: none;
        }

        .mobile-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15,23,42,.25);
            backdrop-filter: blur(5px);
            z-index: 90;
        }

            .mobile-overlay.show {
                display: block;
            }

        @@media(max-width:1100px) {
            .kpi-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .chart-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media(max-width:950px) {
            .sidebar {
                transform: translateX(-120%);
            }

                .sidebar.open {
                    transform: translateX(0);
                }

            .main {
                margin-left: 0;
                padding: 15px;
            }

            .mobile-btn {
                display: flex;
            }
        }

        @@media(max-width:640px) {
            .kpi-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
    <link rel="stylesheet" href="/css/cc-header-widgets.css" asp-append-version="true" />
</head>

<body class="light-mesh min-h-screen text-slate-900 dark:text-slate-100 font-sans">

    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>

    <div id="mobileOverlay" class="mobile-overlay" onclick="closeSidebar()"></div>

    <!-- SIDEBAR -->
    <aside id="sidebar" class="sidebar ios-glass">
                <div class="brand cc-brand-block">
            <div class="brand-logo cc-brand-mark" aria-hidden="true">
                <svg viewBox="0 0 44 44" width="36" height="36" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="ccCoinBG_ad" x1="0" y1="0" x2="44" y2="44" gradientUnits="userSpaceOnUse">
                            <stop offset="0" stop-color="#6b3a92"/><stop offset="1" stop-color="#241232"/>
                        </linearGradient>
                        <linearGradient id="ccCoinAccent_ad" x1="10" y1="10" x2="34" y2="34" gradientUnits="userSpaceOnUse">
                            <stop offset="0" stop-color="#d4ff3d"/><stop offset="1" stop-color="#10b981"/>
                        </linearGradient>
                    </defs>
                    <circle cx="22" cy="22" r="21" fill="url(#ccCoinBG_ad)"/>
                    <circle cx="22" cy="22" r="16.5" fill="none" stroke="rgba(255,255,255,.2)" stroke-width="1" stroke-dasharray="1.5 3"/>
                    <path d="M28.5 15c-1.9-2.2-4.7-3.5-7.8-3.5-5.8 0-10.5 4.7-10.5 10.5s4.7 10.5 10.5 10.5c3.1 0 5.9-1.3 7.8-3.5" stroke="url(#ccCoinAccent_ad)" stroke-width="2.6" stroke-linecap="round" fill="none"/>
                    <path d="M31 12c0 2.2-1.3 3.5-3.5 3.5 2.2 0 3.5 1.3 3.5 3.5 0-2.2 1.3-3.5 3.5-3.5-2.2 0-3.5-1.3-3.5-3.5z" fill="#d4ff3d"/>
                </svg>
            </div>
            <div>
                <div class="brand-name cc-brand-title"><b>Cash</b><span>Campus</span></div>
                <div class="brand-sub">ADMIN CONSOLE</div>
            </div>
        </div>

                <nav class="nav">
            <div class="nav-section">Overview</div>
            <a href="/Admin/Index" class="nav-link"><i class="fa-solid fa-chart-line"></i><span>Dashboard</span></a>
            <a href="/Admin/Students" class="nav-link"><i class="fa-solid fa-user-graduate"></i><span>Students</span></a>
            <a href="/Admin/Transactions" class="nav-link active"><i class="fa-solid fa-arrow-right-arrow-left"></i><span>Transactions</span></a>
            <a href="/Admin/VoucherManagement" class="nav-link"><i class="fa-solid fa-receipt"></i><span>Voucher Management</span></a>
            <div class="nav-section">Financial Management</div>
            <a href="/Admin/Categories" class="nav-link"><i class="fa-solid fa-layer-group"></i><span>Categories</span></a>
            <a href="/Admin/Budgets" class="nav-link"><i class="fa-solid fa-wallet"></i><span>Budgets</span></a>
            <a href="/Admin/EventManager" class="nav-link"><i class="fa-solid fa-calendar-days"></i><span>Event Manager</span></a>
            <a href="/Admin/SavingGoals" class="nav-link"><i class="fa-solid fa-bullseye"></i><span>Saving Goals</span></a>
            <div class="nav-section">System</div>
            <a href="/Admin/Notifications" class="nav-link"><i class="fa-solid fa-bell"></i><span>Notifications</span></a>
            <a href="/Admin/Reports" class="nav-link"><i class="fa-solid fa-chart-pie"></i><span>Reports & Analytics</span></a>
            <a href="/Admin/HomepageCms" class="nav-link"><i class="fa-solid fa-pager"></i><span>Homepage CMS</span></a>
            <a href="/Admin/Settings" class="nav-link"><i class="fa-solid fa-sliders"></i><span>Settings</span></a>
        </nav>

        <div class="admin-mini">
            <div class="admin-avatar">AK</div>
            <div class="flex-1 min-w-0">
                <div class="text-[11px] font-bold">Admin</div>
                <div class="text-[9px] opacity-45">System Administrator</div>
            </div>
        </div>
        <a href="/Auth/Logout" style="display:flex;align-items:center;gap:10px;padding:10px 12px;margin-top:8px;border-radius:12px;font-size:13px;font-weight:700;color:#e11d48;text-decoration:none;">
            <i class="fa-solid fa-right-from-bracket"></i> Logout
        </a>
    </aside>

    <!-- MAIN -->
    <main class="main">
        <header class="topbar ios-glass">
            <button class="action-btn mobile-btn" onclick="toggleSidebar()"><i class="fa-solid fa-bars"></i></button>

            <div class="search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input id="globalSearch" type="text" placeholder="Search by ID, Student, or Category..." autocomplete="off">
            </div>

            <div class="top-actions">
                <button class="glass-btn primary-btn" onclick="loadTransactions()">
                    <i class="fa-solid fa-rotate"></i>
                    <span class="hidden sm:inline ml-1">Refresh</span>
                </button>
                <button class="action-btn" onclick="toggleTheme()"><i id="themeIcon" class="fa-solid fa-moon"></i></button>
                <div class="dropdown-wrap" style="position:relative;">
                    <button type="button" class="action-btn" onclick="toggleDropdown('profileDropdown')" title="Account" style="display:inline-flex;align-items:center;gap:8px;padding:0 12px 0 6px;width:auto;min-width:auto;height:40px;border-radius:12px;">
                        <span style="width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,#a486e0,#6366f1);color:#fff;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;">AD</span>
                        <span class="hidden sm:inline" style="font-size:12px;font-weight:700;">Admin</span>
                        <i class="fa-solid fa-chevron-down" style="font-size:9px;opacity:.5;"></i>
                    </button>
                    <div id="profileDropdown" class="dropdown" style="display:none !important;position:absolute;right:0;top:calc(100% + 10px);min-width:200px;z-index:99999;padding:8px;border-radius:16px;background:#fff;border:1px solid rgba(22,11,33,.1);box-shadow:0 18px 40px rgba(22,11,33,.14);">
                        <a href="/Admin/Settings" class="dropdown-item" style="display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;font-size:13px;font-weight:600;text-decoration:none;color:inherit;"><i class="fa-regular fa-user"></i> My Profile</a>
                        <a href="/Admin/Settings" class="dropdown-item" style="display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;font-size:13px;font-weight:600;text-decoration:none;color:inherit;"><i class="fa-solid fa-gear"></i> Settings</a>
                        <button type="button" onclick="logoutAdmin()" class="dropdown-item" style="display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;font-size:13px;font-weight:600;width:100%;border:0;background:transparent;cursor:pointer;color:#e11d48;"><i class="fa-solid fa-right-from-bracket"></i> Logout</button>
                    </div>
                </div>
            </div>
        </header>

        <section class="page-header">
            <div>
                <div class="eyebrow">CampusCoin / Financial Management</div>
                <h1 class="page-title">Transactions</h1>
                <p class="page-description">Track, audit and manage student transactions across the platform.</p>
            </div>
            <button class="glass-btn" onclick="exportCSV()">
                <i class="fa-solid fa-file-csv text-purple-600"></i> Export CSV
            </button>
        </section>

        <section class="kpi-grid">
            <div class="kpi ios-glass ios-glass-interactive">
                <div class="kpi-icon"><i class="fa-solid fa-receipt"></i></div>
                <div class="kpi-label">Total Volume</div>
                <div class="kpi-value" id="kpiTotalVolume">Rs. 0</div>
                <div class="text-[9px] font-bold text-purple-700 dark:text-purple-400 mt-1"><i class="fa-solid fa-arrow-trend-up"></i> Live system sync</div>
            </div>
            <div class="kpi ios-glass ios-glass-interactive">
                <div class="kpi-icon"><i class="fa-solid fa-arrow-down-long text-emerald-500"></i></div>
                <div class="kpi-label">Total Inflow</div>
                <div class="kpi-value text-emerald-600 dark:text-emerald-400" id="kpiInflow">Rs. 0</div>
                <div class="text-[9px] font-bold text-emerald-600 dark:text-emerald-400 mt-1">Credits &amp; Deposits</div>
            </div>
            <div class="kpi ios-glass ios-glass-interactive">
                <div class="kpi-icon"><i class="fa-solid fa-arrow-up-long text-rose-500"></i></div>
                <div class="kpi-label">Total Outflow</div>
                <div class="kpi-value text-rose-600 dark:text-rose-400" id="kpiOutflow">Rs. 0</div>
                <div class="text-[9px] font-bold text-rose-600 dark:text-rose-400 mt-1">Expenses &amp; Purchases</div>
            </div>
            <div class="kpi ios-glass ios-glass-interactive">
                <div class="kpi-icon"><i class="fa-solid fa-list text-amber-500"></i></div>
                <div class="kpi-label">Total Records</div>
                <div class="kpi-value" id="kpiCount">0</div>
                <div class="text-[9px] font-bold text-amber-600 dark:text-amber-400 mt-1">All transactions</div>
            </div>
        </section>

        <section class="chart-grid">
            <div class="chart-card ios-glass">
                <div class="chart-header mb-4">
                    <div class="chart-title">Income vs Expense Trend</div>
                    <div class="chart-sub">Last 6 months</div>
                </div>
                <div class="h-[220px] relative"><canvas id="txTrendChart"></canvas></div>
            </div>
            <div class="chart-card ios-glass">
                <div class="chart-header mb-4">
                    <div class="chart-title">Type Breakdown</div>
                    <div class="chart-sub">Income vs Expense ratio</div>
                </div>
                <div class="h-[220px] relative"><canvas id="txStatusChart"></canvas></div>
            </div>
        </section>

        <section class="table-panel ios-glass">
            <div class="filters-bar">
                <div class="filter-group">
                    <select id="typeFilter" class="select" onchange="applyFilters()">
                        <option value="All">All Types</option>
                        <option value="Income">Income</option>
                        <option value="Expense">Expense</option>
                    </select>
                    <select id="categoryFilter" class="select" onchange="applyFilters()">
                        <option value="All">All Categories</option>
                    </select>
                    <select id="sortBy" class="select" onchange="applyFilters()">
                        <option value="newest">Newest First</option>
                        <option value="oldest">Oldest First</option>
                        <option value="highest">Highest Amount</option>
                        <option value="lowest">Lowest Amount</option>
                    </select>
                </div>
                <div class="flex items-center gap-2 px-3 py-2 rounded-xl bg-purple-600/10 text-sky-700 dark:text-sky-300 text-xs font-bold">
                    <i class="fa-solid fa-database"></i>
                    <span id="tableCount">0 records</span>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table>
                    <thead>
                        <tr>
                            <th>Tx ID</th>
                            <th>Student</th>
                            <th>Category</th>
                            <th>Date</th>
                            <th>Amount</th>
                            <th>Type</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="transactionTableBody"></tbody>
                </table>
            </div>

            <div class="flex flex-col sm:flex-row justify-between items-center gap-4 mt-6 pt-4 border-t border-slate-500/10">
                <div class="text-xs opacity-50" id="paginationInfo">Loading...</div>
                <div class="flex gap-2" id="paginationBtns"></div>
            </div>
        </section>
    </main>

    <!-- VIEW DETAILS MODAL -->
    <div id="viewModal" class="modal-overlay">
        <div class="modal-card ios-glass">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-base font-bold">Transaction Details</h3>
                <button onclick="closeViewModal()" class="w-8 h-8 rounded-full flex items-center justify-center bg-slate-500/10"><i class="fa-solid fa-xmark text-xs"></i></button>
            </div>
            <div id="viewDetailsBody" class="space-y-3 text-xs"></div>
            <div class="pt-4 flex justify-end">
                <button onclick="closeViewModal()" class="glass-btn primary-btn">Close</button>
            </div>
        </div>
    </div>

    <!-- EDIT MODAL -->
    <div id="editModal" class="modal-overlay">
        <div class="modal-card ios-glass">
            <div class="flex justify-between items-center mb-5">
                <h3 class="text-base font-bold">Edit Transaction</h3>
                <button onclick="closeEditModal()" class="w-8 h-8 rounded-full flex items-center justify-center bg-slate-500/10">
                    <i class="fa-solid fa-xmark text-xs"></i>
                </button>
            </div>
            <form onsubmit="saveEditTx(event)" class="space-y-4">
                <input type="hidden" id="editTxId">
                <div>
                    <label class="block text-[10px] font-bold uppercase opacity-60 mb-1">Amount (Rs.)</label>
                    <input type="number" step="0.01" id="editAmount" required class="input-field w-full" placeholder="0.00">
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-[10px] font-bold uppercase opacity-60 mb-1">Type</label>
                        <select id="editType" class="select w-full" required>
                            <option value="Expense">Expense</option>
                            <option value="Income">Income</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold uppercase opacity-60 mb-1">Date</label>
                        <input type="date" id="editDate" required class="input-field w-full">
                    </div>
                </div>
                <div>
                    <label class="block text-[10px] font-bold uppercase opacity-60 mb-1">Category</label>
                    <select id="editCategory" class="select w-full" required>
                        <option value="0">— Select —</option>
                    </select>
                </div>
                <div class="flex gap-2 justify-end pt-4">
                    <button type="button" onclick="closeEditModal()" class="glass-btn">Cancel</button>
                    <button type="submit" class="glass-btn primary-btn">Update</button>
                </div>
            </form>
        </div>
    </div>

    <div id="toastContainer"></div>

    <script>
        let transactions = [];
        let filteredData = [];
        let currentPage = 1;
        const itemsPerPage = 10;
        let trendChart = null;
        let statusChart = null;
        let categoriesCache = [];
        const API = "/api/admin/transactions";
        const CAT_API = "/api/admin/categories";

        document.addEventListener("DOMContentLoaded", async () => {
            initializeTheme();
            await loadCategories();
            await loadTransactions();
            document.getElementById("globalSearch").addEventListener("input", () => {
                currentPage = 1;
                applyFilters();
            });
        });

        async function loadCategories() {
            try {
                const r = await fetch(CAT_API, { credentials: "same-origin" });
                categoriesCache = await r.json();
                const sel = document.getElementById("categoryFilter");
                sel.innerHTML = '<option value="All">All Categories</option>';
                categoriesCache.forEach(c => {
                    const name = c.name || c.Name;
                    const o = document.createElement("option");
                    o.value = name;
                    o.textContent = name;
                    sel.appendChild(o);
                });
            } catch (e) { console.error(e); }
        }

        async function loadTransactions() {
            try {
                const r = await fetch(API, { credentials: "same-origin" });
                if (!r.ok) throw new Error(`HTTP ${r.status}`);
                const data = await r.json();
                transactions = data.transactions || [];
                updateKPIs(data.summary || {});
                applyFilters();
                initCharts();
            } catch (e) { showToast("Load failed: " + e.message); }
        }

        function updateKPIs(s) {
            const vol = (Number(s.totalIncome || 0) + Number(s.totalExpense || 0));
            document.getElementById("kpiTotalVolume").textContent = "$" + fmt(vol);
            document.getElementById("kpiInflow").textContent = "$" + fmt(s.totalIncome || 0);
            document.getElementById("kpiOutflow").textContent = "$" + fmt(s.totalExpense || 0);
            document.getElementById("kpiCount").textContent = s.totalCount || 0;
        }

        function fmt(n) {
            return Number(n || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function applyFilters() {
            const search = document.getElementById("globalSearch").value.toLowerCase().trim();
            const typeVal = document.getElementById("typeFilter").value;
            const categoryVal = document.getElementById("categoryFilter").value;
            const sortBy = document.getElementById("sortBy").value;

            filteredData = transactions.filter(t => {
                const matchSearch = !search ||
                    (t.studentName || "").toLowerCase().includes(search) ||
                    (t.category || "").toLowerCase().includes(search) ||
                    (t.studentId || "").toLowerCase().includes(search) ||
                    String(t.id).includes(search);
                const matchType = typeVal === "All" || t.type === typeVal;
                const matchCat = categoryVal === "All" || t.category === categoryVal;
                return matchSearch && matchType && matchCat;
            });

            filteredData.sort((a, b) => {
                if (sortBy === "newest") return new Date(b.date) - new Date(a.date);
                if (sortBy === "oldest") return new Date(a.date) - new Date(b.date);
                if (sortBy === "highest") return b.amount - a.amount;
                if (sortBy === "lowest") return a.amount - b.amount;
                return 0;
            });

            currentPage = 1;
            renderTable();
        }

        function renderTable() {
            const tbody = document.getElementById("transactionTableBody");
            tbody.innerHTML = "";

            const total = filteredData.length;
            const startIdx = (currentPage - 1) * itemsPerPage;
            const paginated = filteredData.slice(startIdx, startIdx + itemsPerPage);

            document.getElementById("tableCount").innerText = `${total} records`;

            if (!paginated.length) {
                tbody.innerHTML = `<tr><td colspan="7" class="text-center py-8 opacity-40">
                    <i class="fa-solid fa-folder-open text-2xl mb-2"></i>
                    <div>No transactions found</div>
                </td></tr>`;
            } else {
                paginated.forEach(tx => {
                    const isIncome = tx.type === "Income";
                    const amtClass = isIncome ? "text-emerald-500 font-bold" : "text-rose-500 font-bold";
                    const amtPrefix = isIncome ? "+$" : "-$";

                    const row = document.createElement("tr");
                    row.innerHTML = `
                        <td class="font-mono text-[10px] opacity-70">TX-${tx.id}</td>
                        <td>
                            <div class="flex items-center gap-2">
                                <div class="w-7 h-7 rounded-lg bg-purple-600/10 text-purple-600 font-bold flex items-center justify-center text-[10px]">${tx.initials || "??"}</div>
                                <div>
                                    <div class="font-semibold">${tx.studentName}</div>
                                    <div class="text-[9px] opacity-50">${tx.studentId || ""}</div>
                                </div>
                            </div>
                        </td>
                        <td>${tx.category}</td>
                        <td class="opacity-70">${tx.date}</td>
                        <td class="${amtClass}">${amtPrefix}${fmt(tx.amount)}</td>
                        <td>
                            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full ${isIncome ? 'bg-emerald-500/10 text-emerald-500' : 'bg-rose-500/10 text-rose-500'}">${tx.type}</span>
                        </td>
                        <td class="text-right space-x-1">
                            <button onclick="viewTransaction(${tx.id})" class="p-1.5 rounded-lg hover:bg-slate-500/10 text-purple-600" title="View">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                            <button onclick="editTx(${tx.id})" class="p-1.5 rounded-lg hover:bg-slate-500/10 text-amber-500" title="Edit">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </button>
                            <button onclick="deleteTransaction(${tx.id})" class="p-1.5 rounded-lg hover:bg-slate-500/10 text-rose-500" title="Delete">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </td>`;
                    tbody.appendChild(row);
                });
            }

            renderPagination(total);
        }

        function renderPagination(total) {
            const totalPages = Math.ceil(total / itemsPerPage) || 1;
            document.getElementById("paginationInfo").textContent = `Showing ${total ? ((currentPage - 1) * itemsPerPage) + 1 : 0} to ${Math.min(currentPage * itemsPerPage, total)} of ${total}`;

            const container = document.getElementById("paginationBtns");
            container.innerHTML = "";

            const prevBtn = document.createElement("button");
            prevBtn.className = "glass-btn py-1 px-3";
            prevBtn.disabled = currentPage === 1;
            prevBtn.innerHTML = `<i class="fa-solid fa-chevron-left"></i>`;
            prevBtn.onclick = () => { currentPage--; renderTable(); };
            container.appendChild(prevBtn);

            const maxBtns = 5;
            let start = Math.max(1, currentPage - 2);
            let end = Math.min(totalPages, start + maxBtns - 1);
            if (end - start < maxBtns - 1) start = Math.max(1, end - maxBtns + 1);

            for (let i = start; i <= end; i++) {
                const btn = document.createElement("button");
                btn.className = `glass-btn py-1 px-3 ${i === currentPage ? 'primary-btn' : ''}`;
                btn.textContent = i;
                btn.onclick = () => { currentPage = i; renderTable(); };
                container.appendChild(btn);
            }

            const nextBtn = document.createElement("button");
            nextBtn.className = "glass-btn py-1 px-3";
            nextBtn.disabled = currentPage === totalPages;
            nextBtn.innerHTML = `<i class="fa-solid fa-chevron-right"></i>`;
            nextBtn.onclick = () => { currentPage++; renderTable(); };
            container.appendChild(nextBtn);
        }

        async function deleteTransaction(id) {
            if (!confirm("Delete this transaction?")) return;
            try {
                const r = await fetch(`${API}/${id}`, { method: "DELETE", credentials: "same-origin" });
                const d = await r.json().catch(() => ({}));
                if (!r.ok) throw new Error(d.message || `HTTP ${r.status}`);
                await loadTransactions();
                showToast("Transaction removed");
            } catch (e) { showToast("Delete failed: " + e.message); }
        }

        async function editTx(id) {
            const tx = transactions.find(t => t.id === id);
            if (!tx) return;

            document.getElementById("editTxId").value = tx.id;
            document.getElementById("editAmount").value = tx.amount;
            document.getElementById("editType").value = tx.type;
            document.getElementById("editDate").value = tx.date;

            const sel = document.getElementById("editCategory");
            sel.innerHTML = '<option value="0">— Select —</option>';
            categoriesCache.forEach(c => {
                const name = c.name || c.Name;
                const catId = c.categoryId || c.CategoryId;
                const o = document.createElement("option");
                o.value = catId;
                o.textContent = name;
                if (name === tx.category) o.selected = true;
                sel.appendChild(o);
            });

            document.getElementById("editModal").classList.add("active");
        }

        function closeEditModal() {
            document.getElementById("editModal").classList.remove("active");
        }

        async function saveEditTx(e) {
            e.preventDefault();
            const id = document.getElementById("editTxId").value;
            const payload = {
                amount: Number(document.getElementById("editAmount").value),
                type: document.getElementById("editType").value,
                categoryId: Number(document.getElementById("editCategory").value),
                date: document.getElementById("editDate").value
            };

            try {
                const r = await fetch(`${API}/${id}`, {
                    method: "PUT",
                    headers: { "Content-Type": "application/json" },
                    credentials: "same-origin",
                    body: JSON.stringify(payload)
                });
                const d = await r.json().catch(() => ({}));
                if (!r.ok) throw new Error(d.message || `HTTP ${r.status}`);
                closeEditModal();
                await loadTransactions();
                showToast("Transaction updated");
            } catch (err) { showToast("Update failed: " + err.message); }
        }

        function viewTransaction(id) {
            const tx = transactions.find(t => t.id === id);
            if (!tx) return;

            document.getElementById("viewDetailsBody").innerHTML = `
                <div class="flex justify-between border-b border-slate-500/10 pb-2">
                    <span class="opacity-50">Transaction ID:</span>
                    <span class="font-mono font-bold">TX-${tx.id}</span>
                </div>
                <div class="flex justify-between border-b border-slate-500/10 pb-2">
                    <span class="opacity-50">Student:</span>
                    <span class="font-semibold">${tx.studentName}</span>
                </div>
                <div class="flex justify-between border-b border-slate-500/10 pb-2">
                    <span class="opacity-50">Email:</span>
                    <span>${tx.studentEmail || "—"}</span>
                </div>
                <div class="flex justify-between border-b border-slate-500/10 pb-2">
                    <span class="opacity-50">Category:</span>
                    <span>${tx.category}</span>
                </div>
                <div class="flex justify-between border-b border-slate-500/10 pb-2">
                    <span class="opacity-50">Amount:</span>
                    <span class="font-bold ${tx.type === 'Income' ? 'text-emerald-500' : 'text-rose-500'}">Rs. ${fmt(tx.amount)}</span>
                </div>
                <div class="flex justify-between border-b border-slate-500/10 pb-2">
                    <span class="opacity-50">Type:</span>
                    <span>${tx.type}</span>
                </div>
                <div class="flex justify-between pb-2">
                    <span class="opacity-50">Date:</span>
                    <span>${tx.date}</span>
                </div>`;
            document.getElementById("viewModal").classList.add("active");
        }

        function closeViewModal() {
            document.getElementById("viewModal").classList.remove("active");
        }

        function exportCSV() {
            if (!filteredData.length) { showToast("No data to export"); return; }
            let csv = "ID,Student,StudentID,Email,Category,Date,Amount,Type\n";
            filteredData.forEach(t => {
                csv += `"TX-${t.id}","${t.studentName}","${t.studentId || ''}","${t.studentEmail || ''}","${t.category}","${t.date}",${t.amount},"${t.type}"\n`;
            });
            const blob = new Blob([csv], { type: "text/csv" });
            const url = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = url;
            a.download = `campuscoin-transactions-${new Date().toISOString().split("T")[0]}.csv`;
            a.click();
            URL.revokeObjectURL(url);
            showToast("Exported " + filteredData.length + " transactions");
        }

        function initCharts() {
            if (trendChart || statusChart) {
                trendChart?.destroy();
                statusChart?.destroy();
            }

            const months = {};
            transactions.forEach(t => {
                const m = (t.date || "").substring(0, 7);
                if (!m) return;
                if (!months[m]) months[m] = { income: 0, expense: 0 };
                if (t.type === "Income") months[m].income += Number(t.amount);
                else months[m].expense += Number(t.amount);
            });

            const sortedMonths = Object.keys(months).sort().slice(-6);
            const labels = sortedMonths.map(m => {
                const d = new Date(m + "-01");
                return d.toLocaleString("en", { month: "short" });
            });

            const incomeArr = sortedMonths.map(m => months[m].income);
            const expenseArr = sortedMonths.map(m => months[m].expense);

            const grid = document.documentElement.classList.contains("dark") ? "rgba(255,255,255,0.08)" : "rgba(0,0,0,0.06)";

            trendChart = new Chart(document.getElementById("txTrendChart"), {
                type: "line",
                data: {
                    labels: labels.length ? labels : ["No Data"],
                    datasets: [
                        { label: "Income", data: incomeArr, borderColor: "#10b981", backgroundColor: "rgba(16,185,129,.12)", fill: true, tension: 0.4 },
                        { label: "Expense", data: expenseArr, borderColor: "#f43f5e", backgroundColor: "rgba(244,63,94,.12)", fill: true, tension: 0.4 }
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { position: "bottom", labels: { font: { size: 10 } } } },
                    scales: { y: { grid: { color: grid }, beginAtZero: true }, x: { grid: { display: false } } }
                }
            });

            const incomeCount = transactions.filter(t => t.type === "Income").length;
            const expenseCount = transactions.filter(t => t.type === "Expense").length;

            statusChart = new Chart(document.getElementById("txStatusChart"), {
                type: "doughnut",
                data: {
                    labels: ["Income", "Expense"],
                    datasets: [{ data: [incomeCount, expenseCount], backgroundColor: ["#10b981", "#f43f5e"], borderWidth: 0 }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    cutout: "70%",
                    plugins: { legend: { position: "bottom", labels: { font: { size: 10 } } } }
                }
            });
        }

        function toggleTheme() {
            const html = document.documentElement;
            const icon = document.getElementById("themeIcon");
            if (html.classList.contains("dark")) {
                html.classList.remove("dark"); html.classList.add("light");
                document.body.classList.remove("dark-mesh"); document.body.classList.add("light-mesh");
                icon.className = "fa-solid fa-moon";
                localStorage.setItem("campuscoin-theme", "light");
            } else {
                html.classList.remove("light"); html.classList.add("dark");
                document.body.classList.remove("light-mesh"); document.body.classList.add("dark-mesh");
                icon.className = "fa-solid fa-sun text-amber-300";
                localStorage.setItem("campuscoin-theme", "dark");
            }
            initCharts();
        }

        function initializeTheme() {
            if (localStorage.getItem("campuscoin-theme") === "dark") {
                document.documentElement.classList.add("dark");
                document.body.classList.add("dark-mesh");
                document.getElementById("themeIcon").className = "fa-solid fa-sun text-amber-300";
            }
        }

        function toggleSidebar() {
            document.getElementById("sidebar").classList.toggle("open");
            document.getElementById("mobileOverlay").classList.toggle("show");
        }
        function closeSidebar() {
            document.getElementById("sidebar").classList.remove("open");
            document.getElementById("mobileOverlay").classList.remove("show");
        }

        function showToast(message) {
            const c = document.getElementById("toastContainer");
            const t = document.createElement("div");
            t.className = "toast ios-glass";
            t.innerHTML = `<div class="w-8 h-8 rounded-xl bg-purple-600/10 text-purple-600 flex items-center justify-center"><i class="fa-solid fa-check text-xs"></i></div><div class="text-[10px] font-bold">${message}</div>`;
            c.appendChild(t);
            setTimeout(() => t.remove(), 2500);
        }

        document.addEventListener("keydown", e => {
            if (e.key === "Escape") {
                closeViewModal();
                closeEditModal();
                closeSidebar();
            }
        });
    </script>


<script>
(function(){
  if (typeof window.toggleDropdown !== 'function') {
    window.toggleDropdown = function(id){
      const t = document.getElementById(id);
      if (!t) return;
      document.querySelectorAll('.dropdown').forEach(d => {
        if (d.id !== id) { d.classList.remove('show'); d.style.display = 'none'; }
      });
      const open = !t.classList.contains('show');
      t.classList.toggle('show', open);
      t.style.display = open ? 'block' : 'none';
    };
    document.addEventListener('click', function(e){
      if (!e.target.closest('.dropdown-wrap')) {
        document.querySelectorAll('.dropdown').forEach(d => { d.classList.remove('show'); d.style.display = 'none'; });
      }
    });
  }
  if (typeof window.logoutAdmin !== 'function') {
    window.logoutAdmin = function(){ window.location.href = '/Auth/Logout'; };
  }
  if (typeof window.quickAction !== 'function') {
    window.quickAction = function(action){
      document.querySelectorAll('.dropdown').forEach(d => { d.classList.remove('show'); d.style.display='none'; });
      const routes = {
        'Add Student': '/Admin/Students',
        'View Transactions': '/Admin/Transactions',
        'Send Notification': '/Admin/Notifications',
        'Generate Report': '/Admin/Reports'
      };
      if (routes[action]) window.location.href = routes[action];
    };
  }
})();
</script>


<script>
(function(){
  window.toggleDropdown = function(id){
    document.querySelectorAll('.dropdown').forEach(function(d){
      if(d.id !== id){ d.classList.remove('show'); d.style.setProperty('display','none','important'); }
    });
    var t = document.getElementById(id);
    if(!t) return;
    var open = !(t.classList.contains('show'));
    if(open){ t.classList.add('show'); t.style.setProperty('display','block','important'); }
    else { t.classList.remove('show'); t.style.setProperty('display','none','important'); }
  };
  document.addEventListener('click', function(e){
    if(!e.target.closest('.dropdown-wrap')){
      document.querySelectorAll('.dropdown').forEach(function(d){
        d.classList.remove('show'); d.style.setProperty('display','none','important');
      });
    }
  });
})();
</script>

</body>
</html>
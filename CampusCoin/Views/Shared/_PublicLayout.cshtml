            <!-- ────────── PAGE CONTENT ────────── -->
            @RenderBody()

            <!-- ────────── FOOTER ────────── -->
            <footer class="footer">

                <!-- Newsletter band -->
                <div class="footer-news">
                    <div class="footer-news-inner">
                        <div class="footer-news-text">
                            <span class="footer-news-pill">
                                <i class="ri-mail-send-line"></i> Monthly digest
                            </span>
                            <h3>Small money tips, <em>once a month.</em></h3>
                            <p>Real habits from real students. No spam, no lectures — just one short email a month.</p>
                        </div>


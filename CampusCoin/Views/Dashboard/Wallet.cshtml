    <!-- RECEIVE QR MODAL -->
    <div id="qrModal" class="modal-overlay" onclick="if(event.target===this) closeModal('qrModal')">
        <div class="modal-card ios-glass text-center">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-base font-extrabold"><i class="fa-solid fa-qrcode text-purple-500 mr-2"></i>Receive Money</h3>
                <button type="button" onclick="closeModal('qrModal')" class="action-btn !w-8 !h-8"><i class="fa-solid fa-xmark text-xs"></i></button>
            </div>
            <p class="text-[11px] opacity-50 mb-3">Scan this QR to get your CampusCoin wallet ID</p>
            <div id="walletQr" class="mx-auto mb-3 flex items-center justify-center p-3 rounded-2xl bg-white" style="width:200px;height:200px;"></div>
            <div class="font-mono font-bold text-sm mb-1" id="qrAccountLabel">CC-0000-PK</div>
            <div class="text-[11px] opacity-50 mb-4" id="qrNameLabel">Student</div>
            <button type="button" onclick="copyAccountId()" class="w-full py-2.5 rounded-xl font-bold text-xs text-white bg-gradient-to-r from-purple-600 to-purple-700">
                Copy Account ID
            </button>
        </div>
    </div>

    <div id="toastContainer"></div>

    <script>
        
        // ===== DYNAMIC WALLET (same UI, live API) =====
        let walletState = {
            balance: 0,
            accountId: "CC-0000-PK",
            profile: { name: "Student", initials: "ST", department: "Student" },
            notifications: [],
            transactions: []
        };
        let pendingFees = [];
        let activeCategoryFilter = "All";
        let spendingChart = null;
        let selectedTopUpMethod = "EasyPaisa";

        document.addEventListener("DOMContentLoaded", async function () {
            initializeTheme();
            initializeSearch();
            await loadWalletData();
        });

        async function loadWalletData() {
            try {
                const [sumRes, txRes] = await Promise.all([
                    fetch("/api/wallet/summary", { credentials: "same-origin" }),
                    fetch("/api/wallet/transactions", { credentials: "same-origin" })
                ]);

                if (sumRes.ok) {
                    const sum = await sumRes.json();
                    walletState.balance = sum.balance || 0;
                    walletState.accountId = sum.accountId || walletState.accountId;
                    walletState.qrPayload = sum.qrPayload || ("CAMPUSCOIN|WALLET|" + walletState.accountId);
                    const name = sum.userName || "Student";
                    const initials = name.split(" ").map(n => n[0]).join("").toUpperCase().slice(0, 2) || "ST";
                    walletState.profile = {
                        name: name,
                        initials: initials,
                        department: sum.academicYear || "Student"
                    };
                    pendingFees = sum.pendingFees || [];
                    if (sum.lowBalance) {
                        const w = document.getElementById("lowBalanceWarning");
                        if (w) w.classList.remove("hidden");
                    } else {
                        const w = document.getElementById("lowBalanceWarning");
                        if (w) w.classList.add("hidden");
                    }
                }

                if (txRes.ok) {
                    walletState.transactions = await txRes.json();
                }

                renderProfileDetails();
                updateBalanceDisplay();
                renderTransactions();
                updateAccountIdUI();
                initializeSpendingChart();
                renderNotifications();
                renderWalletQr(walletState.qrPayload || walletState.accountId);
            } catch (err) {
                console.error(err);
                showToast("Could not load wallet data");
            }
        }

        function updateAccountIdUI() {
            const el = document.getElementById("accountId");
            if (el) el.textContent = walletState.accountId;
        }

        function renderProfileDetails() {
            const set = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
            set("sidebarStudentName", walletState.profile.name);
            set("sidebarStudentRole", walletState.profile.department);
            set("sidebarAvatar", walletState.profile.initials);
            set("topStudentName", walletState.profile.name);
            set("topAvatar", walletState.profile.initials);
        }

        function updateBalanceDisplay() {
            const el = document.getElementById("walletBalance");
            if (el) el.textContent = Number(walletState.balance).toLocaleString();
            const warningBanner = document.getElementById("lowBalanceWarning");
            if (warningBanner) {
                if (walletState.balance < 2000) warningBanner.classList.remove("hidden");
                else warningBanner.classList.add("hidden");
            }
        }

        function renderTransactions(searchTerm = "") {
            const tbody = document.getElementById("txTableBody");
            if (!tbody) return;
            const term = (searchTerm || "").toLowerCase().trim();

            const filtered = walletState.transactions.filter(tx => {
                const matchesType = (activeCategoryFilter === "All" || tx.type === activeCategoryFilter);
                const matchesSearch = (tx.title || "").toLowerCase().includes(term)
                    || (tx.id || "").toLowerCase().includes(term)
                    || (tx.category || "").toLowerCase().includes(term);
                return matchesType && matchesSearch;
            });

            tbody.innerHTML = "";
            if (!filtered.length) {
                tbody.innerHTML = `<tr><td colspan="6" class="text-center py-6 opacity-40">No transactions match your query.</td></tr>`;
                return;
            }

            filtered.forEach(tx => {
                const tr = document.createElement("tr");
                tr.className = "hover:bg-slate-500/5 transition-colors";
                const isIncoming = tx.type === "Incoming";
                const amountClass = isIncoming ? "text-emerald-500 font-extrabold" : "text-rose-500 font-extrabold";
                const sign = isIncoming ? "+" : "-";
                tr.innerHTML = `
                    <td class="py-3.5 px-3">
                        <div class="font-bold text-slate-800 dark:text-slate-100">${esc(tx.title)}</div>
                        <div class="text-[9px] opacity-45 font-mono">${esc(tx.id)}</div>
                    </td>
                    <td class="py-3.5 px-3">
                        <span class="px-2 py-1 rounded-lg text-[9px] font-bold bg-slate-500/10">${esc(tx.category)}</span>
                    </td>
                    <td class="py-3.5 px-3 opacity-60 text-[10px]">${esc(tx.date)}</td>
                    <td class="py-3.5 px-3">
                        <span class="inline-flex items-center gap-1 text-[9px] font-bold text-emerald-500 bg-emerald-500/10 px-2 py-0.5 rounded-full">
                            <i class="fa-solid fa-circle-check text-[8px]"></i> ${esc(tx.status || "Completed")}
                        </span>
                    </td>
                    <td class="py-3.5 px-3 text-right ${amountClass} font-mono">
                        ${sign} Rs. ${Number(tx.amount).toLocaleString()}
                    </td>
                    <td class="py-3.5 px-3 text-center">
                        <button onclick="viewReceipt('${esc(tx.id)}')" class="p-1.5 rounded-lg border border-slate-500/20 hover:bg-purple-500/10 hover:text-purple-500" title="View Digital Receipt">
                            <i class="fa-solid fa-receipt text-xs"></i>
                        </button>
                    </td>`;
                tbody.appendChild(tr);
            });
        }

        function filterTx(type, btn) {
            activeCategoryFilter = type;
            document.querySelectorAll(".filter-btn").forEach(b => b.classList.remove("active"));
            if (btn) btn.classList.add("active");
            const search = document.getElementById("globalSearch");
            renderTransactions(search ? search.value : "");
        }

        function initializeSearch() {
            const el = document.getElementById("globalSearch");
            if (el) el.addEventListener("input", function () { renderTransactions(this.value); });
        }

        async function handleTopUp(e) {
            e.preventDefault();
            const amt = parseFloat(document.getElementById("topUpAmount").value);
            if (!amt || amt <= 0) return;
            try {
                const res = await fetch("/api/wallet/topup", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    credentials: "same-origin",
                    body: JSON.stringify({ amount: amt, method: selectedTopUpMethod })
                });
                const data = await res.json();
                if (!res.ok || !data.success) {
                    showToast(data.message || "Top-up failed");
                    return;
                }
                showToast(data.message || `Successfully added Rs. ${amt.toLocaleString()}!`);
                closeModal("topUpModal");
                e.target.reset();
                await loadWalletData();
            } catch {
                showToast("Network error during top-up");
            }
        }

        async function handleTransfer(e) {
            e.preventDefault();
            const recipientEl = document.getElementById("recipientRegId") || e.target.querySelector('input[type="text"]');
            const amtEl = document.getElementById("transferAmount") || e.target.querySelector('input[type="number"]');
            const pinEl = document.getElementById("transferPin") || e.target.querySelector('input[type="password"]');
            const noteInput = document.getElementById("transferNote") || e.target.querySelector('input[placeholder*="Cafeteria"], input[placeholder*="lab"], input[placeholder*="Note"]');
            const recipient = (recipientEl && recipientEl.value || "").trim();
            const amt = parseFloat(amtEl && amtEl.value);
            const pin = (pinEl && pinEl.value || "").trim();
            const note = noteInput ? noteInput.value.trim() : "";
            if (!recipient) { showToast("Enter recipient email or CC-XXXX-PK"); return; }
            if (!amt || amt < 50) { showToast("Minimum transfer is Rs. 50"); return; }
            if (!pin || pin.length < 4) { showToast("Enter 4-digit wallet PIN"); return; }
            try {
                const res = await fetch("/api/wallet/transfer", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    credentials: "same-origin",
                    body: JSON.stringify({ recipient, amount: amt, note, pin })
                });
                const data = await res.json();
                if (!res.ok || !data.success) {
                    showToast(data.message || "Transfer failed");
                    return;
                }
                showToast(data.message || `Transferred Rs. ${amt.toLocaleString()}`);
                closeModal("transferModal");
                e.target.reset();
                await loadWalletData();
            } catch {
                showToast("Network error during transfer");
            }
        }

        async function handleFeeCheckout(e) {
            if (e && e.preventDefault) e.preventDefault();
            if (!pendingFees.length) {
                showToast("No pending fee vouchers");
                return;
            }
            const fee = pendingFees[0];
            try {
                const res = await fetch(`/api/wallet/pay-fee/${fee.id}`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    credentials: "same-origin"
                });
                const data = await res.json();
                if (!res.ok || !data.success) {
                    showToast(data.message || "Fee payment failed");
                    return;
                }
                showToast(data.message || "Fee payment completed!");
                closeModal("feeCheckoutModal");
                await loadWalletData();
            } catch {
                showToast("Network error during fee payment");
            }
        }

        function viewReceipt(txId) {
            const tx = walletState.transactions.find(t => t.id === txId);
            if (!tx) return;
            const details = document.getElementById("receiptDetails");
            if (!details) return;
            details.innerHTML = `
                <div class="flex justify-between"><span>Transaction ID:</span> <strong>${esc(tx.id)}</strong></div>
                <div class="flex justify-between"><span>Description:</span> <strong>${esc(tx.title)}</strong></div>
                <div class="flex justify-between"><span>Category:</span> <strong>${esc(tx.category)}</strong></div>
                <div class="flex justify-between"><span>Date & Time:</span> <strong>${esc(tx.date)}</strong></div>
                <div class="flex justify-between border-t border-slate-500/20 pt-2 text-sm font-black">
                    <span>Total Amount:</span>
                    <span class="${tx.type === "Incoming" ? "text-emerald-500" : "text-rose-500"}">Rs. ${Number(tx.amount).toLocaleString()}</span>
                </div>`;
            openModal("receiptModal");
        }

        function downloadReceiptPdf() {
            showToast("Downloading digital receipt PDF...");
            setTimeout(() => closeModal("receiptModal"), 1200);
        }

        function selectMethod(chip, method) {
            document.querySelectorAll(".method-chip").forEach(c => c.classList.remove("active"));
            chip.classList.add("active");
            selectedTopUpMethod = method || chip.textContent.trim() || "Online";
        }

        function copyAccountId() {
            navigator.clipboard.writeText(walletState.accountId);
            showToast("Account ID copied to clipboard!");
        }

        function initializeSpendingChart() {
            const canvas = document.getElementById("walletSpendingChart");
            if (!canvas || typeof Chart === "undefined") return;
            const ctx = canvas.getContext("2d");
            if (spendingChart) { try { spendingChart.destroy(); } catch (_) {} }

            // Build simple weekly-ish series from outgoing tx amounts (UI chart only)
            const outgoing = walletState.transactions.filter(t => t.type === "Outgoing").slice(0, 8).reverse();
            const labels = outgoing.length ? outgoing.map((t, i) => `T${i + 1}`) : ["Week 1", "Week 2", "Week 3", "Week 4"];
            const data = outgoing.length ? outgoing.map(t => Number(t.amount)) : [0, 0, 0, 0];

            spendingChart = new Chart(ctx, {
                type: "line",
                data: {
                    labels,
                    datasets: [{
                        label: "Spending (Rs.)",
                        data,
                        borderColor: "#8b58b8",
                        backgroundColor: "rgba(139,88,184,0.15)",
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { display: false } },
                        y: { grid: { color: "rgba(150,150,150,0.1)" } }
                    }
                }
            });
        }

        function openModal(id) {
            // When opening fee modal, fill dynamic pending fee if present
            if (id === "feeCheckoutModal" && pendingFees.length) {
                const fee = pendingFees[0];
                const modal = document.getElementById("feeCheckoutModal");
                if (modal) {
                    const titleEl = modal.querySelector(".text-sm.font-extrabold");
                    const amountEls = modal.querySelectorAll(".font-extrabold.text-purple-600, .text-purple-600");
                    if (titleEl) titleEl.textContent = fee.title || "Fee Voucher";
                    amountEls.forEach(el => {
                        if ((el.textContent || "").includes("Rs.") || (el.textContent || "").includes("4,500")) {
                            el.textContent = "Rs. " + Number(fee.amount).toLocaleString();
                        }
                    });
                    const payBtn = modal.querySelector("button[type='submit']");
                    if (payBtn) payBtn.textContent = "Pay Rs. " + Number(fee.amount).toLocaleString() + " Instantly";
                }
            }
            document.getElementById(id).classList.add("show");
        }
        function closeModal(id) { document.getElementById(id).classList.remove("show"); }

        function renderNotifications() {
            const list = document.getElementById("notificationList");
            const count = document.getElementById("notificationCount");
            const dot = document.getElementById("notificationDot");
            if (!list) return;
            const unread = (walletState.notifications || []).filter(n => n.unread).length;
            if (count) count.textContent = `${unread} unread notification${unread === 1 ? "" : "s"}`;
            if (dot) dot.style.display = unread ? "block" : "none";
            list.innerHTML = "";
            (walletState.notifications || []).forEach((n, idx) => {
                const item = document.createElement("button");
                item.className = "dropdown-item";
                item.onclick = () => {
                    walletState.notifications[idx].unread = false;
                    renderNotifications();
                };
                item.innerHTML = `
                    <span class="w-2 h-2 rounded-full ${n.unread ? "bg-purple-500" : "bg-slate-300"}"></span>
                    <span>
                        <span class="block font-bold text-[10px]">${esc(n.title)}</span>
                        <span class="block text-[9px] opacity-45 mt-1">${esc(n.text)}</span>
                    </span>`;
                list.appendChild(item);
            });
        }

        function toggleDropdown(id) {
            const dropdown = document.getElementById(id);
            if (!dropdown) return;
            const isShown = dropdown.classList.contains("show");
            document.querySelectorAll(".dropdown").forEach(d => d.classList.remove("show"));
            if (!isShown) dropdown.classList.add("show");
        }

        document.addEventListener("click", function (e) {
            if (!e.target.closest(".dropdown-wrap")) {
                document.querySelectorAll(".dropdown").forEach(d => d.classList.remove("show"));
            }
        });

        function toggleSidebar() {
            document.getElementById("sidebar").classList.toggle("open");
            document.getElementById("mobileOverlay").classList.toggle("show");
        }
        function closeSidebar() {
            document.getElementById("sidebar").classList.remove("open");
            document.getElementById("mobileOverlay").classList.remove("show");
        }

        function initializeTheme() {
            const saved = localStorage.getItem("campuscoin-theme");
            if (saved === "dark") {
                document.documentElement.classList.replace("light", "dark");
                document.body.classList.remove("light");
                document.body.classList.add("dark-mesh");
            }
            updateThemeIcon();
        }

        function toggleTheme() {
            const isDark = document.documentElement.classList.contains("dark");
            if (isDark) {
                document.documentElement.classList.replace("dark", "light");
                document.body.classList.remove("dark-mesh");
                document.body.classList.add("light");
                localStorage.setItem("campuscoin-theme", "light");
            } else {
                document.documentElement.classList.replace("light", "dark");
                document.body.classList.remove("light");
                document.body.classList.add("dark-mesh");
                localStorage.setItem("campuscoin-theme", "dark");
            }
            updateThemeIcon();
        }

        function updateThemeIcon() {
            const icon = document.getElementById("themeIcon");
            if (!icon) return;
            const isDark = document.documentElement.classList.contains("dark");
            icon.className = isDark ? "fa-solid fa-sun text-amber-300" : "fa-solid fa-moon";
        }

        function logoutStudent() {
            showToast("Logging out...");
            setTimeout(() => { window.location.href = "/Auth/Logout"; }, 600);
        }

        function showToast(msg) {
            const container = document.getElementById("toastContainer");
            if (!container) return;
            const toast = document.createElement("div");
            toast.className = "toast ios-glass font-bold text-xs";
            toast.innerHTML = `<i class="fa-solid fa-circle-info text-purple-500"></i> ${msg}`;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = "0";
                setTimeout(() => toast.remove(), 300);
            }, 2500);
        }

        
        function renderWalletQr(payload) {
            const text = payload || walletState.qrPayload || walletState.accountId || "CAMPUSCOIN";
            const label = document.getElementById("qrAccountLabel");
            const nameEl = document.getElementById("qrNameLabel");
            if (label) label.textContent = walletState.accountId;
            if (nameEl) nameEl.textContent = (walletState.profile && walletState.profile.name) || "Student";
            const inlineAcc = document.getElementById("inlineQrAccount");
            const inlineName = document.getElementById("inlineQrName");
            if (inlineAcc) inlineAcc.textContent = walletState.accountId;
            if (inlineName) inlineName.textContent = (walletState.profile && walletState.profile.name) || "Student";

            function draw(boxId) {
                const box = document.getElementById(boxId);
                if (!box) return;
                box.innerHTML = "";
                if (typeof QRCode === "undefined") {
                    box.innerHTML = '<div class="text-[10px] text-slate-500 p-4">QR loading...</div>';
                    return;
                }
                try {
                    const size = boxId === "walletQrInline" ? 120 : 180;
                    new QRCode(box, {
                        text: text,
                        width: size,
                        height: size,
                        colorDark: "#6b3a92",
                        colorLight: "#ffffff",
                        correctLevel: QRCode.CorrectLevel.M
                    });
                } catch (e) {
                    console.error(e);
                    box.innerHTML = '<div class="text-[10px] text-slate-500">QR unavailable</div>';
                }
            }
            draw("walletQr");
            draw("walletQrInline");
        }

        function esc(s) {

            return String(s ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
        }

    </script>
</body>
</html>
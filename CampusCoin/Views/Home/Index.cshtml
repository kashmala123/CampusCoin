        .cc-landing .cta-orb-1 { width: 380px; height: 380px; top: -20%; right: -8%; background: radial-gradient(circle, rgba(155, 111, 216, .7), transparent 65%); animation: cta-orb-a 18s ease-in-out infinite; }
        .cc-landing .cta-orb-2 { width: 300px; height: 300px; bottom: -30%; left: 10%; background: radial-gradient(circle, rgba(212, 121, 159, .55), transparent 65%); animation: cta-orb-b 22s ease-in-out infinite; }
        .cc-landing .cta-orb-3 { width: 240px; height: 240px; top: 40%; left: 45%; background: radial-gradient(circle, rgba(109, 74, 255, .5), transparent 65%); animation: cta-orb-a 26s ease-in-out infinite reverse; }
        @@keyframes cta-orb-a { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(-40px, 30px) scale(1.15); } }
        @@keyframes cta-orb-b { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(30px, -30px) scale(1.1); } }

@model CampusCoin.Models.HomepageViewModel
@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewData["Title"] = "Campus Coin — Smart spending, student style";
    string Cms(string key, string fallback = "") =>
        Model?.Content != null && Model.Content.TryGetValue(key, out var cv) && !string.IsNullOrWhiteSpace(cv) ? cv : fallback;
    bool ShowSec(string key, bool def = true)
    {
        if (Model?.Content == null || !Model.Content.TryGetValue(key, out var v) || string.IsNullOrWhiteSpace(v)) return def;
        v = v.Trim().ToLowerInvariant();
        return v is "1" or "true" or "yes" or "on";
    }
}
<style>
@if (!ShowSec("show_features")) { <text>.cc-sec-features{display:none!important;}</text> }
@if (!ShowSec("show_categories")) { <text>.cc-sec-categories{display:none!important;}</text> }
@if (!ShowSec("show_manage_bar")) { <text>.cc-sec-manage{display:none!important;}</text> }
@if (!ShowSec("show_testimonials")) { <text>.cc-sec-testimonials{display:none!important;}</text> }
@if (!ShowSec("show_proofs")) { <text>.cc-sec-proofs{display:none!important;}</text> }
@if (!ShowSec("show_newsletter")) { <text>.cc-sec-newsletter{display:none!important;}</text> }
@if (!ShowSec("show_contact")) { <text>.cc-sec-contact{display:none!important;}</text> }
</style>


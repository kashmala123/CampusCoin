    <main class="main">
        <header class="topbar ios-glass">
            <button class="action-btn mobile-btn" onclick="toggleSidebar()"><i class="fa-solid fa-bars"></i></button>
            <div class="search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" placeholder="Search notifications..." id="searchInput" oninput="filterNotifications(this.value)">
            </div>

            <div class="top-actions">
                <button class="glass-btn primary-btn" onclick="markAllRead()">
                    <i class="fa-solid fa-check-double mr-1"></i> Mark All Read
                </button>
                <button class="action-btn" onclick="toggleTheme()"><i id="themeIcon" class="fa-solid fa-moon"></i></button>

                <div class="dropdown-wrap cc-notif-wrap" style="position:relative;z-index:10002;overflow:visible;">
                    <button type="button" class="action-btn cc-notif-btn" title="Notifications" aria-label="Notifications">
                        <i class="fa-regular fa-bell"></i>
                        <span class="cc-notif-dot hidden"></span>
                    </button>
                    <div class="cc-notif-popover" role="menu">
                        <div class="cc-notif-head">
                            <div class="cc-notif-title"><i class="fa-solid fa-bell"></i> Notifications</div>
                            <button type="button" class="cc-notif-markall">Mark all read</button>
                        </div>
                        <div class="cc-notif-list">
                            <div class="cc-notif-empty">Loading…</div>
                        </div>
                        <a href="/Dashboard/Notifications" class="cc-notif-footer">View all notifications →</a>
                    </div>
                </div>
                <div class="dropdown-wrap" style="position:relative;z-index:10002;overflow:visible;">
                    <div class="profile" data-cc-profile-btn style="cursor:pointer;display:flex;align-items:center;gap:8px;">
                        <div class="profile-avatar" id="topAvatar" style="width:34px;height:34px;border-radius:11px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:11px;font-weight:800;background:linear-gradient(135deg,#a486e0,#6366f1);">ST</div>
                        <div class="text-[10px] font-bold" id="topStudentName">Student</div>
                        <i class="fa-solid fa-chevron-down text-[8px] opacity-40"></i>
                    </div>
                    <div data-cc-profile-dd class="cc-shared-dd">
                        <a href="/Dashboard/Profile" class="cc-shared-dd-item"><i class="fa-regular fa-user"></i> Profile</a>
                        <a href="/Dashboard/Index" class="cc-shared-dd-item"><i class="fa-solid fa-chart-line"></i> Dashboard</a>
                        <a href="/Auth/Logout" class="cc-shared-dd-item" style="color:#e11d48;"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
                    </div>
                </div>

            </div>
        </header>

        <section class="page-header">
            <div>
                <div class="eyebrow">CampusCoin / Student Portal</div>
                <h1 class="page-title">Inbox & Notifications</h1>
                <p class="page-description">Stay updated with budget alerts, goal milestones, admin broadcasts, and system notifications.</p>
            </div>
            <div class="date-pill ios-glass">
                <i class="fa-regular fa-calendar mr-1"></i>
                <span id="currentDate">Loading...</span>
            </div>
        </section>

        <!-- INBOX CONTAINER -->
        <section class="inbox-container ios-glass">

            <!-- LEFT: NOTIFICATIONS LIST -->
            <div class="notif-sidebar">
                <div class="notif-list-header">
                    <div class="flex justify-between items-center mb-3">
                        <div class="text-[14px] font-extrabold">Notifications</div>
                        <span class="badge bg-purple-600/15 text-purple-600" id="unreadCountBadge">0 unread</span>
                    </div>
                    <div class="flex gap-1.5">
                        <button class="glass-btn text-[10px] py-1.5 px-3 flex-1 justify-center active" onclick="setFilter('all', this)" data-filter="all">
                            All
                        </button>
                        <button class="glass-btn text-[10px] py-1.5 px-3 flex-1 justify-center" onclick="setFilter('unread', this)" data-filter="unread">
                            Unread
                        </button>
                        <button class="glass-btn text-[10px] py-1.5 px-3 flex-1 justify-center" onclick="setFilter('alerts', this)" data-filter="alerts">
                            Alerts
                        </button>
                    </div>
                </div>

                <div class="notif-list-scroll" id="notificationsList">
                    <div class="text-center py-8 text-[11px] opacity-45">Loading notifications...</div>
                </div>
            </div>

            <!-- RIGHT: DETAIL VIEW -->
            <div class="notif-window">
                <div class="notif-window-header">
                    <div class="flex items-center gap-3">
                        <div id="activeNotifIcon" class="w-10 h-10 rounded-xl bg-purple-600/15 text-purple-600 flex items-center justify-center font-bold text-sm">
                            <i class="fa-solid fa-bell"></i>
                        </div>
                        <div>
                            <div id="activeNotifTitle" class="text-[13px] font-extrabold">Select a notification</div>
                            <div class="text-[10px] opacity-50" id="activeNotifTime">--</div>
                        </div>
                    </div>
                    <span id="activeNotifTypeBadge" class="badge bg-slate-500/10 text-slate-500">--</span>
                </div>

                <div class="notif-content-area" id="notificationDetail">
                    <div class="text-center py-16 opacity-40">
                        <i class="fa-regular fa-envelope-open text-4xl mb-3"></i>
                        <div class="text-sm font-bold">Select a notification to view details</div>
                        <div class="text-xs mt-1">Choose an item from the left panel</div>
                    </div>
                </div>
            </div>

        </section>
    </main>

    <div id="toastContainer"></div>

    <script>
        let allNotifications = [];
        let filteredNotifications = [];
        let activeNotificationId = null;
        let currentFilter = 'all';

        document.addEventListener("DOMContentLoaded", async function () {
            initializeTheme();
            setDate();
            await Promise.all([loadUserInfo(), loadNotifications()]);
        });

        function setDate() {
            document.getElementById("currentDate").textContent = new Date().toLocaleDateString("en-US", {
                weekday: "short", month: "long", day: "numeric", year: "numeric"
            });
        }

        // ================= USER INFO =================
        async function loadUserInfo() {
            try {
                const res = await fetch('/api/dashboard/summary');
                if (!res.ok) return;
                const data = await res.json();
                if (data.userName) {
                    const initials = data.userName.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);
                    document.getElementById('sidebarAvatar').textContent = initials;
                    document.getElementById('sidebarStudentName').textContent = data.userName;
                    var topName = document.getElementById('topStudentName');
                    if (topName) topName.textContent = data.userName;
                    var topAv = document.getElementById('topAvatar');
                    if (topAv) topAv.textContent = data.userName.split(' ').map(function(n){return n[0];}).join('').toUpperCase().slice(0,2);
                }
                if (data.userAcademicYear) document.getElementById('sidebarStudentRole').textContent = data.userAcademicYear;
            } catch (err) { console.error(err); }
        }

        // ================= LOAD NOTIFICATIONS =================
        async function loadNotifications() {
            try {
                const res = await fetch('/api/notifications');
                if (!res.ok) throw new Error('Failed to load notifications');
                const data = await res.json();

                allNotifications = (data.notifications || []).map(function (n) {
                    return Object.assign({}, n, {
                        id: n.notificationId != null ? n.notificationId : n.id,
                        isRead: !!n.isRead,
                        type: n.type || 'Info',
                        message: n.message || '',
                        createdAt: n.createdAt || ''
                    });
                });
                applyFilter();
                updateUnreadCount();
            } catch (err) {
                console.error('Error loading notifications:', err);
                document.getElementById('notificationsList').innerHTML =
                    '<div class="text-center py-8 text-[11px] text-rose-500">Failed to load notifications</div>';
            }
        }

        function updateUnreadCount() {
            const unread = allNotifications.filter(n => !n.isRead).length;
            document.getElementById('unreadCountBadge').textContent = `${unread} unread`;
        }

        // ================= FILTER =================
        function setFilter(filter, btn) {
            currentFilter = filter;
            document.querySelectorAll('[data-filter]').forEach(b => {
                b.classList.remove('active');
                if (b.dataset.filter === filter) b.classList.add('active');
            });
            applyFilter();
        }

        function applyFilter(searchTerm = '') {
            const term = searchTerm.toLowerCase().trim();
            filteredNotifications = allNotifications.filter(n => {
                // Filter by type
                if (currentFilter === 'unread' && n.isRead) return false;
                if (currentFilter === 'alerts' && n.type !== 'Alert') return false;
                // Filter by search term
                if (term && !n.message.toLowerCase().includes(term)) return false;
                return true;
            });
            renderList();
        }

        function filterNotifications(val) {
            applyFilter(val);
        }

        // ================= RENDER LIST =================
        function renderList() {
            const container = document.getElementById('notificationsList');

            if (!filteredNotifications.length) {
                container.innerHTML = `<div class="text-center py-8 text-[11px] opacity-45">No notifications found.</div>`;
                return;
            }

            container.innerHTML = filteredNotifications.map((n, idx) => {
                const isUnread = !n.isRead;
                const isActive = n.id === activeNotificationId;

                const typeStyle = n.type === 'Alert'
                    ? { icon: 'fa-triangle-exclamation', color: 'text-rose-500', bg: 'bg-rose-500/15' }
                    : { icon: 'fa-circle-info', color: 'text-purple-600', bg: 'bg-purple-600/15' };

                return `
                    <div class="notif-item ${isActive ? 'active' : ''} ${isUnread ? 'unread' : ''}"
                         onclick="openNotification(${n.id})">
                        <div class="w-9 h-9 rounded-xl ${typeStyle.bg} ${typeStyle.color} flex items-center justify-center flex-shrink-0 text-xs">
                            <i class="fa-solid ${typeStyle.icon}"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex justify-between items-start gap-2 mb-0.5">
                                <span class="text-[11px] font-bold ${isUnread ? 'text-purple-700 dark:text-purple-400' : ''}">
                                    ${n.type === 'Alert' ? 'Alert' : 'Info'}
                                </span>
                                ${isUnread ? '<span class="w-2 h-2 rounded-full bg-purple-600 flex-shrink-0 mt-1"></span>' : ''}
                            </div>
                            <div class="text-[10px] opacity-60 line-clamp-2 leading-snug">${n.message}</div>
                            <div class="text-[9px] opacity-40 mt-1">${n.createdAt || 'Just now'}</div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        // ================= OPEN DETAIL =================
        async function openNotification(id) {
            const n = allNotifications.find(x => x.id === id);
            if (!n) return;

            activeNotificationId = id;

            // Update header
            document.getElementById('activeNotifTitle').textContent =
                n.type === 'Alert' ? 'System Alert' : 'Information';
            document.getElementById('activeNotifTime').textContent = n.createdAt || 'Just now';

            // Update icon
            const iconEl = document.getElementById('activeNotifIcon');
            if (n.type === 'Alert') {
                iconEl.className = 'w-10 h-10 rounded-xl bg-rose-500/15 text-rose-500 flex items-center justify-center font-bold text-sm';
                iconEl.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i>';
            } else {
                iconEl.className = 'w-10 h-10 rounded-xl bg-purple-600/15 text-purple-600 flex items-center justify-center font-bold text-sm';
                iconEl.innerHTML = '<i class="fa-solid fa-circle-info"></i>';
            }

            // Type badge
            const badgeEl = document.getElementById('activeNotifTypeBadge');
            if (n.type === 'Alert') {
                badgeEl.className = 'badge bg-rose-500/15 text-rose-500';
                badgeEl.textContent = 'Alert';
            } else {
                badgeEl.className = 'badge bg-purple-600/15 text-purple-600';
                badgeEl.textContent = 'Info';
            }

            // Detail content
            const detail = document.getElementById('notificationDetail');
            detail.innerHTML = `
                <div class="max-w-2xl mx-auto">
                    <div class="p-5 rounded-2xl ${n.type === 'Alert' ? 'bg-rose-500/5 border border-rose-500/20' : 'bg-purple-600/5 border border-sky-500/20'} mb-5">
                        <div class="flex items-center gap-2 mb-3">
                            <i class="fa-solid ${n.type === 'Alert' ? 'fa-triangle-exclamation text-rose-500' : 'fa-circle-info text-purple-600'}"></i>
                            <span class="text-[11px] font-extrabold uppercase tracking-wider ${n.type === 'Alert' ? 'text-rose-500' : 'text-purple-600'}">
                                ${n.type === 'Alert' ? 'Alert' : 'Information'}
                            </span>
                        </div>
                        <div class="text-[14px] font-medium leading-relaxed text-slate-800 dark:text-slate-200">
                            ${n.message}
                        </div>
                    </div>

                    <div class="flex items-center justify-between text-[10px] opacity-50 px-1">
                        <span><i class="fa-regular fa-clock mr-1"></i> ${n.createdAt || 'Just now'}</span>
                        <span>${n.isRead ? '<i class="fa-solid fa-check-double text-emerald-500 mr-1"></i> Read' : '<i class="fa-solid fa-circle text-purple-600 mr-1"></i> Unread'}</span>
                    </div>

                    ${!n.isRead ? `
                        <div class="mt-6 flex justify-end">
                            <button onclick="markRead(${n.id})" class="glass-btn primary-btn">
                                <i class="fa-solid fa-check"></i> Mark as Read
                            </button>
                        </div>
                    ` : ''}
                </div>
            `;

            // Mark as read automatically after opening
            if (!n.isRead) {
                setTimeout(() => markRead(id, true), 400);
            }

            renderList();
        }

        // ================= MARK AS READ =================
        async function markRead(id, silent = false) {
            const n = allNotifications.find(x => x.id === id);
            if (!n || n.isRead) return;

            try {
                // Aapke backend mein specific "mark as read" endpoint ho ya nahi,
                // hum read-all use karenge fallback ke liye.
                // Agar aapke paas single mark-read endpoint hai, toh yahan change karein.

                // Optimistic update
                n.isRead = true;
                renderList();
                updateUnreadCount();

                if (!silent) showToast('Marked as read', 'success');

                // Call backend — mark single notification
                await fetch('/api/notifications/' + id + '/read', { method: 'PUT' });

                // Refresh detail if this was the active one
                if (activeNotificationId === id) openNotification(id);
            } catch (err) {
                console.error('Error marking read:', err);
            }
        }

        // ================= MARK ALL READ =================
        async function markAllRead() {
            const unread = allNotifications.filter(n => !n.isRead);
            if (!unread.length) {
                showToast('All caught up!', 'info');
                return;
            }

            try {
                // Optimistic update
                allNotifications.forEach(n => n.isRead = true);
                renderList();
                updateUnreadCount();

                await fetch('/api/notifications/read-all', { method: 'PUT' });

                showToast(`Marked ${unread.length} notification(s) as read`, 'success');
                if (activeNotificationId) openNotification(activeNotificationId);
            } catch (err) {
                console.error(err);
                showToast('Failed to mark all read', 'error');
            }
        }

        // ================= THEME =================
        function initializeTheme() {
            if (localStorage.getItem("campuscoin-theme") === "dark") {
                document.documentElement.classList.replace("light", "dark");
                document.body.classList.replace("light-mesh", "dark-mesh");
            }
            updateThemeIcon();
        }

        function toggleTheme() {
            const isDark = document.documentElement.classList.contains("dark");
            if (isDark) {
                document.documentElement.classList.replace("dark", "light");
                document.body.classList.replace("dark-mesh", "light-mesh");
                localStorage.setItem("campuscoin-theme", "light");
            } else {
                document.documentElement.classList.replace("light", "dark");
                document.body.classList.replace("light-mesh", "dark-mesh");
                localStorage.setItem("campuscoin-theme", "dark");
            }
            updateThemeIcon();
        }

        function updateThemeIcon() {
            const isDark = document.documentElement.classList.contains("dark");
            document.getElementById("themeIcon").className = isDark ? "fa-solid fa-sun text-amber-300" : "fa-solid fa-moon";
        }

        function toggleSidebar() {
            document.getElementById("sidebar").classList.toggle("open");
            document.getElementById("mobileOverlay").classList.toggle("show");
        }

        function closeSidebar() {
            document.getElementById("sidebar").classList.remove("open");
            document.getElementById("mobileOverlay").classList.remove("show");
        }

        // ================= TOAST =================
        function showToast(message, type = 'info') {
            const container = document.getElementById("toastContainer");
            const toast = document.createElement("div");
            toast.className = "toast ios-glass";

            const iconMap = {
                success: '<i class="fa-solid fa-circle-check text-emerald-500"></i>',
                error: '<i class="fa-solid fa-circle-exclamation text-rose-500"></i>',
                info: '<i class="fa-solid fa-circle-info text-purple-600"></i>'
            };

            toast.innerHTML = `
                <div class="w-9 h-9 rounded-xl bg-purple-600/10 flex items-center justify-center">
                    ${iconMap[type] || iconMap.info}
                </div>
                <div>
                    <div class="text-[10px] font-bold">CampusCoin</div>
                    <div class="text-[9px] opacity-50">${message}</div>
                </div>`;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = "0";
                setTimeout(() => toast.remove(), 300);
            }, 2500);
        }
    </script>

<script src="/js/cc-header-widgets.js" asp-append-version="true"></script>
</body>
</html>
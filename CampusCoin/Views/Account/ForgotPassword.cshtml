    </div>

    <!-- ══════════ LEFT · Art panel ══════════ -->
    <aside class="lg-art">
        <div class="lg-art-inner">

            <a asp-controller="Home" asp-action="Index" class="lg-brand">
                <svg viewBox="0 0 44 44" fill="none" aria-hidden="true">
                    <defs>
                        <linearGradient id="lgBg" x1="0" y1="0" x2="44" y2="44" gradientUnits="userSpaceOnUse">
                            <stop offset="0" stop-color="#6b3a92"/>
                            <stop offset="1" stop-color="#241232"/>
                        </linearGradient>
                    </defs>
                    <circle cx="22" cy="22" r="21" fill="url(#lgBg)"/>
                    <path d="M28.5 15c-1.9-2.2-4.7-3.5-7.8-3.5-5.8 0-10.5 4.7-10.5 10.5s4.7 10.5 10.5 10.5c3.1 0 5.9-1.3 7.8-3.5"
                          stroke="#FFD93D" stroke-width="2.6" stroke-linecap="round" fill="none"/>
                    <path d="M31 12c0 2.2-1.3 3.5-3.5 3.5 2.2 0 3.5 1.3 3.5 3.5 0-2.2 1.3-3.5 3.5-3.5-2.2 0-3.5-1.3-3.5-3.5z" fill="#FFD93D"/>
                </svg>
                <span class="name-wrap"><b>Cash</b><span class="coin">Campus</span></span>
            </a>

            <div class="lg-art-body">
                <span class="lg-eyebrow">
                    <i class="ri-key-2-line"></i> Password reset
                </span>

                <h1 class="lg-title">
                    Happens to<br>
                    the <em>best of us.</em>
                </h1>

                <div class="lg-scene" aria-hidden="true">

                    <span class="lg-ripple lg-ripple-1"></span>
                    <span class="lg-ripple lg-ripple-2"></span>
                    <span class="lg-ripple lg-ripple-3"></span>

                    <span class="lg-ring lg-ring-1"></span>
                    <span class="lg-ring lg-ring-2"></span>
                    <span class="lg-ring lg-ring-3"></span>

                    <span class="lg-ticks"></span>
                    <span class="lg-glow"></span>

                    <svg class="lg-arc" viewBox="0 0 100 100" aria-hidden="true">
                        <defs>
                            <linearGradient id="lgArcGrad" x1="0" y1="0" x2="100" y2="100" gradientUnits="userSpaceOnUse">
                                <stop offset="0" stop-color="#c4aee0"/>
                                <stop offset="0.5" stop-color="#a486e0"/>
                                <stop offset="1" stop-color="#d4799f"/>
                            </linearGradient>
                        </defs>
                        <circle cx="50" cy="50" r="46" fill="none" stroke="rgba(168, 140, 230, .14)" stroke-width=".8"/>
                        <circle cx="50" cy="50" r="46" fill="none" stroke="url(#lgArcGrad)" stroke-width="1.4"
                                stroke-linecap="round" stroke-dasharray="289" stroke-dashoffset="289" class="lg-arc-fill"/>
                    </svg>

                    <div class="lg-coin">

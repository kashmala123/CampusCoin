      '<p style="font-size:13px;opacity:.7;">None yet.</p>';
  } catch (e) {
    el.innerHTML = '<p style="color:#e11d48;font-size:13px;">' + esc(e.message) + '</p>';
  }
}
function addProof() {
  document.getElementById('proofsList').insertAdjacentHTML('afterbegin',
    proofCard({ isActive: true, tone: 'mint' }));
}
async function saveProof(btn) {
  try {
    const box = btn.closest('[data-id]');
    const body = Object.fromEntries([...box.querySelectorAll('[data-f]')].map(i =>
      [i.dataset.f, i.type === 'number' ? +i.value : i.value]));
    body.isActive = body.isActive === 'true';
    body.sortOrder = +body.sortOrder || 0;
    btn.disabled = true;
    const id = box.dataset.id;
    if (id) await j('/api/admin/cms/proofs/' + id, { method: 'PUT', body: JSON.stringify(body) });
    else await j('/api/admin/cms/proofs', { method: 'POST', body: JSON.stringify(body) });
    toast('Saved');
    await loadProofs();
  } catch (e) {
    toast(e.message || 'Save failed');
  } finally {
    if (btn) btn.disabled = false;
  }
}
async function delProof(id) {
  if (!confirm('Delete this proof chip?')) return;
  try {
    await j('/api/admin/cms/proofs/' + id, { method: 'DELETE' });
    toast('Deleted');
    await loadProofs();
  } catch (e) {
    toast(e.message || 'Delete failed');
  }
}

async function loadDesign() {
  try {
    const rows = _contentCache || await j('/api/admin/cms/content');
    const map = Object.fromEntries((rows || []).map(r => [r.key || r.Key || r.contentKey, r]));
    const val = (k, def = '') => {
      const r = map[k];
      if (!r) return def;
      return r.value ?? r.Value ?? def;
    };
    const visKeys = [
      ['show_features', 'Features'],
      ['show_categories', 'Categories'],
      ['show_manage_bar', 'Manage categories bar'],
      ['show_testimonials', 'Testimonials'],
      ['show_proofs', 'Proof chips'],
      ['show_newsletter', 'Newsletter'],
      ['show_contact', 'Contact']
    ];
    const visEl = document.getElementById('visibilitySwitches');
    if (visEl) {
      visEl.innerHTML = visKeys.map(([k, label]) => {
        const on = val(k, '1') === '1';
        return `<label class="cms-switch-label">
          <input type="checkbox" data-dkey="${k}" ${on ? 'checked' : ''} />
          <span>${label}</span>
        </label>`;
      }).join('');
    }
    const labelKeys = [
      ['hero_badge', 'Hero badge'],
      ['footer_tagline', 'Footer tagline'],
      ['ai_coach_placeholder', 'AI coach placeholder'],
      ['cta_secondary_label', 'Secondary CTA label']
    ];
    const labEl = document.getElementById('designLabels');
    if (labEl) {
      labEl.innerHTML = labelKeys.map(([k, label]) =>
        `<div class="cms-field"><label>${label}</label><input type="text" data-dkey="${k}" value="${esc(val(k, ''))}" /></div>`
      ).join('');
    }
    document.querySelectorAll('#designGrid [data-dkey]').forEach(el => {
      const k = el.dataset.dkey;
      const v = val(k, el.type === 'checkbox' ? '0' : (el.value || ''));
      if (el.type === 'checkbox') el.checked = v === '1';
      else if (el.tagName === 'SELECT') el.value = v || el.value;
      else el.value = v;
    });
  } catch (e) {
    console.warn('loadDesign', e);
  }
}

async function saveDesign() {
  try {
    await j('/api/admin/cms/ensure', { method: 'POST', body: '{}' });
    const rows = await j('/api/admin/cms/content');
    const map = Object.fromEntries((rows || []).map(r => [r.key || r.Key || r.contentKey, r]));
    const inputs = document.querySelectorAll('#designGrid [data-dkey]');
    let updated = 0;
    for (const el of inputs) {
      const key = el.dataset.dkey;
      let value = el.type === 'checkbox' ? (el.checked ? '1' : '0') : el.value;
      const row = map[key];
      if (row) {
        const id = row.id ?? row.Id;
        await j('/api/admin/cms/content/' + id, { method: 'PUT', body: JSON.stringify({ value }) });
        updated++;
      }
    }
    toast(updated ? `Design saved (${updated} fields)` : 'No matching design keys — run Init first');
    _contentCache = await j('/api/admin/cms/content');
  } catch (e) {
    toast(e.message || 'Save failed');
  }
}

async function loadAll() {
  await Promise.all([loadContent(), loadFeatures(), loadCategories(), loadTestimonials(), loadProofs()]);
  await loadDesign();
}

(async function init() {
  try { await j('/api/admin/cms/ensure', { method: 'POST', body: '{}' }); } catch (e) { console.warn(e); }
  await loadAll();
})();

</script>

<script>
function toggleSidebar(){ const s=document.getElementById('sidebar'); if(s) s.classList.toggle('open'); const o=document.getElementById('mobileOverlay')||document.getElementById('sidebarOverlay'); if(o){ o.classList.toggle('hidden'); o.classList.toggle('show'); } }
function closeSidebar(){ const s=document.getElementById('sidebar'); if(s) s.classList.remove('open'); const o=document.getElementById('mobileOverlay')||document.getElementById('sidebarOverlay'); if(o){ o.classList.add('hidden'); o.classList.remove('show'); } }
function toggleTheme(){
  const html=document.documentElement;
  const dark=html.classList.toggle('dark');
  document.body.classList.toggle('dark-mesh', dark);
  document.body.classList.toggle('light-mesh', !dark);
  localStorage.setItem('campuscoin-theme', dark?'dark':'light');
  localStorage.setItem('cc-admin-theme', dark?'dark':'light');
  const icon=document.getElementById('themeIcon');
  if(icon){ icon.className = dark ? 'fa-solid fa-sun' : 'fa-solid fa-moon'; }
}
function toggleDropdown(id){
  document.querySelectorAll('.dropdown').forEach(d=>{ if(d.id!==id) d.classList.remove('show','open'); });
  const el=document.getElementById(id);
  if(el){ el.classList.toggle('show'); el.classList.toggle('open'); }
}
function logoutAdmin(){ window.location.href='/Auth/Logout'; }
function quickAction(name){ if(name==='Add Student') location.href='/Admin/Students'; else if(name==='View Transactions') location.href='/Admin/Transactions'; else if(name==='Send Notification') location.href='/Admin/Notifications'; else if(name==='Generate Report') location.href='/Admin/Reports'; }
(function(){
  // Prefer shared campuscoin-theme; only use dark if explicitly saved
  const saved = localStorage.getItem('campuscoin-theme') || localStorage.getItem('cc-admin-theme') || 'light';
  if(saved==='dark'){
    document.documentElement.classList.add('dark');
    document.documentElement.classList.remove('light');
    document.body.classList.add('dark-mesh');
    document.body.classList.remove('light-mesh');
    const icon=document.getElementById('themeIcon');
    if(icon) icon.className='fa-solid fa-sun';
  } else {
    document.documentElement.classList.add('light');
    document.documentElement.classList.remove('dark');
    document.body.classList.add('light-mesh');
    document.body.classList.remove('dark-mesh');
    localStorage.setItem('campuscoin-theme','light');
  }
  document.addEventListener('click', function(e){
    if(!e.target.closest('.dropdown-wrap') && !e.target.closest('.cc-notif-wrap'))
      document.querySelectorAll('.dropdown, .cc-shared-dd, .cc-notif-popover').forEach(d=>d.classList.remove('show','open'));
  });
})();
</script>


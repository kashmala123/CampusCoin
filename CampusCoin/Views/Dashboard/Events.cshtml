@{
    ViewData["Title"] = "Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en" class="light">

<head>
    <link rel="stylesheet" href="/css/student-theme.css" />
    <link rel="stylesheet" href="/css/cc-animations.css" />

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CampusCoin — Student Portal</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <link rel="apple-touch-icon" href="/favicon.svg?v=4" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: { 50:'#f6effc', 100:'#ede4f6', 400:'#a486e0', 500:'#8b58b8', 600:'#6b3a92' }
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans','-apple-system', 'BlinkMacSystemFont', 'Inter', 'Segoe UI', 'Roboto', 'sans-serif'],
                    }
                }
            }
        };
    </script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <style>
        * {
            transition: background-color 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease, color 0.3s ease;
        }

        html {
            scroll-behavior: smooth;
        }

        body.light-mesh {
            background-color: #fbf6f0;
            background-image: radial-gradient(at 0% 0%, rgba(237, 228, 246, 0.9) 0px, transparent 50%), radial-gradient(at 100% 0%, rgba(196, 174, 224, 0.85) 0px, transparent 50%), radial-gradient(at 100% 100%, rgba(255, 225, 230, 0.85) 0px, transparent 50%), radial-gradient(at 0% 100%, rgba(246, 239, 252, 0.9) 0px, transparent 50%), radial-gradient(at 50% 50%, rgba(212, 243, 228, 0.4) 0px, transparent 50%);
            background-attachment: fixed;
        }

        body.dark-mesh {
            background-color: #100a1a;
            background-image: radial-gradient(at 10% 10%, rgba(99, 102, 241, 0.28) 0px, transparent 50%), radial-gradient(at 90% 10%, rgba(168, 85, 247, 0.22) 0px, transparent 50%), radial-gradient(at 90% 90%, rgba(107, 58, 146, 0.28) 0px, transparent 50%), radial-gradient(at 10% 90%, rgba(236, 72, 153, 0.2) 0px, transparent 50%);
            background-attachment: fixed;
        }

        .orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(80px);
            z-index: -1;
            pointer-events: none;
            animation: floatOrb 18s infinite alternate ease-in-out;
        }

        .orb-1 {
            width: 450px;
            height: 450px;
            background: rgba(192, 132, 252, 0.4);
            top: -100px;
            left: -100px;
        }

        .orb-2 {
            width: 480px;
            height: 480px;
            background: rgba(139, 88, 184, 0.45);
            top: 30%;
            right: -120px;
            animation-delay: -5s;
        }

        .orb-3 {
            width: 400px;
            height: 400px;
            background: rgba(251, 113, 133, 0.35);
            bottom: -100px;
            left: 20%;
            animation-delay: -10s;
        }

        @@keyframes floatOrb {
            0% {
                transform: translate(0px, 0px) scale(1);
            }

            50% {
                transform: translate(40px, 60px) scale(1.08);
            }

            100% {
                transform: translate(-30px, 30px) scale(0.95);
            }
        }

        .ios-glass {
            backdrop-filter: blur(32px) saturate(240%);
            -webkit-backdrop-filter: blur(32px) saturate(240%);
            position: relative;
            overflow: hidden;
        }

        .light .ios-glass {
            background: rgba(255, 255, 255, 0.72);
            border: 1.5px solid rgba(255, 255, 255, 0.95);
            box-shadow: 0 20px 40px -12px rgba(107, 58, 146, 0.12), 0 4px 16px -2px rgba(0, 0, 0, 0.04), inset 0 1.5px 2px 0 rgba(255, 255, 255, 1);
            color: #0f172a;
        }

        .dark .ios-glass {
            background: rgba(18, 24, 38, 0.58);
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.45), inset 0 1px 0 0 rgba(255, 255, 255, 0.18);
            color: #f8fafc;
        }

        .ios-glass-interactive {
            transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease, background 0.35s ease;
        }

            .ios-glass-interactive:hover {
                transform: translateY(-4px);
            }

        .sidebar {
            position: fixed;
            top: 20px;
            left: 20px;
            bottom: 20px;
            width: 260px;
            z-index: 100;
            border-radius: 30px;
            padding: 18px;
            display: flex;
            flex-direction: column;
            transform: translateX(0);
            transition: transform .35s ease;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 4px 6px 22px;
        }

        .brand-logo {
            width: 46px;
            height: 46px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
            background: linear-gradient(135deg, #a486e0, #8b58b8, #6366f1);
            box-shadow: 0 12px 25px rgba(107, 58, 146, .28);
        }

        .brand-name {
            font-size: 18px;
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        .brand-sub {
            font-size: 9px;
            font-weight: 800;
            letter-spacing: .16em;
            opacity: .45;
            margin-top: 3px;
        }

        .nav-section {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: .15em;
            font-weight: 800;
            opacity: .4;
            padding: 14px 10px 7px;
        }

        .nav {
            flex: 1;
            overflow-y: auto;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 12px;
            margin: 4px 0;
            border-radius: 15px;
            text-decoration: none;
            color: inherit;
            font-size: 12px;
            font-weight: 650;
            transition: all .25s ease;
        }

            .nav-link i {
                width: 20px;
                text-align: center;
                opacity: .55;
            }

            .nav-link:hover {
                background: rgba(255,255,255,.30);
                transform: translateX(3px);
            }

        .dark .nav-link:hover {
            background: rgba(255,255,255,.06);
        }

        .nav-link.active {
            color: #6b3a92;
            background: linear-gradient(135deg, rgba(139,88,184,.18), rgba(99,102,241,.14));
            box-shadow: inset 0 0 0 1px rgba(139,88,184,.15), 0 10px 25px rgba(107,58,146,.08);
        }

        .dark .nav-link.active {
            color: #c4aee0;
            background: rgba(139,88,184,.10);
        }

        .student-mini {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 11px;
            border-radius: 18px;
            background: rgba(255,255,255,.30);
            border: 1px solid rgba(255,255,255,.35);
        }

        .dark .student-mini {
            background: rgba(255,255,255,.04);
            border-color: rgba(255,255,255,.08);
        }

        .student-avatar {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 11px;
            font-weight: 800;
            background: linear-gradient(135deg, #8b58b8, #6366f1);
        }

        .main {
            margin-left: 300px;
            padding: 20px 25px 40px 0;
            min-height: 100vh;
        }

        .topbar {
            height: 70px;
            border-radius: 25px;
            padding: 10px 13px;
            display: flex;
            align-items: center;
            gap: 12px;
            position: sticky;
            top: 20px;
            z-index: 80;
        }

        .search {
            flex: 1;
            max-width: 500px;
            position: relative;
        }

            .search i {
                position: absolute;
                left: 16px;
                top: 50%;
                transform: translateY(-50%);
                opacity: .4;
                font-size: 12px;
            }

            .search input {
                width: 100%;
                border: none;
                outline: none;
                padding: 11px 15px 11px 42px;
                border-radius: 16px;
                background: rgba(255,255,255,.38);
                color: inherit;
                font-size: 12px;
                border: 1px solid rgba(255,255,255,.50);
            }

        .dark .search input {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-left: auto;
        }

        .action-btn {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            border: 1px solid rgba(255,255,255,.55);
            background: rgba(255,255,255,.36);
            color: inherit;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .dark .action-btn {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .action-btn:hover {
            transform: translateY(-2px);
            background: rgba(255,255,255,.65);
        }

        .profile {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 4px 9px 4px 4px;
            border-radius: 15px;
            cursor: pointer;
        }

        .profile-avatar {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 11px;
            font-weight: 800;
            background: linear-gradient(135deg, #a486e0, #6366f1);
        }

        .page-section {
            display: none;
        }

            .page-section.active {
                display: block;
                animation: fadeIn .3s ease;
            }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .page-header {
            display: flex;
            align-items: end;
            justify-content: space-between;
            gap: 20px;
            margin: 28px 3px 20px;
        }

        .eyebrow {
            color: #6b3a92;
            font-size: 9px;
            font-weight: 850;
            text-transform: uppercase;
            letter-spacing: .18em;
            margin-bottom: 8px;
        }

        .page-title {
            font-size: clamp(28px, 3vw, 40px);
            font-weight: 900;
            letter-spacing: -1.8px;
            line-height: 1;
        }

        .page-description {
            font-size: 12px;
            opacity: .48;
            margin-top: 8px;
        }

        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 15px;
        }

        .kpi {
            min-height: 155px;
            padding: 19px;
            border-radius: 25px;
            position: relative;
            overflow: hidden;
        }

            .kpi::after {
                content: '';
                position: absolute;
                width: 110px;
                height: 110px;
                border-radius: 50%;
                right: -45px;
                top: -45px;
                background: rgba(139,88,184,.08);
                pointer-events: none;
            }

        .kpi-icon {
            width: 40px;
            height: 40px;
            border-radius: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(139,88,184,.13);
            color: #6b3a92;
            margin-bottom: 13px;
        }

        .kpi-label {
            font-size: 10px;
            font-weight: 700;
            opacity: .48;
        }

        .kpi-value {
            font-size: 25px;
            font-weight: 900;
            letter-spacing: -1px;
            margin-top: 3px;
        }

        .kpi-change {
            font-size: 9px;
            font-weight: 750;
            margin-top: 5px;
        }

        .chart-grid {
            display: grid;
            grid-template-columns: 1.7fr 1fr;
            gap: 15px;
            margin-top: 15px;
        }

        .chart-card {
            border-radius: 27px;
            padding: 20px;
            min-height: 350px;
        }

        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            margin-bottom: 17px;
        }

        .chart-title {
            font-size: 14px;
            font-weight: 850;
        }

        .chart-sub {
            font-size: 9px;
            opacity: .45;
            margin-top: 3px;
        }

        .chart-container {
            height: 260px;
            position: relative;
        }

        .glass-btn {
            border: 1px solid rgba(255,255,255,.55);
            background: rgba(255,255,255,.38);
            color: inherit;
            border-radius: 13px;
            padding: 9px 12px;
            font-size: 10px;
            font-weight: 750;
            cursor: pointer;
        }

        .dark .glass-btn {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .glass-btn:hover {
            transform: translateY(-2px);
            background: rgba(255,255,255,.65);
        }

        .primary-btn {
            color: white;
            border: none;
            background: linear-gradient(135deg, #a486e0, #8b58b8, #6366f1);
            box-shadow: 0 10px 22px rgba(107,58,146,.20);
        }

        .filter-btn {
            padding: 8px 18px;
            border-radius: 14px;
            font-size: 11px;
            font-weight: 700;
            border: 1px solid rgba(255,255,255,.4);
            background: rgba(255,255,255,.2);
            cursor: pointer;
            transition: all .25s ease;
        }

        .dark .filter-btn {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.08);
        }

        .filter-btn.active {
            background: linear-gradient(135deg, #8b58b8, #6366f1);
            color: white;
            border-color: transparent;
            box-shadow: 0 8px 18px rgba(107,58,146,.3);
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 12px;
            border-radius: 999px;
            font-size: 10px;
            font-weight: 800;
        }

        .status-paid {
            background: rgba(16,185,129,.15);
            color: #10b981;
        }

        .status-pending {
            background: rgba(245,158,11,.15);
            color: #f59e0b;
        }

        .status-overdue {
            background: rgba(244,63,94,.15);
            color: #f43f5e;
        }

        .chat-msg {
            max-width: 82%;
            padding: 12px 16px;
            border-radius: 20px;
            font-size: 12px;
            line-height: 1.55;
            margin-bottom: 12px;
            word-wrap: break-word;
        }

        .msg-ai {
            background: rgba(139,88,184,.12);
            border: 1px solid rgba(139,88,184,.25);
            border-top-left-radius: 4px;
            align-self: flex-start;
        }

        .msg-user {
            background: linear-gradient(135deg, #8b58b8, #6366f1);
            color: white;
            border-top-right-radius: 4px;
            align-self: flex-end;
            margin-left: auto;
        }

        .quick-chip {
            font-size: 9px;
            font-weight: 700;
            padding: 6px 10px;
            border-radius: 10px;
            background: rgba(139,88,184,.12);
            color: #6b3a92;
            border: 1px solid rgba(139,88,184,.2);
            cursor: pointer;
        }

            .quick-chip:hover {
                background: rgba(139,88,184,.22);
            }

        .glass-input {
            width: 100%;
            padding: 12px 16px;
            border-radius: 14px;
            background: rgba(255,255,255,.35);
            border: 1px solid rgba(255,255,255,.5);
            font-size: 12px;
            outline: none;
            color: inherit;
        }

        .dark .glass-input {
            background: rgba(255,255,255,.05);
            border-color: rgba(255,255,255,.1);
        }

        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15,23,42,.5);
            backdrop-filter: blur(10px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 300;
            padding: 15px;
        }

            .modal-overlay.show {
                display: flex;
            }

        .modal-card {
            width: 100%;
            max-width: 520px;
            padding: 24px;
            border-radius: 28px;
            max-height: 90vh;
            overflow-y: auto;
        }

        .mobile-btn {
            display: none;
        }

        .mobile-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15,23,42,.25);
            backdrop-filter: blur(5px);
            z-index: 90;
        }

            .mobile-overlay.show {
                display: block;
            }

        .hidden {
            display: none !important;
        }

        @@media(max-width:1200px) {
            .kpi-grid {
                grid-template-columns: repeat(2,1fr);
            }

            .chart-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media(max-width:950px) {
            .sidebar {
                transform: translateX(-120%);
            }

                .sidebar.open {
                    transform: translateX(0);
                }

            .main {
                margin-left: 0;
                padding: 15px;
            }

            .mobile-btn {
                display: flex;
            }
        }

        @@media(max-width:700px) {
            .kpi-grid {
                grid-template-columns: 1fr;
            }

            .page-header {
                flex-direction: column;
                align-items: flex-start;
            }
        }

        #toastContainer {
            position: fixed;
            right: 20px;
            bottom: 20px;
            z-index: 999;
            display: flex;
            flex-direction: column;
            gap: 9px;
        }

        .toast {
            min-width: 270px;
            padding: 13px;
            border-radius: 17px;
            display: flex;
            align-items: center;
            gap: 10px;
            animation: toastIn .3s ease;
        }

        @@keyframes toastIn {
            from {
                opacity: 0;
                transform: translateY(15px) scale(.96);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }
    </style>
    <link rel="stylesheet" href="/css/cc-header-widgets.css" asp-append-version="true" />
</head>

<body class="light-mesh min-h-screen text-slate-900 dark:text-slate-100 font-sans">

    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    <div id="mobileOverlay" class="mobile-overlay" onclick="closeSidebar()"></div>
    <!-- SIDEBAR -->
    <aside id="sidebar" class="sidebar ios-glass no-print">
                <div class="brand cc-brand-block">
            <div class="brand-logo cc-brand-mark" aria-hidden="true">
                <svg viewBox="0 0 44 44" width="36" height="36" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="ccCoinBG_sb" x1="0" y1="0" x2="44" y2="44" gradientUnits="userSpaceOnUse">
                            <stop offset="0" stop-color="#6b3a92"/><stop offset="1" stop-color="#241232"/>
                        </linearGradient>
                        <linearGradient id="ccCoinAccent_sb" x1="10" y1="10" x2="34" y2="34" gradientUnits="userSpaceOnUse">
                            <stop offset="0" stop-color="#d4ff3d"/><stop offset="1" stop-color="#10b981"/>
                        </linearGradient>
                    </defs>
                    <circle cx="22" cy="22" r="21" fill="url(#ccCoinBG_sb)"/>
                    <circle cx="22" cy="22" r="16.5" fill="none" stroke="rgba(255,255,255,.2)" stroke-width="1" stroke-dasharray="1.5 3"/>
                    <path d="M28.5 15c-1.9-2.2-4.7-3.5-7.8-3.5-5.8 0-10.5 4.7-10.5 10.5s4.7 10.5 10.5 10.5c3.1 0 5.9-1.3 7.8-3.5" stroke="url(#ccCoinAccent_sb)" stroke-width="2.6" stroke-linecap="round" fill="none"/>
                    <path d="M31 12c0 2.2-1.3 3.5-3.5 3.5 2.2 0 3.5 1.3 3.5 3.5 0-2.2 1.3-3.5 3.5-3.5-2.2 0-3.5-1.3-3.5-3.5z" fill="#d4ff3d"/>
                </svg>
            </div>
            <div>
                <div class="brand-name cc-brand-title"><b>Cash</b><span>Campus</span></div>
                <div class="brand-sub">STUDENT PORTAL</div>
            </div>
        </div>

                <nav class="nav">
            <div class="nav-section">Main Menu</div>
            <a href="/Dashboard/Index" class="nav-link"><i class="fa-solid fa-chart-line"></i><span>Dashboard</span></a>
            <a href="/Dashboard/Transactions" class="nav-link"><i class="fa-solid fa-arrow-right-arrow-left"></i><span>My Transactions</span></a>
            <a href="/FeeVouchers" class="nav-link"><i class="fa-solid fa-receipt"></i><span>Fee Vouchers</span></a>
            <a href="/Dashboard/Budgets" class="nav-link"><i class="fa-solid fa-wallet"></i><span>My Budgets</span></a>
            <a href="/Dashboard/Categories" class="nav-link"><i class="fa-solid fa-tags"></i><span>My Categories</span></a>
            <a href="/Dashboard/BillSplit" class="nav-link"><i class="fa-solid fa-people-arrows"></i><span>Bill Split</span></a>
            <a href="/Dashboard/SavingGoals" class="nav-link"><i class="fa-solid fa-bullseye"></i><span>Saving Goals</span></a>
            <a href="/Events" class="nav-link active"><i class="fa-solid fa-calendar-days"></i><span>Events</span></a>
            <a href="/Dashboard/Recurring" class="nav-link"><i class="fa-solid fa-arrows-rotate"></i><span>Recurring</span></a>
            <div class="nav-section">Personal</div>
            <a href="/Dashboard/FinancialHealth" class="nav-link"><i class="fa-solid fa-heart-pulse"></i><span>Financial Score</span></a>
            <a href="/Dashboard/Reports" class="nav-link"><i class="fa-solid fa-chart-column"></i><span>Reports</span></a>
            <a href="/Dashboard/Bookmarks" class="nav-link"><i class="fa-solid fa-bookmark"></i><span>Bookmarks</span></a>
            <a href="/Dashboard/Notifications" class="nav-link"><i class="fa-solid fa-bell"></i><span>Inbox & Chats</span></a>
            <a href="/AiCoach" class="nav-link"><i class="fa-solid fa-robot"></i><span>AI Coach & Support</span></a>
            <a href="/Dashboard/Profile" class="nav-link"><i class="fa-solid fa-sliders"></i><span>Profile</span></a>
        </nav>

        <div class="student-mini">
            <div class="student-avatar" id="sidebarAvatar">AR</div>
            <div class="flex-1 min-w-0">
                <div class="text-[11px] font-bold truncate" id="sidebarStudentName">Loading...</div>
                <div class="text-[9px] opacity-45 truncate" id="sidebarStudentRole">Student</div>
            </div>
            <i class="fa-solid fa-graduation-cap text-xs opacity-35"></i>
        </div>
        <a href="/Auth/Logout" style="display:flex;align-items:center;gap:10px;padding:10px 12px;margin-top:8px;border-radius:12px;font-size:13px;font-weight:700;color:#e11d48;text-decoration:none;">
            <i class="fa-solid fa-right-from-bracket"></i> Logout
        </a>
    </aside>
    <!-- MAIN -->
    <main class="main">

        <header class="topbar ios-glass">
            <button class="action-btn mobile-btn" onclick="toggleSidebar()">
                <i class="fa-solid fa-bars"></i>
            </button>
            <div class="search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input id="globalSearch" type="text" placeholder="Search..." autocomplete="off">
            </div>
            <div class="top-actions">
                <button class="action-btn" onclick="toggleTheme()">
                    <i id="themeIcon" class="fa-solid fa-moon"></i>
                </button>
                <div class="text-[10px] font-bold" id="topStudentName">Loading...</div>
                </div>

                <div class="dropdown-wrap cc-notif-wrap" style="position:relative;z-index:10002;overflow:visible;">
                    <button type="button" class="action-btn cc-notif-btn" title="Notifications" aria-label="Notifications">
                        <i class="fa-regular fa-bell"></i>
                        <span class="cc-notif-dot hidden"></span>
                    </button>
                    <div class="cc-notif-popover" role="menu">
                        <div class="cc-notif-head">
                            <div class="cc-notif-title"><i class="fa-solid fa-bell"></i> Notifications</div>
                            <button type="button" class="cc-notif-markall">Mark all read</button>
                        </div>
                        <div class="cc-notif-list">
                            <div class="cc-notif-empty">Loading…</div>
                        </div>
                        <a href="/Dashboard/Notifications" class="cc-notif-footer">View all notifications →</a>
                    </div>
                </div>
                <div class="dropdown-wrap" style="position:relative;z-index:10002;overflow:visible;">
                    <div class="profile" data-cc-profile-btn style="cursor:pointer;display:flex;align-items:center;gap:8px;">
                        <div class="profile-avatar" id="topAvatar" style="width:34px;height:34px;border-radius:11px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:11px;font-weight:800;background:linear-gradient(135deg,#a486e0,#6366f1);">ST</div>
                        <div class="text-[10px] font-bold" id="topStudentName">Student</div>
                        <i class="fa-solid fa-chevron-down text-[8px] opacity-40"></i>
                    </div>
                    <div data-cc-profile-dd class="cc-shared-dd">
                        <a href="/Dashboard/Profile" class="cc-shared-dd-item"><i class="fa-regular fa-user"></i> Profile</a>
                        <a href="/Dashboard/Index" class="cc-shared-dd-item"><i class="fa-solid fa-chart-line"></i> Dashboard</a>
                        <a href="/Auth/Logout" class="cc-shared-dd-item" style="color:#e11d48;"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
                    </div>
                </div>

            </div>
        </header>

        <!-- ═══════════════════ DASHBOARD SECTION ═══════════════════ -->
        <section id="dashboardSection" class="page-section active">
            <div class="page-header">
                <div>
                    <div class="eyebrow">CampusCoin / Student Area</div>
                    <h1 class="page-title">Welcome back, <span id="welcomeName">Student</span> 👋</h1>
                    <p class="page-description">Manage your personal allowance, campus expenses, and saving goals.</p>
                </div>
            </div>

            <section class="kpi-grid">
                <div class="kpi ios-glass ios-glass-interactive">
                    <div class="kpi-icon"><i class="fa-solid fa-wallet"></i></div>
                    <div class="kpi-label">Current Balance</div>
                    <div class="kpi-value" id="kpiBalance">Rs. 0.00</div>
                </div>
                <div class="kpi ios-glass ios-glass-interactive">
                    <div class="kpi-icon"><i class="fa-solid fa-arrow-down"></i></div>
                    <div class="kpi-label">Monthly Income</div>
                    <div class="kpi-value" id="kpiIncome">Rs. 0.00</div>
                </div>
                <div class="kpi ios-glass ios-glass-interactive">
                    <div class="kpi-icon"><i class="fa-solid fa-arrow-up"></i></div>
                    <div class="kpi-label">Total Expenses</div>
                    <div class="kpi-value" id="kpiExpenses">Rs. 0.00</div>
                </div>
                <div class="kpi ios-glass ios-glass-interactive">
                    <div class="kpi-icon"><i class="fa-solid fa-bullseye"></i></div>
                    <div class="kpi-label">Savings Target</div>
                    <div class="kpi-value" id="kpiSavingsTarget">0%</div>
                </div>
            </section>

            <section class="chart-grid">
                <div class="chart-card ios-glass">
                    <div class="chart-header">
                        <div>
                            <div class="chart-title">Cash Flow Trend</div>
                            <div class="chart-sub">Your monthly allowance vs spending</div>
                        </div>
                    </div>
                    <div class="chart-container"><canvas id="incomeExpenseChart"></canvas></div>
                </div>
                <div class="chart-card ios-glass">
                    <div class="chart-header">
                        <div>
                            <div class="chart-title">Expense Breakdown</div>
                            <div class="chart-sub">Where your money goes</div>
                        </div>
                    </div>
                    <div class="chart-container"><canvas id="expenseChart"></canvas></div>
                </div>
            </section>
        </section>

        <!-- ═══════════════════ EVENTS SECTION ═══════════════════ -->
        <section id="eventsSection" class="page-section">
            <div class="page-header">
                <div>
                    <div class="eyebrow">CampusCoin / Campus Life</div>
                    <h1 class="page-title">Campus Events 🎟️</h1>
                    <p class="page-description">Register for hackathons, workshops, sports & cultural events</p>
                </div>
                <div class="px-4 py-2 rounded-2xl ios-glass text-[11px] font-bold flex items-center gap-2">
                    <i class="fa-solid fa-wallet text-emerald-500"></i>
                    <span>Wallet: <strong class="text-purple-700 dark:text-purple-400 font-extrabold" id="eventsWallet">Rs. 0</strong></span>
                </div>
            </div>

            <div class="ios-glass rounded-3xl p-5 mb-6">
                <div class="flex flex-wrap gap-2">
                    <button class="filter-btn active" onclick="filterEventStatus('Upcoming', this)">Upcoming</button>
                    <button class="filter-btn" onclick="filterEventStatus('Registered', this)">My Passes (<span id="eventRegCount">0</span>)</button>
                    <button class="filter-btn" onclick="filterEventStatus('Past', this)">Past</button>
                </div>
            </div>

            <div id="eventGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <div class="col-span-full text-center py-12 ios-glass rounded-3xl">
                    <p class="text-xs opacity-50">Loading events...</p>
                </div>
            </div>
        </section>

    </main>

    <!-- TICKET MODAL -->
    <div id="ticketModal" class="modal-overlay">
        <div class="modal-card ios-glass">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-base font-extrabold">Submit Support Ticket</h3>
                <button onclick="closeModal('ticketModal')" class="action-btn !w-8 !h-8">
                    <i class="fa-solid fa-xmark text-xs"></i>
                </button>
            </div>
            <form onsubmit="handleTicketSubmit(event)" class="space-y-4">
                <input type="text" id="ticketSubject" placeholder="Subject" class="glass-input" required>
                <textarea id="ticketMessage" rows="3" placeholder="Message" class="glass-input" required></textarea>
                <button type="submit" class="w-full py-3 rounded-xl font-bold text-xs text-white bg-gradient-to-r from-sky-500 to-indigo-600">
                    Submit Ticket
                </button>
            </form>
        </div>
    </div>

    <div id="toastContainer"></div>

    <script>
        // ═══════════════════ PAGE SWITCHING ═══════════════════
        function showSection(sectionId, linkEl) {
            document.querySelectorAll('.page-section').forEach(s => s.classList.remove('active'));
            document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));

            const section = document.getElementById(sectionId);
            if (section) section.classList.add('active');
            if (linkEl) linkEl.classList.add('active');

            if (sectionId === 'eventsSection') {
                loadEvents();
            }
        }

        // ═══════════════════ USER INFO ═══════════════════
        async function loadUserInfo() {
            try {
                const res = await fetch('/api/dashboard/summary');
                if (!res.ok) return;
                const data = await res.json();
                const name = data.userName || 'Student';
                const initials = name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);

                document.getElementById('sidebarStudentName').textContent = name;
                document.getElementById('topStudentName').textContent = name;
                document.getElementById('sidebarAvatar').textContent = initials;
                document.getElementById('topAvatar').textContent = initials;
                document.getElementById('welcomeName').textContent = name.split(' ')[0];

                document.getElementById('kpiBalance').textContent = `Rs. ${(data.totalBalance || 0).toFixed(2)}`;
                document.getElementById('kpiIncome').textContent = `Rs. ${(data.monthlyIncome || 0).toFixed(2)}`;
                document.getElementById('kpiExpenses').textContent = `Rs. ${(data.monthlyExpenses || 0).toFixed(2)}`;
                document.getElementById('eventsWallet').textContent = `Rs. ${(data.totalBalance || 0).toLocaleString()}`;
            } catch (err) { console.error(err); }
        }

        // ═══════════════════ EVENTS ═══════════════════
        let allEvents = [];
        let eventStatusFilter = 'Upcoming';

        async function loadEvents() {
            try {
                const res = await fetch('/api/events', { credentials: 'same-origin' });
                if (!res.ok) throw new Error('HTTP ' + res.status);
                const data = await res.json();
                allEvents = Array.isArray(data) ? data : [];
                renderEvents();
            } catch (err) {
                console.error(err);
                allEvents = [];
                const grid = document.getElementById('eventGrid');
                if (grid) grid.innerHTML =
                    '<div class="col-span-full text-center py-12 ios-glass rounded-3xl">Failed to load events</div>';
            }
        }

        function renderEvents() {
            const grid = document.getElementById('eventGrid');
            const filtered = allEvents.filter(e => {
                if (eventStatusFilter === 'Registered') return e.registered;
                if (eventStatusFilter === 'Past') return e.status === 'Past';
                return e.status === 'Upcoming';
            });

            document.getElementById('eventRegCount').textContent = allEvents.filter(e => e.registered).length;

            if (!filtered.length) {
                grid.innerHTML = '<div class="col-span-full text-center py-12 ios-glass rounded-3xl"><p class="text-xs opacity-50">No events found</p></div>';
                return;
            }

            grid.innerHTML = filtered.map(e => {
                const isFree = e.fee === 0;
                const feeBadge = isFree
                    ? '<span class="bg-emerald-500 text-white text-[9px] font-extrabold px-2.5 py-1 rounded-lg">FREE</span>'
                    : `<span class="bg-purple-700 text-white text-[9px] font-extrabold px-2.5 py-1 rounded-lg">Rs. ${e.fee}</span>`;

                return `
                    <div class="ios-glass ios-glass-interactive rounded-3xl overflow-hidden flex flex-col">
                        <div class="h-44 relative overflow-hidden">
                            <img src="${e.image}" class="w-full h-full object-cover" onerror="this.src='https://via.placeholder.com/400x200/0ea5e9/ffffff?text=Event'">
                            <div class="absolute top-3 left-3 flex gap-2">
                                ${feeBadge}
                                <span class="bg-black/60 backdrop-blur-md text-white text-[9px] font-bold px-2.5 py-1 rounded-lg">${e.category}</span>
                            </div>
                            <div class="absolute bottom-3 right-3 bg-amber-500 text-slate-950 text-[9px] font-black px-2.5 py-1 rounded-lg">
                                <i class="fa-solid fa-chair mr-1"></i> ${e.seatsLeft} Seats
                            </div>
                        </div>
                        <div class="p-5 flex-1 flex flex-col justify-between">
                            <div>
                                <h3 class="font-extrabold text-sm mb-2">${e.title}</h3>
                                <p class="text-[11px] opacity-70 mb-3">${e.description}</p>
                                <div class="space-y-1 text-[10px] opacity-80 font-semibold mb-4">
                                    <div><i class="fa-solid fa-calendar-day text-purple-600 w-4"></i> ${e.date} • ${e.time || ''}</div>
                                    <div><i class="fa-solid fa-location-dot text-rose-500 w-4"></i> ${e.venue}</div>
                                </div>
                            </div>
                            ${e.registered
                                ? `<button onclick="viewEventPass(${e.id})" class="w-full py-2.5 rounded-xl text-xs font-bold text-white bg-emerald-600"><i class="fa-solid fa-qrcode"></i> View Pass</button>`
                                : `<button onclick="registerForEvent(${e.id})" class="w-full py-2.5 rounded-xl text-xs font-bold text-white bg-gradient-to-r from-sky-500 to-indigo-600"><i class="fa-solid fa-ticket"></i> Register</button>`
                            }
                        </div>
                    </div>
                `;
            }).join('');
        }

        function filterEventStatus(status, btn) {
            eventStatusFilter = status;
            btn.parentElement.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            renderEvents();
        }

        async function registerForEvent(eventId) {
            if (!confirm('Confirm registration?')) return;
            try {
                const res = await fetch(`/api/events/${eventId}/register`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({})
                });
                const data = await res.json();
                if (data.success) {
                    showToast('✅ Registered! Pass: ' + data.passCode);
                    await loadEvents();
                    await loadUserInfo();
                } else {
                    showToast(data.message || 'Registration failed');
                }
            } catch (err) {
                showToast('Registration error');
            }
        }

        function viewEventPass(eventId) {
            const evt = allEvents.find(e => e.id === eventId);
            if (!evt) return;
            showToast(`Pass: ${evt.passCode} · ${evt.venue} · ${evt.date}`);
        }

        // ═══════════════════ CHARTS ═══════════════════
        async function loadCharts() {
            try {
                const res = await fetch('/api/dashboard/charts');
                if (!res.ok) return;
                const data = await res.json();

                const ctx1 = document.getElementById('incomeExpenseChart').getContext('2d');
                new Chart(ctx1, {
                    type: 'line',
                    data: {
                        labels: data.cashflow?.labels || [],
                        datasets: [
                            { label: 'Income', data: data.cashflow?.incomeData || [], borderColor: '#6b3a92', backgroundColor: 'rgba(2,132,199,.15)', fill: true, tension: 0.4, borderWidth: 3 },
                            { label: 'Expenses', data: data.cashflow?.expenseData || [], borderColor: '#6366f1', backgroundColor: 'rgba(99,102,241,.15)', fill: true, tension: 0.4, borderWidth: 3 }
                        ]
                    },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { labels: { font: { size: 10 } } } } }
                });

                const ctx2 = document.getElementById('expenseChart').getContext('2d');
                new Chart(ctx2, {
                    type: 'doughnut',
                    data: {
                        labels: data.spendingDonut?.labels || [],
                        datasets: [{ data: data.spendingDonut?.data || [], backgroundColor: data.spendingDonut?.colors || ['#a486e0', '#8b58b8', '#6366f1'], borderWidth: 0 }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, cutout: '68%', plugins: { legend: { position: 'bottom', labels: { font: { size: 9 } } } } }
                });
            } catch (err) { console.error('Charts load failed', err); }
        }

        // ═══════════════════ UI UTILITIES ═══════════════════
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
            document.getElementById('mobileOverlay').classList.toggle('show');
        }
        function closeSidebar() {
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('mobileOverlay').classList.remove('show');
        }

        function initializeTheme() {
            const saved = localStorage.getItem('campuscoin-theme');
            if (saved === 'dark') {
                document.documentElement.classList.replace('light', 'dark');
                document.body.classList.replace('light-mesh', 'dark-mesh');
            }
            updateThemeIcon();
        }

        function toggleTheme() {
            const isDark = document.documentElement.classList.contains('dark');
            if (isDark) {
                document.documentElement.classList.replace('dark', 'light');
                document.body.classList.replace('dark-mesh', 'light-mesh');
                localStorage.setItem('campuscoin-theme', 'light');
            } else {
                document.documentElement.classList.replace('light', 'dark');
                document.body.classList.replace('light-mesh', 'dark-mesh');
                localStorage.setItem('campuscoin-theme', 'dark');
            }
            updateThemeIcon();
        }

        function updateThemeIcon() {
            const icon = document.getElementById('themeIcon');
            const isDark = document.documentElement.classList.contains('dark');
            icon.className = isDark ? 'fa-solid fa-sun text-amber-300' : 'fa-solid fa-moon';
        }

        function showToast(msg) {
            const c = document.getElementById('toastContainer');
            const t = document.createElement('div');
            t.className = 'toast ios-glass font-bold text-xs';
            t.innerHTML = `<i class="fa-solid fa-circle-info text-purple-600"></i> ${msg}`;
            c.appendChild(t);
            setTimeout(() => { t.style.opacity = '0'; setTimeout(() => t.remove(), 300); }, 2500);
        }

        function openModal(id) { document.getElementById(id).classList.add('show'); }
        function closeModal(id) { document.getElementById(id).classList.remove('show'); }

        // ═══════════════════ INIT ═══════════════════
        document.addEventListener('DOMContentLoaded', async () => {
            initializeTheme();
            await loadUserInfo();
            await loadCharts();

            // Check if URL has #events
            if (window.location.hash === '#events') {
                showSection('eventsSection', document.querySelectorAll('.nav-link')[1]);
            }
        });
    </script>

<script src="/js/cc-header-widgets.js" asp-append-version="true"></script>
</body>
</html>
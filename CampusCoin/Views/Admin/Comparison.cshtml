                <h1 class="text-3xl lg:text-4xl font-black tracking-tight">Expense Comparison</h1>
                <p class="text-xs opacity-50 mt-1">This month vs last month spending by category across students.</p>
            </div>
            <div class="flex items-center gap-2 flex-wrap">
                <select id="studentFilter" onchange="loadCmp()" class="p-2.5 rounded-xl bg-slate-500/10 border border-slate-500/20 text-xs font-bold outline-none min-w-[220px]">
                    <option value="">All students</option>
                </select>
                <button type="button" onclick="loadCmp()" class="px-4 py-2.5 rounded-xl text-xs font-bold text-white bg-gradient-to-r from-purple-600 to-violet-700 shadow-md">
                    <i class="fa-solid fa-rotate mr-1"></i> Refresh
                </button>
            </div>
        </section>

        <!-- KPI strip -->
        <section class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-5">
            <div class="ios-glass rounded-3xl p-4">
                <div class="text-[10px] opacity-50 font-bold uppercase">Period</div>
                <div class="text-sm font-black mt-1" id="periodLabel">—</div>
            </div>
            <div class="ios-glass rounded-3xl p-4">
                <div class="text-[10px] opacity-50 font-bold uppercase">Categories tracked</div>
                <div class="text-sm font-black mt-1" id="kpiCats">—</div>
            </div>
            <div class="ios-glass rounded-3xl p-4">
                <div class="text-[10px] opacity-50 font-bold uppercase">Filter</div>
                <div class="text-sm font-black mt-1 truncate" id="kpiFilter">All students</div>
            </div>
        </section>

        <!-- Chart -->
        <section class="ios-glass rounded-3xl p-5 mb-5">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-sm font-extrabold">Spending by category</h2>
                <span class="text-[10px] opacity-45 font-bold">Bar comparison</span>
            </div>
            <div style="height:360px;position:relative;">
                <canvas id="chart"></canvas>
            </div>
        </section>

        <!-- Category change list -->
        <section class="ios-glass rounded-3xl p-5 mb-8">
            <h2 class="text-sm font-extrabold mb-4">Category % change</h2>
            <div id="list" class="space-y-2 text-xs">
                <div class="opacity-40 py-6 text-center">Loading…</div>
            </div>
        </section>
    </main>


<script>
let chart;
async function loadCmp() {
    try {
        const uid = document.getElementById('studentFilter').value;
        const url = '/api/admin/expense-comparison' + (uid ? ('?userId=' + encodeURIComponent(uid)) : '');
        const res = await fetch(url, { credentials: 'same-origin' });
        const data = await res.json();
        if (!data.success) {
            document.getElementById('list').innerHTML = '<div class="text-rose-500 py-4 text-center">Failed to load comparison data</div>';
            return;
        }

        const sel = document.getElementById('studentFilter');
        if (sel.options.length <= 1 && data.students) {
            data.students.forEach(s => {
                const o = document.createElement('option');
                o.value = s.userId;
                o.textContent = (s.fullName || s.FullName || 'Student') + ' (' + (s.email || s.Email || '') + ')';
                sel.appendChild(o);
            });
            if (uid) sel.value = uid;
        }

        const thisL = data.thisMonthLabel || 'This month';
        const lastL = data.lastMonthLabel || 'Last month';
        document.getElementById('periodLabel').textContent = thisL + ' vs ' + lastL;

        const cats = data.categories || [];
        document.getElementById('kpiCats').textContent = String(cats.length);
        const filterText = sel.options[sel.selectedIndex] ? sel.options[sel.selectedIndex].text : 'All students';
        document.getElementById('kpiFilter').textContent = filterText;

        if (chart) chart.destroy();
        const ctx = document.getElementById('chart').getContext('2d');
        chart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: data.labels || [],
                datasets: [
                    { label: thisL, data: data.thisMonth || [], backgroundColor: 'rgba(139,88,184,.75)', borderRadius: 8 },
                    { label: lastL, data: data.lastMonth || [], backgroundColor: 'rgba(16,185,129,.55)', borderRadius: 8 }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'top', labels: { boxWidth: 12, font: { size: 11, weight: '600' } } } },
                scales: { y: { beginAtZero: true, grid: { color: 'rgba(150,150,150,0.12)' } }, x: { grid: { display: false } } }
            }
        });

        document.getElementById('list').innerHTML = cats.length ? cats.map(c => {
            const up = c.direction === 'up';
            const down = c.direction === 'down';
            const cls = up ? 'text-rose-500' : (down ? 'text-emerald-500' : 'opacity-60');
            const arrow = up ? '↑' : (down ? '↓' : '→');
            const sign = (c.changePercent > 0 ? '+' : '');
            const name = c.category || c.Category || 'Category';
            const tm = Number(c.thisMonth ?? c.ThisMonth ?? 0);
            const lm = Number(c.lastMonth ?? c.LastMonth ?? 0);
            const pct = c.changePercent ?? c.ChangePercent ?? 0;
            return `<div class="flex justify-between items-center p-3 rounded-2xl bg-slate-500/5 border border-slate-500/10">
                <div>
                    <div class="font-bold text-[12px]">${name}</div>
                    <div class="text-[10px] opacity-50 mt-0.5">This Rs. ${tm.toLocaleString(undefined,{maximumFractionDigits:0})} · Last Rs. ${lm.toLocaleString(undefined,{maximumFractionDigits:0})}</div>
                </div>
                <div class="font-extrabold text-[12px] ${cls}">${sign}${pct}% ${arrow}</div>
            </div>`;
        }).join('') : '<div class="opacity-40 py-6 text-center">No category data for this period</div>';
    } catch (e) {
        console.error(e);
        document.getElementById('list').innerHTML = '<div class="text-rose-500 py-4 text-center">Network error loading comparison</div>';
    }
}

document.addEventListener('DOMContentLoaded', function () {
    if (typeof initializeTheme === 'function') initializeTheme();
    loadCmp();
});
</script>
</body>
</html>

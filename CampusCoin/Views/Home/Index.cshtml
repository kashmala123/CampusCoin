        .cc-landing .section-head.reveal-group.in-view > * { opacity: 1; transform: none; }
        .cc-landing .section-head.reveal-group.in-view > *:nth-child(1) { transition-delay: 0s;   }
        .cc-landing .section-head.reveal-group.in-view > *:nth-child(2) { transition-delay: .14s; }
        .cc-landing .section-head.reveal-group.in-view > *:nth-child(3) { transition-delay: .28s; }

